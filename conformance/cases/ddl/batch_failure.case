# UpdateDatabaseDdl batches where one statement fails. `get_operation op=NAME meta` observes
# `counts: [done, failed, statements, commit_timestamps]` from the operation and its
# UpdateDatabaseDdlMetadata, or `counts: [-1]` when the request itself failed (no operation).
# `get_ddl` shows which statements before the failing one were kept.
schema:
  CREATE TABLE A (
    K INT64 NOT NULL,
    V STRING(MAX),
  ) PRIMARY KEY (K)
insert A cols=K,V:
  [1, "x"]
  [2, "x"]
  [3, null]

case schema_error_in_second_statement
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE INDEX NopeByV ON Nope(V);
  CREATE TABLE C (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: NOT_FOUND
  message: Table not found: Nope
expect@spanner:
  same
get_operation op=a meta
expect:
  counts: [-1]
expect@spanner:
  counts: [1,1,3,1]
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"

case duplicate_name_in_third_statement
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE INDEX BByK ON B(K);
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE C (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate name in schema: B.
expect@spanner:
  same
get_operation op=a meta
expect:
  counts: [-1]
expect@spanner:
  counts: [1,1,4,2]
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE INDEX BByK ON B(K)"

case schema_error_in_first_statement
ddl op=a:
  CREATE INDEX NopeByV ON Nope(V);
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: NOT_FOUND
  message: Table not found: Nope
expect@spanner:
  same
get_operation op=a meta
expect:
  counts: [-1]
expect@spanner:
  counts: [1,1,2,0]
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
expect@spanner:
  same

case syntax_error_in_second_statement
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABEL C (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing Spanner DDL statement: CREATE TABEL C (K INT64 NOT NULL) PRIMARY KEY (K) : Syntax error on line 1, column 8: Encountered 'TABEL' while parsing: create_statement
expect@spanner:
  same
get_operation op=a meta
expect:
  counts: [-1]
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
expect@spanner:
  same

case unique_index_on_duplicates_in_second_statement
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE UNIQUE INDEX AByV ON A(V);
  CREATE TABLE C (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Found uniqueness violation on index AByV, duplicate key: {String("x")}
expect@spanner:
  error: FAILED_PRECONDITION
  message: Found uniqueness violation: [x,1] [x,2].
get_operation op=a meta
expect:
  counts: [1,1,3,1]
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
expect@spanner:
  same

case not_null_on_nulls_in_second_statement
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  ALTER TABLE A ALTER COLUMN V STRING(MAX) NOT NULL;
  CREATE TABLE C (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Cannot specify a null value for column: V in table: A referenced by key: {Int64(3)}
expect@spanner:
  error: FAILED_PRECONDITION
  message: Adding a NOT NULL constraint on a column A.V is not allowed because it has a NULL value at key: [3]
get_operation op=a meta
expect:
  counts: [1,1,3,1]
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
expect@spanner:
  same

case drop_then_missing_table
ddl op=a:
  CREATE TABLE B (K INT64 NOT NULL) PRIMARY KEY (K);
  DROP TABLE B;
  DROP TABLE B
expect:
  error: NOT_FOUND
  message: Table not found: B
expect@spanner:
  same
get_operation op=a meta
expect:
  counts: [-1]
expect@spanner:
  counts: [1,1,3,2]
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n) PRIMARY KEY(K)"
expect@spanner:
  same
