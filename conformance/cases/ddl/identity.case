# Identity columns must be INT64 (production; the emulator since 1.5.52).
tags: ddl
schema:
  CREATE TABLE A (
    K INT64 NOT NULL,
  ) PRIMARY KEY (K)

case identity_string_key
ddl:
  CREATE TABLE T (K STRING(MAX) GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: The type of an identity column K is invalid. Currently, only INT64 is supported.
expect@spanner:
  same

case identity_timestamp_column
ddl:
  CREATE TABLE T (K INT64, C TIMESTAMP GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: The type of an identity column C is invalid. Currently, only INT64 is supported.
expect@spanner:
  same

case identity_float_add_column
ddl:
  ALTER TABLE A ADD COLUMN C FLOAT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE)
expect:
  error: INVALID_ARGUMENT
  message: The type of an identity column C is invalid. Currently, only INT64 is supported.
expect@spanner:
  same

case identity_int64_ok
ddl:
  CREATE TABLE T (K INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE), V STRING(MAX)) PRIMARY KEY (K)
insert T cols=V:
  ["a"]
query:
  SELECT COUNT(*) AS n FROM T WHERE K > 0
expect:
  columns: n INT64
  ["1"]
expect@spanner:
  same
