# Production's schema limits, which the emulator enforces too: 16 key columns (an index counts
# the base table's key columns it adds), 1024 columns and 128 indexes per table, and 2000 MiB of
# declared non-key column size per table (STRING counts 4 bytes per character, BYTES its length,
# JSON and arrays 10 MiB). Table (5000) and index (10000) counts per database are unit-tested:
# a case would need thousands of statements.
tags: ddl
schema:
  CREATE TABLE A (
    K INT64 NOT NULL,
    V STRING(MAX),
  ) PRIMARY KEY (K)

case key_columns_16
ddl:
  CREATE TABLE T (K0 INT64, K1 INT64, K2 INT64, K3 INT64, K4 INT64, K5 INT64, K6 INT64, K7 INT64, K8 INT64, K9 INT64, K10 INT64, K11 INT64, K12 INT64, K13 INT64, K14 INT64, K15 INT64) PRIMARY KEY (K0, K1, K2, K3, K4, K5, K6, K7, K8, K9, K10, K11, K12, K13, K14, K15)

case key_columns_17
ddl:
  CREATE TABLE T (K0 INT64, K1 INT64, K2 INT64, K3 INT64, K4 INT64, K5 INT64, K6 INT64, K7 INT64, K8 INT64, K9 INT64, K10 INT64, K11 INT64, K12 INT64, K13 INT64, K14 INT64, K15 INT64, K16 INT64) PRIMARY KEY (K0, K1, K2, K3, K4, K5, K6, K7, K8, K9, K10, K11, K12, K13, K14, K15, K16)
expect:
  error: INVALID_ARGUMENT
  message: Table T has too many keys (17); the limit is 16.

case index_key_columns_17
ddl:
  CREATE TABLE T (K INT64, C0 INT64, C1 INT64, C2 INT64, C3 INT64, C4 INT64, C5 INT64, C6 INT64, C7 INT64, C8 INT64, C9 INT64, C10 INT64, C11 INT64, C12 INT64, C13 INT64, C14 INT64, C15 INT64) PRIMARY KEY (K)
ddl:
  CREATE INDEX I ON T(C0, C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15)
expect:
  error: INVALID_ARGUMENT
  message: Index I has too many keys (17); the limit is 16.

case index_key_columns_16
ddl:
  CREATE TABLE T (K INT64, C0 INT64, C1 INT64, C2 INT64, C3 INT64, C4 INT64, C5 INT64, C6 INT64, C7 INT64, C8 INT64, C9 INT64, C10 INT64, C11 INT64, C12 INT64, C13 INT64, C14 INT64) PRIMARY KEY (K)
ddl:
  CREATE INDEX I ON T(C0, C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14)

case index_key_columns_shared_with_table_key
