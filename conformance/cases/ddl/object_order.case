# The order GetDatabaseDdl lists objects in (spanbolt #142). The emulator lists each kind in
# creation order; Cloud Spanner sorts by name. Names mix case to tell byte order from
# case-insensitive order; dependants (interleaved children, foreign keys, views on views, tables
# in named schemas) show where Spanner puts them.
tags: ddl

case tables
schema:
  CREATE TABLE Zeta (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE TABLE alpha (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE TABLE Beta (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE TABLE Delta (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE INDEX ZetaByV ON Zeta (V);
  CREATE INDEX AlphaByV ON alpha (V);
  CREATE INDEX AByV ON Zeta (V)
ddl:
  CREATE TABLE Mid (K INT64 NOT NULL) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE TABLE Zeta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON Zeta(V)"
  "CREATE INDEX ZetaByV ON Zeta(V)"
  "CREATE TABLE alpha (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX AlphaByV ON alpha(V)"
  "CREATE TABLE Beta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Delta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mid (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE Beta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Delta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mid (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Zeta (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON Zeta(V)"
  "CREATE INDEX ZetaByV ON Zeta(V)"
  "CREATE TABLE alpha (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX AlphaByV ON alpha(V)"

case interleaved
schema:
  CREATE TABLE Parent (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Child (K INT64 NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT Parent ON DELETE CASCADE;
  CREATE TABLE AGrandchild (K INT64 NOT NULL, C INT64 NOT NULL, G INT64 NOT NULL) PRIMARY KEY (K, C, G), INTERLEAVE IN PARENT Child;
  CREATE TABLE Other (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Bsibling (K INT64 NOT NULL, S INT64 NOT NULL) PRIMARY KEY (K, S), INTERLEAVE IN PARENT Parent
get_ddl
expect:
  statements:
  "CREATE TABLE Parent (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Child (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Parent ON DELETE CASCADE"
  "CREATE TABLE AGrandchild (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  G INT64 NOT NULL,\n) PRIMARY KEY(K, C, G),\n  INTERLEAVE IN PARENT Child ON DELETE NO ACTION"
  "CREATE TABLE Other (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Bsibling (\n  K INT64 NOT NULL,\n  S INT64 NOT NULL,\n) PRIMARY KEY(K, S),\n  INTERLEAVE IN PARENT Parent ON DELETE NO ACTION"
expect@spanner:
  statements:
  "CREATE TABLE Other (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Parent (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Bsibling (\n  K INT64 NOT NULL,\n  S INT64 NOT NULL,\n) PRIMARY KEY(K, S),\n  INTERLEAVE IN PARENT Parent ON DELETE NO ACTION"
  "CREATE TABLE Child (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Parent ON DELETE CASCADE"
  "CREATE TABLE AGrandchild (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  G INT64 NOT NULL,\n) PRIMARY KEY(K, C, G),\n  INTERLEAVE IN PARENT Child ON DELETE NO ACTION"

case foreign_keys
schema:
  CREATE TABLE Zref (K INT64 NOT NULL, R INT64) PRIMARY KEY (K);
  CREATE TABLE Aref (K INT64 NOT NULL, R INT64, CONSTRAINT FkAZ FOREIGN KEY (R) REFERENCES Zref (K)) PRIMARY KEY (K)
ddl:
  ALTER TABLE Zref ADD CONSTRAINT FkZA FOREIGN KEY (R) REFERENCES Aref (K)
get_ddl
expect:
  statements:
  "CREATE TABLE Zref (\n  K INT64 NOT NULL,\n  R INT64,\n  CONSTRAINT FkZA FOREIGN KEY(R) REFERENCES Aref(K),\n) PRIMARY KEY(K)"
  "CREATE TABLE Aref (\n  K INT64 NOT NULL,\n  R INT64,\n  CONSTRAINT FkAZ FOREIGN KEY(R) REFERENCES Zref(K),\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE Aref (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Zref (\n  K INT64 NOT NULL,\n  R INT64,\n  CONSTRAINT FkZA FOREIGN KEY(R) REFERENCES Aref(K),\n) PRIMARY KEY(K)"
  "ALTER TABLE Aref ADD CONSTRAINT FkAZ FOREIGN KEY(R) REFERENCES Zref(K)"

case views
schema:
  CREATE TABLE T (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE VIEW Zv SQL SECURITY INVOKER AS SELECT T.K, T.V FROM T;
  CREATE VIEW Av SQL SECURITY INVOKER AS SELECT Zv.K FROM Zv;
  CREATE VIEW Mv SQL SECURITY INVOKER AS SELECT T.V FROM T
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE VIEW Zv SQL SECURITY INVOKER AS SELECT T.K, T.V FROM T"
  "CREATE VIEW Av SQL SECURITY INVOKER AS SELECT Zv.K FROM Zv"
  "CREATE VIEW Mv SQL SECURITY INVOKER AS SELECT T.V FROM T"
expect@spanner:
  same

case sequences
schema:
  CREATE SEQUENCE Zseq OPTIONS (sequence_kind = 'bit_reversed_positive');
  CREATE SEQUENCE Aseq OPTIONS (sequence_kind = 'bit_reversed_positive');
  CREATE TABLE T (K INT64 NOT NULL) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE SEQUENCE Zseq OPTIONS (\n  sequence_kind = 'bit_reversed_positive')"
  "CREATE SEQUENCE Aseq OPTIONS (\n  sequence_kind = 'bit_reversed_positive')"
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE SEQUENCE Aseq OPTIONS (\n  sequence_kind = 'bit_reversed_positive'\n)"
  "CREATE SEQUENCE Zseq OPTIONS (\n  sequence_kind = 'bit_reversed_positive'\n)"
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"

case named_schemas
schema:
  CREATE SCHEMA Zsch;
  CREATE SCHEMA Asch;
  CREATE TABLE Zsch.T (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Mt (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Asch.T (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Atab (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE VIEW Zsch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt;
  CREATE VIEW Asch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt
get_ddl
expect:
  statements:
  "CREATE SCHEMA Zsch"
  "CREATE SCHEMA Asch"
  "CREATE TABLE Zsch.T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mt (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Asch.T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Atab (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE VIEW Zsch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt"
  "CREATE VIEW Asch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt"
expect@spanner:
  statements:
  "CREATE SCHEMA Asch"
  "CREATE SCHEMA Zsch"
  "CREATE TABLE Asch.T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Atab (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mt (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Zsch.T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE VIEW Asch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt"
  "CREATE VIEW Zsch.V SQL SECURITY INVOKER AS SELECT Mt.K FROM Mt"

case roles
schema:
  CREATE TABLE T (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE ROLE zrole;
  CREATE ROLE Arole;
  CREATE ROLE mrole;
  GRANT SELECT ON TABLE T TO ROLE zrole;
  GRANT SELECT ON TABLE T TO ROLE Arole;
  GRANT ROLE mrole TO ROLE zrole;
  GRANT ROLE mrole TO ROLE Arole
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE ROLE Arole"
  "CREATE ROLE mrole"
  "CREATE ROLE zrole"
  "GRANT ROLE mrole TO ROLE Arole"
  "GRANT ROLE mrole TO ROLE zrole"
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "GRANT SELECT ON TABLE T TO ROLE Arole"
  "GRANT SELECT ON TABLE T TO ROLE zrole"

case graphs
schema:
  CREATE TABLE Person (Id STRING(MAX) NOT NULL) PRIMARY KEY (Id);
  CREATE PROPERTY GRAPH Zg NODE TABLES (Person KEY (Id) LABEL P PROPERTIES (Id));
  CREATE PROPERTY GRAPH Ag NODE TABLES (Person KEY (Id) LABEL P PROPERTIES (Id))
get_ddl
expect:
  statements:
  "CREATE TABLE Person (\n  Id STRING(MAX) NOT NULL,\n) PRIMARY KEY(Id)"
  "CREATE PROPERTY GRAPH Zg\nNODE TABLES(\n  Person KEY(Id) LABEL P PROPERTIES(\nId)\n)"
  "CREATE PROPERTY GRAPH Ag\nNODE TABLES(\n  Person KEY(Id) LABEL P PROPERTIES(\nId)\n)"
expect@spanner:
  statements:
  "CREATE TABLE Person (\n  Id STRING(MAX) NOT NULL,\n) PRIMARY KEY(Id)"
  "CREATE PROPERTY GRAPH Ag\n  NODE TABLES(\n    Person\n      KEY(Id)\n      LABEL P PROPERTIES(\n        Id)\n  )"
  "CREATE PROPERTY GRAPH Zg\n  NODE TABLES(\n    Person\n      KEY(Id)\n      LABEL P PROPERTIES(\n        Id)\n  )"

case locality_groups
schema:
  CREATE LOCALITY GROUP zlg;
  CREATE LOCALITY GROUP alg;
  ALTER LOCALITY GROUP `default` SET OPTIONS (storage = 'hdd');
  CREATE TABLE T (K INT64 NOT NULL) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE LOCALITY GROUP zlg"
  "CREATE LOCALITY GROUP alg"
  "CREATE LOCALITY GROUP `default` OPTIONS ( storage = 'hdd' )"
expect@spanner:
  statements:
  "CREATE LOCALITY GROUP alg"
  "ALTER LOCALITY GROUP `default` SET OPTIONS (\n  storage = 'hdd'\n)"
  "CREATE LOCALITY GROUP zlg"
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"

case interleaved_tree
schema:
  CREATE TABLE Pz (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Pa (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE INDEX PaByV ON Pa (V);
  CREATE TABLE B (K INT64 NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT Pz;
  CREATE TABLE Q (K INT64 NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT Pa;
  CREATE TABLE Pb (K INT64 NOT NULL, C INT64 NOT NULL, V INT64) PRIMARY KEY (K, C), INTERLEAVE IN PARENT Pa;
  CREATE INDEX PbByV ON Pb (K, V), INTERLEAVE IN Pa;
  CREATE TABLE Pbb (K INT64 NOT NULL, C INT64 NOT NULL, D INT64 NOT NULL) PRIMARY KEY (K, C, D), INTERLEAVE IN PARENT Pb
get_ddl
expect:
  statements:
  "CREATE TABLE Pz (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Pa (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX PaByV ON Pa(V)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pz ON DELETE NO ACTION"
  "CREATE TABLE Q (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pa ON DELETE NO ACTION"
  "CREATE TABLE Pb (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pa ON DELETE NO ACTION"
  "CREATE INDEX PbByV ON Pb(K, V), INTERLEAVE IN Pa"
  "CREATE TABLE Pbb (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  D INT64 NOT NULL,\n) PRIMARY KEY(K, C, D),\n  INTERLEAVE IN PARENT Pb ON DELETE NO ACTION"
expect@spanner:
  statements:
  "CREATE TABLE Pa (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX PaByV ON Pa(V)"
  "CREATE TABLE Pb (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pa ON DELETE NO ACTION"
  "CREATE INDEX PbByV ON Pb(K, V), INTERLEAVE IN Pa"
  "CREATE TABLE Pbb (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n  D INT64 NOT NULL,\n) PRIMARY KEY(K, C, D),\n  INTERLEAVE IN PARENT Pb ON DELETE NO ACTION"
  "CREATE TABLE Q (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pa ON DELETE NO ACTION"
  "CREATE TABLE Pz (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE B (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT Pz ON DELETE NO ACTION"

case foreign_key_placement
schema:
  CREATE TABLE Mfk (K INT64 NOT NULL, R INT64) PRIMARY KEY (K);
  CREATE INDEX MfkByR ON Mfk (R);
  CREATE TABLE Zfk (K INT64 NOT NULL, R INT64, S INT64, CONSTRAINT FkZself FOREIGN KEY (S) REFERENCES Zfk (K)) PRIMARY KEY (K);
  CREATE TABLE Afk (K INT64 NOT NULL, R INT64, S INT64, CONSTRAINT FkAM FOREIGN KEY (R) REFERENCES Mfk (K), CONSTRAINT FkAZ FOREIGN KEY (S) REFERENCES Zfk (K)) PRIMARY KEY (K);
  CREATE INDEX AfkByR ON Afk (R);
  CREATE VIEW V SQL SECURITY INVOKER AS SELECT Afk.K FROM Afk
get_ddl
expect:
  statements:
  "CREATE TABLE Mfk (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX MfkByR ON Mfk(R)"
  "CREATE TABLE Zfk (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  CONSTRAINT FkZself FOREIGN KEY(S) REFERENCES Zfk(K),\n) PRIMARY KEY(K)"
  "CREATE TABLE Afk (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  CONSTRAINT FkAM FOREIGN KEY(R) REFERENCES Mfk(K),\n  CONSTRAINT FkAZ FOREIGN KEY(S) REFERENCES Zfk(K),\n) PRIMARY KEY(K)"
  "CREATE INDEX AfkByR ON Afk(R)"
  "CREATE VIEW V SQL SECURITY INVOKER AS SELECT Afk.K FROM Afk"
expect@spanner:
  statements:
  "CREATE TABLE Afk (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX AfkByR ON Afk(R)"
  "CREATE TABLE Mfk (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "ALTER TABLE Afk ADD CONSTRAINT FkAM FOREIGN KEY(R) REFERENCES Mfk(K)"
  "CREATE INDEX MfkByR ON Mfk(R)"
  "CREATE TABLE Zfk (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  CONSTRAINT FkZself FOREIGN KEY(S) REFERENCES Zfk(K),\n) PRIMARY KEY(K)"
  "ALTER TABLE Afk ADD CONSTRAINT FkAZ FOREIGN KEY(S) REFERENCES Zfk(K)"
  "CREATE VIEW V SQL SECURITY INVOKER AS SELECT Afk.K FROM Afk"

case view_dependencies
schema:
  CREATE TABLE T (K INT64 NOT NULL, V INT64) PRIMARY KEY (K);
  CREATE VIEW Mv SQL SECURITY INVOKER AS SELECT T.V FROM T;
  CREATE VIEW Bv SQL SECURITY INVOKER AS SELECT T.K FROM T;
  CREATE VIEW Cv SQL SECURITY INVOKER AS SELECT T.K FROM T;
  CREATE VIEW Zv SQL SECURITY INVOKER AS SELECT Bv.K FROM Bv;
  CREATE VIEW Av SQL SECURITY INVOKER AS SELECT Zv.K FROM Zv
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE VIEW Mv SQL SECURITY INVOKER AS SELECT T.V FROM T"
  "CREATE VIEW Bv SQL SECURITY INVOKER AS SELECT T.K FROM T"
  "CREATE VIEW Cv SQL SECURITY INVOKER AS SELECT T.K FROM T"
  "CREATE VIEW Zv SQL SECURITY INVOKER AS SELECT Bv.K FROM Bv"
  "CREATE VIEW Av SQL SECURITY INVOKER AS SELECT Zv.K FROM Zv"
expect@spanner:
  statements:
  "CREATE TABLE T (\n  K INT64 NOT NULL,\n  V INT64,\n) PRIMARY KEY(K)"
  "CREATE VIEW Bv SQL SECURITY INVOKER AS SELECT T.K FROM T"
  "CREATE VIEW Zv SQL SECURITY INVOKER AS SELECT Bv.K FROM Bv"
  "CREATE VIEW Av SQL SECURITY INVOKER AS SELECT Zv.K FROM Zv"
  "CREATE VIEW Cv SQL SECURITY INVOKER AS SELECT T.K FROM T"
  "CREATE VIEW Mv SQL SECURITY INVOKER AS SELECT T.V FROM T"

case foreign_keys_to_one_table
schema:
  CREATE TABLE Mt (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Bx (K INT64 NOT NULL, R INT64, FOREIGN KEY (R) REFERENCES Mt (K) ON DELETE CASCADE) PRIMARY KEY (K);
  CREATE TABLE Ax (K INT64 NOT NULL, R INT64, CONSTRAINT Zname FOREIGN KEY (R) REFERENCES Mt (K)) PRIMARY KEY (K);
  CREATE TABLE Cx (K INT64 NOT NULL, R INT64, CONSTRAINT Aname FOREIGN KEY (R) REFERENCES Mt (K) NOT ENFORCED) PRIMARY KEY (K);
  CREATE TABLE Ay (K INT64 NOT NULL, R INT64, S INT64, CONSTRAINT Yb FOREIGN KEY (S) REFERENCES Mt (K), CONSTRAINT Ya FOREIGN KEY (R) REFERENCES Mt (K)) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE TABLE Mt (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Bx (\n  K INT64 NOT NULL,\n  R INT64,\n  FOREIGN KEY(R) REFERENCES Mt(K) ON DELETE CASCADE,\n) PRIMARY KEY(K)"
  "CREATE TABLE Ax (\n  K INT64 NOT NULL,\n  R INT64,\n  CONSTRAINT Zname FOREIGN KEY(R) REFERENCES Mt(K),\n) PRIMARY KEY(K)"
  "CREATE TABLE Cx (\n  K INT64 NOT NULL,\n  R INT64,\n  CONSTRAINT Aname FOREIGN KEY(R) REFERENCES Mt(K) NOT ENFORCED,\n) PRIMARY KEY(K)"
  "CREATE TABLE Ay (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  CONSTRAINT Yb FOREIGN KEY(S) REFERENCES Mt(K),\n  CONSTRAINT Ya FOREIGN KEY(R) REFERENCES Mt(K),\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE Ax (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Ay (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Bx (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Cx (\n  K INT64 NOT NULL,\n  R INT64,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mt (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "ALTER TABLE Cx ADD CONSTRAINT Aname FOREIGN KEY(R) REFERENCES Mt(K) NOT ENFORCED"
  "ALTER TABLE Bx ADD FOREIGN KEY(R) REFERENCES Mt(K) ON DELETE CASCADE"
  "ALTER TABLE Ay ADD CONSTRAINT Ya FOREIGN KEY(R) REFERENCES Mt(K)"
  "ALTER TABLE Ay ADD CONSTRAINT Yb FOREIGN KEY(S) REFERENCES Mt(K)"
  "ALTER TABLE Ax ADD CONSTRAINT Zname FOREIGN KEY(R) REFERENCES Mt(K)"

case foreign_keys_inline_and_deferred
schema:
  CREATE TABLE Aa (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Ab (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Zz (K INT64 NOT NULL) PRIMARY KEY (K);
  CREATE TABLE Mm (K INT64 NOT NULL, R INT64, S INT64, T INT64, CONSTRAINT Zfk FOREIGN KEY (R) REFERENCES Aa (K), CONSTRAINT Afk FOREIGN KEY (S) REFERENCES Ab (K), CONSTRAINT Mfk FOREIGN KEY (T) REFERENCES Zz (K), CONSTRAINT Ck CHECK (K > 0)) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE TABLE Aa (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Ab (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Zz (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mm (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  T INT64,\n  CONSTRAINT Zfk FOREIGN KEY(R) REFERENCES Aa(K),\n  CONSTRAINT Afk FOREIGN KEY(S) REFERENCES Ab(K),\n  CONSTRAINT Mfk FOREIGN KEY(T) REFERENCES Zz(K),\n  CONSTRAINT Ck CHECK(K > 0),\n) PRIMARY KEY(K)"
expect@spanner:
  statements:
  "CREATE TABLE Aa (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Ab (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "CREATE TABLE Mm (\n  K INT64 NOT NULL,\n  R INT64,\n  S INT64,\n  T INT64,\n  CONSTRAINT Afk FOREIGN KEY(S) REFERENCES Ab(K),\n  CONSTRAINT Zfk FOREIGN KEY(R) REFERENCES Aa(K),\n  CONSTRAINT Ck CHECK(K > 0),\n) PRIMARY KEY(K)"
  "CREATE TABLE Zz (\n  K INT64 NOT NULL,\n) PRIMARY KEY(K)"
  "ALTER TABLE Mm ADD CONSTRAINT Mfk FOREIGN KEY(T) REFERENCES Zz(K)"
