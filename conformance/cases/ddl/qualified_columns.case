tags: ddl generated
# Table-qualified column names in generated, DEFAULT and CHECK expressions (#127: the generated
# column cycle check skips names after a dot). `expect:` from the emulator 1.5.59.
schema:
  CREATE TABLE T (
    K INT64 NOT NULL,
    N INT64,
  ) PRIMARY KEY (K)

case generated_qualified
ddl:
  ALTER TABLE T ADD COLUMN G INT64 AS (T.N + 1) STORED
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the definition of generated column `T`.`G`: Unrecognized name: T [at 1:2]

case generated_qualified_self_named
ddl:
  ALTER TABLE T ADD COLUMN N2 INT64 AS (T.N2 + 1) STORED
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the definition of generated column `T`.`N2`: Unrecognized name: T [at 1:2]

case default_qualified
ddl:
  ALTER TABLE T ADD COLUMN D INT64 DEFAULT (T.N)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the default value of column `T`.`D`: Unrecognized name: T [at 1:1]

case check_qualified
ddl:
  ALTER TABLE T ADD CONSTRAINT C CHECK (T.N > 0)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing expression 'T.N > 0' from check constraint 'C' in table 'T': Unrecognized name: T [at 1:1]
