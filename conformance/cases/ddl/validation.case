tags: ddl
schema:
  CREATE TABLE A (
    K INT64 NOT NULL,
    V STRING(MAX),
    Arr ARRAY<INT64>,
  ) PRIMARY KEY (K);
  CREATE INDEX AByV ON A(V)

case dup_table
ddl:
  CREATE TABLE A (K INT64 NOT NULL) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate name in schema: A.

case dup_column
ddl:
  CREATE TABLE X (K INT64, K STRING(MAX)) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate column name X.K.

case missing_pk_column
ddl:
  CREATE TABLE X (K INT64) PRIMARY KEY (Nope)
expect:
  error: FAILED_PRECONDITION
  message: Table X references nonexistent key column Nope.
expect@spanner:
  error: FAILED_PRECONDITION
  message: table X references nonexistent key column Nope.

case unknown_type
skip: the emulator answers INTERNAL (GOOGLESQL_RET_CHECK); real Spanner rejects with INVALID_ARGUMENT
ddl:
  CREATE TABLE X (K WAT) PRIMARY KEY (K)
expect:
  error: INTERNAL
  message: GOOGLESQL_RET_CHECK failure (backend/schema/updater/ddl_type_conversion.cc:242) false Unrecognized ddl::ColumnDefinition: column_name: "K" type: NONE proto_type_name: "WAT"

case string_no_length
ddl:
  CREATE TABLE X (K INT64, S STRING) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing Spanner DDL statement: CREATE TABLE X (K INT64, S STRING) PRIMARY KEY (K) : Syntax error on line 1, column 34: Expecting '(' but found ')'
expect@spanner:
  same

case string_length_zero
ddl:
  CREATE TABLE X (K INT64, S STRING(0)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Bad length for column X.S: 0 : Allowed length range: [1, 2621440].

case string_length_too_big
ddl:
  CREATE TABLE X (K INT64, S STRING(2621441)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Bad length for column X.S: 2621441 : Allowed length range: [1, 2621440].

case array_key
ddl:
  CREATE TABLE X (K ARRAY<INT64>) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Column X.K has type ARRAY, but is part of the primary key.

case json_key
ddl:
  CREATE TABLE X (K JSON) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Column X.K has type JSON, but is part of the primary key.

case nested_array
ddl:
  CREATE TABLE X (K INT64, A ARRAY<ARRAY<INT64>>) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Array of arrays type is not supported by the schema.

case syntax_error
ddl:
  CREATE TABEL X (K INT64) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing Spanner DDL statement: CREATE TABEL X (K INT64) PRIMARY KEY (K) : Syntax error on line 1, column 8: Encountered 'TABEL' while parsing: create_statement
expect@spanner:
  same

case no_primary_key
ddl:
  CREATE TABLE X (K INT64)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
  "CREATE TABLE X (\n  K INT64,\n  rowid INT64 NOT NULL GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE) HIDDEN,\n) PRIMARY KEY(rowid)"

case empty_primary_key
ddl:
  CREATE TABLE X (K INT64) PRIMARY KEY ()
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
  "CREATE TABLE X (\n  K INT64,\n) PRIMARY KEY()"

case interleave_missing_parent
ddl:
  CREATE TABLE X (K INT64 NOT NULL) PRIMARY KEY (K), INTERLEAVE IN PARENT Nope
expect:
  error: NOT_FOUND
  message: Table not found: Nope

case interleave_bad_prefix
ddl:
  CREATE TABLE X (Z INT64 NOT NULL, K INT64 NOT NULL) PRIMARY KEY (Z, K), INTERLEAVE IN PARENT A
expect:
  error: FAILED_PRECONDITION
  message: Table X references parent key column K at incorrect position 1.

case interleave_type_mismatch
ddl:
  CREATE TABLE X (K STRING(MAX) NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT A
expect:
  error: FAILED_PRECONDITION
  message: Table X references parent key column K with incorrect type STRING (should be INT64).

case interleave_ok
ddl:
  CREATE TABLE X (K INT64 NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT A ON DELETE CASCADE
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
  "CREATE TABLE X (\n  K INT64 NOT NULL,\n  C INT64 NOT NULL,\n) PRIMARY KEY(K, C),\n  INTERLEAVE IN PARENT A ON DELETE CASCADE"

case index_missing_table
ddl:
  CREATE INDEX I ON Nope(K)
expect:
  error: NOT_FOUND
  message: Table not found: Nope

case index_missing_column
ddl:
  CREATE INDEX I ON A(Nope)
expect:
  error: INVALID_ARGUMENT
  message: Index I specifies key column Nope which does not exist in the index's base table.
expect@spanner:
  error: FAILED_PRECONDITION
  message: Index I specifies key column Nope which does not exist in the index's base table.

case index_dup_name
ddl:
  CREATE INDEX AByV ON A(V)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate name in schema: AByV.

case index_name_clashes_table
ddl:
  CREATE INDEX A ON A(V)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate name in schema: A.

case index_on_array
ddl:
  CREATE INDEX I ON A(Arr)
expect:
  error: FAILED_PRECONDITION
  message: Cannot reference ARRAY Arr in the creation of index I.

case index_storing_key
ddl:
  CREATE INDEX I ON A(V) STORING (K)
expect:
  error: FAILED_PRECONDITION
  message: Index I specifies stored column K which is a key of table A.

case index_storing_missing
ddl:
  CREATE INDEX I ON A(V) STORING (Nope)
expect:
  error: INVALID_ARGUMENT
  message: Index I specifies key column Nope which does not exist in the index's base table.
expect@spanner:
  error: FAILED_PRECONDITION
  message: Index I specifies nonexistent stored column Nope.

case drop_missing_table
ddl:
  DROP TABLE Nope
expect:
  error: NOT_FOUND
  message: Table not found: Nope

case drop_table_with_index
ddl:
  DROP TABLE A
expect:
  error: FAILED_PRECONDITION
  message: Cannot drop table A with indices: AByV.

case drop_parent_with_child
ddl:
  CREATE TABLE X (K INT64 NOT NULL, C INT64 NOT NULL) PRIMARY KEY (K, C), INTERLEAVE IN PARENT A;
  DROP TABLE A
expect:
  error: FAILED_PRECONDITION
  message: Cannot drop table A with interleaved tables: X.

case drop_missing_index
ddl:
  DROP INDEX Nope
expect:
  error: NOT_FOUND
  message: Index not found: Nope

case drop_key_column
ddl:
  ALTER TABLE A DROP COLUMN K
expect:
  error: INVALID_ARGUMENT
  message: Cannot drop key column K from table A.

case drop_indexed_column
ddl:
  ALTER TABLE A DROP COLUMN V
expect:
  error: FAILED_PRECONDITION
  message: Cannot drop column V from table A because it is used by index AByV.

case add_existing_column
ddl:
  ALTER TABLE A ADD COLUMN V INT64
expect:
  error: FAILED_PRECONDITION
  message: Duplicate column name A.V.

case add_not_null_no_default
ddl:
  ALTER TABLE A ADD COLUMN N INT64 NOT NULL
expect:
  error: UNIMPLEMENTED
  message: Cannot add NOT NULL column A.N to existing table A.

case add_not_null_default
ddl:
  ALTER TABLE A ADD COLUMN N INT64 NOT NULL DEFAULT (7)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n  N INT64 NOT NULL DEFAULT (7),\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"

case add_column_if_not_exists
ddl:
  ALTER TABLE A ADD COLUMN IF NOT EXISTS V STRING(MAX)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"

case alter_type_incompatible
ddl:
  ALTER TABLE A ALTER COLUMN V BOOL
expect:
  error: INVALID_ARGUMENT
  message: Cannot change type of column `V` from `STRING` to `BOOL`

case alter_string_to_bytes
ddl:
  ALTER TABLE A ALTER COLUMN V BYTES(MAX)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V BYTES(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"

case alter_missing_column
ddl:
  ALTER TABLE A ALTER COLUMN Nope INT64
expect:
  error: NOT_FOUND
  message: Column not found in table A: Nope

case fk_missing_table
ddl:
  CREATE TABLE X (K INT64, R INT64, CONSTRAINT FK FOREIGN KEY (R) REFERENCES Nope (K)) PRIMARY KEY (K)
expect:
  error: NOT_FOUND
  message: Table not found: Nope

case fk_type_mismatch
ddl:
  CREATE TABLE X (K INT64, R STRING(MAX), CONSTRAINT FK FOREIGN KEY (R) REFERENCES A (K)) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: The column types are different for column `R` of table `X` and column `K` of table `A` in foreign key `FK`.

case check_bad_expr
ddl:
  CREATE TABLE X (K INT64, CONSTRAINT C CHECK (Nope > 0)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing expression 'Nope > 0' from check constraint 'C' in table 'X': Unrecognized name: Nope [at 1:1]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing expression \'Nope > 0\' from check constraint \'C\' in table \'X\': Unrecognized name: Nope [at 1:1]

case generated_missing_ref
ddl:
  CREATE TABLE X (K INT64, G INT64 AS (Nope + 1) STORED) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the definition of generated column `X`.`G`: Unrecognized name: Nope [at 1:2]

case default_type_mismatch
ddl:
  CREATE TABLE X (K INT64, D INT64 DEFAULT ('x')) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the default value of column `X`.`D`: Expected type INT64; found STRING [at 1:1]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing default value expression \'\'x\'\' from column \'D\' in table \'X\': Expected type INT64; found STRING [at 1:1]

case commit_ts_option_on_int
ddl:
  CREATE TABLE X (K INT64, T INT64 OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Column X.T has invalid allow_commit_timestamp option. Option only allowed on TIMESTAMP columns.

case row_deletion_bad_column
ddl:
  CREATE TABLE X (K INT64, T TIMESTAMP) PRIMARY KEY (K), ROW DELETION POLICY (OLDER_THAN(Nope, INTERVAL 1 DAY))
expect:
  error: INVALID_ARGUMENT
  message: Cannot create ROW DELETION POLICY because there is no column named Nope in table X.

case search_index_non_tokenlist
ddl:
  CREATE SEARCH INDEX SI ON A(V)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
  "CREATE SEARCH INDEX SI ON A(V)"

case create_if_not_exists_existing
ddl:
  CREATE TABLE IF NOT EXISTS A (K INT64 NOT NULL) PRIMARY KEY (K)
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"

case drop_if_exists_missing
ddl:
  DROP TABLE IF EXISTS Nope
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"

case multi_statement_partial_failure
ddl:
  CREATE TABLE X (K INT64) PRIMARY KEY (K);
  CREATE TABLE X (K INT64) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Duplicate name in schema: X.
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
expect@spanner:
  statements:
  "CREATE TABLE A (\n  K INT64 NOT NULL,\n  V STRING(MAX),\n  Arr ARRAY<INT64>,\n) PRIMARY KEY(K)"
  "CREATE INDEX AByV ON A(V)"
  "CREATE TABLE X (\n  K INT64,\n) PRIMARY KEY(K)"


# A filtered index can't drop the STORING column its WHERE clause filters on.
case alter_index_drop_stored_filter_column
schema:
  CREATE TABLE U (
    K INT64 NOT NULL,
    A INT64,
    B INT64,
    C INT64,
  ) PRIMARY KEY (K);
  CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL
ddl:
  ALTER INDEX UByA DROP STORED COLUMN B
expect@spanner:
  error: INVALID_ARGUMENT
  message: Cannot drop null filtered column B in index UByA.
get_ddl
expect:
  statements:
  "CREATE TABLE U (\n  K INT64 NOT NULL,\n  A INT64,\n  B INT64,\n  C INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX UByA ON U(A) STORING (C)"
expect@spanner:
  statements:
  "CREATE TABLE U (\n  K INT64 NOT NULL,\n  A INT64,\n  B INT64,\n  C INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL"

case alter_index_drop_stored_non_filter_column
schema:
  CREATE TABLE U (
    K INT64 NOT NULL,
    A INT64,
    B INT64,
    C INT64,
  ) PRIMARY KEY (K);
  CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL
ddl:
  ALTER INDEX UByA DROP STORED COLUMN C
get_ddl
expect:
  statements:
  "CREATE TABLE U (\n  K INT64 NOT NULL,\n  A INT64,\n  B INT64,\n  C INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX UByA ON U(A) STORING (B) WHERE B IS NOT NULL"
expect@spanner:
  same

case alter_index_drop_stored_filter_column_two_filters
schema:
  CREATE TABLE U (
    K INT64 NOT NULL,
    A INT64,
    B INT64,
    C INT64,
  ) PRIMARY KEY (K);
  CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL AND C IS NOT NULL
ddl:
  ALTER INDEX UByA DROP STORED COLUMN C
expect@spanner:
  error: INVALID_ARGUMENT
  message: Cannot drop null filtered column C in index UByA.
get_ddl
expect:
  statements:
  "CREATE TABLE U (\n  K INT64 NOT NULL,\n  A INT64,\n  B INT64,\n  C INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX UByA ON U(A) STORING (B) WHERE B IS NOT NULL"
expect@spanner:
  statements:
  "CREATE TABLE U (\n  K INT64 NOT NULL,\n  A INT64,\n  B INT64,\n  C INT64,\n) PRIMARY KEY(K)"
  "CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL AND C IS NOT NULL"

case alter_index_drop_stored_filter_column_data
schema:
  CREATE TABLE U (
    K INT64 NOT NULL,
    A INT64,
    B INT64,
    C INT64,
  ) PRIMARY KEY (K);
  CREATE INDEX UByA ON U(A) STORING (B, C) WHERE B IS NOT NULL
insert U cols=K,A,B,C:
  [1, 10, 100, 1000]
  [2, 20, null, 2000]
ddl:
  ALTER INDEX UByA DROP STORED COLUMN B
expect@spanner:
  error: INVALID_ARGUMENT
  message: Cannot drop null filtered column B in index UByA.
read U cols=K,A,C index=UByA:
  all
expect:
  columns: K INT64, A INT64, C INT64
  ["1","10","1000"]
expect@spanner:
  same
query:
  SELECT K, A, C FROM U@{FORCE_INDEX=UByA} ORDER BY K
expect:
  columns: K INT64, A INT64, C INT64
  ["1","10","1000"]
  ["2","20","2000"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: The index UByA cannot be used because it filters nulls that are required to answer the query for column B.
insert U cols=K,A,B,C:
  [3, 30, null, 3000]
read U cols=K,A,C index=UByA:
  all
expect:
  columns: K INT64, A INT64, C INT64
  ["1","10","1000"]
  ["3","30","3000"]
expect@spanner:
  columns: K INT64, A INT64, C INT64
  ["1","10","1000"]
