# Production's write limits: a key (table or index) of at most 8 KiB, and at most 80,000
# mutations per commit. The emulator enforces the key size but not the mutation count.
tags: mutations
schema:
  CREATE TABLE T (
    K STRING(MAX) NOT NULL,
    V STRING(MAX),
  ) PRIMARY KEY (K);
  CREATE INDEX TByV ON T(V);
  CREATE TABLE Plain (
    K STRING(MAX) NOT NULL,
  ) PRIMARY KEY (K);
  CREATE TABLE Wide (
    K INT64 NOT NULL,
    A INT64,
    B INT64,
  ) PRIMARY KEY (K)

case key_size_at_limit
insert Plain cols=K:
  [""]
expect:
  ok

case key_size_over_limit
insert Plain cols=K:
  [""]
expect:
  error: INVALID_ARGUMENT
  message: Number of bytes for key of table Plain is 8193 which exceeds the maximum of 8192.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Number of bytes in key of table Plain is 8193 which exceeds the maximum of 8192.

case index_key_size_over_limit
insert T cols=K,V:
  ["k", ""]
expect:
  error: INVALID_ARGUMENT
  message: Number of bytes for key of index TByV is 8194 which exceeds the maximum of 8192.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Number of bytes in key of table T, index TByV is 8195 which exceeds the maximum of 8192.

case key_size_dml
dml:
  INSERT INTO Plain (K) VALUES (REPEAT('a', 8193))
expect:
  error: INVALID_ARGUMENT
  message: Number of bytes for key of table Plain is 8193 which exceeds the maximum of 8192.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Number of bytes in key of table Plain is 8193 which exceeds the maximum of 8192.

case mutations_at_limit
dml:
  INSERT INTO Wide (K, A, B) SELECT a * 1000 + b, a, b FROM UNNEST(GENERATE_ARRAY(1, 200)) AS a, UNNEST(GENERATE_ARRAY(1, 133)) AS b
expect:
  count: 26600
expect@spanner:
  same

case mutations_over_limit
dml:
  INSERT INTO Wide (K, A, B) SELECT a * 1000 + b, a, b FROM UNNEST(GENERATE_ARRAY(1, 200)) AS a, UNNEST(GENERATE_ARRAY(1, 134)) AS b
expect:
  count: 26800
expect@spanner:
  error: INVALID_ARGUMENT
  message: The transaction contains too many mutations. Insert and update operations count with the multiplicity of the number of columns they affect. For example, inserting values into one key column and four non-key columns count as five mutations total for the insert. Delete and delete range operations count as one mutation regardless of the number of columns affected. The total mutation count includes any changes to indexes that the transaction generates. Please reduce the number of writes, or use fewer indexes. (Maximum number: 80000)

case mutations_over_limit_update
dml:
  INSERT INTO Wide (K) SELECT a * 1000 + b FROM UNNEST(GENERATE_ARRAY(1, 200)) AS a, UNNEST(GENERATE_ARRAY(1, 150)) AS b
expect:
  count: 30000
expect@spanner:
  same
dml:
  UPDATE Wide SET A = 1, B = 2 WHERE TRUE
expect:
  count: 30000
expect@spanner:
  error: INVALID_ARGUMENT
  message: The transaction contains too many mutations. Insert and update operations count with the multiplicity of the number of columns they affect. For example, inserting values into one key column and four non-key columns count as five mutations total for the insert. Delete and delete range operations count as one mutation regardless of the number of columns affected. The total mutation count includes any changes to indexes that the transaction generates. Please reduce the number of writes, or use fewer indexes. (Maximum number: 80000)

case mutations_over_limit_across_statements
begin txn=t
dml txn=t:
  INSERT INTO Wide (K, A, B) SELECT a * 1000 + b, a, b FROM UNNEST(GENERATE_ARRAY(1, 100)) AS a, UNNEST(GENERATE_ARRAY(1, 134)) AS b
expect:
  count: 13400
expect@spanner:
  same
dml txn=t:
  INSERT INTO Wide (K, A, B) SELECT 1000000 + a * 1000 + b, a, b FROM UNNEST(GENERATE_ARRAY(1, 100)) AS a, UNNEST(GENERATE_ARRAY(1, 134)) AS b
expect:
  count: 13400
expect@spanner:
  same
commit txn=t
query:
  SELECT COUNT(*) AS n FROM Wide
expect:
  columns: n INT64
  ["26800"]
expect@spanner:
  same

case mutations_delete_counts_one
dml:
  INSERT INTO Wide (K, A, B) SELECT a * 1000 + b, a, b FROM UNNEST(GENERATE_ARRAY(1, 200)) AS a, UNNEST(GENERATE_ARRAY(1, 133)) AS b
expect:
  count: 26600
expect@spanner:
  same
dml:
  DELETE FROM Wide WHERE TRUE
expect:
  count: 26600
expect@spanner:
  same
