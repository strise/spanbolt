case alter_column_drop_default_with_on_update
ddl:
  ALTER TABLE T ALTER COLUMN Updated DROP DEFAULT
expect:
  error: INVALID_ARGUMENT
  message: Column `Updated` with an ON UPDATE expression must have an identical DEFAULT value expression.
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
expect@spanner:
  same

case alter_column_set_default_with_on_update
ddl:
  ALTER TABLE T ALTER COLUMN Updated SET DEFAULT (TIMESTAMP '2020-01-01T00:00:00Z')
expect:
  error: FAILED_PRECONDITION
  message: The only default value expression permitted for commit timestamp column `Updated` is PENDING_COMMIT_TIMESTAMP().
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
expect@spanner:
  same

