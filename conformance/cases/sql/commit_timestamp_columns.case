ddl:
  ALTER TABLE T ALTER COLUMN Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP())
expect:
  ok
expect@spanner:
  same
get_ddl
expect:
  statements:
