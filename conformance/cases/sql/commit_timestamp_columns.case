  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
expect@spanner:
  same
dml:
  UPDATE T SET V = 'b' WHERE Id = 1
expect:
  count: 1
expect@spanner:
  same
query:
