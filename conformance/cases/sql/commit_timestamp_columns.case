expect:
  count: 1
expect@spanner:
  same
query:
  SELECT Id, Created, Updated, V FROM T
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, V STRING
  ["1","2020-01-01T00:00:00Z","<now>","b"]
expect@spanner:
  same

case dml_update_explicit_value
dml:
  UPDATE T SET V = 'b', Updated = TIMESTAMP '2021-01-01T00:00:00Z' WHERE Id = 1
expect:
  count: 1
expect@spanner:
  same
query:
  SELECT Id, Created, Updated, V FROM T
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, V STRING
  ["1","2020-01-01T00:00:00Z","2021-01-01T00:00:00Z","b"]
expect@spanner:
  same

case dml_update_on_update_then_select
begin txn=t
dml txn=t:
  UPDATE T SET V = 'b' WHERE Id = 1
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT V FROM T WHERE Id = 1
expect:
  columns: V STRING
  ["b"]
expect@spanner:
  same
query txn=t:
  SELECT Updated FROM T WHERE Id = 1
expect:
  error: INVALID_ARGUMENT
  message: Column Updated cannot be accessed because it, or its associated index, has a pending CommitTimestamp
expect@spanner:
  error: INVALID_ARGUMENT
  message: Column Updated cannot be accessed because 1. it, or its associated index, has a pending CommitTimestamp, or 2. change stream tracking Column Updated can't access the pending commit timestamp to record the old value.

case dml_update_on_update_then_return
dml:
  UPDATE T SET V = 'b' WHERE Id = 1 THEN RETURN Id, V
expect:
  count: 1
  columns: Id INT64, V STRING
  ["1","b"]
expect@spanner:
  same

case dml_update_no_rows
dml:
  UPDATE T SET V = 'b' WHERE Id = 99
expect:
  count: 0
expect@spanner:
  same
query:
  SELECT Id, Created, Updated, V FROM T
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, V STRING
  ["1","2020-01-01T00:00:00Z","2020-01-01T00:00:00Z","a"]
expect@spanner:
  same

case add_column_on_update
ddl:
  ALTER TABLE T ADD COLUMN Touched TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)
expect:
  ok
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n  Touched TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n) PRIMARY KEY(Id)"
expect@spanner:
  same
query:
  SELECT Id, Touched FROM T
expect:
  columns: Id INT64, Touched TIMESTAMP
  ["1","9999-12-31T23:59:59.999999Z"]
expect@spanner:
  columns: Id INT64, Touched TIMESTAMP
  ["1","<now>"]
update T cols=Id,V:
  [1, "b"]
query:
  SELECT Id, Touched IS NOT NULL, Touched = Updated FROM T
expect:
  columns: Id INT64, BOOL, BOOL
  ["1",true,true]
expect@spanner:
  same

case alter_column_set_on_update
ddl:
  ALTER TABLE T ALTER COLUMN Created SET ON UPDATE (PENDING_COMMIT_TIMESTAMP())
expect:
  ok
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
expect@spanner:
  same
dml:
  UPDATE T SET V = 'b' WHERE Id = 1
expect:
  count: 1
expect@spanner:
  same
query:
  SELECT Created > '2021-01-01T00:00:00Z', Created = Updated FROM T
expect:
  columns: BOOL, BOOL
  [true,true]
expect@spanner:
  same

case alter_column_set_on_update_without_default
ddl:
  ALTER TABLE T ALTER COLUMN V SET ON UPDATE (PENDING_COMMIT_TIMESTAMP())
expect:
  error: INVALID_ARGUMENT
  message: Column `V` with an ON UPDATE expression must have an identical DEFAULT value expression.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing ON UPDATE expression \'PENDING_COMMIT_TIMESTAMP()\' from column \'V\' in table \'T\': Expected type STRING; found TIMESTAMP [at 1:1]

