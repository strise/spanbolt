  ["1","2020-01-01T00:00:00Z","2020-01-01T00:00:00Z","b"]
expect@spanner:
  same

case alter_column_drop_on_update_none
ddl:
  ALTER TABLE T ALTER COLUMN V DROP ON UPDATE
expect:
  ok
