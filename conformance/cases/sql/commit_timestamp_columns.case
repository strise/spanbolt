# DEFAULT (PENDING_COMMIT_TIMESTAMP()) and ON UPDATE (PENDING_COMMIT_TIMESTAMP()) column clauses
# (emulator issues #316, #338; v1.5.48, v1.5.53/54).
tags: sql ddl dml
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true),
    Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true),
    V STRING(MAX),
  ) PRIMARY KEY (Id)
insert T cols=Id,Created,Updated,V:
  [1, "2020-01-01T00:00:00Z", "2020-01-01T00:00:00Z", "a"]

case get_ddl
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
expect@spanner:
  same

case information_schema_columns
query:
  SELECT COLUMN_NAME, COLUMN_DEFAULT, ON_UPDATE_EXPRESSION, IS_GENERATED
  FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'T' ORDER BY ORDINAL_POSITION
expect:
  columns: COLUMN_NAME STRING, COLUMN_DEFAULT STRING, ON_UPDATE_EXPRESSION STRING, IS_GENERATED STRING
  ["Id",null,null,"NEVER"]
  ["Created","PENDING_COMMIT_TIMESTAMP()",null,"NEVER"]
  ["Updated","PENDING_COMMIT_TIMESTAMP()","PENDING_COMMIT_TIMESTAMP()","NEVER"]
  ["V",null,null,"NEVER"]
expect@spanner:
  same

case mutation_insert_default
insert T cols=Id,V:
  [2, "b"]
query:
  SELECT Id, Created, Updated, Created = Updated FROM T WHERE Id = 2
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, BOOL
  ["2","<now>","<now>",true]
expect@spanner:
  same

case mutation_insert_or_update_default
insert_or_update T cols=Id,V:
  [2, "b"]
query:
  SELECT Id, Created, Updated, Created = Updated FROM T WHERE Id = 2
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, BOOL
  ["2","<now>","<now>",true]
expect@spanner:
  same

case mutation_replace_default
replace T cols=Id,V:
  [1, "b"]
query:
  SELECT Id, Created, Updated, Created = Updated FROM T WHERE Id = 1
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, BOOL
  ["1","<now>","<now>",true]
expect@spanner:
  same

case dml_insert_default
dml:
  INSERT INTO T (Id, V) VALUES (2, 'b')
expect:
  count: 1
expect@spanner:
  same
query:
  SELECT Id, Created, Updated, Created = Updated FROM T WHERE Id = 2
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, BOOL
  ["2","<now>","<now>",true]
expect@spanner:
  same

case dml_insert_default_keyword
dml:
  INSERT INTO T (Id, Created, V) VALUES (2, DEFAULT, 'b')
expect:
  count: 1
expect@spanner:
  same
query:
  SELECT Id, Created, Updated FROM T WHERE Id = 2
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP
  ["2","<now>","<now>"]
expect@spanner:
  same

case dml_insert_default_then_return
dml:
  INSERT INTO T (Id, V) VALUES (2, 'b') THEN RETURN Id
expect:
  count: 1
  columns: Id INT64
  ["2"]
expect@spanner:
  same

case dml_insert_default_then_return_pending
dml:
  INSERT INTO T (Id, V) VALUES (2, 'b') THEN RETURN Created
expect:
  error: INVALID_ARGUMENT
  message: The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.
expect@spanner:
  same

case dml_insert_default_then_select
begin txn=t
dml txn=t:
  INSERT INTO T (Id, V) VALUES (2, 'b')
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Created FROM T WHERE Id = 2
expect:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because it, or its associated index, has a pending CommitTimestamp
expect@spanner:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because 1. it, or its associated index, has a pending CommitTimestamp, or 2. change stream tracking Column Created can't access the pending commit timestamp to record the old value.

case mutation_update_on_update
update T cols=Id,V:
  [1, "b"]
query:
  SELECT Id, Created, Updated, V FROM T
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, V STRING
  ["1","2020-01-01T00:00:00Z","<now>","b"]
expect@spanner:
  same

case mutation_insert_or_update_on_update
insert_or_update T cols=Id,V:
  [1, "b"]
query:
  SELECT Id, Created, Updated, V FROM T
expect:
  columns: Id INT64, Created TIMESTAMP, Updated TIMESTAMP, V STRING
  ["1","2020-01-01T00:00:00Z","<now>","b"]
expect@spanner:
  same

