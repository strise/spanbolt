case on_update_without_default
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing Spanner DDL statement: CREATE TABLE X (K INT64, U TIMESTAMP ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K) : Syntax error on line 1, column 38: Encountered 'ON' while parsing: column_def
expect@spanner:
  same

case on_update_without_allow_commit_timestamp
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP())) PRIMARY KEY (K)
expect:
  error: FAILED_PRECONDITION
  message: Cannot use default value expression PENDING_COMMIT_TIMESTAMP() on column `U` without the allow_commit_timestamp column option.
expect@spanner:
  same

case on_update_other_expression
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (CURRENT_TIMESTAMP()) ON UPDATE (CURRENT_TIMESTAMP())) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: PENDING_COMMIT_TIMESTAMP() is the only supported ON UPDATE expression.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing ON UPDATE expression 'CURRENT_TIMESTAMP()' from column 'U' in table 'X': PENDING_COMMIT_TIMESTAMP() and PENDING_COMMIT_TIMESTAMP_INT64() are the only supported ON UPDATE expressions.

case on_update_literal
ddl:
  CREATE TABLE X (K INT64, U STRING(MAX) DEFAULT ('a') ON UPDATE ('a')) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: PENDING_COMMIT_TIMESTAMP() is the only supported ON UPDATE expression.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing ON UPDATE expression ''a'' from column 'U' in table 'X': PENDING_COMMIT_TIMESTAMP() and PENDING_COMMIT_TIMESTAMP_INT64() are the only supported ON UPDATE expressions.

case on_update_differs_from_default
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (TIMESTAMP '2020-01-01T00:00:00Z') ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: The ON UPDATE expression of column `U` does not match the DEFAULT value expression.
expect@spanner:
  error: FAILED_PRECONDITION
  message: The only default value expression permitted for commit timestamp column `U` is PENDING_COMMIT_TIMESTAMP().

case on_update_lowercase
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP default (pending_commit_timestamp()) on update (pending_commit_timestamp()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  ok
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
  "CREATE TABLE X (\n  K INT64,\n  U TIMESTAMP DEFAULT (pending_commit_timestamp()) ON UPDATE (pending_commit_timestamp()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n) PRIMARY KEY(K)"
expect@spanner:
  same
query:
  SELECT COLUMN_DEFAULT, ON_UPDATE_EXPRESSION FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'X' AND COLUMN_NAME = 'U'
expect:
  columns: COLUMN_DEFAULT STRING, ON_UPDATE_EXPRESSION STRING
  ["pending_commit_timestamp()","pending_commit_timestamp()"]
expect@spanner:
  same

case on_update_before_default
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP ON UPDATE (PENDING_COMMIT_TIMESTAMP()) DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  ok
expect@spanner:
  same
get_ddl
expect:
  statements:
  "CREATE TABLE T (\n  Id INT64 NOT NULL,\n  Created TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  Updated TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n  V STRING(MAX),\n) PRIMARY KEY(Id)"
  "CREATE TABLE X (\n  K INT64,\n  U TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (\n    allow_commit_timestamp = true\n  ),\n) PRIMARY KEY(K)"
expect@spanner:
  same

case on_update_after_options
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true) ON UPDATE (PENDING_COMMIT_TIMESTAMP())) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing Spanner DDL statement: CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true) ON UPDATE (PENDING_COMMIT_TIMESTAMP())) PRIMARY KEY (K) : Syntax error on line 1, column 115: Expecting ')' but found 'ON'
expect@spanner:
  same

case on_update_key_column
ddl:
  CREATE TABLE X (K TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) ON UPDATE (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
