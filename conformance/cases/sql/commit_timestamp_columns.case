case default_pending_in_expression
ddl:
  CREATE TABLE X (K INT64, U TIMESTAMP DEFAULT (TIMESTAMP_ADD(PENDING_COMMIT_TIMESTAMP(), INTERVAL 1 SECOND)) OPTIONS (allow_commit_timestamp = true)) PRIMARY KEY (K)
expect:
  error: INVALID_ARGUMENT
  message: Error parsing the default value of column `X`.`U`: The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error parsing default value expression 'TIMESTAMP_ADD(PENDING_COMMIT_TIMESTAMP(), INTERVAL 1 SECOND)' from column 'U' in table 'X': The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.

case default_pending_key_column
ddl:
  CREATE TABLE X (K TIMESTAMP NOT NULL DEFAULT (PENDING_COMMIT_TIMESTAMP()) OPTIONS (allow_commit_timestamp = true), V INT64) PRIMARY KEY (K)
expect:
  ok
expect@spanner:
  same
insert X cols=V:
  [1]
expect:
  error: FAILED_PRECONDITION
  message: Cannot write timestamps in the future, found: 9999-12-31T23:59:59.999999+00:00
expect@spanner:
  ok
query:
  SELECT K IS NOT NULL, V FROM X
expect:
  columns: BOOL, V INT64
expect@spanner:
  columns: BOOL, V INT64
  [true,"1"]

