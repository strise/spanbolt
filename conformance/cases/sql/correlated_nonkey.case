# Correlated subqueries whose correlation columns are neither key nor index columns (spanbolt
# turns these into hash lookups). Covers NULL correlation values, NULLs in IN lists, FLOAT64 -0.0/0.0
# and NaN, and two correlated equalities at once.
tags: sql subquery
schema:
  CREATE TABLE Lhs (
    Id INT64 NOT NULL,
    K STRING(16),
    F FLOAT64,
    A INT64,
    B STRING(16),
  ) PRIMARY KEY (Id);
  CREATE TABLE Rhs (
    Id INT64 NOT NULL,
    K STRING(16),
    F FLOAT64,
    A INT64,
    B STRING(16),
    V INT64,
  ) PRIMARY KEY (Id)
insert Lhs cols=Id,K,F,A,B:
  [1, "a", 0.0, 1, "x"]
  [2, "b", -0.0, 2, "y"]
  [3, null, "NaN", 1, null]
  [4, "c", 1.5, null, "x"]
  [5, "a", null, 2, "y"]
  [6, "d", "Infinity", 3, "z"]
insert Rhs cols=Id,K,F,A,B,V:
  [10, "a", -0.0, 1, "x", 100]
  [11, "a", "NaN", 2, "y", 200]
  [12, "b", 0.0, 2, "y", 300]
  [13, null, 1.5, null, "x", 400]
  [14, "c", null, 1, null, 500]
  [15, "a", 0.0, 1, "y", null]

case exists_string
query:
  SELECT o.Id FROM Lhs o
  WHERE EXISTS (SELECT 1 FROM Rhs i WHERE i.K = o.K)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["4"]
  ["5"]

case not_exists_string
query:
  SELECT o.Id FROM Lhs o
  WHERE NOT EXISTS (SELECT 1 FROM Rhs i WHERE i.K = o.K)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["3"]
  ["6"]

case exists_int_null_outer
query:
  SELECT o.Id FROM Lhs o
  WHERE EXISTS (SELECT 1 FROM Rhs i WHERE i.A = o.A)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["5"]

case not_exists_int_null_outer
query:
  SELECT o.Id FROM Lhs o
  WHERE NOT EXISTS (SELECT 1 FROM Rhs i WHERE i.A = o.A)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["4"]
  ["6"]

case exists_float_zero_nan
query:
  SELECT o.Id FROM Lhs o
  WHERE EXISTS (SELECT 1 FROM Rhs i WHERE i.F = o.F)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["4"]

case not_exists_float_zero_nan
query:
  SELECT o.Id FROM Lhs o
  WHERE NOT EXISTS (SELECT 1 FROM Rhs i WHERE i.F = o.F)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["3"]
  ["5"]
  ["6"]

case count_float_zero_nan
query:
  SELECT o.Id, (SELECT COUNT(*) FROM Rhs i WHERE i.F = o.F) AS n FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, n INT64
  ["1","3"]
  ["2","3"]
  ["3","0"]
  ["4","1"]
  ["5","0"]
  ["6","0"]

case in_correlated_string
query:
  SELECT o.Id FROM Lhs o
  WHERE o.B IN (SELECT i.B FROM Rhs i WHERE i.K = o.K)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["5"]

case not_in_correlated_string_nulls
query:
  SELECT o.Id FROM Lhs o
  WHERE o.B NOT IN (SELECT i.B FROM Rhs i WHERE i.A = o.A)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["4"]
  ["6"]

case in_select_list_nulls
query:
  SELECT o.Id, o.B IN (SELECT i.B FROM Rhs i WHERE i.A = o.A) AS hit FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, hit BOOL
  ["1",true]
  ["2",true]
  ["3",null]
  ["4",false]
  ["5",true]
  ["6",false]

case not_in_select_list_nulls
query:
  SELECT o.Id, o.B NOT IN (SELECT i.B FROM Rhs i WHERE i.A = o.A) AS miss FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, miss BOOL
  ["1",false]
  ["2",false]
  ["3",null]
  ["4",true]
  ["5",false]
  ["6",true]

case in_float_correlated
query:
  SELECT o.Id, o.F IN (SELECT i.F FROM Rhs i WHERE i.A = o.A) AS hit FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, hit BOOL
  ["1",true]
  ["2",true]
  ["3",null]
  ["4",false]
  ["5",null]
  ["6",false]

case scalar_sum_null_correlation
query:
  SELECT o.Id, (SELECT SUM(i.V) FROM Rhs i WHERE i.K = o.K) AS total FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, total INT64
  ["1","300"]
  ["2","300"]
  ["3",null]
  ["4","500"]
  ["5","300"]
  ["6",null]

case scalar_count_column
query:
  SELECT o.Id, (SELECT COUNT(i.V) FROM Rhs i WHERE i.K = o.K) AS n FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, n INT64
  ["1","2"]
  ["2","1"]
  ["3","0"]
  ["4","1"]
  ["5","2"]
  ["6","0"]

case scalar_max_float
query:
  SELECT o.Id, (SELECT MAX(i.V) FROM Rhs i WHERE i.F = o.F) AS top FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, top INT64
  ["1","300"]
  ["2","300"]
  ["3",null]
  ["4","400"]
  ["5",null]
  ["6",null]

case array_string
query:
  SELECT o.Id, ARRAY(SELECT i.Id FROM Rhs i WHERE i.K = o.K ORDER BY i.Id) AS ids FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, ids ARRAY<INT64>
  ["1",["10","11","15"]]
  ["2",["12"]]
  ["3",[]]
  ["4",["14"]]
  ["5",["10","11","15"]]
  ["6",[]]

case array_float
query:
  SELECT o.Id, ARRAY(SELECT i.Id FROM Rhs i WHERE i.F = o.F ORDER BY i.Id) AS ids FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, ids ARRAY<INT64>
  ["1",["10","12","15"]]
  ["2",["10","12","15"]]
  ["3",[]]
  ["4",["13"]]
  ["5",[]]
  ["6",[]]

case exists_two_equalities
query:
  SELECT o.Id FROM Lhs o
  WHERE EXISTS (SELECT 1 FROM Rhs i WHERE i.K = o.K AND i.A = o.A)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["5"]

case not_exists_two_equalities
query:
  SELECT o.Id FROM Lhs o
  WHERE NOT EXISTS (SELECT 1 FROM Rhs i WHERE i.A = o.A AND i.B = o.B)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["3"]
  ["4"]
  ["6"]

case count_two_equalities_float
query:
  SELECT o.Id, (SELECT COUNT(*) FROM Rhs i WHERE i.F = o.F AND i.A = o.A) AS n FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, n INT64
  ["1","2"]
  ["2","1"]
  ["3","0"]
  ["4","0"]
  ["5","0"]
  ["6","0"]

case array_two_equalities
query:
  SELECT o.Id, ARRAY(SELECT i.V FROM Rhs i WHERE i.A = o.A AND i.B = o.B ORDER BY i.Id) AS vs
  FROM Lhs o
  ORDER BY o.Id
expect:
  columns: Id INT64, vs ARRAY<INT64>
  ["1",["100"]]
  ["2",["200","300"]]
  ["3",[]]
  ["4",[]]
  ["5",["200","300"]]
  ["6",[]]

case exists_with_extra_filter
query:
  SELECT o.Id FROM Lhs o
  WHERE EXISTS (SELECT 1 FROM Rhs i WHERE i.A = o.A AND i.V > 250)
  ORDER BY o.Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["5"]
