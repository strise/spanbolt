# DEBUG_TOKENLIST, which only Cloud Spanner has. It prints production's token lists: positions
# holding a set of tokens ([...]), boundary attributes, gaps, value-carrying TOKEN, TOKENIZE_BOOL,
# TOKENIZE_NUMBER and TOKENIZE_JSON lists, and character n-grams. spanbolt's token lists follow the
# emulator's format, so it answers UNIMPLEMENTED; these recordings are the target for a real port.
tags: sql search
schema:
  CREATE TABLE D (
    Id INT64 NOT NULL,
    S STRING(MAX),
    N INT64,
    B BOOL,
    J JSON,
    A ARRAY<STRING(MAX)>,
    Ft TOKENLIST AS (TOKENIZE_FULLTEXT(S)) HIDDEN,
    Ngr TOKENLIST AS (TOKENIZE_NGRAMS(S)) HIDDEN,
    Ngr23 TOKENLIST AS (TOKENIZE_NGRAMS(S, ngram_size_min => 2, ngram_size_max => 3)) HIDDEN,
    Sub TOKENLIST AS (TOKENIZE_SUBSTRING(S)) HIDDEN,
    Sub23 TOKENLIST AS (TOKENIZE_SUBSTRING(S, ngram_size_min => 2, ngram_size_max => 3)) HIDDEN,
    Num TOKENLIST AS (TOKENIZE_NUMBER(N)) HIDDEN,
    Bl TOKENLIST AS (TOKENIZE_BOOL(B)) HIDDEN,
    Tok TOKENLIST AS (TOKEN(S)) HIDDEN,
    Js TOKENLIST AS (TOKENIZE_JSON(J)) HIDDEN,
    FullArr TOKENLIST AS (TOKENIZE_FULLTEXT(A)) HIDDEN,
    SubArr TOKENLIST AS (TOKENIZE_SUBSTRING(A)) HIDDEN,
    Cat TOKENLIST AS (TOKENLIST_CONCAT([TOKENIZE_FULLTEXT(S), TOKENIZE_FULLTEXT(A)])) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX DIdx ON D(Ft, Ngr, Ngr23, Sub, Sub23, Num, Bl, Tok, Js, FullArr, SubArr, Cat)
insert D cols=Id,S,N,B,J,A:
  [1, "alpha", 0, true, "{\"a\": 1}", ["alpha"]]
  [2, "alpha beta gamma", 42, false, "{\"a\": {\"b\": \"x y\"}, \"c\": [1, 2]}", ["alpha beta", "gamma"]]
  [3, "Hello, World! foo-bar 123", -7, null, "[1, \"two\", null]", ["a", "b c"]]
  [4, "ab", 1234567890, null, "null", []]
  [5, "abcde", null, null, null, null]
  [6, "abc  def", null, null, null, null]
  [7, "", null, null, null, null]
  [8, null, null, null, null, null]
  [9, "Ærø straße", null, null, null, null]

case fulltext
query:
  SELECT Id, DEBUG_TOKENLIST(Ft) AS t FROM D ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["1","alpha(boundary, end_boundary)"]
  ["2","alpha(boundary), beta, gamma(end_boundary)"]
  ["3","hello(boundary), world, foo, bar, 123(end_boundary)"]
  ["4","ab(boundary, end_boundary)"]
  ["5","abcde(boundary, end_boundary)"]
  ["6","abc(boundary), def(end_boundary)"]
  ["7",""]
  ["8",null]
  ["9","ærø(boundary), straße(end_boundary)"]

