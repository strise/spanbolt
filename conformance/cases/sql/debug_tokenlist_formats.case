# DEBUG_TOKENLIST's output format beyond debug_tokenlist.case (#128): which tokens it quotes and
# escapes, how gaps and positions print for arrays, empty values and TOKENLIST_CONCAT, and what
# TOKEN, TOKENIZE_BOOL, TOKENIZE_NUMBER and TOKENIZE_JSON print for other values and options.
# Only Cloud Spanner has DEBUG_TOKENLIST.
tags: sql search

case quoting_ascii
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NGRAMS('a ,()[]<>"\'\\{}:;=#|`~*%$^?/.+@&_', ngram_size_max => 1)) AS t
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: t STRING
  ["a, \" \", \",\", \"(\", \")\", \"[\", \"]\", <, >, \\\", \\', \\\\, {, }, :, ;, =, #, |, `, ~, *, %, $, ^, ?, /, ., +, @, &, _"]

case quoting_space_chars
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NGRAMS('a\tb\nc\rd\x01e\u00a0f\u3000g\u200bh', ngram_size_max => 1)) AS t
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: t STRING
  ["a, \\t, b, \\n, c, \\r, d, \\x01, e,  , f, 　, g, ​, h"]

case quoting_pairs
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NGRAMS('a(b)c[d]e"f', ngram_size_min => 2, ngram_size_max => 2)) AS t
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: t STRING
  ["\"a(\", \"(b\", \"b)\", \")c\", \"c[\", \"[d\", \"d]\", \"]e\", e\\\", \\\"f"]

case token_specials
query:
  SELECT DEBUG_TOKENLIST(TOKEN('a"b')) AS a, DEBUG_TOKENLIST(TOKEN('(x)')) AS b,
    DEBUG_TOKENLIST(TOKEN('[x]')) AS c, DEBUG_TOKENLIST(TOKEN('a,b')) AS d,
    DEBUG_TOKENLIST(TOKEN('<gap(1)>')) AS e, DEBUG_TOKENLIST(TOKEN('a\\b')) AS f,
    DEBUG_TOKENLIST(TOKEN("it's")) AS g, DEBUG_TOKENLIST(TOKEN('Ab\tc')) AS h,
    DEBUG_TOKENLIST(TOKEN('x(boundary)')) AS i, DEBUG_TOKENLIST(TOKEN('==1')) AS j
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING, e STRING, f STRING, g STRING, h STRING, i STRING, j STRING
  ["a\\\"b","\"(x)\"","\"[x]\"","\"a,b\"","\"<gap(1)>\"","a\\\\b","it\\'s","Ab\\tc","\"x(boundary)\"","==1"]

case token_bytes
query:
  SELECT DEBUG_TOKENLIST(TOKEN(b'\x00\x01ab\xff')) AS a, DEBUG_TOKENLIST(TOKEN(b'')) AS b,
    DEBUG_TOKENLIST(TOKEN(b'abc')) AS c, DEBUG_TOKENLIST(TOKEN(CAST(NULL AS BYTES))) AS d
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING
  ["\\x00\\x01\\x61\\x62?","","abc",null]

case token_string_empty
query:
  SELECT DEBUG_TOKENLIST(TOKEN('')) AS a, DEBUG_TOKENLIST(TOKEN(CAST(NULL AS STRING))) AS b,
    DEBUG_TOKENLIST(TOKEN(' ')) AS c, DEBUG_TOKENLIST(TOKEN('\xc3\xa9\u00e9')) AS d
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING
  ["",null,"\" \"","Ã©é"]

case token_array
query:
  SELECT DEBUG_TOKENLIST(TOKEN(['a', 'b c'])) AS a, DEBUG_TOKENLIST(TOKEN(ARRAY<STRING>[])) AS b,
    DEBUG_TOKENLIST(TOKEN(['b', 'a', 'b'])) AS c, DEBUG_TOKENLIST(TOKEN(['x', NULL])) AS d,
    DEBUG_TOKENLIST(TOKEN([''])) AS e
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING, e STRING
  ["a, \"b c\"","","a, b","x",""]

case token_bytes_array
query:
  SELECT DEBUG_TOKENLIST(TOKEN([b'a', b'\x00'])) AS a
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING
  ["\\x00, a"]

case token_int
query:
  SELECT DEBUG_TOKENLIST(TOKEN(42)) AS a
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:TOKEN\n Argument types: INT64\n Signature: TOKEN(BYTES)\n Argument 1: Unable to coerce type INT64 to expected type BYTES\n Signature: TOKEN(ARRAY<BYTES>)\n Argument 1: Unable to coerce type INT64 to expected type ARRAY<BYTES>\n Signature: TOKEN(STRING)\n Argument 1: Unable to coerce type INT64 to expected type STRING\n Signature: TOKEN(ARRAY<STRING>)\n Argument 1: Unable to coerce type INT64 to expected type ARRAY<STRING> [at 1:24]

case bool_array
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_BOOL([true, false, NULL])) AS a,
    DEBUG_TOKENLIST(TOKENIZE_BOOL(ARRAY<BOOL>[])) AS b, DEBUG_TOKENLIST(TOKENIZE_BOOL([true, true])) AS c,
    DEBUG_TOKENLIST(TOKENIZE_BOOL(CAST(NULL AS BOOL))) AS d
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:TOKENIZE_BOOL\n Argument types: ARRAY<BOOL>\n Signature: TOKENIZE_BOOL(BOOL)\n Argument 1: Unable to coerce type ARRAY<BOOL> to expected type BOOL [at 1:24]

case number_tree_base
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NUMBER(42, tree_base => 10)) AS a
expect:
