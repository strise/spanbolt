  ["==42, [-9223372036854775808, 776627963145224191], [-223372036854775808, 776627963145224191], [-23372036854775808, 76627963145224191], [-3372036854775808, 6627963145224191], [-372036854775808, 627963145224191], [-72036854775808, 27963145224191], [-2036854775808, 7963145224191], [-36854775808, 63145224191], [-36854775808, 963145224191], [-6854775808, 3145224191], [-854775808, 145224191], [-54775808, 45224191], [-4775808, 5224191], [-775808, 224191], [-75808, 24191], [-5808, 4191], [-808, 191], [-8, 91], [42, 42], [42, 51]"]

