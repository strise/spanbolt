  SELECT DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_FULLTEXT(''), TOKENIZE_FULLTEXT(ARRAY<STRING>[])])) AS a,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_FULLTEXT(CAST(NULL AS STRING)), TOKENIZE_FULLTEXT('a')])) AS b,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_FULLTEXT('a'), TOKENIZE_FULLTEXT('b'), TOKENIZE_FULLTEXT('c d')])) AS c,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_FULLTEXT(''), TOKENIZE_FULLTEXT('a')])) AS d,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_FULLTEXT('a')])) AS e
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING, e STRING
  ["","a(boundary, end_boundary)","a(boundary, end_boundary), <gap(25)>, b(boundary, end_boundary), <gap(25)>, cd(boundary, end_boundary)","a(boundary, end_boundary)","a(boundary, end_boundary)"]

case concat_ngrams
query:
  SELECT DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_NGRAMS('abc'), TOKENIZE_NGRAMS('de')])) AS a,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_SUBSTRING('alpha beta'), TOKENIZE_SUBSTRING('gamma')])) AS b
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TOKENLIST_CONCAT can only be used with TOKENLIST values generated by TOKENIZE_FULLTEXT or TOKENIZE_SUBSTRING.

case concat_other
query:
  SELECT DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_NUMBER(1), TOKENIZE_NUMBER(2)])) AS a,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKEN('a'), TOKEN('b')])) AS b,
    DEBUG_TOKENLIST(TOKENLIST_CONCAT([TOKENIZE_BOOL(true), TOKENIZE_BOOL(false)])) AS c
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TOKENLIST_CONCAT can only be used with TOKENLIST values generated by TOKENIZE_FULLTEXT or TOKENIZE_SUBSTRING.

case ngrams_arrays
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NGRAMS(['ab', 'cd'])) AS a, DEBUG_TOKENLIST(TOKENIZE_NGRAMS(['abcdef', 'ghijk'])) AS b,
    DEBUG_TOKENLIST(TOKENIZE_NGRAMS(['', 'ab'])) AS c, DEBUG_TOKENLIST(TOKENIZE_NGRAMS(ARRAY<STRING>[])) AS d
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING
  ["[a, ab, b, c, cd, d]","[a, ab, abc, abcd, b, bc, bcd, c, cd, cde, d, de, def, e, ef, f, g, gh, ghi, h, hi, hij, i, ij, ijk, j, jk, k], bcde, cdef, <gap(25)>, ghij, hijk","[a, ab, b]",""]

case ngrams_repeat
query:
