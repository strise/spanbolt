    DEBUG_TOKENLIST(TOKENIZE_SUBSTRING('a', ngram_size_min => 2, ngram_size_max => 3)) AS b,
    DEBUG_TOKENLIST(TOKENIZE_SUBSTRING('ab a', ngram_size_min => 2, ngram_size_max => 3)) AS c
