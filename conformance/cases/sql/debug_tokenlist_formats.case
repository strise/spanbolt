    DEBUG_TOKENLIST(TOKENIZE_NUMBER([5, NULL], comparison_type => 'equality')) AS b,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(ARRAY<INT64>[], comparison_type => 'equality')) AS c,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(CAST(NULL AS INT64))) AS d
