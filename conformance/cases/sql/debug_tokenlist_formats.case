case number_bucket_count
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 63)) AS a,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 64)) AS b,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 65)) AS c,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 640, granularity => 10)) AS d,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 635, granularity => 10)) AS e,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 630, granularity => 10)) AS f,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(5, min => 0, max => 645, granularity => 10)) AS g
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING, e STRING, f STRING, g STRING
  ["==5, [0, 7], [0, 15], [0, 31], [0, 63], [4, 5], [4, 7], [5, 5]","==5, [0, 7], [0, 15], [0, 31], [0, 63], [4, 5], [4, 7], [5, 5]","==5, [0, 7], [0, 15], [0, 31], [0, 63], [4, 5], [4, 7], [5, 5]","==5, [0, 14], [0, 34], [0, 74], [0, 154], [0, 314], [0, 634], [5, 14]","==5, [0, 14], [0, 34], [0, 74], [0, 154], [0, 314], [0, 634], [5, 14]","==5, [0, 14], [0, 34], [0, 74], [0, 154], [0, 314], [0, 634], [5, 14]","==5, [0, 14], [0, 34], [0, 74], [0, 154], [0, 314], [0, 634], [5, 14]"]

case number_granularity_rounding
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NUMBER(45, min => 0, max => 1000, granularity => 10)) AS a,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(44, min => 0, max => 1000, granularity => 10)) AS b,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(7, min => 0, max => 100, granularity => 3)) AS c,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(8, min => 1, max => 100, granularity => 3)) AS d,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(-7, min => -100, max => 100, granularity => 5)) AS e,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(1000, min => 0, max => 1000, granularity => 10)) AS f
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: a STRING, b STRING, c STRING, d STRING, e STRING, f STRING
  ["==45, [0, 74], [0, 154], [0, 314], [0, 634], [35, 54], [35, 74], [45, 54]","==44, [0, 74], [0, 154], [0, 314], [0, 634], [35, 44], [35, 54], [35, 74]","==7, [0, 10], [0, 22], [0, 46], [0, 94], [5, 7], [5, 10]","==8, [1, 11], [1, 23], [1, 47], [1, 95], [6, 8], [6, 11]","==-7, [-100, 57], [-22, -3], [-22, 17], [-22, 57], [-12, -3], [-7, -3]","==1000, [635, 1274], [955, 1034], [955, 1114], [955, 1274], [995, 1004], [995, 1014], [995, 1034]"]

case number_base_options
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_NUMBER(42, min => 0, max => 1000, tree_base => 10)) AS a,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(42, min => 0, max => 1000, tree_base => 3, granularity => 2)) AS b,
    DEBUG_TOKENLIST(TOKENIZE_NUMBER(42, min => 0, max => 100, comparison_type => 'equality')) AS c
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: min, max, granularity, tree_base, precision, and algorithm arguments are not allowed in equality comparison mode (because they would not affect the generated tokenlist).

