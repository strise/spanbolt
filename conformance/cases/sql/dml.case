tags: sql dml
schema:
  CREATE TABLE Teams (
    TeamId STRING(36) NOT NULL,
    Name STRING(MAX) NOT NULL,
    CustomerId STRING(36),
    Created TIMESTAMP NOT NULL,
  ) PRIMARY KEY (TeamId);
  CREATE TABLE Entities (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    Kind STRING(32) NOT NULL,
    Status STRING(32),
    Name STRING(MAX),
    Aliases ARRAY<STRING(MAX)>,
    Data JSON,
    Score FLOAT64,
    Version INT64 NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    UpdatedAt TIMESTAMP,
  ) PRIMARY KEY (TeamId, EntityId),
    INTERLEAVE IN PARENT Teams ON DELETE CASCADE;
  CREATE INDEX EntitiesByKind ON Entities(TeamId, Kind);
  CREATE NULL_FILTERED INDEX EntitiesByStatus ON Entities(Status) STORING (Name);
  CREATE TABLE Reviews (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    ReviewId INT64 NOT NULL,
    CreatedBy STRING(36) NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    Outcome STRING(16),
  ) PRIMARY KEY (TeamId, EntityId, ReviewId),
    INTERLEAVE IN PARENT Entities ON DELETE CASCADE;
  CREATE TABLE Users (
    UserId STRING(36) NOT NULL,
    Email STRING(MAX) NOT NULL,
    Name STRING(MAX),
  ) PRIMARY KEY (UserId);
  CREATE TABLE Signals (
    EntityId STRING(36) NOT NULL,
    SignalType STRING(32) NOT NULL,
    ValidFrom TIMESTAMP NOT NULL,
    Confidence FLOAT64 NOT NULL,
  ) PRIMARY KEY (EntityId, SignalType, ValidFrom)
insert Teams cols=TeamId,Name,CustomerId,Created:
  ["t1", "Alpha", "c1", "2024-01-01T00:00:00Z"]
  ["t2", "Beta", "c1", "2024-02-01T00:00:00Z"]
  ["t3", "Gamma", null, "2024-03-01T00:00:00Z"]
insert Entities cols=TeamId,EntityId,Kind,Status,Name,Aliases,Data,Score,Version,CreatedAt,UpdatedAt:
  ["t1", "e1", "company", "active", "Acme AS", ["ACME", "Acme Group"], "{\"country\":\"NO\",\"size\":120,\"tags\":[\"a\",\"b\"],\"owner\":{\"id\":\"p1\",\"share\":0.5}}", 0.75, 3, "2024-01-05T10:00:00Z", "2024-06-01T12:30:00.123456Z"]
  ["t1", "e2", "person", "active", "Kari Nordmann", [], "{\"country\":\"NO\",\"birth\":{\"year\":1980}}", 0.5, 1, "2024-01-06T00:00:00Z", null]
  ["t1", "e3", "company", "archived", "Beta Holding", ["BH"], "{\"country\":\"SE\",\"size\":5}", null, 2, "2024-02-10T08:00:00Z", "2024-03-01T00:00:00Z"]
  ["t1", "e4", "company", null, "Delta ASA", null, null, 1.25, 1, "2024-03-15T00:00:00Z", null]
  ["t2", "e1", "company", "active", "Acme AS", ["ACME"], "{\"country\":\"NO\",\"size\":120}", 0.9, 5, "2024-02-02T00:00:00Z", null]
  ["t2", "e5", "person", "pending", "Ola Nordmann", ["Ola"], "{\"country\":\"DK\"}", 0.1, 1, "2024-04-01T00:00:00Z", null]
insert Reviews cols=TeamId,EntityId,ReviewId,CreatedBy,CreatedAt,Outcome:
  ["t1", "e1", 1, "u1", "2024-01-10T00:00:00Z", "approved"]
  ["t1", "e1", 2, "u2", "2024-02-10T00:00:00Z", null]
  ["t1", "e3", 1, "u1", "2024-02-11T00:00:00Z", "rejected"]
  ["t2", "e5", 1, "u3", "2024-04-02T00:00:00Z", null]
insert Users cols=UserId,Email,Name:
  ["u1", "ann@example.com", "Ann"]
  ["u2", "bob@example.com", null]
  ["u4", "dan@example.com", "Dan"]
insert Signals cols=EntityId,SignalType,ValidFrom,Confidence:
  ["e1", "news", "2024-05-01T00:00:00Z", 0.8]
  ["e1", "news", "2024-05-20T00:00:00Z", 0.4]
  ["e1", "sanction", "2024-04-01T00:00:00Z", 1.0]
  ["e3", "news", "2024-05-02T00:00:00Z", 0.6]
  ["e5", "pep", "2024-01-01T00:00:00Z", 0.9]

case insert_values
dml:
  INSERT INTO Users (UserId, Email, Name) VALUES (@id, @email, @name)
params:
  @id STRING = "u9"
  @email STRING = "x@example.com"
  @name STRING = null
expect:
  count: 1

case insert_duplicate
dml:
  INSERT INTO Users (UserId, Email) VALUES ('u1', 'dup@example.com')
expect:
  error: ALREADY_EXISTS
  message: Failed to insert row with primary key ({pk#UserId:"u1"}) due to previously existing row

case insert_multi_row_then_return
dml:
  INSERT INTO Users (UserId, Email) VALUES ('u7', 'a@x'), ('u8', 'b@x')
  THEN RETURN UserId, Email
expect:
  count: 2
  columns: UserId STRING, Email STRING
  ["u7","a@x"]
  ["u8","b@x"]

case insert_or_update
dml:
  INSERT OR UPDATE INTO Users (UserId, Email, Name) VALUES ('u1', 'new@example.com', 'Ann B'), ('u9', 'n@x', NULL)
expect:
  count: 2

case insert_or_update_then_return
dml:
  INSERT OR UPDATE INTO Users (UserId, Email) VALUES ('u2', 'bob2@example.com')
  THEN RETURN UserId, Email, Name
expect:
  count: 1
  columns: UserId STRING, Email STRING, Name STRING
  ["u2","bob2@example.com",null]

case insert_or_ignore
dml:
  INSERT OR IGNORE INTO Users (UserId, Email) VALUES ('u1', 'ignored@x'), ('u5', 'e@x')
  THEN RETURN UserId
expect:
  count: 1
  columns: UserId STRING
  ["u5"]

case upsert_keeps_old_values
dml:
  INSERT OR UPDATE INTO Users (UserId, Email, Name)
  VALUES (@k, @email, COALESCE(@name, (SELECT Name FROM Users WHERE UserId = @k)))
  THEN RETURN TO_JSON(Users) AS json
params:
  @k STRING = "u1"
  @email STRING = "ann2@example.com"
  @name STRING = null
expect:
  count: 1
  columns: json JSON
  ["{\"Email\":\"ann2@example.com\",\"Name\":\"Ann\",\"UserId\":\"u1\"}"]

case insert_select_guarded
dml:
  INSERT INTO Reviews (TeamId, EntityId, ReviewId, CreatedBy, CreatedAt)
  SELECT e.TeamId, e.EntityId, 99, @reviewer, @now FROM Entities e
  WHERE e.TeamId = @team AND e.EntityId = @id AND e.Status IS NOT NULL
params:
  @reviewer STRING = "u1"
  @now TIMESTAMP = "2024-07-01T00:00:00Z"
  @team STRING = "t1"
  @id STRING = "e2"
expect:
  count: 1

case insert_select_from_unnest
dml:
  INSERT INTO Users (UserId, Email)
  SELECT k, CONCAT(k, '@example.com') FROM UNNEST(@keys) AS k
  WHERE NOT EXISTS (SELECT 1 FROM Users u WHERE u.UserId = k)
params:
  @keys ARRAY<STRING> = ["u1", "u6"]
expect:
  count: 1

case insert_missing_parent
dml:
  INSERT INTO Entities (TeamId, EntityId, Kind, Version, CreatedAt) VALUES ('nope', 'x', 'company', 1, CURRENT_TIMESTAMP())
expect:
  error: NOT_FOUND
  message: Insert failed because key was not found in parent table: Parent Table: Teams Child Table: Entities Key: {String("nope")}

case insert_not_null_violation
dml:
  INSERT INTO Users (UserId) VALUES ('u9')
expect:
  error: FAILED_PRECONDITION
  message: A new row in table Users does not specify a non-null value for NOT NULL column: Email

case insert_commit_timestamp_function
dml:
  INSERT INTO Teams (TeamId, Name, Created) VALUES ('t9', 'n', PENDING_COMMIT_TIMESTAMP())
expect:
  error: FAILED_PRECONDITION
  message: Cannot write commit timestamp because the allow_commit_timestamp column option is not set to true for column Teams.Created, or for all corresponding shared key columns in this table's interleaved table hierarchy.

case update_compare_and_set
dml:
  UPDATE Entities SET Status = @s, Version = Version + 1
  WHERE TeamId = @team AND EntityId = @id AND Status IN UNNEST(@from)
  THEN RETURN EntityId, Status, Version
params:
  @s STRING = "archived"
  @team STRING = "t1"
  @id STRING = "e1"
  @from ARRAY<STRING> = ["active", "pending"]
expect:
  count: 1
  columns: EntityId STRING, Status STRING, Version INT64
  ["e1","archived","4"]

case update_no_match
dml:
  UPDATE Entities SET Status = 'x' WHERE TeamId = 'none'
expect:
  count: 0

case update_stale_reclaim
dml:
  UPDATE Entities SET UpdatedAt = @now
  WHERE TeamId = 't1' AND (UpdatedAt IS NULL OR UpdatedAt < TIMESTAMP_SUB(@now, INTERVAL @stale SECOND))
  THEN RETURN EntityId
params:
  @now TIMESTAMP = "2024-06-01T12:31:00Z"
  @stale INT64 = 120
expect:
  count: 3
  columns: EntityId STRING
  ["e2"]
  ["e3"]
  ["e4"]

case update_where_in_subquery_limit
dml:
  UPDATE Entities SET Status = 'swept' WHERE (TeamId, EntityId) IN (SELECT AS STRUCT TeamId, EntityId FROM Entities WHERE Status IS NULL LIMIT 10)
expect:
  count: 1

case update_key_column
dml:
  UPDATE Users SET UserId = 'zz' WHERE UserId = 'u1'
expect:
  error: INVALID_ARGUMENT
  message: Cannot modify a primary key column with UPDATE

case update_without_where
dml:
  UPDATE Users SET Name = 'x'
expect:
  error: INVALID_ARGUMENT
  message: UPDATE must have a WHERE clause [at 1:1]

case delete_in_unnest
dml:
  DELETE FROM Signals WHERE EntityId IN UNNEST(@ids)
  THEN RETURN EntityId, SignalType
params:
  @ids ARRAY<STRING> = ["e1"]
expect:
  count: 3
  columns: EntityId STRING, SignalType STRING
  ["e1","news"]
  ["e1","news"]
  ["e1","sanction"]

case delete_cascade_count
dml:
  DELETE FROM Teams WHERE TeamId = 't1'
expect:
  count: 1

case delete_where_true
dml:
  DELETE FROM Signals WHERE TRUE
expect:
  count: 5

case dml_in_single_use_query
query:
  UPDATE Users SET Name = 'x' WHERE TRUE
expect:
  error: INVALID_ARGUMENT
  message: DML statements may not be performed in single-use transactions, to avoid replay.

case select_as_dml
dml:
  SELECT 1
expect:
  columns: INT64
  ["1"]

