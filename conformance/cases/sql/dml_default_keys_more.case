tags: sql dml
# More INSERTs whose key comes from a DEFAULT, an identity or a generated column (see
# dml_default_keys.case); keys that can't be computed are in mutations/generated_key_inputs.case.
schema:
  CREATE TABLE U (
    Id STRING(36) NOT NULL DEFAULT (GENERATE_UUID()),
    Source STRING(MAX) NOT NULL,
  ) PRIMARY KEY (Id);
  CREATE TABLE L (
    Src STRING(MAX) NOT NULL,
    Note STRING(MAX) DEFAULT ('fresh'),
    K STRING(MAX) NOT NULL AS (CONCAT(Src, '-Note')) STORED,
  ) PRIMARY KEY (K);
  CREATE TABLE I (
    Id INT64 NOT NULL GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    Name STRING(MAX),
  ) PRIMARY KEY (Id)

case dml_insert_or_update_key_literal_names_column
dml:
  INSERT INTO L (Src, Note) VALUES ('a', 'kept')
expect:
  count: 1
dml:
  INSERT OR UPDATE INTO L (Src) VALUES ('a') THEN RETURN K, Note
expect:
  count: 1
  columns: K STRING, Note STRING
  ["a-Note","kept"]

case dml_insert_identity_key_then_return
dml:
  INSERT INTO I (Name) VALUES ('a'), ('b') THEN RETURN Name, Id > 0 AS positive
expect:
  count: 2
  columns: Name STRING, positive BOOL
  ["a",true]
  ["b",true]
query:
  SELECT COUNT(*) AS n, COUNT(DISTINCT Id) AS ids FROM I
expect:
  columns: n INT64, ids INT64
  ["2","2"]

case dml_insert_or_ignore_default_key_then_return
dml:
  INSERT OR IGNORE INTO U (Source) VALUES ('a'), ('b') THEN RETURN Source
expect:
  count: 2
  columns: Source STRING
  ["a"]
  ["b"]
query:
  SELECT COUNT(*) AS n, COUNT(DISTINCT Id) AS ids FROM U
expect:
  columns: n INT64, ids INT64
  ["2","2"]
