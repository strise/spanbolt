case json_353
query:
  SELECT TO_JSON_STRING(JSON '[1,{"b":[]},{}]', true)
expect:
  columns: STRING
  ["[\n  1,\n  {\n    \"b\": []\n  },\n  {}\n]"]

case json_354
query:
  SELECT TO_JSON_STRING(NULL)
expect:
  error: UNIMPLEMENTED
  message: TO_JSON_STRING is not supported on values of type INT64

case json_355
query:
  SELECT TO_JSON_STRING(CAST(NULL AS JSON))
expect:
  columns: STRING
  ["null"]

case json_356
query:
  SELECT TO_JSON_STRING(TO_JSON(DATE '0001-01-01'))
expect:
  columns: STRING
  ["\"0001-01-01\""]

case json_357
query:
  SELECT TO_JSON_STRING(TO_JSON(CAST(NULL AS ARRAY<INT64>)))
expect:
  columns: STRING
  ["null"]

case json_358
query:
  SELECT TO_JSON_STRING(TO_JSON(STRUCT<x INT64, x INT64>(1, 2)))
expect:
  columns: STRING
  ["{\"x\":1}"]

case json_359
query:
  SELECT TO_JSON_STRING(TO_JSON(STRUCT(CAST(NULL AS INT64) AS a)))
expect:
  columns: STRING
  ["{\"a\":null}"]

