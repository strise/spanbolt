case time_zones_118
query:
  WITH t AS (SELECT '%d' AS p) SELECT FORMAT(p, 1, 2) FROM t
expect:
  error: OUT_OF_RANGE
  message: Too many arguments to FORMAT for pattern "%d"; Expected 2; Got 3

case time_zones_119
query:
  WITH t AS (SELECT '$.a' AS p) SELECT JSON_VALUE('{"a": 5}', p) FROM t
expect:
  error: INVALID_ARGUMENT
  message: Argument 2 to JSON_VALUE must be a literal or query parameter [at 1:61]

case time_zones_120
query:
  WITH t AS (SELECT x FROM UNNEST(['a', 'b', 'a']) AS x) SELECT STRING_AGG(UPPER(x), ',') FROM t
expect:
  columns: STRING
  ["A,B,A"]

case time_zones_121
query:
  SELECT ARRAY(SELECT FARM_FINGERPRINT(x) FROM UNNEST(['a', 'bb', 'ccc']) AS x WITH OFFSET o ORDER BY o)
expect:
  columns: ARRAY<INT64>
  [["-5528939962900187677","161571533504518082","5019631782728660205"]]
