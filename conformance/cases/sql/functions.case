query:
  SELECT GENERATE_DATE_ARRAY(DATE '2020-01-01', DATE '2022-02-05', INTERVAL 1 YEAR)
expect:
  columns: ARRAY<DATE>
  [["2020-01-01","2021-01-01","2022-01-01"]]

