  [["-9223372036854775808","-1","9223372036854775806"]]

case arrays_063
query:
  SELECT GENERATE_DATE_ARRAY(DATE '2020-01-01', DATE '2020-01-05')
expect:
  columns: ARRAY<DATE>
  [["2020-01-01","2020-01-02","2020-01-03","2020-01-04","2020-01-05"]]

case arrays_064
query:
  SELECT GENERATE_DATE_ARRAY(DATE '2020-01-01', DATE '2020-03-05', INTERVAL 1 MONTH)
expect:
  columns: ARRAY<DATE>
  [["2020-01-01","2020-02-01","2020-03-01"]]

