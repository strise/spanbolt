# Scalar functions, one SELECT per case; generated from the function probe list.
tags: sql function
schema:
  CREATE TABLE Dummy (Id INT64 NOT NULL) PRIMARY KEY (Id)

case math_001
query:
  SELECT ABS(-5)
expect:
  columns: INT64
  ["5"]

case math_002
query:
  SELECT ABS(-9223372036854775808)
expect:
  error: OUT_OF_RANGE
  message: int64 overflow: --9223372036854775808

