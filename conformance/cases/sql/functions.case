case arrays_058
query:
  SELECT GENERATE_ARRAY(1, 16001)
expect:
  error: OUT_OF_RANGE
  message: Cannot generate arrays with more than 16000 elements.

case arrays_059
query:
  SELECT ARRAY_LENGTH(GENERATE_ARRAY(1, 1000000))
expect:
  error: OUT_OF_RANGE
  message: Cannot generate arrays with more than 16000 elements.

case arrays_060
query:
  SELECT GENERATE_ARRAY(9223372036854775806, 9223372036854775807)
expect:
  columns: ARRAY<INT64>
  [["9223372036854775806","9223372036854775807"]]

case arrays_061
query:
  SELECT GENERATE_ARRAY(9223372036854775807, 9223372036854775807, 9223372036854775807)
expect:
  columns: ARRAY<INT64>
  [["9223372036854775807"]]

