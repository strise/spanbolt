query:
  SELECT GENERATE_DATE_ARRAY(DATE '2020-01-01', DATE '2021-02-05', INTERVAL 1 QUARTER)
expect:
  columns: ARRAY<DATE>
  [["2020-01-01","2020-04-01","2020-07-01","2020-10-01","2021-01-01"]]

