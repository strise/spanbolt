  SELECT INTERVAL 10001 YEAR
expect:
  error: OUT_OF_RANGE
  message: Interval field months '120012' is out of range -120000 to 120000

case misc_002
query:
  SELECT INTERVAL 120001 MONTH
expect:
  error: OUT_OF_RANGE
  message: Interval field months '120001' is out of range -120000 to 120000

