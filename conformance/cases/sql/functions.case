expect:
  columns: STRING
  ["1"]

case json_015
query:
  SELECT JSON_VALUE('{"a b": 1}', '$["a b"]')
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: ["a b"]

case json_016
query:
  SELECT JSON_VALUE('{"a": 1}', '$[\'a\']')
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: ['a']

case json_017
query:
  SELECT JSON_VALUE('{"a": 1}', 'a')
expect:
  error: OUT_OF_RANGE
  message: JSONPath must start with '$'

case json_018
query:
  SELECT JSON_VALUE('{"a": 1}', '$.')
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: .

case json_019
query:
  SELECT JSON_VALUE('{"a": 1}', '$..a')
expect:
  error: OUT_OF_RANGE
  message: Unsupported operator in JSONPath: ..

case json_020
query:
  SELECT JSON_VALUE('{"a": 1}', '$.a[')
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: [

case json_021
query:
  SELECT JSON_VALUE('{"a": 1}', '$[*]')
expect:
  error: OUT_OF_RANGE
  message: Unsupported operator in JSONPath: *

