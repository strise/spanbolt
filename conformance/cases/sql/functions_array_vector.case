query:
  SELECT ARRAY_INCLUDES_ANY(CAST([] AS ARRAY<INT64>), CAST([] AS ARRAY<INT64>))
expect:
  columns: BOOL
  [false]

case array_includes_any_null_in_targets_hit
query:
  SELECT ARRAY_INCLUDES_ANY([1, 2], [1, NULL])
expect:
  columns: BOOL
  [true]

case array_includes_any_null_in_targets_miss
query:
  SELECT ARRAY_INCLUDES_ANY([1, 2], [5, NULL])
expect:
  columns: BOOL
  [false]

case array_includes_any_null_in_source
query:
  SELECT ARRAY_INCLUDES_ANY([1, NULL], [1, 2])
expect:
  columns: BOOL
  [true]

case array_includes_any_null_in_both
query:
  SELECT ARRAY_INCLUDES_ANY([NULL, 1], [CAST(NULL AS INT64)])
expect:
  columns: BOOL
  [false]

case array_includes_any_only_null_target
query:
  SELECT ARRAY_INCLUDES_ANY([1, 2], [CAST(NULL AS INT64)])
expect:
  columns: BOOL
  [false]

case array_includes_any_nan
query:
  SELECT ARRAY_INCLUDES_ANY([1.0, CAST('nan' AS FLOAT64)], [CAST('nan' AS FLOAT64)])
expect:
  columns: BOOL
  [false]

case array_includes_any_dups
query:
  SELECT ARRAY_INCLUDES_ANY([1, 1], [1, 1, 1])
expect:
  columns: BOOL
  [true]

case array_includes_any_string
query:
  SELECT ARRAY_INCLUDES_ANY(['a', 'b'], ['b', 'a'])
expect:
  columns: BOOL
  [true]

case array_includes_any_where_param
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ANY(Tags, @p)
params:
  @p ARRAY<STRING> = ["b", "x"]
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["5"]

case array_includes_any_where_param_ab
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ANY(Tags, @p)
params:
  @p ARRAY<STRING> = ["a", "b"]
expect:
  columns: Id INT64
  ["1"]
  ["2"]

case array_includes_any_where_param_empty
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ANY(Tags, @p)
params:
