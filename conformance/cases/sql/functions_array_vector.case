case array_includes_any_int_float
query:
  SELECT ARRAY_INCLUDES_ANY([1, 2], [1.0])
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function ARRAY_INCLUDES_ANY Argument types: ARRAY<INT64>, ARRAY<FLOAT64> Signature: ARRAY_INCLUDES_ANY(ARRAY<T1>, ARRAY<T1>) Unable to coerce type ARRAY<INT64> to inferred array type ARRAY<FLOAT64> for argument <array<T1>> [at 1:8]

