query:
  SELECT DOT_PRODUCT([1, 2], [3, 4])
expect:
  columns: FLOAT64
  [11.0]

case dot_product_mixed_float
query:
  SELECT DOT_PRODUCT(ARRAY<FLOAT32>[1, 2], [3.0, 4.0])
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function DOT_PRODUCT Argument types: ARRAY<FLOAT32>, ARRAY<FLOAT64> Signature: DOT_PRODUCT(ARRAY<INT64>, ARRAY<INT64>) Argument 1: Unable to coerce type ARRAY<FLOAT32> to expected type ARRAY<INT64> Signature: DOT_PRODUCT(ARRAY<FLOAT32>, ARRAY<FLOAT32>) Argument 2: Unable to coerce type ARRAY<FLOAT64> to expected type ARRAY<FLOAT32> Signature: DOT_PRODUCT(ARRAY<FLOAT64>, ARRAY<FLOAT64>) Argument 1: Unable to coerce type ARRAY<FLOAT32> to expected type ARRAY<FLOAT64> [at 1:8]

case dot_product_length_mismatch
query:
  SELECT DOT_PRODUCT([1.0, 2.0], [3.0])
expect:
  error: OUT_OF_RANGE
  message: Array arguments to DOT_PRODUCT must have equal length. The given arrays have lengths of 2 and 1

case dot_product_null_array
query:
