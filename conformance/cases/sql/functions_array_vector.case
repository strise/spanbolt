expect:
  columns: FLOAT64
  [null]

case dot_product_null_elem
query:
  SELECT DOT_PRODUCT([1.0, NULL], [3.0, 4.0])
expect:
  error: OUT_OF_RANGE
  message: Cannot compute DOT_PRODUCT with a NULL element, since it is unclear if NULLs should be ignored, counted as a zero value, or another interpretation. The NULL element was found in the first array argument at OFFSET 1

