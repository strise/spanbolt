expect:
  columns: FLOAT64
  [0.01613008990009257]

case cosine_distance_int64
query:
  SELECT COSINE_DISTANCE([1, 2], [3, 4])
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function COSINE_DISTANCE Argument types: ARRAY<INT64>, ARRAY<INT64> Signature: COSINE_DISTANCE(ARRAY<FLOAT64>, ARRAY<FLOAT64>) Argument 1: Unable to coerce type ARRAY<INT64> to expected type ARRAY<FLOAT64> Signature: COSINE_DISTANCE(ARRAY<FLOAT32>, ARRAY<FLOAT32>) Argument 1: Unable to coerce type ARRAY<INT64> to expected type ARRAY<FLOAT32> [at 1:8]

case cosine_distance_mixed_float
query:
  SELECT COSINE_DISTANCE(ARRAY<FLOAT32>[1, 2], [3.0, 4.0])
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function COSINE_DISTANCE Argument types: ARRAY<FLOAT32>, ARRAY<FLOAT64> Signature: COSINE_DISTANCE(ARRAY<FLOAT64>, ARRAY<FLOAT64>) Argument 1: Unable to coerce type ARRAY<FLOAT32> to expected type ARRAY<FLOAT64> Signature: COSINE_DISTANCE(ARRAY<FLOAT32>, ARRAY<FLOAT32>) Argument 2: Unable to coerce type ARRAY<FLOAT64> to expected type ARRAY<FLOAT32> [at 1:8]

