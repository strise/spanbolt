  ["1"]

case array_includes_all_where_param_empty
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ALL(Tags, @p)
params:
  @p ARRAY<STRING> = []
expect:
  columns: Id INT64
  ["1"]
  ["5"]
  ["2"]
  ["3"]

case array_includes_all_where_param_null
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ALL(Tags, @p)
params:
  @p ARRAY<STRING> = null
expect:
  columns: Id INT64

case array_includes_all_where_param_with_null
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES_ALL(Tags, @p)
params:
  @p ARRAY<STRING> = ["b", null]
expect:
  columns: Id INT64

case array_includes_all_select_column
query:
  SELECT Id, ARRAY_INCLUDES_ALL(Nums, [1, 5]) FROM Items
expect:
  columns: Id INT64, BOOL
  ["4",null]
  ["3",false]
  ["2",false]
  ["1",false]
  ["5",false]

case array_includes_all_struct
query:
  SELECT ARRAY_INCLUDES_ALL([STRUCT(1 AS a)], [STRUCT(1 AS a)])
expect:
  columns: BOOL
  [true]

case array_includes_all_int_float
query:
  SELECT ARRAY_INCLUDES_ALL([1, 2], [1.0])
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function ARRAY_INCLUDES_ALL Argument types: ARRAY<INT64>, ARRAY<FLOAT64> Signature: ARRAY_INCLUDES_ALL(ARRAY<T1>, ARRAY<T1>) Unable to coerce type ARRAY<INT64> to inferred array type ARRAY<FLOAT64> for argument <array<T1>> [at 1:8]

case array_includes_any_not_where
query:
  SELECT Id FROM Items WHERE NOT ARRAY_INCLUDES_ANY(Tags, @p)
params:
  @p ARRAY<STRING> = ["b"]
expect:
  columns: Id INT64
  ["5"]
  ["3"]

case array_filter_basic
query:
  SELECT ARRAY_FILTER([1, 2, 3, 4], e -> e > 2)
expect:
  columns: ARRAY<INT64>
  [["3","4"]]

case array_filter_index
query:
  SELECT ARRAY_FILTER([10, 20, 30, 40], (e, i) -> i > 1)
expect:
  columns: ARRAY<INT64>
  [["30","40"]]

case array_filter_null_array
query:
  SELECT ARRAY_FILTER(CAST(NULL AS ARRAY<INT64>), e -> e > 2)
expect:
  columns: ARRAY<INT64>
  [null]

case array_filter_null_elem
query:
  SELECT ARRAY_FILTER([1, NULL, 3], e -> e > 0)
expect:
  columns: ARRAY<INT64>
  [["1","3"]]

case array_filter_null_elem_kept
query:
  SELECT ARRAY_FILTER([1, NULL, 3], e -> e IS NULL)
expect:
  columns: ARRAY<INT64>
  [[null]]

case array_filter_empty
query:
  SELECT ARRAY_FILTER(CAST([] AS ARRAY<INT64>), e -> true)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_filter_captured_param
query:
  SELECT ARRAY_FILTER([1, 2, 3, 4], e -> e >= @m)
params:
  @m INT64 = 3
expect:
  columns: ARRAY<INT64>
  [["3","4"]]

case array_filter_column
query:
  SELECT Id, ARRAY_FILTER(Nums, e -> e > Id) FROM Items
expect:
  columns: Id INT64, ARRAY<INT64>
  ["4",null]
  ["3",[]]
  ["2",["5"]]
  ["1",["2","3"]]
  ["5",["7"]]

case array_filter_where
query:
  SELECT Id FROM Items WHERE ARRAY_LENGTH(ARRAY_FILTER(Tags, t -> t > 'a')) > 0
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["5"]

case array_filter_error
query:
  SELECT ARRAY_FILTER([1, 0], e -> 1 / e > 0)
expect:
  error: OUT_OF_RANGE
  message: division by zero: 1 / 0

case array_filter_non_bool
query:
  SELECT ARRAY_FILTER([1, 2], e -> e)
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function ARRAY_FILTER Argument types: ARRAY<INT64>, LAMBDA Signature: ARRAY_FILTER(ARRAY<T1>, FUNCTION<T1->BOOL>) Argument 2: failed to resolve lambda body, error: Lambda should return type BOOL, but returns INT64 Signature: ARRAY_FILTER(ARRAY<T1>, FUNCTION<(T1, INT64)->BOOL>) Argument 2: lambda requires 2 arguments but 1 is provided [at 1:8]

case array_transform_basic
query:
  SELECT ARRAY_TRANSFORM([1, 2, 3], e -> e * 10)
expect:
  columns: ARRAY<INT64>
  [["10","20","30"]]

case array_transform_index
query:
  SELECT ARRAY_TRANSFORM(['a', 'b'], (e, i) -> CONCAT(e, CAST(i AS STRING)))
expect:
  columns: ARRAY<STRING>
  [["a0","b1"]]

case array_transform_null_array
query:
  SELECT ARRAY_TRANSFORM(CAST(NULL AS ARRAY<INT64>), e -> e + 1)
expect:
  columns: ARRAY<INT64>
  [null]

case array_transform_null_elem
query:
  SELECT ARRAY_TRANSFORM([1, NULL], e -> e + 1)
expect:
  columns: ARRAY<INT64>
  [["2",null]]

case array_transform_empty
query:
  SELECT ARRAY_TRANSFORM(CAST([] AS ARRAY<STRING>), e -> LENGTH(e))
expect:
  columns: ARRAY<INT64>
  [[]]

case array_transform_type_change
query:
  SELECT ARRAY_TRANSFORM(['ab', 'c'], e -> LENGTH(e))
expect:
  columns: ARRAY<INT64>
  [["2","1"]]

case array_transform_column
query:
  SELECT Id, ARRAY_TRANSFORM(Tags, t -> UPPER(t)) FROM Items
expect:
  columns: Id INT64, ARRAY<STRING>
  ["4",null]
  ["3",[]]
  ["2",["B",null]]
  ["1",["A","B","C"]]
  ["5",["X"]]

case array_transform_nested
query:
  SELECT ARRAY_TRANSFORM([1, 2], e -> ARRAY_TRANSFORM([10, 20], f -> e + f))
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function ARRAY_TRANSFORM Argument types: ARRAY<INT64>, LAMBDA Signature: ARRAY_TRANSFORM(ARRAY<T1>, FUNCTION<T1->T2>) <array<T2>> is inferred to be array of array, which is not supported Signature: ARRAY_TRANSFORM(ARRAY<T1>, FUNCTION<(T1, INT64)->T2>) Argument 2: lambda requires 2 arguments but 1 is provided [at 1:8]

case array_transform_error
query:
  SELECT ARRAY_TRANSFORM([9223372036854775807], e -> e + 1)
expect:
  error: OUT_OF_RANGE
  message: int64 overflow: 9223372036854775807 + 1

case array_includes_lambda_hit
query:
  SELECT ARRAY_INCLUDES([1, 2, 3], e -> e > 2)
expect:
  columns: BOOL
  [true]

case array_includes_lambda_miss
query:
  SELECT ARRAY_INCLUDES([1, 2, 3], e -> e > 5)
expect:
  columns: BOOL
  [false]

case array_includes_lambda_null_result
query:
  SELECT ARRAY_INCLUDES([1, NULL], e -> e > 5)
expect:
  columns: BOOL
  [false]

case array_includes_lambda_null_array
query:
  SELECT ARRAY_INCLUDES(CAST(NULL AS ARRAY<INT64>), e -> e > 5)
expect:
  columns: BOOL
  [null]

case array_includes_lambda_empty
query:
  SELECT ARRAY_INCLUDES(CAST([] AS ARRAY<INT64>), e -> true)
expect:
  columns: BOOL
  [false]

case array_includes_lambda_where
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES(Nums, n -> n > @m)
params:
  @m INT64 = 2
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["5"]

case array_includes_lambda_index
query:
  SELECT ARRAY_INCLUDES([1, 2], (e, i) -> i = 1)
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function ARRAY_INCLUDES Argument types: ARRAY<INT64>, LAMBDA Signature: ARRAY_INCLUDES(ARRAY<T1>, T1) Argument 2: expected T1, found LAMBDA Signature: ARRAY_INCLUDES(ARRAY<T1>, FUNCTION<T1->BOOL>) Argument 2: lambda requires 1 arguments but 2 is provided [at 1:8]

case array_filter_subquery_in_body
query:
  SELECT ARRAY_FILTER([1, 2, 3], e -> e IN (SELECT 2 UNION ALL SELECT 3))
expect:
  columns: ARRAY<INT64>
  [["2","3"]]

case array_filter_key_filter
query:
  SELECT Id FROM Items WHERE Id = ARRAY_FIRST(ARRAY_FILTER(Nums, e -> e > 1))
expect:
  error: OUT_OF_RANGE
  message: ARRAY_FIRST cannot get the first element of an empty array

case cosine_distance_basic
query:
