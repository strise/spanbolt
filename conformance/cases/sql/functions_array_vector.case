# ARRAY_MIN/MAX/SLICE/FIRST/LAST/INCLUDES*, the lambda forms (ARRAY_FILTER, ARRAY_TRANSFORM,
# ARRAY_INCLUDES with a lambda) and the vector distance functions.
tags: sql function array
schema:
  CREATE TABLE Items (
    Id INT64 NOT NULL,
    Tags ARRAY<STRING(MAX)>,
    Nums ARRAY<INT64>,
    Vec ARRAY<FLOAT64>,
    Vec32 ARRAY<FLOAT32>,
  ) PRIMARY KEY (Id)
insert Items cols=Id,Tags,Nums,Vec,Vec32:
  [1, ["a", "b", "c"], [1, 2, 3], [1.0, 0.0], [1.0, 0.0]]
  [2, ["b", null], [5, null], [0.0, 1.0], [0.0, 1.0]]
  [3, [], [], [3.0, 4.0], [3.0, 4.0]]
  [4, null, null, null, null]
  [5, ["x"], [7], [1.0, 2.0, 3.0], [1.0, 2.0, 3.0]]

case array_min_int
query:
  SELECT ARRAY_MIN([3, 1, 2])
expect:
  columns: INT64
  ["1"]

case array_min_null_elems
query:
  SELECT ARRAY_MIN([3, NULL, 1])
expect:
  columns: INT64
  ["1"]

case array_min_all_null
query:
  SELECT ARRAY_MIN([CAST(NULL AS INT64), NULL])
expect:
  columns: INT64
  [null]

case array_min_empty
query:
  SELECT ARRAY_MIN(CAST([] AS ARRAY<INT64>))
expect:
  columns: INT64
  [null]

case array_min_null_array
query:
  SELECT ARRAY_MIN(CAST(NULL AS ARRAY<INT64>))
expect:
  columns: INT64
  [null]

case array_min_float
query:
  SELECT ARRAY_MIN([1.5, -2.5, 0.0])
expect:
  columns: FLOAT64
  [-2.5]

case array_min_float_nan
query:
  SELECT ARRAY_MIN([1.5, CAST('nan' AS FLOAT64), -2.5])
expect:
  columns: FLOAT64
  ["NaN"]

case array_min_float_inf
query:
  SELECT ARRAY_MIN([1.5, CAST('inf' AS FLOAT64), -CAST('inf' AS FLOAT64)])
expect:
  columns: FLOAT64
  ["-Infinity"]

case array_min_float32
query:
  SELECT ARRAY_MIN([CAST(1.5 AS FLOAT32), CAST(-1 AS FLOAT32)])
expect:
  columns: FLOAT32
  [-1.0]

case array_min_string
query:
  SELECT ARRAY_MIN(['b', 'a', 'C'])
expect:
  columns: STRING
  ["C"]

case array_min_bytes
query:
  SELECT ARRAY_MIN([b'b', b'a'])
expect:
  columns: BYTES
  ["YQ=="]

case array_min_date
query:
  SELECT ARRAY_MIN([DATE '2020-01-02', DATE '2019-05-01'])
expect:
  columns: DATE
  ["2019-05-01"]

case array_min_timestamp
query:
  SELECT ARRAY_MIN([TIMESTAMP '2020-01-02T00:00:00Z', TIMESTAMP '2019-05-01T00:00:00Z'])
expect:
  columns: TIMESTAMP
  ["2019-05-01T00:00:00Z"]

case array_min_numeric
query:
  SELECT ARRAY_MIN([NUMERIC '1.25', NUMERIC '-3.5'])
expect:
  columns: NUMERIC
  ["-3.5"]

case array_min_bool
query:
  SELECT ARRAY_MIN([true, false])
expect:
  columns: BOOL
  [false]

case array_min_column
query:
  SELECT Id, ARRAY_MIN(Nums), ARRAY_MIN(Tags), ARRAY_MIN(Vec) FROM Items
expect:
  columns: Id INT64, INT64, STRING, FLOAT64
  ["4",null,null,null]
  ["3",null,null,3.0]
  ["2","5","b",0.0]
  ["1","1","a",0.0]
  ["5","7","x",1.0]

case array_max_int
query:
  SELECT ARRAY_MAX([3, 1, 2])
expect:
  columns: INT64
  ["3"]

case array_max_null_elems
query:
  SELECT ARRAY_MAX([3, NULL, 1])
expect:
  columns: INT64
  ["3"]

case array_max_all_null
query:
  SELECT ARRAY_MAX([CAST(NULL AS INT64), NULL])
expect:
  columns: INT64
  [null]

case array_max_empty
query:
  SELECT ARRAY_MAX(CAST([] AS ARRAY<INT64>))
expect:
  columns: INT64
  [null]

case array_max_null_array
query:
  SELECT ARRAY_MAX(CAST(NULL AS ARRAY<INT64>))
expect:
  columns: INT64
  [null]

case array_max_float
query:
  SELECT ARRAY_MAX([1.5, -2.5, 0.0])
expect:
  columns: FLOAT64
  [1.5]

case array_max_float_nan
query:
  SELECT ARRAY_MAX([1.5, CAST('nan' AS FLOAT64), -2.5])
expect:
  columns: FLOAT64
  ["NaN"]

case array_max_float_inf
query:
  SELECT ARRAY_MAX([1.5, CAST('inf' AS FLOAT64), -CAST('inf' AS FLOAT64)])
expect:
  columns: FLOAT64
  ["Infinity"]

case array_max_float32
query:
  SELECT ARRAY_MAX([CAST(1.5 AS FLOAT32), CAST(-1 AS FLOAT32)])
expect:
  columns: FLOAT32
  [1.5]

case array_max_string
query:
  SELECT ARRAY_MAX(['b', 'a', 'C'])
expect:
  columns: STRING
  ["b"]

case array_max_bytes
query:
  SELECT ARRAY_MAX([b'b', b'a'])
expect:
  columns: BYTES
  ["Yg=="]

case array_max_date
query:
  SELECT ARRAY_MAX([DATE '2020-01-02', DATE '2019-05-01'])
expect:
  columns: DATE
  ["2020-01-02"]

case array_max_timestamp
query:
  SELECT ARRAY_MAX([TIMESTAMP '2020-01-02T00:00:00Z', TIMESTAMP '2019-05-01T00:00:00Z'])
expect:
  columns: TIMESTAMP
  ["2020-01-02T00:00:00Z"]

case array_max_numeric
query:
  SELECT ARRAY_MAX([NUMERIC '1.25', NUMERIC '-3.5'])
expect:
  columns: NUMERIC
  ["1.25"]

case array_max_bool
query:
  SELECT ARRAY_MAX([true, false])
expect:
  columns: BOOL
  [true]

case array_max_column
query:
  SELECT Id, ARRAY_MAX(Nums), ARRAY_MAX(Tags), ARRAY_MAX(Vec) FROM Items
expect:
  columns: Id INT64, INT64, STRING, FLOAT64
  ["4",null,null,null]
  ["3",null,null,4.0]
  ["2","5","b",1.0]
  ["1","3","c",1.0]
  ["5","7","x",3.0]

case array_min_nan_only
query:
  SELECT ARRAY_MIN([CAST('nan' AS FLOAT64), NULL])
expect:
  columns: FLOAT64
  ["NaN"]

case array_max_nan_first
query:
  SELECT ARRAY_MAX([CAST('nan' AS FLOAT64), 1.0])
expect:
  columns: FLOAT64
  ["NaN"]

case array_min_struct
query:
  SELECT ARRAY_MIN([STRUCT(1 AS a)])
expect:
  error: INVALID_ARGUMENT
  message: ARRAY_MIN cannot be used on argument of type ARRAY<STRUCT<a INT64>> because the array's element type does not support ordering [at 1:8]

case array_min_array_of_array
query:
  SELECT ARRAY_MIN([[1]])
expect:
  error: INVALID_ARGUMENT
  message: Cannot construct array with element type ARRAY<INT64> because nested arrays are not supported [at 1:19]

case array_slice_basic
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 1, 3)
expect:
  columns: ARRAY<INT64>
  [["2","3","4"]]

case array_slice_from_zero
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 0, 0)
expect:
  columns: ARRAY<INT64>
  [["1"]]

case array_slice_neg
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -3, -1)
expect:
  columns: ARRAY<INT64>
  [["3","4","5"]]

case array_slice_neg_start_pos_end
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -2, 4)
expect:
  columns: ARRAY<INT64>
  [["4","5"]]

case array_slice_start_after_end
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 3, 1)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_neg_start_after_end
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -1, -3)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_start_out_of_range
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 7, 9)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_end_out_of_range
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 2, 99)
expect:
  columns: ARRAY<INT64>
  [["3","4","5"]]

case array_slice_neg_out_of_range
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -99, -4)
expect:
  columns: ARRAY<INT64>
  [["1","2"]]

case array_slice_both_neg_out_of_range
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -99, -50)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_start_neg_end_neg_oor
query:
  SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 0, -99)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_null_elems
query:
  SELECT ARRAY_SLICE(['a', NULL, 'c'], 0, 1)
expect:
  columns: ARRAY<STRING>
  [["a",null]]

case array_slice_empty
query:
  SELECT ARRAY_SLICE(CAST([] AS ARRAY<INT64>), 0, 1)
expect:
  columns: ARRAY<INT64>
  [[]]

case array_slice_int64_extremes
query:
  SELECT ARRAY_SLICE([1, 2, 3], -9223372036854775808, 9223372036854775807)
expect:
  columns: ARRAY<INT64>
  [["1","2","3"]]

case array_slice_null_array
query:
  SELECT ARRAY_SLICE(CAST(NULL AS ARRAY<INT64>), 0, 1)
expect:
  columns: ARRAY<INT64>
  [null]

case array_slice_null_start
query:
  SELECT ARRAY_SLICE([1, 2], NULL, 1)
expect:
  columns: ARRAY<INT64>
  [null]

case array_slice_null_end
query:
  SELECT ARRAY_SLICE([1, 2], 0, NULL)
expect:
  columns: ARRAY<INT64>
  [null]

case array_slice_column
query:
  SELECT Id, ARRAY_SLICE(Tags, 1, -1) FROM Items
expect:
  columns: Id INT64, ARRAY<STRING>
  ["4",null]
  ["3",[]]
  ["2",[null]]
  ["1",["b","c"]]
  ["5",[]]

case array_slice_params
query:
  SELECT ARRAY_SLICE(@a, @s, @e)
params:
  @a ARRAY<INT64> = [10, 20, 30, 40]
  @s INT64 = -3
  @e INT64 = 2
expect:
  columns: ARRAY<INT64>
  [["20","30"]]

case array_first_int
query:
  SELECT ARRAY_FIRST([1, 2, 3])
expect:
  columns: INT64
  ["1"]

case array_first_null_elem
query:
  SELECT ARRAY_FIRST([CAST(NULL AS INT64)])
expect:
  columns: INT64
  [null]

case array_first_empty
query:
  SELECT ARRAY_FIRST(CAST([] AS ARRAY<INT64>))
expect:
  error: OUT_OF_RANGE
  message: ARRAY_FIRST cannot get the first element of an empty array

case array_first_null_array
query:
  SELECT ARRAY_FIRST(CAST(NULL AS ARRAY<STRING>))
expect:
  columns: STRING
  [null]

case array_first_struct
query:
  SELECT ARRAY_FIRST([STRUCT(1 AS a, 'x' AS b), STRUCT(2, 'y')]).b
expect:
  columns: b STRING
  ["x"]

case array_first_column
query:
  SELECT Id, ARRAY_FIRST(Tags) FROM Items WHERE Id != 3
expect:
  columns: Id INT64, STRING
  ["5","x"]
  ["1","a"]
  ["4",null]
  ["2","b"]

case array_first_column_empty
query:
  SELECT Id, ARRAY_FIRST(Tags) FROM Items WHERE Id = 3
expect:
  error: OUT_OF_RANGE
  message: ARRAY_FIRST cannot get the first element of an empty array

case array_last_int
query:
  SELECT ARRAY_LAST([1, 2, 3])
expect:
  columns: INT64
  ["3"]

case array_last_null_elem
query:
  SELECT ARRAY_LAST([CAST(NULL AS INT64)])
expect:
  columns: INT64
  [null]

case array_last_empty
query:
  SELECT ARRAY_LAST(CAST([] AS ARRAY<INT64>))
expect:
  error: OUT_OF_RANGE
  message: ARRAY_LAST cannot get the last element of an empty array

case array_last_null_array
query:
  SELECT ARRAY_LAST(CAST(NULL AS ARRAY<STRING>))
expect:
  columns: STRING
  [null]

case array_last_struct
query:
  SELECT ARRAY_LAST([STRUCT(1 AS a, 'x' AS b), STRUCT(2, 'y')]).b
expect:
  columns: b STRING
  ["y"]

case array_last_column
query:
  SELECT Id, ARRAY_LAST(Tags) FROM Items WHERE Id != 3
expect:
  columns: Id INT64, STRING
  ["5","x"]
  ["1","c"]
  ["4",null]
  ["2",null]

case array_last_column_empty
query:
  SELECT Id, ARRAY_LAST(Tags) FROM Items WHERE Id = 3
expect:
  error: OUT_OF_RANGE
  message: ARRAY_LAST cannot get the last element of an empty array

case array_includes_hit
query:
  SELECT ARRAY_INCLUDES([1, 2, 3], 2)
expect:
  columns: BOOL
  [true]

case array_includes_miss
query:
  SELECT ARRAY_INCLUDES([1, 2, 3], 5)
expect:
  columns: BOOL
  [false]

case array_includes_null_target
query:
  SELECT ARRAY_INCLUDES([1, 2, 3], NULL)
expect:
  columns: BOOL
  [null]

case array_includes_null_elem_miss
query:
  SELECT ARRAY_INCLUDES([1, NULL], 3)
expect:
  columns: BOOL
  [false]

case array_includes_null_elem_hit
query:
  SELECT ARRAY_INCLUDES([1, NULL], 1)
expect:
  columns: BOOL
  [true]

case array_includes_null_array
query:
  SELECT ARRAY_INCLUDES(CAST(NULL AS ARRAY<INT64>), 1)
expect:
  columns: BOOL
  [null]

case array_includes_empty
query:
  SELECT ARRAY_INCLUDES(CAST([] AS ARRAY<INT64>), 1)
expect:
  columns: BOOL
  [false]

case array_includes_nan
query:
  SELECT ARRAY_INCLUDES([1.0, CAST('nan' AS FLOAT64)], CAST('nan' AS FLOAT64))
expect:
  columns: BOOL
  [false]

case array_includes_int_float
query:
  SELECT ARRAY_INCLUDES([1.0, 2.0], 1)
expect:
  columns: BOOL
  [true]

case array_includes_string
query:
  SELECT ARRAY_INCLUDES(['a', 'B'], 'b')
expect:
  columns: BOOL
  [false]

case array_includes_struct
query:
  SELECT ARRAY_INCLUDES([STRUCT(1 AS a)], STRUCT(1 AS a))
expect:
  columns: BOOL
  [true]

case array_includes_array_elem
query:
  SELECT ARRAY_INCLUDES([[1]], [1])
expect:
  error: INVALID_ARGUMENT
  message: Cannot construct array with element type ARRAY<INT64> because nested arrays are not supported [at 1:24]

case array_includes_where_param
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES(Tags, @x)
params:
  @x STRING = "b"
expect:
  columns: Id INT64
  ["1"]
  ["2"]

case array_includes_where_null_param
query:
  SELECT Id FROM Items WHERE ARRAY_INCLUDES(Tags, @x)
params:
  @x STRING = null
expect:
  columns: Id INT64

case array_includes_select_column
query:
  SELECT Id, ARRAY_INCLUDES(Nums, 5) FROM Items
expect:
  columns: Id INT64, BOOL
  ["4",null]
  ["3",false]
  ["2",true]
  ["1",false]
  ["5",false]

