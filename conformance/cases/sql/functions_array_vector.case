case array_includes_any_select_column
query:
  SELECT Id, ARRAY_INCLUDES_ANY(Nums, [1, 5]) FROM Items
expect:
  columns: Id INT64, BOOL
  ["4",null]
  ["3",false]
  ["2",true]
  ["1",true]
  ["5",false]

