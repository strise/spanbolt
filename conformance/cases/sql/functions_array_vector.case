  error: OUT_OF_RANGE
  message: NULL array element in second argument

case euclidean_distance_null_elem_both
query:
  SELECT EUCLIDEAN_DISTANCE([1.0, NULL], [NULL, 4.0])
expect:
  error: OUT_OF_RANGE
  message: NULL array element in second argument

case euclidean_distance_null_elem_and_mismatch
query:
  SELECT EUCLIDEAN_DISTANCE([CAST(NULL AS FLOAT64)], [1.0, 2.0])
expect:
  error: OUT_OF_RANGE
  message: Array length mismatch: 1 and 2

case euclidean_distance_sum_overflow
query:
  SELECT EUCLIDEAN_DISTANCE([1e308, 1e308], [1.0, 1.0])
expect:
  error: OUT_OF_RANGE
  message: double overflow: 1e+308 * 1e+308

case euclidean_distance_add_overflow
query:
  SELECT EUCLIDEAN_DISTANCE([1.3e154, 1.3e154], [1.3e154, 1.3e154])
expect:
  columns: FLOAT64
  [0.0]

case euclidean_distance_add_overflow_zero
query:
  SELECT EUCLIDEAN_DISTANCE([1.3e154, 1.3e154], [0.0, 0.0])
expect:
  error: OUT_OF_RANGE
  message: double overflow: 1.69e+308 + 1.69e+308

case euclidean_distance_float32_big
query:
  SELECT EUCLIDEAN_DISTANCE(ARRAY<FLOAT32>[3e38, 3e38], ARRAY<FLOAT32>[3e38, -3e38])
expect:
  columns: FLOAT64
  [6.0000000109955115e+38]

case dot_product_null_elem_second
query:
  SELECT DOT_PRODUCT([1.0, 2.0], [3.0, NULL])
expect:
  error: OUT_OF_RANGE
  message: Cannot compute DOT_PRODUCT with a NULL element, since it is unclear if NULLs should be ignored, counted as a zero value, or another interpretation. The NULL element was found in the second array argument at OFFSET 1

case dot_product_null_elem_both
query:
  SELECT DOT_PRODUCT([1.0, NULL], [NULL, 4.0])
expect:
  error: OUT_OF_RANGE
  message: Cannot compute DOT_PRODUCT with a NULL element, since it is unclear if NULLs should be ignored, counted as a zero value, or another interpretation. The NULL element was found in the first array argument at OFFSET 1

case dot_product_null_elem_and_mismatch
query:
  SELECT DOT_PRODUCT([CAST(NULL AS FLOAT64)], [1.0, 2.0])
expect:
  error: OUT_OF_RANGE
  message: Array arguments to DOT_PRODUCT must have equal length. The given arrays have lengths of 1 and 2

case dot_product_sum_overflow
query:
  SELECT DOT_PRODUCT([1e308, 1e308], [1.0, 1.0])
expect:
  error: OUT_OF_RANGE
  message: double overflow

case dot_product_add_overflow
query:
  SELECT DOT_PRODUCT([1.3e154, 1.3e154], [1.3e154, 1.3e154])
expect:
  error: OUT_OF_RANGE
  message: double overflow

case dot_product_add_overflow_zero
query:
  SELECT DOT_PRODUCT([1.3e154, 1.3e154], [0.0, 0.0])
expect:
  columns: FLOAT64
  [0.0]

case dot_product_float32_big
query:
  SELECT DOT_PRODUCT(ARRAY<FLOAT32>[3e38, 3e38], ARRAY<FLOAT32>[3e38, -3e38])
expect:
  columns: FLOAT64
  [0.0]

case dot_product_int64_null_elem
query:
  SELECT DOT_PRODUCT([1, NULL], [1, 2])
expect:
  error: OUT_OF_RANGE
  message: Cannot compute DOT_PRODUCT with a NULL element, since it is unclear if NULLs should be ignored, counted as a zero value, or another interpretation. The NULL element was found in the first array argument at OFFSET 1

case array_slice_null_elem_kept
query:
  SELECT ARRAY_SLICE([NULL, 1, NULL], -1, -1)
expect:
  columns: ARRAY<INT64>
  [[null]]

case dot_product_int64_overflow
query:
  SELECT DOT_PRODUCT([9223372036854775807], [2])
expect:
  columns: FLOAT64
  [1.8446744073709552e+19]

case dot_product_int64_sum_overflow
query:
  SELECT DOT_PRODUCT([9223372036854775807, 1], [1, 1])
expect:
  columns: FLOAT64
  [9.223372036854776e+18]

