  message: Array length mismatch: 3 and 2

case cosine_distance_column32
query:
  SELECT Id, COSINE_DISTANCE(Vec32, ARRAY<FLOAT32>[1, 1]) FROM Items WHERE Id < 5
expect:
  columns: Id INT64, FLOAT64
  ["3",0.010050506338833531]
  ["1",0.29289321881345254]
  ["4",null]
  ["2",0.29289321881345254]

case cosine_distance_param
query:
  SELECT Id, COSINE_DISTANCE(Vec, @q) FROM Items WHERE Id < 4 ORDER BY COSINE_DISTANCE(Vec, @q), Id
params:
