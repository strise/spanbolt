# JUSTIFY_DAYS, JUSTIFY_HOURS, JUSTIFY_INTERVAL and MAKE_INTERVAL, one SELECT per case.
tags: sql function interval
schema:
  CREATE TABLE Dummy (Id INT64 NOT NULL) PRIMARY KEY (Id)

case make_interval_all_positional
query:
  SELECT MAKE_INTERVAL(1, 2, 3, 4, 5, 6) AS i
expect:
  columns: i INTERVAL
  ["P1Y2M3DT4H5M6S"]

case make_interval_named_all
query:
  SELECT MAKE_INTERVAL(year => 1, month => 2, day => 3, hour => 4, minute => 5, second => 6) AS i
expect:
  columns: i INTERVAL
  ["P1Y2M3DT4H5M6S"]

case make_interval_named_some
query:
  SELECT MAKE_INTERVAL(day => 10) AS a, MAKE_INTERVAL(hour => 25, second => 3601) AS b, MAKE_INTERVAL(month => 14) AS c
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL
  ["P10D","PT26H1S","P1Y2M"]

case make_interval_named_out_of_order
query:
  SELECT MAKE_INTERVAL(second => 1, year => 2) AS i
expect:
  columns: i INTERVAL
  ["P2YT1S"]

case make_interval_positional_then_named
query:
  SELECT MAKE_INTERVAL(1, minute => 30) AS i
expect:
  columns: i INTERVAL
  ["P1YT30M"]

case make_interval_no_args
query:
  SELECT MAKE_INTERVAL() AS i
expect:
  columns: i INTERVAL
  ["P0Y"]

case make_interval_negative_mixed
query:
  SELECT MAKE_INTERVAL(-1, 3, -40, 5, -70, 59) AS i
expect:
  columns: i INTERVAL
  ["P-9M-40DT3H50M59S"]

case make_interval_null_arg
query:
  SELECT MAKE_INTERVAL(1, NULL) AS a, MAKE_INTERVAL(day => CAST(NULL AS INT64)) AS b
expect:
  columns: a INTERVAL, b INTERVAL
  [null,null]

case make_interval_large_seconds
query:
  SELECT MAKE_INTERVAL(second => 315576000000) AS i
expect:
  columns: i INTERVAL
  ["PT87660000H"]

case make_interval_max_fields
query:
  SELECT MAKE_INTERVAL(10000, 0, 3660000, 87840000) AS i
expect:
  columns: i INTERVAL
  ["P10000Y3660000DT87840000H"]

case make_interval_year_overflow
query:
  SELECT MAKE_INTERVAL(10001) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field months '120012' is out of range -120000 to 120000

case make_interval_month_overflow
query:
  SELECT MAKE_INTERVAL(month => -120001) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field months '-120001' is out of range -120000 to 120000

case make_interval_year_month_sum_overflow
query:
  SELECT MAKE_INTERVAL(10000, 1) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field months '120001' is out of range -120000 to 120000

case make_interval_year_int64_overflow
query:
  SELECT MAKE_INTERVAL(9223372036854775807) AS i
expect:
  error: OUT_OF_RANGE
  message: int64 overflow: 9223372036854775807 * 12

case make_interval_day_overflow
query:
  SELECT MAKE_INTERVAL(day => 3660001) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field days '3660001' is out of range -3660000 to 3660000

case make_interval_nanos_overflow
query:
  SELECT MAKE_INTERVAL(hour => 87840001) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field nanoseconds '316224003600000000000' is out of range -316224000000000000000 to 316224000000000000000

case make_interval_huge_hours
query:
  SELECT MAKE_INTERVAL(hour => 9223372036854775807, second => -9223372036854775807) AS i
expect:
  error: OUT_OF_RANGE
  message: Interval field nanoseconds '33194915960640338129393000000000' is out of range -316224000000000000000 to 316224000000000000000

case make_interval_cancel
query:
  SELECT MAKE_INTERVAL(hour => 1, minute => -60) AS a, MAKE_INTERVAL(year => 1, month => -12) AS b
expect:
  columns: a INTERVAL, b INTERVAL
  ["P0Y","P0Y"]

case make_interval_safe
query:
  SELECT SAFE.MAKE_INTERVAL(10001) AS i
expect:
  columns: i INTERVAL
  [null]

case make_interval_param
query:
  SELECT MAKE_INTERVAL(day => @d, hour => @h) AS i
params:
  @d INT64 = 7
  @h INT64 = -3
expect:
  columns: i INTERVAL
  ["P7DT-3H"]

case make_interval_bad_name
query:
  SELECT MAKE_INTERVAL(days => 1) AS i
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function MAKE_INTERVAL Argument types: days => INT64 Signature: MAKE_INTERVAL([[year=>]INT64], [[month=>]INT64], [[day=>]INT64], [[hour=>]INT64], [[minute=>]INT64], [[second=>]INT64]) Named argument `days` does not exist in signature [at 1:8]

case make_interval_string_arg
query:
  SELECT MAKE_INTERVAL('1') AS i
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function MAKE_INTERVAL Argument types: STRING Signature: MAKE_INTERVAL([INT64], [INT64], [INT64], [INT64], [INT64], [INT64]) Argument 1: Unable to coerce type STRING to expected type INT64 [at 1:8]

case make_interval_in_timestamp_add
query:
  SELECT TIMESTAMP_ADD(TIMESTAMP '2024-01-01T00:00:00Z', MAKE_INTERVAL(hour => 36)) AS t
expect:
  error: INVALID_ARGUMENT
  message: Expected INTERVAL expression [at 1:56]

case make_interval_cast_string
query:
  SELECT CAST(MAKE_INTERVAL(1, 2, 3, 4, 5, 6) AS STRING) AS s
expect:
  columns: s STRING
  ["1-2 3 4:5:6"]

case justify_days_basic
query:
  SELECT JUSTIFY_DAYS(INTERVAL 35 DAY) AS a, JUSTIFY_DAYS(INTERVAL -35 DAY) AS b, JUSTIFY_DAYS(INTERVAL 30 DAY) AS c, JUSTIFY_DAYS(INTERVAL 29 DAY) AS d
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL, d INTERVAL
  ["P1M5D","P-1M-5D","P1M","P29D"]

case justify_days_mixed_sign
query:
  SELECT JUSTIFY_DAYS(MAKE_INTERVAL(month => 1, day => -1)) AS a, JUSTIFY_DAYS(MAKE_INTERVAL(month => -1, day => 1)) AS b, JUSTIFY_DAYS(MAKE_INTERVAL(month => 2, day => -65)) AS c, JUSTIFY_DAYS(MAKE_INTERVAL(month => -2, day => 65)) AS d
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL, d INTERVAL
  ["P29D","P-29D","P-5D","P5D"]

case justify_days_keeps_time
query:
  SELECT JUSTIFY_DAYS(MAKE_INTERVAL(day => 400, hour => 30)) AS a
expect:
  columns: a INTERVAL
  ["P1Y1M10DT30H"]

case justify_days_overflow
query:
  SELECT JUSTIFY_DAYS(MAKE_INTERVAL(10000, 0, 3000000)) AS a
expect:
  error: OUT_OF_RANGE
  message: Interval field months '220000' is out of range -120000 to 120000

case justify_days_null
query:
  SELECT JUSTIFY_DAYS(CAST(NULL AS INTERVAL)) AS a, JUSTIFY_HOURS(CAST(NULL AS INTERVAL)) AS b, JUSTIFY_INTERVAL(CAST(NULL AS INTERVAL)) AS c
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL
  [null,null,null]

case justify_hours_basic
query:
  SELECT JUSTIFY_HOURS(INTERVAL 25 HOUR) AS a, JUSTIFY_HOURS(INTERVAL -25 HOUR) AS b, JUSTIFY_HOURS(INTERVAL 24 HOUR) AS c, JUSTIFY_HOURS(INTERVAL 1440 MINUTE) AS d
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL, d INTERVAL
  ["P1DT1H","P-1DT-1H","P1D","P1D"]

case justify_hours_mixed_sign
query:
  SELECT JUSTIFY_HOURS(MAKE_INTERVAL(day => 1, hour => -1)) AS a, JUSTIFY_HOURS(MAKE_INTERVAL(day => -1, hour => 1)) AS b, JUSTIFY_HOURS(MAKE_INTERVAL(day => 2, hour => -50)) AS c, JUSTIFY_HOURS(MAKE_INTERVAL(day => -2, hour => 50)) AS d
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL, d INTERVAL
  ["PT23H","PT-23H","PT-2H","PT2H"]

case justify_hours_fraction
query:
  SELECT JUSTIFY_HOURS(INTERVAL '100:30:15.123456789' HOUR TO SECOND) AS a, JUSTIFY_HOURS(INTERVAL '-100:30:15.5' HOUR TO SECOND) AS b
expect:
  columns: a INTERVAL, b INTERVAL
  ["P4DT4H30M15.123456789S","P-4DT-4H-30M-15.5S"]

case justify_hours_keeps_months
query:
  SELECT JUSTIFY_HOURS(MAKE_INTERVAL(month => 40, day => 45, hour => 49)) AS a
expect:
  columns: a INTERVAL
  ["P3Y4M47DT1H"]

case justify_hours_overflow
query:
  SELECT JUSTIFY_HOURS(MAKE_INTERVAL(0, 0, 3660000, 48)) AS a
expect:
  error: OUT_OF_RANGE
  message: Interval field days '3660002' is out of range -3660000 to 3660000

case justify_interval_basic
query:
  SELECT JUSTIFY_INTERVAL(MAKE_INTERVAL(day => 29, hour => 49)) AS a, JUSTIFY_INTERVAL(MAKE_INTERVAL(day => -29, hour => -49)) AS b, JUSTIFY_INTERVAL(MAKE_INTERVAL(month => 1, hour => -1)) AS c, JUSTIFY_INTERVAL(MAKE_INTERVAL(month => -1, hour => 1)) AS d
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL, d INTERVAL
  ["P1M1DT1H","P-1M-1DT-1H","P29DT23H","P-29DT-23H"]

case justify_interval_mixed
query:
  SELECT JUSTIFY_INTERVAL(MAKE_INTERVAL(1, -13, 31, -25, 61, -61)) AS a, JUSTIFY_INTERVAL(MAKE_INTERVAL(-1, 13, -31, 25, -61, 61)) AS b, JUSTIFY_INTERVAL(MAKE_INTERVAL(month => 1, day => -30, hour => -1)) AS c
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL
  ["PT-1S","PT1S","PT-1H"]

case justify_interval_zero
query:
  SELECT JUSTIFY_INTERVAL(MAKE_INTERVAL()) AS a, JUSTIFY_DAYS(MAKE_INTERVAL()) AS b, JUSTIFY_HOURS(MAKE_INTERVAL()) AS c
expect:
  columns: a INTERVAL, b INTERVAL, c INTERVAL
  ["P0Y","P0Y","P0Y"]

case justify_interval_large
query:
  SELECT JUSTIFY_INTERVAL(MAKE_INTERVAL(second => 315576000000)) AS a
expect:
  error: OUT_OF_RANGE
  message: Interval field months '121750' is out of range -120000 to 120000

case justify_interval_overflow
query:
  SELECT JUSTIFY_INTERVAL(MAKE_INTERVAL(10000, 0, 0, 1000)) AS a
expect:
  error: OUT_OF_RANGE
  message: Interval field months '120001' is out of range -120000 to 120000

case justify_interval_safe
query:
  SELECT SAFE.JUSTIFY_INTERVAL(MAKE_INTERVAL(10000, 0, 0, 1000)) AS a
expect:
  columns: a INTERVAL
  [null]

case justify_bad_arg
query:
  SELECT JUSTIFY_DAYS(5) AS a
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function JUSTIFY_DAYS Argument types: INT64 Signature: JUSTIFY_DAYS(INTERVAL) Argument 1: Unable to coerce type INT64 to expected type INTERVAL [at 1:8]

case justify_from_string_cast
query:
  SELECT JUSTIFY_INTERVAL(CAST('P1Y14M45DT50H' AS INTERVAL)) AS a, JUSTIFY_HOURS(CAST('PT-49H' AS INTERVAL)) AS b
expect:
  columns: a INTERVAL, b INTERVAL
  ["P2Y3M17DT2H","P-2DT-1H"]
