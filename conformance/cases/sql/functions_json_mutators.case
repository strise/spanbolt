query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[1]', [7, 8], insert_each_element => false)
expect:
  columns: JSON
  ["[1,[7,8],3]"]

case jm_073
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[1]', [7, 8], insert_each_element => CAST(NULL AS BOOL))
expect:
  columns: JSON
