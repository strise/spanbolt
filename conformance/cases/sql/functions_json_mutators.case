expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not a boolean

case jm_119
query:
  SELECT BOOL_ARRAY(JSON '[1]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not a boolean

