query:
  SELECT JSON_ARRAY_INSERT(JSON '[1]', CAST(NULL AS STRING), 2)
expect:
  columns: JSON
  ["[1]"]

case jm_085
query:
  SELECT JSON_ARRAY_INSERT(JSON '{"a": [1]}', '$.a.0', 2)
expect:
  columns: JSON
  ["{\"a\":[1]}"]

case jm_086
query:
  SELECT JSON_CONTAINS(JSON '{"a": [1, 2]}', JSON '{"a": [2]}')
expect:
  columns: BOOL
  [true]

case jm_087
query:
  SELECT JSON_CONTAINS(JSON '{"a": 1, "b": 2}', JSON '{"a": 1}')
expect:
  columns: BOOL
  [true]

case jm_088
query:
  SELECT JSON_CONTAINS(JSON '{"a": 1}', JSON '{"a": 1, "b": 2}')
expect:
  columns: BOOL
  [false]

case jm_089
query:
  SELECT JSON_CONTAINS(JSON '{"a": {"b": 1, "c": 2}}', JSON '{"a": {"b": 1}}')
expect:
  columns: BOOL
  [true]

case jm_090
query:
  SELECT JSON_CONTAINS(JSON '{"a": 1}', JSON '{}')
expect:
  columns: BOOL
  [true]

case jm_091
query:
  SELECT JSON_CONTAINS(JSON '[1, 2, 3]', JSON '[]')
expect:
  columns: BOOL
  [true]

case jm_092
query:
  SELECT JSON_CONTAINS(JSON '[1, 2, 3]', JSON '[3, 1]')
expect:
  columns: BOOL
  [true]

