case jm_116
query:
  SELECT BOOL_ARRAY(JSON '[true, false]')
expect:
  columns: ARRAY<BOOL>
  [[true,false]]

case jm_117
query:
  SELECT BOOL_ARRAY(JSON '[]')
expect:
  columns: ARRAY<BOOL>
  [[]]

case jm_118
query:
