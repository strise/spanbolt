query:
  SELECT JSON_CONTAINS(JSON '[1, [2, 3]]', JSON '[[2]]')
expect:
  columns: BOOL
  [true]

case jm_097
query:
  SELECT JSON_CONTAINS(JSON '[[1, 2, 3]]', JSON '[[1, 2]]')
expect:
  columns: BOOL
  [true]

