case set_column
query:
  SELECT Id, JSON_SET(Data, '$.b.d', Id) FROM Docs ORDER BY Id
expect:
  columns: Id INT64, JSON
  ["1","{\"a\":[1,2],\"b\":{\"c\":true,\"d\":1}}"]
  ["2","{\"a\":1,\"b\":{\"d\":2}}"]
  ["3",null]

case set_param
query:
  SELECT Id, JSON_SET(Data, @p, @v) FROM Docs ORDER BY Id
params:
  @p STRING = "$.a[3]"
  @v STRING = "z"
expect:
  columns: Id INT64, JSON
  ["1","{\"a\":[1,2,null,\"z\"],\"b\":{\"c\":true}}"]
  ["2","{\"a\":1}"]
  ["3",null]

case append_column
query:
  SELECT Id, JSON_ARRAY_APPEND(Data, '$.a', Tags) FROM Docs ORDER BY Id
expect:
  columns: Id INT64, JSON
  ["1","{\"a\":[1,2,\"x\",\"y\"],\"b\":{\"c\":true}}"]
  ["2","{\"a\":1}"]
  ["3",null]

case insert_column
query:
  SELECT Id, JSON_ARRAY_INSERT(Data, '$.a[0]', Id) FROM Docs ORDER BY Id
expect:
  columns: Id INT64, JSON
  ["1","{\"a\":[1,1,2],\"b\":{\"c\":true}}"]
  ["2","{\"a\":1}"]
  ["3",null]

case contains_where
query:
  SELECT Id FROM Docs WHERE JSON_CONTAINS(Data, JSON '{"a": [2]}') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]

case contains_param
query:
  SELECT Id, JSON_CONTAINS(Data, @c) FROM Docs ORDER BY Id
params:
  @c JSON = "{\"b\": {}}"
expect:
  columns: Id INT64, BOOL
  ["1",true]
  ["2",false]
  ["3",null]

case bool_array_column
query:
  SELECT Id, BOOL_ARRAY(JSON_QUERY(Data, '$.x')) FROM Docs ORDER BY Id
expect:
  columns: Id INT64, ARRAY<BOOL>
  ["1",null]
  ["2",null]
  ["3",null]

case dml_set
dml:
  UPDATE Docs SET Data = JSON_SET(Data, '$.n', 1) WHERE Id = 2 THEN RETURN Id, Data
expect:
  count: 1
  columns: Id INT64, Data JSON
  ["2","{\"a\":1,\"n\":1}"]

case edge_insert_bad_path
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1]', '$[-1]', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: [-1]

case edge_insert_no_dollar
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1]', 'x', 2)
expect:
  error: OUT_OF_RANGE
  message: JSONPath must start with '$'

case edge_append_bad_token
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$..a', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid token in JSONPath at: ..a

case edge_set_leading_zero
query:
  SELECT JSON_SET(JSON '[1, 2]', '$[01]', 9)
expect:
  columns: JSON
  ["[1,9]"]

case edge_set_space_index
query:
  SELECT JSON_SET(JSON '[1, 2]', '$[ 1 ]', 9)
expect:
  columns: JSON
  ["[1,9]"]

case edge_set_wildcard
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.*', 9)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: .*

case edge_set_empty_quoted
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.""', 9)
expect:
  columns: JSON
  ["{\"\":9,\"a\":1}"]

case edge_contains_big
query:
  SELECT JSON_CONTAINS(JSON '[18446744073709551615]', JSON '18446744073709551615'), JSON_CONTAINS(JSON '9007199254740993', JSON '9007199254740992')
expect:
  columns: BOOL, BOOL
  [true,false]

case edge_set_nan
query:
  SELECT JSON_SET(JSON '{}', '$.a', CAST('NaN' AS FLOAT64))
expect:
  columns: JSON
  ["{\"a\":\"NaN\"}"]

case edge_remove_bad_token
query:
  SELECT JSON_REMOVE(JSON '{"a": 1}', '$[-1]')
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_REMOVE: Invalid token in JSONPath at: [-1]

case edge_insert_null_pad_empty
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1]', '$[3]', ARRAY<INT64>[])
expect:
  columns: JSON
  ["[1,null,null,null]"]

case edge_float32_array_wide_null
query:
  SELECT FLOAT32_ARRAY(JSON '[1]', wide_number_mode => CAST(NULL AS STRING)), FLOAT32(JSON '1', wide_number_mode => CAST(NULL AS STRING))
expect:
  columns: ARRAY<FLOAT32>, FLOAT32
  [null,null]

case edge_set_where_param_path
query:
  SELECT Id FROM Docs WHERE JSON_CONTAINS(JSON_SET(Data, '$.z', 1), JSON '{"z": 1}') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]

case edge_path_chars
query:
  SELECT JSON_SET(JSON '{}', '$.a-b', 1), JSON_SET(JSON '{}', '$.a b', 1), JSON_SET(JSON '{}', '$.ø', 1), JSON_SET(JSON '{}', '$.a$', 1)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: $

case edge_path_star_mid
query:
  SELECT JSON_SET(JSON '{}', '$.a*', 1)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: *

case edge_path_quote_in_key
query:
  SELECT JSON_SET(JSON '{}', '$.a"b', 1)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: "b

case edge_path_bracket_quoted
query:
  SELECT JSON_SET(JSON '{}', '$["a"]', 1)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: ["a"]

case edge_path_trailing_dot
query:
  SELECT JSON_SET(JSON '{}', '$.a.', 1)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: .

case edge_remove_dotdot
query:
  SELECT JSON_REMOVE(JSON '{"a": 1}', '$..a')
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_REMOVE: Invalid token in JSONPath at: ..a

case edge_remove_key_on_array
query:
  SELECT JSON_REMOVE(JSON '[1, 2]', '$.0')
expect:
  columns: JSON
  ["[1,2]"]

case edge_insert_null_empty
query:
  SELECT JSON_ARRAY_INSERT(JSON '{"a": null}', '$.a[2]', ARRAY<INT64>[])
expect:
  columns: JSON
  ["{\"a\":[null,null,null]}"]

case edge_append_null_empty
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": null}', '$.a', ARRAY<INT64>[])
expect:
  columns: JSON
  ["{\"a\":[]}"]
