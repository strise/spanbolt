# JSON mutators, JSON_CONTAINS, and JSON-to-array/FLOAT32 conversions.
tags: sql function json
schema:
  CREATE TABLE Docs (Id INT64 NOT NULL, Data JSON, Tags ARRAY<STRING(MAX)>) PRIMARY KEY (Id)
insert Docs cols=Id,Data,Tags:
  [1, "{\"a\": [1, 2], \"b\": {\"c\": true}}", ["x", "y"]]
  [2, "{\"a\": 1}", []]
  [3, null, null]

case jm_001
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":2}"]

case jm_002
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$', 2)
expect:
  columns: JSON
  ["2"]

case jm_003
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b.c.d', 2)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":{\"c\":{\"d\":2}}}"]

case jm_004
query:
  SELECT JSON_SET(JSON '{"a": null}', '$.a.b', 2)
expect:
  columns: JSON
  ["{\"a\":{\"b\":2}}"]

case jm_005
query:
  SELECT JSON_SET(JSON '{"a": null}', '$.a[1]', 2)
expect:
  columns: JSON
  ["{\"a\":[null,2]}"]

case jm_006
query:
  SELECT JSON_SET(JSON 'null', '$.a', 2)
expect:
  columns: JSON
  ["{\"a\":2}"]

case jm_007
query:
  SELECT JSON_SET(JSON 'null', '$[2]', 2)
expect:
  columns: JSON
  ["[null,null,2]"]

case jm_008
query:
  SELECT JSON_SET(JSON '[1, 2]', '$.a', 2)
expect:
  columns: JSON
  ["[1,2]"]

case jm_009
query:
  SELECT JSON_SET(JSON '[1, 2]', '$[0]', 'x')
expect:
  columns: JSON
  ["[\"x\",2]"]

case jm_010
query:
  SELECT JSON_SET(JSON '[1, 2]', '$[5]', 'x')
expect:
  columns: JSON
  ["[1,2,null,null,null,\"x\"]"]

case jm_011
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$[0]', 2)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_012
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2, '$.c', 3)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":2,\"c\":3}"]

case jm_013
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2, '$.b.c', 3)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":2}"]

case jm_014
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', [1, 2])
expect:
  columns: JSON
  ["{\"a\":1,\"b\":[1,2]}"]

case jm_015
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', STRUCT(1 AS x, 'y' AS z))
expect:
  columns: JSON
  ["{\"a\":1,\"b\":{\"x\":1,\"z\":\"y\"}}"]

case jm_016
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', JSON '{"c": [true]}')
expect:
  columns: JSON
  ["{\"a\":1,\"b\":{\"c\":[true]}}"]

case jm_017
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', NULL)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":null}"]

case jm_018
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', CAST(NULL AS STRING))
expect:
  columns: JSON
  ["{\"a\":1,\"b\":null}"]

case jm_019
query:
  SELECT JSON_SET(CAST(NULL AS JSON), '$.b', 2)
expect:
  columns: JSON
  [null]

case jm_020
query:
  SELECT JSON_SET(JSON '{"a": 1}', CAST(NULL AS STRING), 2)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_021
query:
  SELECT JSON_SET(JSON '{"a": 1}', 'b', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: JSONPath must start with '$'

case jm_022
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2, create_if_missing => false)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_023
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.a', 5, create_if_missing => false)
expect:
  columns: JSON
  ["{\"a\":5}"]

case jm_024
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2, create_if_missing => CAST(NULL AS BOOL))
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_025
query:
  SELECT JSON_SET(JSON '{"a": [1, 2]}', '$.a[1]', 9, create_if_missing => false)
expect:
  columns: JSON
  ["{\"a\":[1,9]}"]

case jm_026
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 1.5)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":1.5}"]

case jm_027
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 1e300 * 10)
expect:
  columns: JSON
  ["{\"a\":1,\"b\":1e+301}"]

case jm_028
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', NUMERIC '1.25')
expect:
  columns: JSON
  ["{\"a\":1,\"b\":1.25}"]

case jm_029
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', DATE '2024-01-02')
expect:
  columns: JSON
  ["{\"a\":1,\"b\":\"2024-01-02\"}"]

case jm_030
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', b'ab')
expect:
  columns: JSON
  ["{\"a\":1,\"b\":\"YWI=\"}"]

case jm_031
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$."x.y"', 2)
expect:
  columns: JSON
  ["{\"a\":1,\"x.y\":2}"]

case jm_032
query:
  SELECT JSON_SET(JSON '{"a": {"b": {"c": 1}}}', '$.a.b.c', 2)
expect:
  columns: JSON
  ["{\"a\":{\"b\":{\"c\":2}}}"]

case jm_033
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.a[0]', 2)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_034
query:
  SELECT JSON_SET(JSON '[]', '$[0][1]', 2)
expect:
  columns: JSON
  ["[[null,2]]"]

case jm_035
query:
  SELECT JSON_SET(JSON '{"b": 1, "a": 2}', '$.c', 3)
expect:
  columns: JSON
  ["{\"a\":2,\"b\":1,\"c\":3}"]

case jm_036
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function JSON_SET Argument types: JSON, STRING Signature: JSON_SET(JSON, STRING, ANY, [[STRING, ANY], ...], [create_if_missing => BOOL]) Signature requires at least 3 arguments, found 2 arguments [at 1:8]

case jm_037
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$.b', 2, '$.c')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function JSON_SET Argument types: JSON, STRING, INT64, STRING Signature: JSON_SET(JSON, STRING, ANY, [[STRING, ANY], ...], [create_if_missing => BOOL]) Positional argument at 4 is invalid because argument `create_if_missing` can only be referred to by name [at 1:8]

case jm_038
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$[-1]', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: [-1]

case jm_039
query:
  SELECT JSON_SET(JSON '[1]', '$[-1]', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: [-1]

case jm_040
query:
  SELECT JSON_SET(JSON '[1]', '$.0', 2)
expect:
  columns: JSON
  ["[1]"]

case jm_041
query:
  SELECT JSON_SET(JSON '[1]', '$.1', 2)
expect:
  columns: JSON
  ["[1]"]

case jm_042
query:
  SELECT JSON_SET(JSON '{"a": 1}', '$..a', 2)
expect:
  error: OUT_OF_RANGE
  message: Invalid input to JSON_SET: Invalid token in JSONPath at: ..a

case jm_043
query:
  SELECT JSON_REMOVE(JSON '{"a": 1, "b": {"c": 2}}', '$.b.c', '$.a')
expect:
  columns: JSON
  ["{\"b\":{}}"]

case jm_044
query:
  SELECT JSON_REMOVE(JSON '{"a": 1}', '$.x')
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_045
query:
  SELECT JSON_REMOVE(JSON '[1, 2, 3]', '$[7]')
expect:
  columns: JSON
  ["[1,2,3]"]

case jm_046
query:
  SELECT JSON_REMOVE(JSON '[1, 2, 3]', '$[0]', '$[0]')
expect:
  columns: JSON
  ["[3]"]

case jm_047
query:
  SELECT JSON_REMOVE(JSON '{"a": 1}', CAST(NULL AS STRING))
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_048
query:
  SELECT JSON_REMOVE(JSON '{"a": 1}', '$.a', CAST(NULL AS STRING))
expect:
  columns: JSON
  ["{}"]

case jm_049
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', 2)
expect:
  columns: JSON
  ["[1,2]"]

case jm_050
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', [2, 3])
expect:
  columns: JSON
  ["[1,2,3]"]

case jm_051
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', [2, 3], append_each_element => false)
expect:
  columns: JSON
  ["[1,[2,3]]"]

case jm_052
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', [2, 3], append_each_element => CAST(NULL AS BOOL))
expect:
  columns: JSON
  ["[1]"]

case jm_053
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": [1]}', '$.a', 'x', '$.a', 'y')
expect:
  columns: JSON
  ["{\"a\":[1,\"x\",\"y\"]}"]

case jm_054
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": 1}', '$.a', 2)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_055
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": null}', '$.a', 2)
expect:
  columns: JSON
  ["{\"a\":[2]}"]

case jm_056
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": 1}', '$.b', 2)
expect:
  columns: JSON
  ["{\"a\":1}"]

case jm_057
query:
  SELECT JSON_ARRAY_APPEND(JSON '{"a": {}}', '$.a', 2)
expect:
  columns: JSON
  ["{\"a\":{}}"]

case jm_058
query:
  SELECT JSON_ARRAY_APPEND(JSON 'null', '$', 2)
expect:
  columns: JSON
  ["[2]"]

case jm_059
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', NULL)
expect:
  columns: JSON
  ["[1,null]"]

case jm_060
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', CAST(NULL AS ARRAY<INT64>))
expect:
  columns: JSON
  ["[1]"]

case jm_061
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', ARRAY<INT64>[])
expect:
  columns: JSON
  ["[1]"]

case jm_062
query:
  SELECT JSON_ARRAY_APPEND(JSON '[[1], 2]', '$[0]', 3)
expect:
  columns: JSON
  ["[[1,3],2]"]

case jm_063
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', CAST(NULL AS STRING), 2)
expect:
  columns: JSON
  ["[1]"]

case jm_064
query:
  SELECT JSON_ARRAY_APPEND(CAST(NULL AS JSON), '$', 2)
expect:
  columns: JSON
  [null]

case jm_065
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', 'x', 2)
expect:
  error: OUT_OF_RANGE
  message: JSONPath must start with '$'

case jm_066
query:
  SELECT JSON_ARRAY_APPEND(JSON '[1]', '$', JSON '[2, 3]')
expect:
  columns: JSON
  ["[1,[2,3]]"]

case jm_067
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[1]', 2)
expect:
  columns: JSON
  ["[1,2,3]"]

case jm_068
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[0]', 0)
expect:
  columns: JSON
  ["[0,1,3]"]

case jm_069
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[2]', 4)
expect:
  columns: JSON
  ["[1,3,4]"]

case jm_070
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[5]', 4)
expect:
  columns: JSON
  ["[1,3,null,null,null,4]"]

case jm_071
query:
  SELECT JSON_ARRAY_INSERT(JSON '[1, 3]', '$[1]', [7, 8])
expect:
  columns: JSON
  ["[1,7,8,3]"]

