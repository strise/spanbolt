case jm_124
query:
  SELECT INT64_ARRAY(JSON '[1, -2, 3.0, 1e2]')
expect:
  columns: ARRAY<INT64>
  [["1","-2","3","100"]]

case jm_125
query:
  SELECT INT64_ARRAY(JSON '[1.5]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON number: 1.5 cannot be converted to an int64

case jm_126
query:
  SELECT INT64_ARRAY(JSON '[9223372036854775808]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not an integer

case jm_127
query:
  SELECT INT64_ARRAY(JSON '["1"]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not an integer

case jm_128
query:
  SELECT INT64_ARRAY(JSON '[null]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not an integer

case jm_129
query:
  SELECT INT64_ARRAY(JSON '1')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not an array

case jm_130
query:
  SELECT INT64_ARRAY(JSON '[]')
expect:
  columns: ARRAY<INT64>
  [[]]

case jm_131
query:
  SELECT FLOAT64_ARRAY(JSON '[1, 2.5, -1e300]')
expect:
  columns: ARRAY<FLOAT64>
  [[1.0,2.5,-1e+300]]

case jm_132
query:
  SELECT FLOAT64_ARRAY(JSON '["NaN", "Infinity", "-Infinity"]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not a number

case jm_133
query:
  SELECT FLOAT64_ARRAY(JSON '["1.5"]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not a number

case jm_134
query:
  SELECT FLOAT64_ARRAY(JSON '[18446744073709551615]')
expect:
  columns: ARRAY<FLOAT64>
  [[1.8446744073709552e+19]]

case jm_135
query:
  SELECT FLOAT64_ARRAY(JSON '[18446744073709551615]', wide_number_mode => 'exact')
expect:
  error: OUT_OF_RANGE
  message: JSON number: 18446744073709551615 cannot be converted to FLOAT64 without loss of precision

case jm_136
query:
  SELECT FLOAT64_ARRAY(JSON '[18446744073709551615]', wide_number_mode => 'round')
expect:
  columns: ARRAY<FLOAT64>
  [[1.8446744073709552e+19]]

case jm_137
query:
  SELECT FLOAT64_ARRAY(JSON '[1]', wide_number_mode => 'foo')
expect:
  error: OUT_OF_RANGE
  message: Invalid `wide_number_mode` specified: foo

case jm_138
query:
  SELECT FLOAT64_ARRAY(JSON '[true]')
expect:
  error: OUT_OF_RANGE
  message: The provided JSON input is not a number

