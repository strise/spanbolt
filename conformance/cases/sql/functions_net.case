case public_suffix_lowercase_odd
query:
  SELECT x, NET.PUBLIC_SUFFIX(x) AS s, NET.REG_DOMAIN(x) AS d FROM UNNEST(['a..com', '-a.com', 'a-.com', 'ab--c.com', 'a_b.com', 'a b.com', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com', 'www.ck.', 'co.uk.', '*.ck', '!www.ck', 'a.*.ck', 'x.y.z']) AS x
expect:
  columns: x STRING, s STRING, d STRING
  ["ab--c.com","com","ab--c.com"]
  ["www.ck.","ck.","www.ck."]
  ["a.*.ck","*.ck","a.*.ck"]
  ["a-.com","com","a-.com"]
  ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com","com","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com"]
  ["!www.ck","!www.ck",null]
  ["-a.com","com","-a.com"]
  ["a b.com","com","a b.com"]
  ["*.ck","*.ck",null]
  ["a..com","com",null]
  ["a_b.com","com","a_b.com"]
  ["co.uk.","co.uk.",null]
  ["x.y.z",null,null]

case public_suffix_null
query:
  SELECT NET.PUBLIC_SUFFIX(CAST(NULL AS STRING)) AS a, NET.REG_DOMAIN(CAST(NULL AS STRING)) AS b, NET.HOST(CAST(NULL AS STRING)) AS c
expect:
  columns: a STRING, b STRING, c STRING
  [null,null,null]

case net_bad_arg_type
query:
  SELECT NET.HOST(5) AS a
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function NET.HOST Argument types: INT64 Signature: NET.HOST(STRING) Argument 1: Unable to coerce type INT64 to expected type STRING [at 1:8]

case net_unknown_function
query:
  SELECT NET.FORMAT_IP(5) AS a
expect:
  error: INVALID_ARGUMENT
  message: Function not found: NET.FORMAT_IP [at 1:8]

case net_ip_in_net_unsupported
query:
  SELECT NET.IP_IN_NET('10.1.2.3', '10.0.0.0/8') AS a
expect:
  error: INVALID_ARGUMENT
  message: Function not found: NET.IP_IN_NET [at 1:8]

