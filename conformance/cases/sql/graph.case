# Spanner Graph: property graph DDL, INFORMATION_SCHEMA.PROPERTY_GRAPHS and GQL queries. Each edge
# table here has one definition per base table: the emulator keeps only one of several.
tags: graph
schema:
  CREATE TABLE Person (Id STRING(MAX) NOT NULL, Name STRING(MAX), Country STRING(MAX)) PRIMARY KEY (Id);
  CREATE TABLE Company (Id STRING(MAX) NOT NULL, Name STRING(MAX), Bankrupt BOOL) PRIMARY KEY (Id);
  CREATE TABLE PersonOwns (Id STRING(MAX) NOT NULL, Src STRING(MAX), Dst STRING(MAX), Share FLOAT64, Active BOOL) PRIMARY KEY (Id);
  CREATE TABLE CompanyOwns (Id STRING(MAX) NOT NULL, Src STRING(MAX), Dst STRING(MAX), Share FLOAT64, Active BOOL) PRIMARY KEY (Id);
  CREATE PROPERTY GRAPH Ownership
    NODE TABLES (
      Person KEY (Id) LABEL Person PROPERTIES ALL COLUMNS LABEL Entity PROPERTIES (Id, Name),
      Company KEY (Id) LABEL Company PROPERTIES ALL COLUMNS LABEL Entity PROPERTIES (Id, Name)
    )
    EDGE TABLES (
      PersonOwns KEY (Id) SOURCE KEY (Src) REFERENCES Person (Id) DESTINATION KEY (Dst) REFERENCES Company (Id) LABEL Owns PROPERTIES ALL COLUMNS,
      CompanyOwns KEY (Id) SOURCE KEY (Src) REFERENCES Company (Id) DESTINATION KEY (Dst) REFERENCES Company (Id) LABEL Owns PROPERTIES ALL COLUMNS
    )
insert Person cols=Id,Name,Country:
  ["p1", "Ola", "NO"]
  ["p2", "Kari", "SE"]
insert Company cols=Id,Name,Bankrupt:
  ["c1", "Nordvik AS", false]
  ["c2", "Holding AS", false]
  ["c3", "Top AS", false]
  ["c4", "Bankrupt AS", true]
insert PersonOwns cols=Id,Src,Dst,Share,Active:
  ["po1", "p1", "c1", 40.0, true]
  ["po2", "p2", "c3", 100.0, true]
  ["po9", "gone", "c1", 1.0, true]
insert CompanyOwns cols=Id,Src,Dst,Share,Active:
  ["co1", "c2", "c1", 60.0, true]
  ["co2", "c3", "c2", 100.0, true]
  ["co3", "c4", "c1", 10.0, false]

case property_graphs_listed
query:
  SELECT PROPERTY_GRAPH_CATALOG, PROPERTY_GRAPH_SCHEMA, PROPERTY_GRAPH_NAME FROM INFORMATION_SCHEMA.PROPERTY_GRAPHS
expect:
  columns: PROPERTY_GRAPH_CATALOG STRING, PROPERTY_GRAPH_SCHEMA STRING, PROPERTY_GRAPH_NAME STRING
  ["","","Ownership"]
expect@spanner:
  same

case property_graph_metadata
# Label order in the emulator's metadata follows a hash set, so labels are left out.
query:
  SELECT JSON_QUERY(PROPERTY_GRAPH_METADATA_JSON, '$.nodeTables') AS node_tables,
    JSON_QUERY(PROPERTY_GRAPH_METADATA_JSON, '$.edgeTables') AS edge_tables,
    JSON_QUERY(PROPERTY_GRAPH_METADATA_JSON, '$.propertyDeclarations') AS properties,
    JSON_VALUE(PROPERTY_GRAPH_METADATA_JSON, '$.name') AS name
  FROM INFORMATION_SCHEMA.PROPERTY_GRAPHS
expect:
  columns: node_tables JSON, edge_tables JSON, properties JSON, name STRING
  ["[{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"Company\",\"keyColumns\":[\"Id\"],\"kind\":\"NODE\",\"labelNames\":[\"Company\",\"Entity\"],\"name\":\"Company\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Name\",\"valueExpressionSql\":\"Name\"},{\"propertyDeclarationName\":\"Bankrupt\",\"valueExpressionSql\":\"Bankrupt\"}]},{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"Person\",\"keyColumns\":[\"Id\"],\"kind\":\"NODE\",\"labelNames\":[\"Person\",\"Entity\"],\"name\":\"Person\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Name\",\"valueExpressionSql\":\"Name\"},{\"propertyDeclarationName\":\"Country\",\"valueExpressionSql\":\"Country\"}]}]","[{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"CompanyOwns\",\"destinationNodeTable\":{\"edgeTableColumns\":[\"Dst\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"},\"keyColumns\":[\"Id\"],\"kind\":\"EDGE\",\"labelNames\":[\"Owns\"],\"name\":\"CompanyOwns\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Src\",\"valueExpressionSql\":\"Src\"},{\"propertyDeclarationName\":\"Dst\",\"valueExpressionSql\":\"Dst\"},{\"propertyDeclarationName\":\"Share\",\"valueExpressionSql\":\"Share\"},{\"propertyDeclarationName\":\"Active\",\"valueExpressionSql\":\"Active\"}],\"sourceNodeTable\":{\"edgeTableColumns\":[\"Src\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"}},{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"PersonOwns\",\"destinationNodeTable\":{\"edgeTableColumns\":[\"Dst\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"},\"keyColumns\":[\"Id\"],\"kind\":\"EDGE\",\"labelNames\":[\"Owns\"],\"name\":\"PersonOwns\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Src\",\"valueExpressionSql\":\"Src\"},{\"propertyDeclarationName\":\"Dst\",\"valueExpressionSql\":\"Dst\"},{\"propertyDeclarationName\":\"Share\",\"valueExpressionSql\":\"Share\"},{\"propertyDeclarationName\":\"Active\",\"valueExpressionSql\":\"Active\"}],\"sourceNodeTable\":{\"edgeTableColumns\":[\"Src\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Person\"}}]","[{\"name\":\"Id\",\"type\":\"STRING\"},{\"name\":\"Name\",\"type\":\"STRING\"},{\"name\":\"Country\",\"type\":\"STRING\"},{\"name\":\"Bankrupt\",\"type\":\"BOOL\"},{\"name\":\"Src\",\"type\":\"STRING\"},{\"name\":\"Dst\",\"type\":\"STRING\"},{\"name\":\"Share\",\"type\":\"FLOAT64\"},{\"name\":\"Active\",\"type\":\"BOOL\"}]","Ownership"]
expect@spanner:
  columns: node_tables JSON, edge_tables JSON, properties JSON, name STRING
  ["[{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"Company\",\"keyColumns\":[\"Id\"],\"kind\":\"NODE\",\"labelNames\":[\"Company\",\"Entity\"],\"name\":\"Company\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Bankrupt\",\"valueExpressionSql\":\"Bankrupt\"},{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Name\",\"valueExpressionSql\":\"Name\"}]},{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"Person\",\"keyColumns\":[\"Id\"],\"kind\":\"NODE\",\"labelNames\":[\"Entity\",\"Person\"],\"name\":\"Person\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Country\",\"valueExpressionSql\":\"Country\"},{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Name\",\"valueExpressionSql\":\"Name\"}]}]","[{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"CompanyOwns\",\"destinationNodeTable\":{\"edgeTableColumns\":[\"Dst\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"},\"keyColumns\":[\"Id\"],\"kind\":\"EDGE\",\"labelNames\":[\"Owns\"],\"name\":\"CompanyOwns\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Active\",\"valueExpressionSql\":\"Active\"},{\"propertyDeclarationName\":\"Dst\",\"valueExpressionSql\":\"Dst\"},{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Share\",\"valueExpressionSql\":\"Share\"},{\"propertyDeclarationName\":\"Src\",\"valueExpressionSql\":\"Src\"}],\"sourceNodeTable\":{\"edgeTableColumns\":[\"Src\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"}},{\"baseCatalogName\":\"\",\"baseSchemaName\":\"\",\"baseTableName\":\"PersonOwns\",\"destinationNodeTable\":{\"edgeTableColumns\":[\"Dst\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Company\"},\"keyColumns\":[\"Id\"],\"kind\":\"EDGE\",\"labelNames\":[\"Owns\"],\"name\":\"PersonOwns\",\"propertyDefinitions\":[{\"propertyDeclarationName\":\"Active\",\"valueExpressionSql\":\"Active\"},{\"propertyDeclarationName\":\"Dst\",\"valueExpressionSql\":\"Dst\"},{\"propertyDeclarationName\":\"Id\",\"valueExpressionSql\":\"Id\"},{\"propertyDeclarationName\":\"Share\",\"valueExpressionSql\":\"Share\"},{\"propertyDeclarationName\":\"Src\",\"valueExpressionSql\":\"Src\"}],\"sourceNodeTable\":{\"edgeTableColumns\":[\"Src\"],\"nodeTableColumns\":[\"Id\"],\"nodeTableName\":\"Person\"}}]","[{\"name\":\"Active\",\"type\":\"BOOL\"},{\"name\":\"Bankrupt\",\"type\":\"BOOL\"},{\"name\":\"Country\",\"type\":\"STRING\"},{\"name\":\"Dst\",\"type\":\"STRING\"},{\"name\":\"Id\",\"type\":\"STRING\"},{\"name\":\"Name\",\"type\":\"STRING\"},{\"name\":\"Share\",\"type\":\"FLOAT64\"},{\"name\":\"Src\",\"type\":\"STRING\"}]","Ownership"]

case match_node_filter_order_limit
# The emulator ignores ORDER BY before LIMIT in a GQL RETURN; the outer query orders instead.
query:
  SELECT id, name FROM GRAPH_TABLE(Ownership
    MATCH (c:Company WHERE c.Bankrupt = false)
    COLUMNS (c.Id AS id, c.Name AS name))
  ORDER BY name DESC
  LIMIT 2
expect:
  columns: id STRING, name STRING
  ["c3","Top AS"]
  ["c1","Nordvik AS"]
expect@spanner:
  same

case edge_properties_and_labels
query:
  GRAPH Ownership
  MATCH (o)-[e:Owns WHERE e.Active]->(c:Company WHERE c.Id = 'c1')
  RETURN o.Id AS owner, e.Share AS share, ARRAY_TO_STRING(ARRAY(SELECT l FROM UNNEST(LABELS(o)) l ORDER BY l), ',') AS labels
expect:
  columns: owner STRING, share FLOAT64, labels STRING
  ["p1",40.0,"Entity,Person"]
  ["c2",60.0,"Company,Entity"]
expect@spanner:
  same

case dangling_edges_do_not_match
query:
  GRAPH Ownership
  MATCH ()-[e:Owns]->(c WHERE c.Id = 'c1')
  RETURN e.Id AS edge
expect:
  columns: edge STRING
  ["co1"]
  ["po1"]
  ["co3"]
expect@spanner:
  same

case quantified_path
query:
  GRAPH Ownership
  MATCH (c:Company WHERE c.Id = 'c1')<-[e:Owns]-{1,3}(top)
  RETURN top.Id AS top, ARRAY_LENGTH(e) AS hops
expect:
  columns: top STRING, hops INT64
  ["c4","1"]
  ["p1","1"]
  ["c2","1"]
  ["p2","3"]
  ["c3","2"]
expect@spanner:
  same

case quantified_path_for_and_next
query:
  GRAPH Ownership
  MATCH (c:Company WHERE c.Id = 'c1')<-[e:Owns WHERE e.Active]-{1,6}(top)
  FOR x IN e
  RETURN DISTINCT x.Id AS edge_id
  NEXT
  MATCH (s)-[o:Owns]->(d:Company)
  WHERE o.Id = edge_id
  RETURN s.Id AS src, d.Id AS dst
expect:
  columns: src STRING, dst STRING
  ["p1","c1"]
  ["c2","c1"]
  ["p2","c3"]
  ["c3","c2"]
expect@spanner:
  same

case optional_match
query:
  GRAPH Ownership
  MATCH (c:Company WHERE c.Id IN ('c3', 'c4'))
  OPTIONAL MATCH (c)<-[:Owns]-(x)
  RETURN c.Id AS company, x.Id AS owner
expect:
  columns: company STRING, owner STRING
  ["c3","p2"]
  ["c4",null]
expect@spanner:
  same

case any_direction
query:
  GRAPH Ownership
  MATCH (c:Company WHERE c.Id = 'c2')-[o:Owns]-(x)
  RETURN x.Id AS other, o.Id AS edge
expect:
  columns: other STRING, edge STRING
  ["c3","co2"]
  ["c1","co1"]
expect@spanner:
  same

case paths_sharing_a_variable
query:
  GRAPH Ownership
  MATCH (a:Company)-[:Owns]->(b:Company), (b)-[:Owns]->(c:Company)
  WHERE a.Id != c.Id
  RETURN a.Id AS a, b.Id AS b, c.Id AS c
expect:
  columns: a STRING, b STRING, c STRING
  ["c3","c2","c1"]
expect@spanner:
  same

case filter_statement
query:
  GRAPH Ownership
  MATCH (c:Company)
  FILTER c.Bankrupt
  RETURN c.Id AS id
expect:
  columns: id STRING
  ["c4"]
expect@spanner:
  same

case label_shared_by_tables
query:
  GRAPH Ownership
  MATCH (n:Entity)
  RETURN COUNT(*) AS n
expect:
  columns: n INT64
  ["6"]
expect@spanner:
  same

case graph_table
query:
  SELECT owner, dst FROM GRAPH_TABLE(Ownership
    MATCH (a)-[o:Owns]->(b:Company WHERE b.Id = 'c1')
    COLUMNS (a.Id AS owner, b.Id AS dst))
  ORDER BY owner
expect:
  columns: owner STRING, dst STRING
  ["c2","c1"]
  ["c4","c1"]
  ["p1","c1"]
expect@spanner:
  same

case returning_a_node_is_rejected
query:
  GRAPH Ownership MATCH (c:Company) RETURN c
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:42]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_ELEMENT is not allowed [at 1:1]

case returning_a_node_with_a_property_is_rejected
query:
  GRAPH Ownership MATCH (c:Company) RETURN c.Id AS id, c
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:54]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_ELEMENT is not allowed [at 1:1]

case returning_a_path_is_rejected
query:
  GRAPH Ownership MATCH p = (c:Company) RETURN p
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:46]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_PATH is not allowed [at 1:1]

case returning_an_edge_from_a_linear_query_is_rejected
query:
  GRAPH Ownership MATCH (a)-[o:Owns]->(b) WHERE a.Id = 'c2' RETURN o NEXT RETURN o
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:80]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_ELEMENT is not allowed [at 1:1]

case returning_nodes_in_an_array_is_rejected
query:
  GRAPH Ownership MATCH (c:Company) RETURN ARRAY_AGG(c) AS a
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for aggregate function ARRAY_AGG Argument types: GRAPH_NODE(Ownership)<Bankrupt BOOL, Id STRING, Name STRING> Signature: ARRAY_AGG(T1) Argument 1: expected T1, found GRAPH_NODE(Ownership)<Bankrupt BOOL, Id STRING, Name STRING>: which is not allowed for ANY arguments [at 1:42]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_ELEMENT is not allowed [at 1:1]

case graph_table_without_columns
query:
  SELECT * FROM GRAPH_TABLE(Ownership MATCH (c:Company WHERE c.Id = 'c1'))
expect:
  error: INVALID_ARGUMENT
  message: Graph query without COLUMNS clause is not supported [at 1:15]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Returning expressions of type GRAPH_ELEMENT is not allowed [at 1:1]

case graph_table_column_of_a_node_is_rejected
query:
  SELECT 1 FROM GRAPH_TABLE(Ownership MATCH (c:Company) COLUMNS (c AS x))
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:64]
expect@spanner:
  columns: INT64
  ["1"]
  ["1"]
  ["1"]
  ["1"]

case node_as_a_function_argument
query:
  GRAPH Ownership MATCH (c:Company WHERE c.Id = 'c1') RETURN IF(true, c, c).Id AS id
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function IF Argument types: BOOL, GRAPH_NODE(Ownership)<Bankrupt BOOL, Id STRING, Name STRING>, GRAPH_NODE(Ownership)<Bankrupt BOOL, Id STRING, Name STRING> Signature: IF(BOOL, T1, T1) Argument 2: expected T1, found GRAPH_NODE(Ownership)<Bankrupt BOOL, Id STRING, Name STRING>: which is not allowed for ANY arguments [at 1:60]
expect@spanner:
  columns: id STRING
  ["c1"]

case node_property_read_outside_graph_table
query:
  SELECT x.Name FROM GRAPH_TABLE(Ownership MATCH (c:Company WHERE c.Id = 'c1') COLUMNS (c AS x))
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:87]
expect@spanner:
  columns: Name STRING
  ["Nordvik AS"]

case graph_table_without_columns_property
query:
  SELECT c.Name FROM GRAPH_TABLE(Ownership MATCH (c:Company WHERE c.Id = 'c1'))
expect:
  error: INVALID_ARGUMENT
  message: Graph query without COLUMNS clause is not supported [at 1:20]
expect@spanner:
  columns: Name STRING
  ["Nordvik AS"]

case graph_table_without_columns_counted
query:
  SELECT COUNT(*) AS n FROM GRAPH_TABLE(Ownership MATCH (c:Company))
expect:
  error: INVALID_ARGUMENT
  message: Graph query without COLUMNS clause is not supported [at 1:27]
expect@spanner:
  columns: n INT64
  ["4"]

case nodes_in_an_array_literal
query:
  GRAPH Ownership MATCH (c:Company WHERE c.Id = 'c1') RETURN ARRAY_LENGTH([c, c]) AS n
expect:
  error: INVALID_ARGUMENT
  message: Graph element typed expression is not allowed here [at 1:74]
expect@spanner:
  columns: n INT64
  ["2"]

case node_compared_in_a_subquery
query:
  SELECT (SELECT COUNT(*) FROM GRAPH_TABLE(Ownership MATCH (a:Company)-[:Owns]->(b:Company) WHERE a = b COLUMNS (a.Id AS id))) AS n
expect:
  columns: n INT64
  ["0"]
expect@spanner:
  same

case edge_property_read_outside_graph_table
query:
  SELECT x.Share FROM GRAPH_TABLE(Ownership MATCH (a)-[o:Owns]->(b) WHERE a.Id = 'c2' COLUMNS (o AS x))
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:94]
expect@spanner:
  columns: Share FLOAT64
  [60.0]

case grouped_by_a_node_outside_graph_table
query:
  SELECT COUNT(*) AS n FROM GRAPH_TABLE(Ownership MATCH (a)-[:Owns]->(b) COLUMNS (b AS x)) GROUP BY x
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:81]
expect@spanner:
  columns: n INT64
  ["3"]
  ["1"]
  ["1"]

case path_read_outside_graph_table
query:
  SELECT ARRAY_LENGTH(NODES(p)) AS n FROM GRAPH_TABLE(Ownership MATCH p = (a)-[:Owns]->(b) WHERE a.Id = 'c2' COLUMNS (p))
expect:
  error: INVALID_ARGUMENT
  message: Returning graph-typed column is not supported [at 1:117]
expect@spanner:
  columns: n INT64
  ["2"]

case graph_over_a_missing_table
ddl:
  CREATE PROPERTY GRAPH Broken NODE TABLES (Missing KEY (Id) LABEL X PROPERTIES ALL COLUMNS)
expect:
  error: INVALID_ARGUMENT
  message: Table not found: Missing [at 1:43]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Error analyzing the definition of graph `Broken`: Table not found: Missing [at 3:5]

case drop_property_graph
ddl:
  DROP PROPERTY GRAPH Ownership
query:
  SELECT PROPERTY_GRAPH_NAME FROM INFORMATION_SCHEMA.PROPERTY_GRAPHS
expect:
  columns: PROPERTY_GRAPH_NAME STRING
expect@spanner:
  same

# The emulator returns quantified_path's and optional_match's rows in a different order from run to
# run (they have no ORDER BY, so they compare as multisets, but re-recording reorders them). These
# variants order the rows in SQL around GRAPH_TABLE, as the emulator ignores some GQL ORDER BYs.
case quantified_path_ordered
query:
  SELECT top, hops FROM GRAPH_TABLE(Ownership
    MATCH (c:Company WHERE c.Id = 'c1')<-[e:Owns]-{1,3}(top)
    COLUMNS (top.Id AS top, ARRAY_LENGTH(e) AS hops))
  ORDER BY top, hops
expect:
  columns: top STRING, hops INT64
  ["c2","1"]
  ["c3","2"]
  ["c4","1"]
  ["p1","1"]
  ["p2","3"]
expect@spanner:
  same

case optional_match_ordered
query:
  SELECT company, owner FROM GRAPH_TABLE(Ownership
    MATCH (c:Company WHERE c.Id IN ('c3', 'c4'))
    OPTIONAL MATCH (c)<-[:Owns]-(x)
    RETURN c.Id AS company, x.Id AS owner)
  ORDER BY company
expect:
  columns: company STRING, owner STRING
  ["c3","p2"]
  ["c4",null]
expect@spanner:
  same
