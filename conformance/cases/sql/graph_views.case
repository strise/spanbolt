tags: sql graph oracle
# `expect:` is recorded from the emulator 1.5.59; `expect@spanner:` from real Spanner (spanbolt #40).

# GoogleCloudPlatform/cloud-spanner-emulator#325: a property graph whose element tables are views
# (the graph-with-views how-to). The emulator used to crash on it.
case property_graph_over_views
schema:
  CREATE TABLE Person (Id STRING(MAX) NOT NULL, Name STRING(MAX), Active BOOL) PRIMARY KEY (Id);
  CREATE TABLE Knows (Id STRING(MAX) NOT NULL, Src STRING(MAX), Dst STRING(MAX)) PRIMARY KEY (Id);
  CREATE VIEW ActivePerson SQL SECURITY INVOKER AS SELECT p.Id, p.Name FROM Person p WHERE p.Active;
  CREATE VIEW KnowsView SQL SECURITY INVOKER AS SELECT k.Id, k.Src, k.Dst FROM Knows k
insert Person cols=Id,Name,Active:
  ["p1", "Ola", true]
  ["p2", "Kari", true]
  ["p3", "Nils", false]
insert Knows cols=Id,Src,Dst:
  ["k1", "p1", "p2"]
  ["k2", "p2", "p3"]
ddl:
  CREATE PROPERTY GRAPH Social NODE TABLES (ActivePerson KEY (Id) LABEL Person PROPERTIES (Id, Name)) EDGE TABLES (KnowsView KEY (Id) SOURCE KEY (Src) REFERENCES ActivePerson (Id) DESTINATION KEY (Dst) REFERENCES ActivePerson (Id) LABEL Knows PROPERTIES (Id))
expect:
  ok
expect@spanner:
  same
query:
  GRAPH Social MATCH (a:Person)-[k:Knows]->(b:Person) RETURN a.Name AS a, b.Name AS b ORDER BY a
expect:
  columns: a STRING, b STRING
  ["Ola","Kari"]
expect@spanner:
  same
query:
  GRAPH Social MATCH (p:Person) RETURN p.Id AS id ORDER BY id
expect:
  columns: id STRING
  ["p2"]
  ["p1"]
expect@spanner:
  columns: id STRING
  ["p1"]
  ["p2"]

# Walking a graph over views: edges from a view anchored by key, both directions, and a quantified
# path. p3 is not active, so the edge k2 to it has no destination node.
case property_graph_over_views_paths
schema:
  CREATE TABLE Person (Id STRING(MAX) NOT NULL, Name STRING(MAX), Active BOOL) PRIMARY KEY (Id);
  CREATE TABLE Knows (Id STRING(MAX) NOT NULL, Src STRING(MAX), Dst STRING(MAX)) PRIMARY KEY (Id);
  CREATE VIEW ActivePerson SQL SECURITY INVOKER AS SELECT p.Name, p.Id FROM Person p WHERE p.Active;
  CREATE VIEW KnowsView SQL SECURITY INVOKER AS SELECT k.Id, k.Src, k.Dst FROM Knows k;
  CREATE PROPERTY GRAPH Social NODE TABLES (ActivePerson KEY (Id) LABEL Person PROPERTIES (Id, Name)) EDGE TABLES (KnowsView KEY (Id) SOURCE KEY (Src) REFERENCES ActivePerson (Id) DESTINATION KEY (Dst) REFERENCES ActivePerson (Id) LABEL Knows PROPERTIES (Id))
insert Person cols=Id,Name,Active:
  ["p1", "Ola", true]
  ["p2", "Kari", true]
  ["p3", "Nils", false]
  ["p4", "Per", true]
insert Knows cols=Id,Src,Dst:
  ["k1", "p1", "p2"]
  ["k2", "p2", "p3"]
  ["k3", "p2", "p4"]
  ["k4", "p4", "p1"]
query:
  SELECT other, edge FROM GRAPH_TABLE(Social
    MATCH (a:Person WHERE a.Id = 'p2')-[k:Knows]-(b)
    COLUMNS (b.Name AS other, k.Id AS edge))
  ORDER BY edge
expect:
  columns: other STRING, edge STRING
  ["Ola","k1"]
  ["Per","k3"]
expect@spanner:
  same
query:
  SELECT name, hops FROM GRAPH_TABLE(Social
    MATCH (a:Person WHERE a.Id = 'p1')-[k:Knows]->{1,3}(b)
    COLUMNS (b.Name AS name, ARRAY_LENGTH(k) AS hops))
  ORDER BY hops, name
expect:
  columns: name STRING, hops INT64
  ["Kari","1"]
  ["Per","2"]
  ["Ola","3"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS n FROM GRAPH_TABLE(Social MATCH (a)-[k:Knows]->(b) COLUMNS (k.Id AS id))
expect:
  columns: n INT64
  ["3"]
expect@spanner:
  same
