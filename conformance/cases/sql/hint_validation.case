case stmt_lock_scanned_ranges_bad_value
query:
  @{LOCK_SCANNED_RANGES=everything} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: LOCK_SCANNED_RANGES hint: "everything".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: everything hint: lock_scanned_ranges.

case stmt_enhance_query_timeout_string
query:
  @{ENHANCE_QUERY_TIMEOUT_MS='soon'} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: ENHANCE_QUERY_TIMEOUT_MS hint: "soon".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: enhance_query_timeout_ms.

case stmt_use_additional_parallelism_string
query:
  @{USE_ADDITIONAL_PARALLELISM='yes'} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: USE_ADDITIONAL_PARALLELISM hint: "yes".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: use_additional_parallelism.

case duplicate_hint
query:
  SELECT K FROM T@{SCAN_METHOD=ROW, SCAN_METHOD=BATCH} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Multiple values for hint: SCAN_METHOD
expect@spanner:
  error: INVALID_ARGUMENT
  message: Providing the same hint multiple times is not supported: scan_method.

case dml_optimizer_version
dml:
  @{OPTIMIZER_VERSION=6} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  count: 1

case dml_lock_scanned_ranges
dml:
  @{LOCK_SCANNED_RANGES=exclusive} DELETE FROM T WHERE K = 1
expect:
  count: 1
expect@spanner:
  same

case dml_lock_scanned_ranges_bad_value
dml:
  @{LOCK_SCANNED_RANGES=nope} DELETE FROM T WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: LOCK_SCANNED_RANGES hint: "nope".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: nope hint: lock_scanned_ranges.

case dml_insert_optimizer_version
dml:
  @{OPTIMIZER_VERSION=6} INSERT INTO U (K, X) VALUES (3, 300)
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  count: 1

