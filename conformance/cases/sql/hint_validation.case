dml:
  @{USE_ADDITIONAL_PARALLELISM=TRUE} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: USE_ADDITIONAL_PARALLELISM.
expect@spanner:
  same

case dml_pdml_max_parallelism_on_delete
dml:
  @{PDML_MAX_PARALLELISM=2} DELETE FROM T WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: PDML_MAX_PARALLELISM.
expect@spanner:
  count: 1

case dml_unknown_statement_hint
dml:
  @{NOPE_HINT=1} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: NOPE_HINT.
expect@spanner:
  same

case delete_force_index
dml:
  DELETE FROM T@{FORCE_INDEX=TByV} WHERE V = 'a'
expect:
  count: 2
expect@spanner:
  same

case delete_force_index_unknown
dml:
  DELETE FROM T@{FORCE_INDEX=Nope} WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: The table does not have a secondary index called Nope
expect@spanner:
  error: INVALID_ARGUMENT
  message: The table T does not have an index called Nope

case update_force_index_unknown
dml:
  UPDATE T@{FORCE_INDEX=Nope} SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: The table does not have a secondary index called Nope
expect@spanner:
  error: INVALID_ARGUMENT
  message: The table T does not have an index called Nope

case update_force_index
dml:
  UPDATE T@{FORCE_INDEX=TByV} SET W = 11 WHERE V = 'b'
expect:
  count: 1
expect@spanner:
  same

case delete_unknown_table_hint
dml:
  DELETE FROM T@{NOPE_HINT=1} WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: NOPE_HINT.
expect@spanner:
  same

case delete_scan_method_bad_value
dml:
  DELETE FROM T@{SCAN_METHOD=COLUMNAR} WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: SCAN_METHOD hint: "COLUMNAR".
expect@spanner:
  count: 1

case ignore_unknown_hints_query
query:
  @{spanner_emulator.ignore_unknown_hints=true} SELECT K FROM T@{SOME_NEW_HINT=1} ORDER BY K
expect:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SOME_NEW_HINT.

case ignore_unknown_hints_statement
query:
  @{spanner_emulator.ignore_unknown_hints=true, SOME_NEW_HINT=1} SELECT K FROM T ORDER BY K
expect:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SOME_NEW_HINT.

case ignore_unknown_hints_join
query:
  @{spanner_emulator.ignore_unknown_hints=true} SELECT T.K FROM T JOIN @{SOME_NEW_HINT=1} U ON T.K = U.K ORDER BY T.K
expect:
  columns: K INT64
  ["1"]
  ["2"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SOME_NEW_HINT.

case ignore_unknown_hints_emulator_hint
query:
  @{spanner_emulator.ignore_unknown_hints=true, spanner_emulator.some_new_hint=1} SELECT K FROM T ORDER BY K
expect:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]
expect@spanner:
  same

case ignore_unknown_hints_false
query:
  @{spanner_emulator.ignore_unknown_hints=false} SELECT K FROM T@{SOME_NEW_HINT=1} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SOME_NEW_HINT.
expect@spanner:
  same

case ignore_unknown_hints_bad_value
query:
  @{spanner_emulator.ignore_unknown_hints=1} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for emulator-only hint spanner_emulator.ignore_unknown_hints: Literal(type=INT64, value=1) .
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case ignore_unknown_hints_still_checks_values
query:
  @{spanner_emulator.ignore_unknown_hints=true} SELECT K FROM T@{SCAN_METHOD=COLUMNAR} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: SCAN_METHOD hint: "COLUMNAR".
expect@spanner:
