expect:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]
expect@spanner:
  same

case table_force_index_int
query:
  SELECT K FROM T@{FORCE_INDEX=1} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: FORCE_INDEX hint: 1.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: force_index.

case stmt_force_index_base_table
query:
  @{FORCE_INDEX=_BASE_TABLE} SELECT K FROM T ORDER BY K
expect:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]
expect@spanner:
  same

case stmt_force_index_named
query:
  @{FORCE_INDEX=TByV} SELECT K FROM T WHERE V = 'a' ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid statement-level hint value: FORCE_INDEX="TByV".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Unsupported statement-level hint value: force_index=TByV.

case join_method_bad_value
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=SIDEWAYS_JOIN} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: JOIN_METHOD hint: "SIDEWAYS_JOIN".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid value for join_type/join_method hint: SIDEWAYS_JOIN.

case join_method_hash
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=HASH_JOIN, HASH_JOIN_BUILD_SIDE=BUILD_RIGHT} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: hash_join_build_side hint is only supported for HASH joins.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]

case join_build_side_without_hash_join
query:
  SELECT T.K FROM T JOIN @{HASH_JOIN_BUILD_SIDE=BUILD_LEFT} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: hash_join_build_side hint is only supported for HASH joins.
expect@spanner:
  same

case join_build_side_bad_value
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=HASH_JOIN, HASH_JOIN_BUILD_SIDE=MIDDLE} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: hash_join_build_side hint is only supported for HASH joins.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid value for hash_join_build_side hint: MIDDLE.

case join_force_join_order_int
query:
  SELECT T.K FROM T JOIN @{FORCE_JOIN_ORDER=1} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: FORCE_JOIN_ORDER hint: 1.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: force_join_order.

case join_hash_join_execution_bad_value
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=HASH_JOIN, HASH_JOIN_EXECUTION=THREE_PASS} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: HASH_JOIN_EXECUTION hint: "THREE_PASS".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid value for hash_join_execution hint: THREE_PASS.

case group_method_bad_value
query:
  SELECT V, COUNT(*) AS n FROM T GROUP @{GROUP_METHOD=SORT_GROUP} BY V ORDER BY V
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: GROUP_METHOD hint: "SORT_GROUP".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: group_type/group_method hint: SORT_GROUP.

