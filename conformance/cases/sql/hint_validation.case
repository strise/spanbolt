case dml_optimizer_version_string
skip: Cloud Spanner rejects a quoted OPTIMIZER_VERSION string but accepts the same text as an identifier; the resolved AST doesn't tell them apart
dml:
  @{OPTIMIZER_VERSION='latest_version'} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  error: INVALID_ARGUMENT
  message: The value of optimizer_version hint has to be latest or a positive int32 value

case dml_lock_scanned_ranges_int
dml:
  @{LOCK_SCANNED_RANGES=1} DELETE FROM T WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: LOCK_SCANNED_RANGES hint: 1.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: lock_scanned_ranges.

case query_pdml_max_parallelism
query:
  @{PDML_MAX_PARALLELISM=2} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: PDML_MAX_PARALLELISM.
expect@spanner:
  same

case update_table_scan_method_bad_value
dml:
  UPDATE T@{SCAN_METHOD=SIDEWAYS} SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: SCAN_METHOD hint: "SIDEWAYS".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: scan_method hint: SIDEWAYS.

case update_table_seekable_key_size
dml:
  UPDATE T@{SEEKABLE_KEY_SIZE=1} SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SEEKABLE_KEY_SIZE.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Request contains an invalid argument.

case delete_force_index_int
dml:
  DELETE FROM T@{FORCE_INDEX=1} WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: FORCE_INDEX hint: 1.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: force_index.

case stmt_optimizer_version_latest_ident
query:
  @{OPTIMIZER_VERSION=latest} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case stmt_optimizer_version_zero
query:
  @{OPTIMIZER_VERSION=0} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  error: INVALID_ARGUMENT
  message: The value of optimizer_version hint has to be latest or a positive int32 value

case stmt_optimizer_version_too_big
query:
  @{OPTIMIZER_VERSION=3000000000} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  error: INVALID_ARGUMENT
  message: The value of optimizer_version hint has to be latest or a positive int32 value

case dml_optimizer_version_latest_version
dml:
  @{OPTIMIZER_VERSION=latest_version} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  count: 1

case dml_optimizer_version_latest
dml:
  @{OPTIMIZER_VERSION=latest} UPDATE T SET W = 11 WHERE K = 1
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  count: 1

