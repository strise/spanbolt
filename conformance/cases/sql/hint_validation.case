query:
  @{PARAMETER_SENSITIVE=sometimes} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: PARAMETER_SENSITIVE hint: "sometimes".
expect@spanner:
