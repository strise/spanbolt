case group_type_hash_group
query:
  SELECT V, COUNT(*) AS n FROM T GROUP @{GROUP_TYPE=HASH_GROUP} BY V ORDER BY V
expect:
  columns: V STRING, n INT64
  ["a","2"]
  ["b","1"]
expect@spanner:
  same

case join_type_loop_join
query:
  SELECT T.K FROM T JOIN @{JOIN_TYPE=LOOP_JOIN} U ON T.K = U.K ORDER BY T.K
expect:
  columns: K INT64
  ["1"]
  ["2"]
expect@spanner:
  same

case join_method_nested_loop_join
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=NESTED_LOOP_JOIN} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: JOIN_METHOD hint: "NESTED_LOOP_JOIN".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid value for join_type/join_method hint: NESTED_LOOP_JOIN.

case join_method_push_broadcast_hash_join
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=PUSH_BROADCAST_HASH_JOIN} U ON T.K = U.K ORDER BY T.K
expect:
  columns: K INT64
  ["1"]
  ["2"]
expect@spanner:
  same

case join_build_side_with_apply_join
query:
  SELECT T.K FROM T JOIN @{JOIN_METHOD=APPLY_JOIN, HASH_JOIN_BUILD_SIDE=BUILD_LEFT} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: hash_join_build_side hint is only supported for HASH joins.
expect@spanner:
  same

case join_build_side_with_join_type
query:
  SELECT T.K FROM T JOIN @{JOIN_TYPE=hash_join, HASH_JOIN_BUILD_SIDE=build_left} U ON T.K = U.K ORDER BY T.K
expect:
  error: INVALID_ARGUMENT
  message: hash_join_build_side hint is only supported for HASH joins.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]

case duplicate_hint_bad_value
query:
  SELECT K FROM T@{SCAN_METHOD=SIDEWAYS, SCAN_METHOD=BATCH} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Multiple values for hint: SCAN_METHOD
expect@spanner:
  error: INVALID_ARGUMENT
  message: Providing the same hint multiple times is not supported: scan_method.

case unknown_hint_before_bad_value
query:
  SELECT K FROM T@{SCAN_METHOD=SIDEWAYS, NOPE=1} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: NOPE.
expect@spanner:
  same

