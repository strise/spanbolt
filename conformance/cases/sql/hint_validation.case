query:
  SELECT K FROM T@{INDEX_STRATEGY=EVERYTHING} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: INDEX_STRATEGY hint: "EVERYTHING".
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: index_strategy hint: EVERYTHING.

