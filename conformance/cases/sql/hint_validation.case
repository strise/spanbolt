# Hint names per node, hint values, DML hints and spanner_emulator.ignore_unknown_hints.
tags: sql hints
schema:
  CREATE TABLE T (
    K INT64 NOT NULL,
    V STRING(MAX),
    W INT64,
  ) PRIMARY KEY (K);
  CREATE INDEX TByV ON T(V);
  CREATE TABLE U (
    K INT64 NOT NULL,
    X INT64,
  ) PRIMARY KEY (K)
insert T cols=K,V,W:
  [1, "a", 10]
  [2, "b", 20]
  [3, "a", 30]
insert U cols=K,X:
  [1, 100]
  [2, 200]

case stmt_allow_distributed_merge
query:
  @{ALLOW_DISTRIBUTED_MERGE=TRUE} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: ALLOW_DISTRIBUTED_MERGE.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case stmt_execution_method
query:
  @{EXECUTION_METHOD=BATCH} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: EXECUTION_METHOD.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case stmt_execution_method_bad_value
query:
  @{EXECUTION_METHOD=SIDEWAYS} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: EXECUTION_METHOD.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: execution_method hint: SIDEWAYS.

case table_execution_method
query:
  SELECT K FROM T@{EXECUTION_METHOD=ROW} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: EXECUTION_METHOD.
expect@spanner:
  same

case stmt_use_unenforced_foreign_key
query:
  @{USE_UNENFORCED_FOREIGN_KEY=TRUE} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: USE_UNENFORCED_FOREIGN_KEY.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case stmt_allow_timestamp_predicate_pushdown
query:
  @{ALLOW_TIMESTAMP_PREDICATE_PUSHDOWN=TRUE} SELECT K FROM T ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: ALLOW_TIMESTAMP_PREDICATE_PUSHDOWN.
expect@spanner:
  columns: K INT64
  ["1"]
  ["2"]
  ["3"]

case table_seekable_key_size
query:
  SELECT K FROM T@{FORCE_INDEX=TByV, SEEKABLE_KEY_SIZE=1} WHERE V = 'a' ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SEEKABLE_KEY_SIZE.
expect@spanner:
  columns: K INT64
  ["1"]
  ["3"]

case table_seekable_key_size_string
query:
  SELECT K FROM T@{SEEKABLE_KEY_SIZE='one'} ORDER BY K
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: SEEKABLE_KEY_SIZE.
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid hint value for: seekable_key_size.

