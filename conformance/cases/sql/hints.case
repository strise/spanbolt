tags: sql index
schema:
  CREATE TABLE Teams (
    TeamId STRING(36) NOT NULL,
    Name STRING(MAX) NOT NULL,
    CustomerId STRING(36),
    Created TIMESTAMP NOT NULL,
  ) PRIMARY KEY (TeamId);
  CREATE TABLE Entities (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    Kind STRING(32) NOT NULL,
    Status STRING(32),
    Name STRING(MAX),
    Aliases ARRAY<STRING(MAX)>,
    Data JSON,
    Score FLOAT64,
    Version INT64 NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    UpdatedAt TIMESTAMP,
  ) PRIMARY KEY (TeamId, EntityId),
    INTERLEAVE IN PARENT Teams ON DELETE CASCADE;
  CREATE INDEX EntitiesByKind ON Entities(TeamId, Kind);
  CREATE NULL_FILTERED INDEX EntitiesByStatus ON Entities(Status) STORING (Name);
  CREATE TABLE Reviews (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    ReviewId INT64 NOT NULL,
    CreatedBy STRING(36) NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    Outcome STRING(16),
  ) PRIMARY KEY (TeamId, EntityId, ReviewId),
    INTERLEAVE IN PARENT Entities ON DELETE CASCADE;
  CREATE TABLE Users (
    UserId STRING(36) NOT NULL,
    Email STRING(MAX) NOT NULL,
    Name STRING(MAX),
  ) PRIMARY KEY (UserId);
  CREATE TABLE Signals (
    EntityId STRING(36) NOT NULL,
    SignalType STRING(32) NOT NULL,
    ValidFrom TIMESTAMP NOT NULL,
    Confidence FLOAT64 NOT NULL,
  ) PRIMARY KEY (EntityId, SignalType, ValidFrom)
insert Teams cols=TeamId,Name,CustomerId,Created:
  ["t1", "Alpha", "c1", "2024-01-01T00:00:00Z"]
  ["t2", "Beta", "c1", "2024-02-01T00:00:00Z"]
  ["t3", "Gamma", null, "2024-03-01T00:00:00Z"]
insert Entities cols=TeamId,EntityId,Kind,Status,Name,Aliases,Data,Score,Version,CreatedAt,UpdatedAt:
  ["t1", "e1", "company", "active", "Acme AS", ["ACME", "Acme Group"], "{\"country\":\"NO\",\"size\":120,\"tags\":[\"a\",\"b\"],\"owner\":{\"id\":\"p1\",\"share\":0.5}}", 0.75, 3, "2024-01-05T10:00:00Z", "2024-06-01T12:30:00.123456Z"]
  ["t1", "e2", "person", "active", "Kari Nordmann", [], "{\"country\":\"NO\",\"birth\":{\"year\":1980}}", 0.5, 1, "2024-01-06T00:00:00Z", null]
  ["t1", "e3", "company", "archived", "Beta Holding", ["BH"], "{\"country\":\"SE\",\"size\":5}", null, 2, "2024-02-10T08:00:00Z", "2024-03-01T00:00:00Z"]
  ["t1", "e4", "company", null, "Delta ASA", null, null, 1.25, 1, "2024-03-15T00:00:00Z", null]
  ["t2", "e1", "company", "active", "Acme AS", ["ACME"], "{\"country\":\"NO\",\"size\":120}", 0.9, 5, "2024-02-02T00:00:00Z", null]
  ["t2", "e5", "person", "pending", "Ola Nordmann", ["Ola"], "{\"country\":\"DK\"}", 0.1, 1, "2024-04-01T00:00:00Z", null]
insert Reviews cols=TeamId,EntityId,ReviewId,CreatedBy,CreatedAt,Outcome:
  ["t1", "e1", 1, "u1", "2024-01-10T00:00:00Z", "approved"]
  ["t1", "e1", 2, "u2", "2024-02-10T00:00:00Z", null]
  ["t1", "e3", 1, "u1", "2024-02-11T00:00:00Z", "rejected"]
  ["t2", "e5", 1, "u3", "2024-04-02T00:00:00Z", null]
insert Users cols=UserId,Email,Name:
  ["u1", "ann@example.com", "Ann"]
  ["u2", "bob@example.com", null]
  ["u4", "dan@example.com", "Dan"]
insert Signals cols=EntityId,SignalType,ValidFrom,Confidence:
  ["e1", "news", "2024-05-01T00:00:00Z", 0.8]
  ["e1", "news", "2024-05-20T00:00:00Z", 0.4]
  ["e1", "sanction", "2024-04-01T00:00:00Z", 1.0]
  ["e3", "news", "2024-05-02T00:00:00Z", 0.6]
  ["e5", "pep", "2024-01-01T00:00:00Z", 0.9]

case force_index
query:
  SELECT EntityId, Kind FROM Entities@{FORCE_INDEX=EntitiesByKind} WHERE TeamId = 't1' AND Kind = 'company'
expect:
  columns: EntityId STRING, Kind STRING
  ["e1","company"]
  ["e4","company"]
  ["e3","company"]
expect@spanner:
  same

case force_index_base_table
query:
  SELECT EntityId FROM Entities@{FORCE_INDEX=_BASE_TABLE} WHERE TeamId = 't2'
expect:
  columns: EntityId STRING
  ["e1"]
  ["e5"]
expect@spanner:
  same

case force_index_unknown
query:
  SELECT EntityId FROM Entities@{FORCE_INDEX=Nope}
expect:
  error: INVALID_ARGUMENT
  message: The table does not have a secondary index called Nope
expect@spanner:
  error: INVALID_ARGUMENT
  message: The table Entities does not have an index called Nope

case force_index_non_covering_column
query:
  SELECT EntityId, Name FROM Entities@{FORCE_INDEX=EntitiesByKind} WHERE TeamId = 't1' AND Kind = 'person'
expect:
  columns: EntityId STRING, Name STRING
  ["e2","Kari Nordmann"]
expect@spanner:
  same

case null_filtered_without_filter
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT EntityId, Status FROM Entities@{FORCE_INDEX=EntitiesByStatus}
expect:
  error: INVALID_ARGUMENT
  message: The emulator is not able to determine whether the null filtered index EntitiesByStatus can be used to answer this query as it may filter out nulls that may be required to answer the query. Please test this query against Cloud Spanner. If you confirm against Cloud Spanner that the null filtered index can be used to answer the query, set the hint @{spanner_emulator.disable_query_null_filtered_index_check=true} on the table, or the query statement to bypass this check in the emulator. This hint will be ignored by the production Cloud Spanner service and the emulator will accept the query and return a valid result when it is run with the check disabled.
expect@spanner:
  error: INVALID_ARGUMENT
  message: The index EntitiesByStatus cannot be used because it filters nulls that are required to answer the query for column Status.

case null_filtered_with_is_not_null
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT Status, Name FROM Entities@{FORCE_INDEX=EntitiesByStatus} WHERE Status IS NOT NULL
expect:
  error: INVALID_ARGUMENT
  message: The emulator is not able to determine whether the null filtered index EntitiesByStatus can be used to answer this query as it may filter out nulls that may be required to answer the query. Please test this query against Cloud Spanner. If you confirm against Cloud Spanner that the null filtered index can be used to answer the query, set the hint @{spanner_emulator.disable_query_null_filtered_index_check=true} on the table, or the query statement to bypass this check in the emulator. This hint will be ignored by the production Cloud Spanner service and the emulator will accept the query and return a valid result when it is run with the check disabled.
expect@spanner:
  columns: Status STRING, Name STRING
  ["active","Acme AS"]
  ["active","Kari Nordmann"]
  ["active","Acme AS"]
  ["archived","Beta Holding"]
  ["pending","Ola Nordmann"]

case null_filtered_equality
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT Status, Name FROM Entities@{FORCE_INDEX=EntitiesByStatus} WHERE Status = 'active'
expect:
  error: INVALID_ARGUMENT
  message: The emulator is not able to determine whether the null filtered index EntitiesByStatus can be used to answer this query as it may filter out nulls that may be required to answer the query. Please test this query against Cloud Spanner. If you confirm against Cloud Spanner that the null filtered index can be used to answer the query, set the hint @{spanner_emulator.disable_query_null_filtered_index_check=true} on the table, or the query statement to bypass this check in the emulator. This hint will be ignored by the production Cloud Spanner service and the emulator will accept the query and return a valid result when it is run with the check disabled.
expect@spanner:
  columns: Status STRING, Name STRING
  ["active","Acme AS"]
  ["active","Kari Nordmann"]
  ["active","Acme AS"]

case null_filtered_check_disabled
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT Status, Name FROM Entities@{FORCE_INDEX=EntitiesByStatus, spanner_emulator.disable_query_null_filtered_index_check=true}
expect:
  columns: Status STRING, Name STRING
  ["active","Kari Nordmann"]
  [null,"Delta ASA"]
  ["pending","Ola Nordmann"]
  ["active","Acme AS"]
  ["archived","Beta Holding"]
  ["active","Acme AS"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: The index EntitiesByStatus cannot be used because it filters nulls that are required to answer the query for column Status.

case null_filtered_in_unnest
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT Name FROM Entities@{FORCE_INDEX=EntitiesByStatus} WHERE Status IN UNNEST(@s)
params:
  @s ARRAY<STRING> = ["active", "pending"]
expect:
  error: INVALID_ARGUMENT
  message: The emulator is not able to determine whether the null filtered index EntitiesByStatus can be used to answer this query as it may filter out nulls that may be required to answer the query. Please test this query against Cloud Spanner. If you confirm against Cloud Spanner that the null filtered index can be used to answer the query, set the hint @{spanner_emulator.disable_query_null_filtered_index_check=true} on the table, or the query statement to bypass this check in the emulator. This hint will be ignored by the production Cloud Spanner service and the emulator will accept the query and return a valid result when it is run with the check disabled.
expect@spanner:
  error: INVALID_ARGUMENT
  message: The index EntitiesByStatus cannot be used because it filters nulls that are required to answer the query for column Status.

case null_filtered_in_unnest_is_not_null
# diverges-from-emulator: production Spanner accepts FORCE_INDEX on a NULL_FILTERED index when the indexed columns are filtered IS NOT NULL, rejects it otherwise, and ignores the emulator-only check hint; spanbolt follows production.
tags: diverges-from-emulator
query:
  SELECT Name FROM Entities@{FORCE_INDEX=EntitiesByStatus} WHERE Status IS NOT NULL AND Status IN UNNEST(@s)
params:
  @s ARRAY<STRING> = ["active", "pending"]
expect:
  error: INVALID_ARGUMENT
  message: The emulator is not able to determine whether the null filtered index EntitiesByStatus can be used to answer this query as it may filter out nulls that may be required to answer the query. Please test this query against Cloud Spanner. If you confirm against Cloud Spanner that the null filtered index can be used to answer the query, set the hint @{spanner_emulator.disable_query_null_filtered_index_check=true} on the table, or the query statement to bypass this check in the emulator. This hint will be ignored by the production Cloud Spanner service and the emulator will accept the query and return a valid result when it is run with the check disabled.
expect@spanner:
  columns: Name STRING
  ["Acme AS"]
  ["Kari Nordmann"]
  ["Acme AS"]
  ["Ola Nordmann"]

case statement_hint_optimizer
# diverges-from-emulator: production Spanner accepts the OPTIMIZER_VERSION statement hint; the emulator rejects it.
tags: diverges-from-emulator
query:
  @{OPTIMIZER_VERSION=6} SELECT COUNT(*) AS n FROM Entities
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: OPTIMIZER_VERSION.
expect@spanner:
  columns: n INT64
  ["6"]

case unknown_hint
query:
  SELECT 1 FROM Entities@{NOPE_HINT=1}
expect:
  error: INVALID_ARGUMENT
  message: Unsupported hint: NOPE_HINT.
expect@spanner:
  same

case group_by_hint
query:
  SELECT Kind, COUNT(*) AS n FROM Entities GROUP @{GROUP_METHOD=STREAM_GROUP} BY Kind
expect:
  columns: Kind STRING, n INT64
  ["person","2"]
  ["company","4"]
expect@spanner:
  same

