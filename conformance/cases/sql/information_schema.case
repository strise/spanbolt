case tables
query:
  SELECT TABLE_NAME, PARENT_TABLE_NAME, ON_DELETE_ACTION FROM INFORMATION_SCHEMA.TABLES
  WHERE TABLE_SCHEMA NOT IN ('INFORMATION_SCHEMA', 'SPANNER_SYS') AND TABLE_TYPE = 'BASE TABLE'
  ORDER BY TABLE_NAME
expect:
  columns: TABLE_NAME STRING, PARENT_TABLE_NAME STRING, ON_DELETE_ACTION STRING
  ["Entities","Teams","CASCADE"]
  ["Reviews","Entities","CASCADE"]
  ["Signals",null,null]
  ["Teams",null,null]
  ["Users",null,null]

case columns
query:
  SELECT COLUMN_NAME, ORDINAL_POSITION, SPANNER_TYPE, IS_NULLABLE FROM INFORMATION_SCHEMA.COLUMNS
  WHERE TABLE_SCHEMA = '' AND TABLE_NAME = 'Entities' ORDER BY ORDINAL_POSITION
expect:
  columns: COLUMN_NAME STRING, ORDINAL_POSITION INT64, SPANNER_TYPE STRING, IS_NULLABLE STRING
  ["TeamId","1","STRING(36)","NO"]
  ["EntityId","2","STRING(36)","NO"]
  ["Kind","3","STRING(32)","NO"]
  ["Status","4","STRING(32)","YES"]
  ["Name","5","STRING(MAX)","YES"]
  ["Aliases","6","ARRAY<STRING(MAX)>","YES"]
  ["Data","7","JSON","YES"]
  ["Score","8","FLOAT64","YES"]
  ["Version","9","INT64","NO"]
  ["CreatedAt","10","TIMESTAMP","NO"]
  ["UpdatedAt","11","TIMESTAMP","YES"]

case indexes
query:
  SELECT TABLE_NAME, INDEX_NAME, INDEX_TYPE, IS_UNIQUE, IS_NULL_FILTERED, INDEX_STATE FROM INFORMATION_SCHEMA.INDEXES
  WHERE TABLE_SCHEMA = '' ORDER BY TABLE_NAME, INDEX_NAME
expect:
  columns: TABLE_NAME STRING, INDEX_NAME STRING, INDEX_TYPE STRING, IS_UNIQUE BOOL, IS_NULL_FILTERED BOOL, INDEX_STATE STRING
  ["Entities","EntitiesByKind","INDEX",false,false,"READ_WRITE"]
  ["Entities","EntitiesByStatus","INDEX",false,true,"READ_WRITE"]
  ["Entities","PRIMARY_KEY","PRIMARY_KEY",true,false,null]
  ["Reviews","PRIMARY_KEY","PRIMARY_KEY",true,false,null]
  ["Signals","PRIMARY_KEY","PRIMARY_KEY",true,false,null]
  ["Teams","PRIMARY_KEY","PRIMARY_KEY",true,false,null]
  ["Users","PRIMARY_KEY","PRIMARY_KEY",true,false,null]

case index_count_precondition
query:
  SELECT count(*) FROM INFORMATION_SCHEMA.INDEXES WHERE TABLE_NAME = @t AND INDEX_NAME = @i
params:
  @t STRING = "Entities"
  @i STRING = "EntitiesByKind"
expect:
  columns: INT64
  ["1"]

case index_columns
query:
  SELECT INDEX_NAME, COLUMN_NAME, ORDINAL_POSITION, COLUMN_ORDERING FROM INFORMATION_SCHEMA.INDEX_COLUMNS
  WHERE TABLE_SCHEMA = '' AND TABLE_NAME = 'Entities' ORDER BY INDEX_NAME, ORDINAL_POSITION, COLUMN_NAME
expect:
  columns: INDEX_NAME STRING, COLUMN_NAME STRING, ORDINAL_POSITION INT64, COLUMN_ORDERING STRING
  ["EntitiesByKind","TeamId","1","ASC"]
  ["EntitiesByKind","Kind","2","ASC"]
  ["EntitiesByStatus","Name",null,null]
  ["EntitiesByStatus","Status","1","ASC"]
  ["PRIMARY_KEY","TeamId","1","ASC"]
  ["PRIMARY_KEY","EntityId","2","ASC"]

case key_columns_via_constraints
query:
  SELECT kcu.TABLE_NAME, kcu.COLUMN_NAME, kcu.ORDINAL_POSITION
  FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc
  JOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE kcu
    ON kcu.CONSTRAINT_SCHEMA = tc.CONSTRAINT_SCHEMA AND kcu.CONSTRAINT_NAME = tc.CONSTRAINT_NAME
  WHERE tc.CONSTRAINT_TYPE = 'PRIMARY KEY' AND tc.TABLE_SCHEMA = ''
  ORDER BY kcu.TABLE_NAME, kcu.ORDINAL_POSITION
expect:
  columns: TABLE_NAME STRING, COLUMN_NAME STRING, ORDINAL_POSITION INT64
  ["Entities","TeamId","1"]
  ["Entities","EntityId","2"]
  ["Reviews","TeamId","1"]
  ["Reviews","EntityId","2"]
  ["Reviews","ReviewId","3"]
  ["Signals","EntityId","1"]
  ["Signals","SignalType","2"]
  ["Signals","ValidFrom","3"]
  ["Teams","TeamId","1"]
  ["Users","UserId","1"]

case schemata
query:
  SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA ORDER BY SCHEMA_NAME
expect:
  columns: SCHEMA_NAME STRING
  [""]
  ["INFORMATION_SCHEMA"]
  ["SPANNER_SYS"]

case union_tables_and_indexes
query:
  SELECT TABLE_NAME AS name, 'table' AS kind FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ''
  UNION ALL
  SELECT INDEX_NAME, 'index' FROM INFORMATION_SCHEMA.INDEXES WHERE TABLE_SCHEMA = '' AND INDEX_TYPE = 'INDEX'
  ORDER BY name
expect:
  columns: name STRING, kind STRING
  ["Entities","table"]
  ["EntitiesByKind","index"]
  ["EntitiesByStatus","index"]
  ["Reviews","table"]
  ["Signals","table"]
  ["Teams","table"]
  ["Users","table"]

case database_options
query:
  SELECT OPTION_NAME, OPTION_VALUE FROM INFORMATION_SCHEMA.DATABASE_OPTIONS ORDER BY OPTION_NAME
expect:
  columns: OPTION_NAME STRING, OPTION_VALUE STRING
  ["database_dialect","GOOGLE_STANDARD_SQL"]

case column_options
query:
  SELECT TABLE_NAME, COLUMN_NAME, OPTION_NAME, OPTION_VALUE FROM INFORMATION_SCHEMA.COLUMN_OPTIONS WHERE TABLE_SCHEMA = '' ORDER BY TABLE_NAME, COLUMN_NAME
expect:
  columns: TABLE_NAME STRING, COLUMN_NAME STRING, OPTION_NAME STRING, OPTION_VALUE STRING

case info_schema_in_rw_txn
dml:
  SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
expect:
  columns: INT64
  ["36"]

