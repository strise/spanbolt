# Foreign keys in INFORMATION_SCHEMA: what REFERENTIAL_CONSTRAINTS.UNIQUE_CONSTRAINT_NAME names for a
# key onto the referenced table's primary key, onto columns with a unique index, with a non-unique
# index, and with no index at all (Spanner creates backing indexes), in the default and a named schema.
tags: sql information_schema
schema:
  CREATE TABLE Parents (
    ParentId STRING(36) NOT NULL,
    Code STRING(16) NOT NULL,
    Slug STRING(16),
    Label STRING(16),
    A INT64,
    B INT64,
  ) PRIMARY KEY (ParentId);
  CREATE UNIQUE INDEX ParentsByCode ON Parents(Code);
  CREATE INDEX ParentsByLabel ON Parents(Label);
  CREATE TABLE Children (
    ChildId STRING(36) NOT NULL,
    ParentId STRING(36),
    ParentCode STRING(16),
    ParentSlug STRING(16),
    ParentLabel STRING(16),
    PA INT64,
    PB INT64,
    CONSTRAINT FK_ChildPk FOREIGN KEY (ParentId) REFERENCES Parents (ParentId) ON DELETE CASCADE,
    CONSTRAINT FK_ChildCode FOREIGN KEY (ParentCode) REFERENCES Parents (Code),
    CONSTRAINT FK_ChildSlug FOREIGN KEY (ParentSlug) REFERENCES Parents (Slug),
    CONSTRAINT FK_ChildLabel FOREIGN KEY (ParentLabel) REFERENCES Parents (Label),
    CONSTRAINT FK_ChildAB FOREIGN KEY (PB, PA) REFERENCES Parents (B, A),
  ) PRIMARY KEY (ChildId);
  CREATE TABLE Others (
    OtherId STRING(36) NOT NULL,
    Slug STRING(16),
    CONSTRAINT FK_OtherSlug FOREIGN KEY (Slug) REFERENCES Parents (Slug),
  ) PRIMARY KEY (OtherId);
  CREATE TABLE Pairs (
    X INT64 NOT NULL,
    Y INT64 NOT NULL,
  ) PRIMARY KEY (X, Y);
  CREATE TABLE PairRefs (
    X INT64 NOT NULL,
    Y INT64 NOT NULL,
    Z INT64,
    CONSTRAINT FK_PairWhole FOREIGN KEY (Y, X) REFERENCES Pairs (Y, X),
    CONSTRAINT FK_PairPrefix FOREIGN KEY (X) REFERENCES Pairs (X),
    CONSTRAINT FK_PairLoose FOREIGN KEY (Z) REFERENCES Pairs (Y) NOT ENFORCED,
  ) PRIMARY KEY (X, Y);
  CREATE SCHEMA mon;
  CREATE TABLE mon.alerts (
    id STRING(36) NOT NULL,
    code STRING(16),
  ) PRIMARY KEY (id);
  CREATE TABLE mon.comments (
    id STRING(36) NOT NULL,
    alert_id STRING(36) NOT NULL,
    alert_code STRING(16),
    CONSTRAINT fk_comments FOREIGN KEY (alert_id) REFERENCES mon.alerts (id) ON DELETE CASCADE,
    CONSTRAINT fk_comments_code FOREIGN KEY (alert_code) REFERENCES mon.alerts (code),
  ) PRIMARY KEY (id)

