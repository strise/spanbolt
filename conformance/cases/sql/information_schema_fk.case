case mito_foreign_key_targets
query:
  SELECT fk.TABLE_SCHEMA, fk.TABLE_NAME, rc.CONSTRAINT_NAME,
    COALESCE(pk.TABLE_SCHEMA, ix.TABLE_SCHEMA) AS REF_SCHEMA, COALESCE(pk.TABLE_NAME, ix.TABLE_NAME) AS REF_NAME
  FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS rc
  JOIN INFORMATION_SCHEMA.TABLE_CONSTRAINTS fk ON fk.CONSTRAINT_SCHEMA = rc.CONSTRAINT_SCHEMA AND fk.CONSTRAINT_NAME = rc.CONSTRAINT_NAME
  LEFT JOIN INFORMATION_SCHEMA.TABLE_CONSTRAINTS pk ON pk.CONSTRAINT_SCHEMA = rc.UNIQUE_CONSTRAINT_SCHEMA AND pk.CONSTRAINT_NAME = rc.UNIQUE_CONSTRAINT_NAME
  LEFT JOIN INFORMATION_SCHEMA.INDEXES ix ON ix.TABLE_SCHEMA = rc.UNIQUE_CONSTRAINT_SCHEMA AND ix.INDEX_NAME = rc.UNIQUE_CONSTRAINT_NAME
  ORDER BY rc.CONSTRAINT_SCHEMA, rc.CONSTRAINT_NAME
expect:
  columns: TABLE_SCHEMA STRING, TABLE_NAME STRING, CONSTRAINT_NAME STRING, REF_SCHEMA STRING, REF_NAME STRING
  ["","Children","FK_ChildAB","","Parents"]
  ["","Children","FK_ChildCode","","Parents"]
  ["","Children","FK_ChildLabel","","Parents"]
  ["","Children","FK_ChildPk","","Parents"]
  ["","Children","FK_ChildSlug","","Parents"]
  ["","Children","FK_ChildSlug","","Parents"]
  ["","Others","FK_OtherSlug","","Parents"]
  ["","Others","FK_OtherSlug","","Parents"]
  ["","PairRefs","FK_PairLoose","","Pairs"]
  ["","PairRefs","FK_PairPrefix","","Pairs"]
  ["","PairRefs","FK_PairWhole","","Pairs"]
  ["mon","comments","fk_comments","mon","alerts"]
  ["mon","comments","fk_comments_code","mon","alerts"]
