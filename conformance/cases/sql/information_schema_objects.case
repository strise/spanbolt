  ["","","Notes","NotesByShard","INDEX","",false,false,"READ_WRITE",null,false,null,null]
  ["","","Notes","NotesByText","SEARCH","",true,false,"READ_WRITE",null,false,["Shard"],["NoteId"]]
  ["","","Notes","PRIMARY_KEY","PRIMARY_KEY","",true,false,null,null,false,null,null]
