case synonym_in_named_schema
schema:
  CREATE SCHEMA app;
  CREATE TABLE app.Items (
    ItemId INT64 NOT NULL,
  ) PRIMARY KEY (ItemId)
ddl:
  ALTER TABLE app.Items ADD SYNONYM app.Things
query:
  SELECT * FROM INFORMATION_SCHEMA.TABLE_SYNONYMS
expect:
  error: INVALID_ARGUMENT
  message: Table not found: INFORMATION_SCHEMA.TABLE_SYNONYMS [at 1:15]
