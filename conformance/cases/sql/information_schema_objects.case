  columns: SYNONYM_CATALOG STRING, SYNONYM_SCHEMA STRING, SYNONYM_NAME STRING, TABLE_CATALOG STRING, TABLE_SCHEMA STRING, TABLE_NAME STRING
  ["","app","Things","","app","Items"]
query:
  SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'app' ORDER BY TABLE_NAME
expect:
  columns: TABLE_SCHEMA STRING, TABLE_NAME STRING, TABLE_TYPE STRING
  ["app","Items","BASE TABLE"]
expect@spanner:
  columns: TABLE_SCHEMA STRING, TABLE_NAME STRING, TABLE_TYPE STRING
  ["app","Items","BASE TABLE"]
  ["app","Things","SYNONYM"]
