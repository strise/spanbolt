case change_streams
query:
  SELECT * FROM INFORMATION_SCHEMA.CHANGE_STREAMS ORDER BY CHANGE_STREAM_NAME
expect:
  columns: CHANGE_STREAM_CATALOG STRING, CHANGE_STREAM_SCHEMA STRING, CHANGE_STREAM_NAME STRING, ALL BOOL
  ["","","AllChanges",true]
  ["","","DocChanges",false]
  ["","","DocKeys",false]
  ["","","Idle",false]
expect@spanner:
  same
query:
  SELECT * FROM INFORMATION_SCHEMA.CHANGE_STREAM_TABLES ORDER BY CHANGE_STREAM_NAME, TABLE_NAME
expect:
  columns: CHANGE_STREAM_CATALOG STRING, CHANGE_STREAM_SCHEMA STRING, CHANGE_STREAM_NAME STRING, TABLE_CATALOG STRING, TABLE_SCHEMA STRING, TABLE_NAME STRING, ALL_COLUMNS BOOL
  ["","","DocChanges","","","Docs",true]
  ["","","DocChanges","","","Tags",false]
  ["","","DocKeys","","","Docs",false]
expect@spanner:
  same
query:
  SELECT * FROM INFORMATION_SCHEMA.CHANGE_STREAM_COLUMNS ORDER BY CHANGE_STREAM_NAME, TABLE_NAME, COLUMN_NAME
expect:
  columns: CHANGE_STREAM_CATALOG STRING, CHANGE_STREAM_SCHEMA STRING, CHANGE_STREAM_NAME STRING, TABLE_CATALOG STRING, TABLE_SCHEMA STRING, TABLE_NAME STRING, COLUMN_NAME STRING
  ["","","DocChanges","","","Tags","Label"]
expect@spanner:
  same

case change_stream_set_for
ddl:
  ALTER CHANGE STREAM DocChanges SET FOR Tags, Docs(Title, Body)
query:
  SELECT CHANGE_STREAM_NAME, TABLE_NAME, ALL_COLUMNS FROM INFORMATION_SCHEMA.CHANGE_STREAM_TABLES WHERE CHANGE_STREAM_NAME = 'DocChanges' ORDER BY TABLE_NAME
expect:
  columns: CHANGE_STREAM_NAME STRING, TABLE_NAME STRING, ALL_COLUMNS BOOL
  ["DocChanges","Docs",false]
  ["DocChanges","Tags",true]
expect@spanner:
  same
query:
  SELECT TABLE_NAME, COLUMN_NAME FROM INFORMATION_SCHEMA.CHANGE_STREAM_COLUMNS WHERE CHANGE_STREAM_NAME = 'DocChanges' ORDER BY TABLE_NAME, COLUMN_NAME
expect:
  columns: TABLE_NAME STRING, COLUMN_NAME STRING
  ["Docs","Body"]
  ["Docs","Title"]
expect@spanner:
  same

