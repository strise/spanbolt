  ["","","AllChanges","retention_period","STRING","36h"]
  ["","","AllChanges","value_capture_type","STRING","NEW_ROW"]

case change_stream_options_bool_and_null
ddl:
  CREATE CHANGE STREAM Filtered FOR Docs OPTIONS ( retention_period = NULL, value_capture_type = 'NEW_VALUES', exclude_insert = false, exclude_update = true, exclude_delete = false )
query:
  SELECT OPTION_NAME, OPTION_TYPE, OPTION_VALUE FROM INFORMATION_SCHEMA.CHANGE_STREAM_OPTIONS WHERE CHANGE_STREAM_NAME = 'Filtered' ORDER BY OPTION_NAME
expect:
  columns: OPTION_NAME STRING, OPTION_TYPE STRING, OPTION_VALUE STRING
  ["value_capture_type","STRING","NEW_VALUES"]
expect@spanner:
  columns: OPTION_NAME STRING, OPTION_TYPE STRING, OPTION_VALUE STRING
  ["exclude_delete","BOOL","FALSE"]
  ["exclude_insert","BOOL","FALSE"]
  ["exclude_update","BOOL","TRUE"]
  ["value_capture_type","STRING","NEW_VALUES"]

