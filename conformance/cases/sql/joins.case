tags: sql join
schema:
  CREATE TABLE Teams (
    TeamId STRING(36) NOT NULL,
    Name STRING(MAX) NOT NULL,
    CustomerId STRING(36),
    Created TIMESTAMP NOT NULL,
  ) PRIMARY KEY (TeamId);
  CREATE TABLE Entities (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    Kind STRING(32) NOT NULL,
    Status STRING(32),
    Name STRING(MAX),
    Aliases ARRAY<STRING(MAX)>,
    Data JSON,
    Score FLOAT64,
    Version INT64 NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    UpdatedAt TIMESTAMP,
  ) PRIMARY KEY (TeamId, EntityId),
    INTERLEAVE IN PARENT Teams ON DELETE CASCADE;
  CREATE INDEX EntitiesByKind ON Entities(TeamId, Kind);
  CREATE NULL_FILTERED INDEX EntitiesByStatus ON Entities(Status) STORING (Name);
  CREATE TABLE Reviews (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    ReviewId INT64 NOT NULL,
    CreatedBy STRING(36) NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    Outcome STRING(16),
  ) PRIMARY KEY (TeamId, EntityId, ReviewId),
    INTERLEAVE IN PARENT Entities ON DELETE CASCADE;
  CREATE TABLE Users (
    UserId STRING(36) NOT NULL,
    Email STRING(MAX) NOT NULL,
    Name STRING(MAX),
  ) PRIMARY KEY (UserId);
  CREATE TABLE Signals (
    EntityId STRING(36) NOT NULL,
    SignalType STRING(32) NOT NULL,
    ValidFrom TIMESTAMP NOT NULL,
    Confidence FLOAT64 NOT NULL,
  ) PRIMARY KEY (EntityId, SignalType, ValidFrom)
insert Teams cols=TeamId,Name,CustomerId,Created:
  ["t1", "Alpha", "c1", "2024-01-01T00:00:00Z"]
  ["t2", "Beta", "c1", "2024-02-01T00:00:00Z"]
  ["t3", "Gamma", null, "2024-03-01T00:00:00Z"]
insert Entities cols=TeamId,EntityId,Kind,Status,Name,Aliases,Data,Score,Version,CreatedAt,UpdatedAt:
  ["t1", "e1", "company", "active", "Acme AS", ["ACME", "Acme Group"], "{\"country\":\"NO\",\"size\":120,\"tags\":[\"a\",\"b\"],\"owner\":{\"id\":\"p1\",\"share\":0.5}}", 0.75, 3, "2024-01-05T10:00:00Z", "2024-06-01T12:30:00.123456Z"]
  ["t1", "e2", "person", "active", "Kari Nordmann", [], "{\"country\":\"NO\",\"birth\":{\"year\":1980}}", 0.5, 1, "2024-01-06T00:00:00Z", null]
  ["t1", "e3", "company", "archived", "Beta Holding", ["BH"], "{\"country\":\"SE\",\"size\":5}", null, 2, "2024-02-10T08:00:00Z", "2024-03-01T00:00:00Z"]
  ["t1", "e4", "company", null, "Delta ASA", null, null, 1.25, 1, "2024-03-15T00:00:00Z", null]
  ["t2", "e1", "company", "active", "Acme AS", ["ACME"], "{\"country\":\"NO\",\"size\":120}", 0.9, 5, "2024-02-02T00:00:00Z", null]
  ["t2", "e5", "person", "pending", "Ola Nordmann", ["Ola"], "{\"country\":\"DK\"}", 0.1, 1, "2024-04-01T00:00:00Z", null]
insert Reviews cols=TeamId,EntityId,ReviewId,CreatedBy,CreatedAt,Outcome:
  ["t1", "e1", 1, "u1", "2024-01-10T00:00:00Z", "approved"]
  ["t1", "e1", 2, "u2", "2024-02-10T00:00:00Z", null]
  ["t1", "e3", 1, "u1", "2024-02-11T00:00:00Z", "rejected"]
  ["t2", "e5", 1, "u3", "2024-04-02T00:00:00Z", null]
insert Users cols=UserId,Email,Name:
  ["u1", "ann@example.com", "Ann"]
  ["u2", "bob@example.com", null]
  ["u4", "dan@example.com", "Dan"]
insert Signals cols=EntityId,SignalType,ValidFrom,Confidence:
  ["e1", "news", "2024-05-01T00:00:00Z", 0.8]
  ["e1", "news", "2024-05-20T00:00:00Z", 0.4]
  ["e1", "sanction", "2024-04-01T00:00:00Z", 1.0]
  ["e3", "news", "2024-05-02T00:00:00Z", 0.6]
  ["e5", "pep", "2024-01-01T00:00:00Z", 0.9]

case left_join
query:
  SELECT r.ReviewId, r.CreatedBy, u.Email
  FROM Reviews r LEFT JOIN Users u ON r.CreatedBy = u.UserId
  WHERE r.TeamId = 't1'
expect:
  columns: ReviewId INT64, CreatedBy STRING, Email STRING
  ["2","u2","bob@example.com"]
  ["1","u1","ann@example.com"]
  ["1","u1","ann@example.com"]

case inner_join_multi_column
query:
  SELECT e.EntityId, r.ReviewId FROM Entities e
  JOIN Reviews r ON r.TeamId = e.TeamId AND r.EntityId = e.EntityId
expect:
  columns: EntityId STRING, ReviewId INT64
  ["e1","2"]
  ["e3","1"]
  ["e5","1"]
  ["e1","1"]

case join_using
query:
  SELECT TeamId, t.Name, e.EntityId FROM Teams t JOIN Entities e USING (TeamId) WHERE e.Kind = 'person'
expect:
  columns: TeamId STRING, Name STRING, EntityId STRING
  ["t1","Alpha","e2"]
  ["t2","Beta","e5"]

case join_param_in_on
query:
  SELECT s.EntityId, s.SignalType, e.Name FROM Signals s
  JOIN Entities e ON e.TeamId = @team AND e.EntityId = s.EntityId
params:
  @team STRING = "t1"
expect:
  columns: EntityId STRING, SignalType STRING, Name STRING
  ["e3","news","Beta Holding"]
  ["e1","sanction","Acme AS"]
  ["e1","news","Acme AS"]
  ["e1","news","Acme AS"]

case four_way_join
query:
  SELECT t.Name AS team, e.Name AS entity, r.ReviewId, u.Name AS reviewer
  FROM Teams t
  JOIN Entities e ON e.TeamId = t.TeamId
  JOIN Reviews r ON r.TeamId = e.TeamId AND r.EntityId = e.EntityId
  LEFT JOIN Users u ON u.UserId = r.CreatedBy
  ORDER BY t.Name, e.Name, r.ReviewId
expect:
  columns: team STRING, entity STRING, ReviewId INT64, reviewer STRING
  ["Alpha","Acme AS","1","Ann"]
  ["Alpha","Acme AS","2",null]
  ["Alpha","Beta Holding","1","Ann"]
  ["Beta","Ola Nordmann","1",null]

case cross_join_unnest_column
query:
  SELECT e.EntityId, alias FROM Entities e, UNNEST(e.Aliases) AS alias WHERE e.TeamId = 't1'
expect:
  columns: EntityId STRING, alias STRING
  ["e1","Acme Group"]
  ["e3","BH"]
  ["e1","ACME"]

case cross_join
query:
  SELECT t.TeamId, u.UserId FROM Teams t CROSS JOIN Users u WHERE t.TeamId = 't3'
expect:
  columns: TeamId STRING, UserId STRING
  ["t3","u1"]
  ["t3","u2"]
  ["t3","u4"]

case full_outer_join
query:
  SELECT r.CreatedBy, u.UserId FROM (SELECT DISTINCT CreatedBy FROM Reviews) r FULL OUTER JOIN Users u ON r.CreatedBy = u.UserId
expect:
  columns: CreatedBy STRING, UserId STRING
  ["u1","u1"]
  [null,"u4"]
  ["u2","u2"]
  ["u3",null]

case join_hint_apply
query:
  SELECT e.EntityId FROM Teams t
  INNER JOIN @{JOIN_METHOD=APPLY_JOIN} Entities e ON e.TeamId = t.TeamId
  WHERE t.CustomerId = 'c1'
expect:
  columns: EntityId STRING
  ["e4"]
  ["e3"]
  ["e1"]
  ["e2"]
  ["e1"]
  ["e5"]

case join_hint_hash
query:
  SELECT e.EntityId, u.UserId FROM Entities e
  JOIN @{JOIN_METHOD=HASH_JOIN} Reviews r ON r.TeamId = e.TeamId AND r.EntityId = e.EntityId
  JOIN Users u ON u.UserId = r.CreatedBy
expect:
  columns: EntityId STRING, UserId STRING
  ["e3","u1"]
  ["e1","u2"]
  ["e1","u1"]

case join_to_cte
query:
  WITH active_users AS (SELECT UserId, Email FROM Users WHERE Name IS NOT NULL)
  SELECT r.ReviewId, r.EntityId, au.Email FROM Reviews r LEFT JOIN active_users au ON r.CreatedBy = au.UserId
expect:
  columns: ReviewId INT64, EntityId STRING, Email STRING
  ["1","e5",null]
  ["1","e3","ann@example.com"]
  ["2","e1",null]
  ["1","e1","ann@example.com"]

case ambiguous_column
query:
  SELECT TeamId FROM Teams JOIN Entities ON Teams.TeamId = Entities.TeamId
expect:
  error: INVALID_ARGUMENT
  message: Column name TeamId is ambiguous [at 1:8]

