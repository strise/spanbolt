case json_value_paths
query:
  SELECT EntityId, JSON_VALUE(Data, '$.country') AS country, JSON_VALUE(Data, '$.owner.id') AS owner, JSON_VALUE(Data, '$.birth.year') AS year
  FROM Entities WHERE TeamId = 't1'
expect:
  columns: EntityId STRING, country STRING, owner STRING, year STRING
  ["e3","SE",null,null]
  ["e1","NO","p1",null]
  ["e4",null,null,null]
  ["e2","NO",null,"1980"]

case json_query
query:
  SELECT EntityId, JSON_QUERY(Data, '$.owner') AS owner, JSON_QUERY(Data, '$.tags') AS tags FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: EntityId STRING, owner JSON, tags JSON
  ["e1","{\"id\":\"p1\",\"share\":0.5}","[\"a\",\"b\"]"]

case json_query_array
query:
  SELECT JSON_QUERY_ARRAY(Data, '$.tags') AS tags, JSON_VALUE_ARRAY(Data, '$.tags') AS vals FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: tags ARRAY<JSON>, vals ARRAY<STRING>
  [["\"a\"","\"b\""],["a","b"]]

case ifnull_json_query_array
query:
  SELECT EntityId, IFNULL(JSON_QUERY_ARRAY(Data, '$.tags'), []) AS tags FROM Entities WHERE TeamId = 't1'
expect:
  columns: EntityId STRING, tags ARRAY<JSON>
  ["e3",[]]
  ["e1",["\"a\"","\"b\""]]
  ["e4",[]]
  ["e2",[]]

case json_subscripts
query:
  SELECT Data['owner']['share'] AS share, Data.owner.id AS dotted, Data['tags'][1] AS second, Data['missing'] AS missing FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: share JSON, dotted JSON, second JSON, missing JSON
  ["0.5","\"p1\"","\"b\"",null]

case json_value_non_scalar
query:
  SELECT JSON_VALUE(JSON '{"a":{"b":1}}', '$.a') AS obj, JSON_VALUE(JSON '{"a":null}', '$.a') AS jnull
expect:
  columns: obj STRING, jnull STRING
  [null,null]

case json_literal_normalisation
query:
  SELECT JSON '{"b":1,  "a":[1.0, 2e2, -0]}' AS j, JSON 'null' AS n, JSON '"s"' AS s
expect:
  columns: j JSON, n JSON, s JSON
  ["{\"a\":[1.0,200.0,0],\"b\":1}","null","\"s\""]

case json_big_numbers
query:
  SELECT JSON '{"i":12345678901234567890, "f":1.0000000000000002, "e":1e400}' AS j
expect:
  error: INVALID_ARGUMENT
  message: Invalid JSON literal: number overflow parsing '1e400' [at 1:8]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid JSON literal: number overflow parsing \'1e400\' [at 1:8]

case parse_json_and_to_json
query:
  SELECT PARSE_JSON('{"x": 1}') AS p, TO_JSON(STRUCT(1 AS a, 'x' AS b, [1.5] AS c)) AS t, TO_JSON(NUMERIC '1.10') AS n
expect:
  columns: p JSON, t JSON, n JSON
  ["{\"x\":1}","{\"a\":1,\"b\":\"x\",\"c\":[1.5]}","1.1"]

case to_json_row
query:
  SELECT TO_JSON(t) AS json FROM Teams t WHERE t.TeamId = 't3'
expect:
  columns: json JSON
  ["{\"Created\":\"2024-03-01T00:00:00Z\",\"CustomerId\":null,\"Name\":\"Gamma\",\"TeamId\":\"t3\"}"]

case to_json_subquery_row
query:
  SELECT TO_JSON(res) AS json FROM (SELECT TeamId, Name FROM Teams WHERE TeamId = @id) AS res
params:
  @id STRING = "t1"
expect:
  columns: json JSON
  ["{\"Name\":\"Alpha\",\"TeamId\":\"t1\"}"]

case json_typed_accessors
query:
  SELECT INT64(Data.size) AS size, STRING(Data.country) AS country, FLOAT64(Data.owner.share) AS share, BOOL(JSON 'true') AS b FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: size INT64, country STRING, share FLOAT64, b BOOL
  ["120","NO",0.5,true]

case json_type_and_keys
query:
  SELECT JSON_TYPE(Data.tags) AS t1, JSON_TYPE(Data.size) AS t2, JSON_TYPE(Data.nope) AS t3 FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: t1 STRING, t2 STRING, t3 STRING
  ["array","number",null]

case json_param
query:
  SELECT JSON_VALUE(@j, '$.k') AS k, @j AS j
params:
  @j JSON = {"k": "v", "a": [1]}
expect:
  columns: k STRING, j JSON
  ["v","{\"a\":[1],\"k\":\"v\"}"]

case json_compare_error
query:
  SELECT EntityId FROM Entities WHERE Data = JSON '{}'
expect:
  columns: EntityId STRING

case json_invalid_path
query:
  SELECT JSON_VALUE(Data, 'country') FROM Entities
expect:
  error: OUT_OF_RANGE
  message: JSONPath must start with '$'

case json_set_remove
query:
  SELECT JSON_SET(JSON '{"a":1}', '$.b', 2) AS s, JSON_REMOVE(JSON '{"a":1,"b":2}', '$.a') AS r
expect:
  columns: s JSON, r JSON
  ["{\"a\":1,\"b\":2}","{\"b\":2}"]

