# The AROUND operator (#122): `a AROUND b` without a distance, AROUND(n) bounds, order, phrases,
# chains and malformed operators. Row k (1 to 10) has k-1 words between alpha and omega.
tags: sql search
schema:
  CREATE TABLE D (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX DIdx ON D(Tok)
insert D cols=Id,Body:
  [1, "alpha omega"]
  [2, "alpha pad omega"]
  [3, "alpha pad pad omega"]
  [4, "alpha pad pad pad omega"]
  [5, "alpha pad pad pad pad omega"]
  [6, "alpha pad pad pad pad pad omega"]
  [7, "alpha pad pad pad pad pad pad omega"]
  [8, "alpha pad pad pad pad pad pad pad omega"]
  [9, "alpha pad pad pad pad pad pad pad pad omega"]
  [10, "alpha pad pad pad pad pad pad pad pad pad omega"]
  [11, "omega alpha"]
  [12, "omega pad pad alpha"]
  [13, "omega pad pad pad pad pad pad pad alpha"]
  [14, "alpha the of and omega"]
  [15, "alpha"]
  [16, "alpha alpha pad pad pad pad pad pad pad pad pad pad omega omega"]
  [20, "quick brown fox jumps over the lazy dog"]
  [21, "the lazy dog jumps over the quick brown fox"]
  [22, "fox fox"]
  [23, "fox"]
  [24, "brown quick fox"]

case default_distance
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'alpha AROUND omega') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["11"]
  ["12"]
  ["14"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'omega AROUND alpha') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["11"]
  ["12"]
  ["14"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'alpha  AROUND  omega') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `alpha AROUND omega`, has error(s): -Syntax error on column 8: Expecting 'AROUND(
expect@spanner:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["11"]
  ["12"]
  ["14"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'alpha around omega') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'alpha Around omega') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'fox AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["22"]

