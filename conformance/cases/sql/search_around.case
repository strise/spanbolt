case phrases
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick brown" AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick brown" AROUND(0) fox') ORDER BY Id
expect:
  columns: Id INT64
  ["20"]
  ["21"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND "lazy dog"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND(3) "lazy dog"') ORDER BY Id
expect:
  columns: Id INT64
  ["21"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick-brown AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick AROUND fox"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]

case chains
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND fox AROUND dog') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND(1) fox AROUND(6) dog') ORDER BY Id
expect:
  columns: Id INT64
  ["21"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND(1) fox AROUND dog') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick | lazy AROUND(1) fox') ORDER BY Id
expect:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND(1) fox | dog') ORDER BY Id
expect:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND fox jumps') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'alpha AROUND omega pad') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["12"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND fox OR alpha AROUND omega') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same

case malformed
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND -fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid use of negation found in search query. Negation may not be used within AROUND.
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '-quick AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid use of negation found in search query. Negation may not be used within AROUND.
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'AROUND') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND AROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND( 2 ) fox') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `quick AROUND( 2 ) fox`, has error(s): -Syntax error on column 14: Expecting '<NUMBER>
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND (2) fox') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `quick AROUND (2) fox`, has error(s): -Encountered error on column 14 while parsing: sub_expression. Using parentheses to group query terms is not supported in rquery parser.
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND(2)') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `quick AROUND(2)`, has error(s): -Syntax error on column 15: Expecting '<SEPARATOR>
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND() fox') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `quick AROUND() fox`, has error(s): -Syntax error on column 14: Expecting '<NUMBER>
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND | fox') ORDER BY Id
expect:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quick AROUND-fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'quickAROUND fox') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same

case quoted
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick brown AROUND fox"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick AROUND(1) fox"') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `"quick AROUND(1) fox"`, has error(s): -Encountered error on column 8 while parsing: term.
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"alpha AROUND(1) omega"') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `"alpha AROUND(1) omega"`, has error(s): -Encountered error on column 8 while parsing: term.
expect@spanner:
  columns: Id INT64
  ["1"]
  ["2"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"alpha AROUND omega"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["14"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"brown AROUND quick"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["24"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick AROUND"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"lazy dog AROUND quick brown"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM D WHERE SEARCH(Tok, '"quick" AROUND "fox"') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["20"]
  ["21"]
  ["24"]

