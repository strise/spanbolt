# Tokenizer options, rquery operators and edge cases, SNIPPET, SEARCH_SUBSTRING, dialects,
# TOKEN/TOKENIZE_NUMBER/TOKENIZE_BOOL/TOKENIZE_JSON columns and argument validation.
tags: sql search
schema:
  CREATE TABLE Docs (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Parts ARRAY<STRING(MAX)>,
    Code STRING(MAX),
    Amount INT64,
    Ratio FLOAT64,
    Flag BOOL,
    Meta JSON,
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body, language_tag => 'no', content_type => 'text/plain', token_category => 'small')) HIDDEN,
    Parts_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Parts)) HIDDEN,
    Body_Substr TOKENLIST AS (TOKENIZE_SUBSTRING(Body, ngram_size_min => 2, ngram_size_max => 5, relative_search_types => ['word_prefix', 'value_suffix', 'phrase'])) HIDDEN,
    Code_Substr TOKENLIST AS (TOKENIZE_SUBSTRING(Code, support_relative_search => true)) HIDDEN,
    Code_Ngrams TOKENLIST AS (TOKENIZE_NGRAMS(Code)) HIDDEN,
    Code_Token TOKENLIST AS (TOKEN(Code)) HIDDEN,
    Amount_Tokens TOKENLIST AS (TOKENIZE_NUMBER(Amount, comparison_type => 'all', min => 0, max => 1000, granularity => 10)) HIDDEN,
    Ratio_Tokens TOKENLIST AS (TOKENIZE_NUMBER(Ratio, algorithm => 'floatingpoint')) HIDDEN,
    Flag_Tokens TOKENLIST AS (TOKENIZE_BOOL(Flag)) HIDDEN,
    Meta_Tokens TOKENLIST AS (TOKENIZE_JSON(Meta)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX DocsSearch ON Docs(Body_Tokens, Parts_Tokens, Body_Substr) STORING (Amount) PARTITION BY Flag ORDER BY Id;
  CREATE SEARCH INDEX DocsCodes ON Docs(Code_Token, Amount_Tokens, Flag_Tokens, Meta_Tokens)
insert Docs cols=Id,Body,Parts,Code,Amount,Ratio,Flag,Meta:
  [1, "Cloud Spanner emulator runs on Google Cloud", ["cloud spanner", "emulator"], "ABC-123/x", 10, 0.5, true, {"a": 1}]
  [2, "The quick brown fox jumps over the lazy dog", ["quick fox", "lazy dog"], "XYZ.987", 500, 1.25, false, null]
  [3, "Spanner: the emulator is not Spanner itself.", [], "abc", 999, -2.0, true, {"b": [1, 2]}]
  [4, "", null, null, null, null, null, null]
  [5, null, ["", "solo"], "", 0, 0.0, false, {}]

case and_operator
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'spanner emulator')
expect:
  columns: Id INT64
  ["3"]
  ["1"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: SEARCH is not supported in this query. Possible reasons are: There is no appropriate search index to use, or the function is used in unsupported query shapes. You can get more details on why a specific search index cannot be used by adding @{force_index} hint to the query.

