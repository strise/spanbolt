# Entity search shapes: fulltext over name/aliases/identifiers, weighted SCORE, quoted
# legal-form synonyms joined with OR, identifier lookups and the trigram (ngram) fallback.
tags: sql search
schema:
  CREATE TABLE granite_no (
    id STRING(MAX) NOT NULL,
    is_slim BOOL,
    entity_kind STRING(MAX),
    identifiers ARRAY<STRING(MAX)>,
    name STRING(MAX),
    aliases ARRAY<STRING(MAX)>,
    countries ARRAY<STRING(2)>,
    primary_country STRING(2),
    num_connections INT64,
    is_stale BOOL,
    aliases_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(aliases)) HIDDEN,
    name_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(name)) HIDDEN,
    identifiers_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(identifiers)) HIDDEN,
    name_ngram_tokens TOKENLIST AS (TOKENIZE_NGRAMS(name, ngram_size_max => 3, ngram_size_min => 3)) HIDDEN,
  ) PRIMARY KEY (id);
  CREATE TABLE granite_se (
    id STRING(MAX) NOT NULL,
    is_slim BOOL,
    entity_kind STRING(MAX),
    identifiers ARRAY<STRING(MAX)>,
    name STRING(MAX),
    aliases ARRAY<STRING(MAX)>,
    countries ARRAY<STRING(2)>,
    primary_country STRING(2),
    num_connections INT64,
    is_stale BOOL,
    aliases_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(aliases)) HIDDEN,
    name_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(name)) HIDDEN,
    identifiers_tokens TOKENLIST AS (TOKENIZE_FULLTEXT(identifiers)) HIDDEN,
  ) PRIMARY KEY (id);
  CREATE SEARCH INDEX idx_granite_no_search ON granite_no(name_tokens, aliases_tokens, identifiers_tokens) STORING (is_stale, is_slim, primary_country, entity_kind, num_connections, countries);
  CREATE SEARCH INDEX idx_granite_no_ngram ON granite_no(name_ngram_tokens) STORING (is_stale, is_slim, primary_country, entity_kind, num_connections, countries);
  CREATE SEARCH INDEX idx_granite_se_search ON granite_se(name_tokens, aliases_tokens, identifiers_tokens) STORING (is_stale, is_slim, primary_country, entity_kind, num_connections, countries)
insert granite_no cols=id,is_slim,entity_kind,identifiers,name,aliases,countries,primary_country,num_connections,is_stale:
  ["no-1", false, "company", ["NO900000001"], "Fjordkraft Testselskap AS", ["Fjordkraft"], ["NO"], "NO", 12, false]
  ["no-2", false, "company", ["NO900000002", "900000002"], "Coca-Cola Testbryggeri AS", ["Coca Cola Norge"], ["NO"], "NO", 40, false]
  ["no-3", false, "company", ["NO900000003"], "Nordlys Holding AS", [], ["NO", "SE"], "NO", 3, false]
  ["no-4", false, "person", [], "Ola Testmann", ["Ola T. Testmann"], ["NO"], "NO", 2, false]
  ["no-5", true, "company", ["NO900000005"], "Nordlys Invest ASA", null, ["NO"], "NO", null, false]
  ["no-6", false, "company", ["NO900000006"], "Bjørn Åse Ærlig AS", ["Bjorn Ase Aerlig"], ["NO"], "NO", 0, true]
  ["no-7", false, "person", null, "Kari Testdatter", null, null, null, 7, null]
  ["no-8", false, "company", ["NO900000008"], "Acme Shipping A/S", ["Acme Shipping Aksjeselskap"], ["NO", "DK"], "NO", 25, false]
  ["no-9", false, "company", [], null, ["Ghost Company"], [], "NO", 1, false]
insert granite_se cols=id,is_slim,entity_kind,identifiers,name,aliases,countries,primary_country,num_connections,is_stale:
  ["se-1", false, "company", ["SE5560000001"], "Nordlys Holding AB", ["Nordlys Aktiebolag"], ["SE"], "SE", 9, false]
  ["se-2", false, "company", ["SE5560000002"], "Coca-Cola Sverige AB", [], ["SE"], "SE", 30, false]
  ["se-3", false, "person", [], "Ola Testmann", [], ["SE"], "SE", 1, false]

case quoted_name_or_alias
query:
  SELECT id FROM granite_no WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery) OR SEARCH(identifiers_tokens, @trimmedQuery))
params:
  @quotedQuery STRING = "\"Coca-Cola AS\" OR \"Coca-Cola A/S\" OR \"Coca-Cola Aksjeselskap\""
  @trimmedQuery STRING = "CocaColaAS"
expect:
  columns: id STRING
expect@spanner:
  same

case quoted_phrase_does_not_match_partial
query:
  SELECT id FROM granite_no WHERE SEARCH(name_tokens, @q)
params:
  @q STRING = "\"Coca-Cola AS\""
expect:
  columns: id STRING
expect@spanner:
  same

