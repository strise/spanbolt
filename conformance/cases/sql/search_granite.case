expect@spanner:
  same

case ngram_min_ngrams_named
query:
  SELECT id FROM granite_no WHERE SEARCH_NGRAMS(name_ngram_tokens, 'testmann', min_ngrams => 5)
expect:
  columns: id STRING
  ["no-4"]
expect@spanner:
  same

case force_search_index_with_storing
query:
  SELECT id, primary_country, num_connections FROM granite_no@{FORCE_INDEX=idx_granite_no_search} WHERE SEARCH(name_tokens, 'nordlys')
expect:
  columns: id STRING, primary_country STRING, num_connections INT64
  ["no-5","NO",null]
  ["no-3","NO","3"]
expect@spanner:
  same

# Prod requires a matching SEARCH predicate for SCORE (ESCORER_SCORE). Same query as
# score_raw_query_counts_terms with the predicate added, to record prod's SCORE values.

case score_with_search_predicate
tags: oracle2
query:
  SELECT id, SCORE(name_tokens, @query) AS s FROM granite_no WHERE SEARCH(name_tokens, @query) ORDER BY id
params:
  @query STRING = "Nordlys Holding AS"
expect:
  columns: id STRING, s FLOAT64
  ["no-3",3.0]
expect@spanner:
  columns: id STRING, s FLOAT64
  ["no-3",3.2661805152893066]

case score_single_term_with_search_predicate
tags: oracle2
query:
  SELECT id, SCORE(name_tokens, 'nordlys') AS s FROM granite_no WHERE SEARCH(name_tokens, 'nordlys') ORDER BY id
expect:
  columns: id STRING, s FLOAT64
  ["no-3",1.0]
  ["no-5",1.0]
expect@spanner:
  columns: id STRING, s FLOAT64
  ["no-3",1.2588917016983032]
  ["no-5",1.2588917016983032]

case score_or_query_two_columns
tags: oracle2
query:
  SELECT id, SCORE(name_tokens, @query) AS s, SCORE(aliases_tokens, @query) AS a FROM granite_no WHERE SEARCH(name_tokens, @query) OR SEARCH(aliases_tokens, @query) ORDER BY id
params:
  @query STRING = "nordlys OR fjordkraft"
expect:
  columns: id STRING, s FLOAT64, a FLOAT64
  ["no-1",1.0,1.0]
  ["no-3",1.0,0.0]
  ["no-5",1.0,0.0]
expect@spanner:
  columns: id STRING, s FLOAT64, a FLOAT64
  ["no-1",1.2704493999481201,1.2704493999481201]
  ["no-3",1.2704493999481201,0.0]
  ["no-5",1.2704493999481201,0.0]
