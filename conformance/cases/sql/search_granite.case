params:
  @trimmedQuery STRING = "900000002"
expect:
  columns: id STRING, is_slim BOOL, entity_kind STRING, identifiers ARRAY<STRING>, name STRING, aliases ARRAY<STRING>, countries ARRAY<STRING>, primary_country STRING, num_connections INT64, is_stale BOOL, relevance_score FLOAT64
  ["no-2",false,"company",["NO900000002","900000002"],"Coca-Cola Testbryggeri AS",["Coca Cola Norge"],["NO"],"NO","40",false,10000.0]
expect@spanner:
  same

case identifier_with_prefix
query:
  SELECT id FROM granite_no AS t WHERE SEARCH(identifiers_tokens, @trimmedQuery)
params:
  @trimmedQuery STRING = "NO900000003"
expect:
  columns: id STRING
  ["no-3"]
expect@spanner:
  same

case identifier_list_or
query:
  SELECT id FROM granite_no AS t WHERE SEARCH(identifiers_tokens, @identifiersQueryStr)
params:
  @identifiersQueryStr STRING = "NO900000001 OR NO900000008 OR NO000000000"
expect:
  columns: id STRING
