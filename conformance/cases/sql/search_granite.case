expect@spanner:
  same

case weighted_relevance_score
query:
  SELECT id,
    (
      COALESCE(SCORE(identifiers_tokens, @trimmedQuery ) * 10.0, 0) +
      COALESCE(SCORE(name_tokens,        @query ) * 5.0, 0) +
      COALESCE(SCORE(aliases_tokens,     @query ) * 2.0, 0) +
      case when lower(entity_kind) = 'company' then 1.0 else 0.0 end +
      LN(coalesce(num_connections, 0) + 1) * 1.5
      + 1
    ) AS relevance_score
  FROM granite_no AS t
  WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery) OR SEARCH(identifiers_tokens, @trimmedQuery))
  ORDER BY relevance_score DESC, id
  LIMIT 100
params:
  @query STRING = "Nordlys Holding AS"
  @trimmedQuery STRING = "NordlysHoldingAS"
  @quotedQuery STRING = "\"Nordlys Holding AS\" OR \"Nordlys Holding A/S\" OR \"Nordlys Holding Aksjeselskap\""
expect:
  columns: id STRING, relevance_score FLOAT64
  ["no-3",19.079441541679834]
expect@spanner:
  columns: id STRING, relevance_score FLOAT64
  ["no-3",20.410344118126368]

case score_raw_query_counts_terms
query:
  SELECT id, SCORE(name_tokens, @query) AS s, SCORE(aliases_tokens, @query) AS a FROM granite_no ORDER BY id
params:
  @query STRING = "Nordlys Holding AS"
expect:
  columns: id STRING, s FLOAT64, a FLOAT64
  ["no-1",1.0,0.0]
  ["no-2",1.0,0.0]
  ["no-3",3.0,0.0]
  ["no-4",0.0,0.0]
  ["no-5",1.0,0.0]
  ["no-6",1.0,0.0]
  ["no-7",0.0,0.0]
  ["no-8",0.0,0.0]
  ["no-9",0.0,0.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: ESCORER_SCORE: This function may only be used with a compatible SEARCH predicate

case score_null_source
query:
  SELECT id, SCORE(name_tokens, 'ghost') AS s, SCORE(aliases_tokens, 'ghost') AS a FROM granite_no WHERE id = 'no-9'
expect:
  columns: id STRING, s FLOAT64, a FLOAT64
  ["no-9",0.0,1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: ESCORER_SCORE: This function may only be used with a compatible SEARCH predicate

case score_on_null_array
query:
  SELECT id, SCORE(aliases_tokens, 'nordlys') AS a FROM granite_no WHERE id IN ('no-5', 'no-7')
expect:
  columns: id STRING, a FLOAT64
  ["no-5",0.0]
  ["no-7",0.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: ESCORER_SCORE: This function may only be used with a compatible SEARCH predicate

case search_null_array_column
query:
  SELECT id, SEARCH(aliases_tokens, 'nordlys') AS hit FROM granite_no WHERE id IN ('no-5', 'no-7', 'no-3')
expect:
  columns: id STRING, hit BOOL
  ["no-3",false]
  ["no-5",null]
  ["no-7",null]
expect@spanner:
  error: INVALID_ARGUMENT
  message: The function SEARCH can only be used in a WHERE clause.

case union_of_markets_with_filters
query:
  WITH full_text_match AS (
    SELECT * FROM (
      (SELECT id, is_slim, is_stale, primary_country, entity_kind FROM granite_no AS t
       WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery) OR SEARCH(identifiers_tokens, @trimmedQuery)))
      UNION ALL
      (SELECT id, is_slim, is_stale, primary_country, entity_kind FROM granite_se AS t
       WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery) OR SEARCH(identifiers_tokens, @trimmedQuery)))
    ) AS t
  )
  SELECT id FROM full_text_match
  WHERE (is_stale = FALSE OR is_stale IS NULL)
  AND (is_slim = FALSE OR is_slim IS NULL)
  AND primary_country IN UNNEST(@primaryCountries)
params:
  @quotedQuery STRING = "\"Nordlys Holding AB\" OR \"Nordlys Holding Aktiebolag\" OR \"Nordlys\""
  @trimmedQuery STRING = "NordlysHoldingAB"
  @primaryCountries ARRAY<STRING> = ["NO", "SE"]
expect:
  columns: id STRING
  ["se-1"]
  ["no-3"]
expect@spanner:
  same

case all_matches_group_by_max
query:
  WITH id_match AS (
    SELECT id, 1000000.0 AS relevance_score FROM granite_no AS t WHERE id = @query
  ),
  full_text_match AS (
    SELECT id, (COALESCE(SCORE(name_tokens, @query) * 5.0, 0) + 1) AS relevance_score
    FROM granite_no AS t
    WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery))
    ORDER BY relevance_score DESC
    LIMIT 100
  ),
  all_matches AS (
    SELECT id, MAX(relevance_score) AS relevance_score FROM (
      SELECT id, relevance_score FROM id_match
      UNION ALL SELECT id, relevance_score FROM full_text_match
    )
    GROUP BY id
  )
  SELECT am.id, am.relevance_score, t.name
  FROM all_matches am
  INNER JOIN granite_no t USING (id)
  ORDER BY relevance_score DESC, id
  LIMIT @limit
params:
  @query STRING = "Fjordkraft"
  @quotedQuery STRING = "\"Fjordkraft\""
  @limit INT64 = 50
expect:
  columns: id STRING, relevance_score FLOAT64, name STRING
  ["no-1",6.0,"Fjordkraft Testselskap AS"]
expect@spanner:
  columns: id STRING, relevance_score FLOAT64, name STRING
  ["no-1",7.294458508491516,"Fjordkraft Testselskap AS"]

case countries_exists_filter
query:
  SELECT id FROM granite_no AS t
  WHERE SEARCH(name_tokens, @q)
  AND (countries IS NULL OR ARRAY_LENGTH(countries) = 0 OR EXISTS (SELECT 1 FROM UNNEST(countries) AS c WHERE c NOT IN UNNEST(@localMarkets)))
params:
  @q STRING = "nordlys"
  @localMarkets ARRAY<STRING> = ["NO"]
expect:
  columns: id STRING
  ["no-3"]
expect@spanner:
  same

case count_by_kind
query:
  WITH matches AS (
    SELECT DISTINCT id, entity_kind FROM granite_no AS t
    WHERE (SEARCH(name_tokens, @quotedQuery) OR SEARCH(aliases_tokens, @quotedQuery) OR SEARCH(identifiers_tokens, @trimmedQuery))
    AND (is_stale = FALSE OR is_stale IS NULL)
  )
  SELECT LOWER(entity_kind) AS entity_kind, COUNT(*) AS cnt FROM matches GROUP BY LOWER(entity_kind)
params:
  @quotedQuery STRING = "\"testmann\" OR \"nordlys\" OR \"testdatter\""
  @trimmedQuery STRING = "testmann"
expect:
  columns: entity_kind STRING, cnt INT64
  ["person","2"]
  ["company","2"]
expect@spanner:
  same

case ngram_match_percent
query:
  SELECT id FROM granite_no AS t WHERE SEARCH_NGRAMS(name_ngram_tokens, @ngramQuery, min_ngrams_percent => 40.0)
params:
  @ngramQuery STRING = "Fjordkraf Testselskp"
expect:
  columns: id STRING
  ["no-1"]
expect@spanner:
  same

case ngram_typo_recall
query:
  SELECT id FROM granite_no AS t WHERE SEARCH_NGRAMS(name_ngram_tokens, @ngramQuery, min_ngrams_percent => 40.0)
params:
  @ngramQuery STRING = "Nordlis"
expect:
  columns: id STRING
  ["no-5"]
  ["no-3"]
expect@spanner:
  same

case ngram_default_min_ngrams
query:
  SELECT id FROM granite_no AS t WHERE SEARCH_NGRAMS(name_ngram_tokens, @ngramQuery)
params:
  @ngramQuery STRING = "acmx"
expect:
  columns: id STRING
expect@spanner:
  same

case ngram_score_order
query:
  SELECT id,
    (COALESCE(SCORE_NGRAMS(name_ngram_tokens, @ngramQuery) * 8.0, 0) +
     case when lower(entity_kind) = 'company' then 1.0 else 0.0 end +
     coalesce(num_connections, 0) * 0.01) AS relevance_score
  FROM granite_no AS t
  WHERE SEARCH_NGRAMS(name_ngram_tokens, @ngramQuery, min_ngrams_percent => 40.0)
  ORDER BY relevance_score DESC, id
  LIMIT 100
params:
  @ngramQuery STRING = "Nordlys"
expect:
  columns: id STRING, relevance_score FLOAT64
  ["no-3",3.53]
  ["no-5",3.5]
expect@spanner:
  columns: id STRING, relevance_score FLOAT64
  ["no-3",3.8299999999999996]
  ["no-5",3.8]

case ngram_score_values
query:
  SELECT id, SCORE_NGRAMS(name_ngram_tokens, @q) AS s FROM granite_no WHERE id IN ('no-1', 'no-3', 'no-6', 'no-9')
params:
  @q STRING = "Nordlys Holdings"
expect:
  columns: id STRING, s FLOAT64
  ["no-9",0.0]
  ["no-3",0.7647058823529411]
  ["no-1",0.027777777777777776]
  ["no-6",0.0]
expect@spanner:
  columns: id STRING, s FLOAT64
  ["no-1",0.023809523809523808]
  ["no-3",0.7142857142857143]
  ["no-6",0.0]
  ["no-9",0.0]

case ngram_norwegian_letters
query:
  SELECT id FROM granite_no WHERE SEARCH_NGRAMS(name_ngram_tokens, @q, min_ngrams_percent => 40.0)
params:
  @q STRING = "Bjørn Ærlig"
expect:
  columns: id STRING
  ["no-6"]
expect@spanner:
