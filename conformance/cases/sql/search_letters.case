  ["26","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4}],\"snippet\":\"ß x y\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"ß x y\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ß x y\"}]}"]
  ["27","{\"snippets\":[{\"highlights\":[],\"snippet\":\"1x y z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4}],\"snippet\":\"1x y z\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"1x y z\"}]}"]
  ["28","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x\"}]}"]

case snippet_query
query:
  SELECT SNIPPET('xy x y xyz yx i ix', "x y") AS q0, SNIPPET('xy x y xyz yx i ix', "y x") AS q1, SNIPPET('xy x y xyz yx i ix', "x y z") AS q2, SNIPPET('xy x y xyz yx i ix', "x-y") AS q3, SNIPPET('xy x y xyz yx i ix', "\"x y\"") AS q4, SNIPPET('xy x y xyz yx i ix', "x OR y") AS q5, SNIPPET('xy x y xyz yx i ix', "x AROUND y") AS q6, SNIPPET('xy x y xyz yx i ix', "x y -z") AS q7, SNIPPET('xy x y xyz yx i ix', "ix") AS q8
expect:
  columns: q0 JSON, q1 JSON, q2 JSON, q3 JSON, q4 JSON, q5 JSON, q6 JSON, q7 JSON, q8 JSON
  ["{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":19,\"start_position\":17}],\"snippet\":\"xy x y xyz yx i ix\"}]}"]

case snippet_width
query:
  SELECT SNIPPET('one x y z two', 'xyz', max_snippet_width => 7) AS a, SNIPPET('one U.S.A. two', 'usa', max_snippet_width => 9) AS b, SNIPPET('one x-y two', 'x y', max_snippet_width => 6) AS c
expect:
  columns: a JSON, b JSON, c JSON
  ["{\"snippets\":[{\"highlights\":[],\"snippet\":\"one x\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"one U.S\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x-y\"}]}"]
