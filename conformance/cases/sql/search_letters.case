# Runs of single letters in fulltext search (#86). Cloud Spanner's TOKENIZE_FULLTEXT joins runs
# of single ASCII letters into one token (`x y z w` is xyzw, `b c` is bc), reads SEARCH queries
# the same way (`'x y'` looks for xy) and shows the joined text in SNIPPET; the emulator keeps
# every letter a token. The rule is `joined_letters` in crates/sql/src/search/tokens.rs; the
# other files are search_letters_separators.case and search_letters_case.case.
tags: sql search
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
  [1, "x y z w"]
  [2, "q b c"]
  [3, "hello b c world"]
  [4, "x yz w"]
  [5, "x, y z"]
  [6, "x-y z"]
  [7, "1 2 3"]
  [8, "x 1 y"]
  [9, "x"]
  [10, "hello x world"]
  [11, "X Y"]
  [12, "é f g"]
  [13, "x  y\nz"]
  [14, "ab c d"]
  [15, "x y z w, then more"]
  [16, "b. c"]
  [17, "hello q"]
  [18, "q hello"]
  [19, "x y z w v u t s r"]
  [20, "b c d e f g h ij k l"]

case tokens
query:
  SELECT Id, DEBUG_TOKENLIST(Tok) AS t FROM T ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["1","xyzw(boundary, end_boundary)"]
  ["2","qbc(boundary, end_boundary)"]
  ["3","hello(boundary), bc, world(end_boundary)"]
  ["4","x(boundary), yz, w(end_boundary)"]
  ["5","x(boundary), yz(end_boundary)"]
  ["6","xy(boundary), z(end_boundary)"]
  ["7","1(boundary), 2, 3(end_boundary)"]
  ["8","x(boundary), 1, y(end_boundary)"]
  ["9","x(boundary, end_boundary)"]
  ["10","hello(boundary), x, world(end_boundary)"]
  ["11","xy(boundary, end_boundary)"]
  ["12","é(boundary), fg(end_boundary)"]
  ["13","xy(boundary), z(end_boundary)"]
  ["14","ab(boundary), cd(end_boundary)"]
  ["15","xyzw(boundary), then, more(end_boundary)"]
  ["16","b(boundary), c(end_boundary)"]
  ["17","hello(boundary), q(end_boundary)"]
  ["18","q(boundary), hello(end_boundary)"]
  ["19","xyzwvutsr(boundary, end_boundary)"]
  ["20","bcdefgh(boundary), ij, kl(end_boundary)"]

case snip
query:
  SELECT Id, SNIPPET(Body, 'x') AS sx, SNIPPET(Body, 'xyzw') AS sxyzw, SNIPPET(Body, 'bc') AS sbc, SNIPPET(Body, 'zzz') AS snone FROM T ORDER BY Id
expect:
  columns: Id INT64, sx JSON, sxyzw JSON, sbc JSON, snone JSON
  ["1","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x y z w\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x y z w\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x y z w\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x y z w\"}]}"]
