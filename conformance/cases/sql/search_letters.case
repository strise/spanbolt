  ["21","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x y.\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x y.\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x y.\"}]}"]
  ["22","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x.y. z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x.y. z\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x.y. z\"}]}"]
