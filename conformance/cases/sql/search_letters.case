# Runs of single letters in fulltext search. Cloud Spanner's tokenizer joins them into one token
# (`x y z` is xyz, `U.S.A.` is usa, `x-y` is xy), reads SEARCH and SCORE queries the same way
# (`'x y'` looks for xy) and shows them joined in SNIPPET. The emulator keeps every letter a
# token. The rule (`joined_letters` in crates/sql/src/search/tokens.rs) is fitted to these
# recordings: `.`/`-` runs whatever the case, space runs only between letters of the same case
# and never with an initial (`y.`), at most 21 letters per token.
tags: sql search
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok);
  CREATE TABLE Q (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX QIdx ON Q(Tok)
insert T cols=Id,Body:
  [1, "x y z w, then more"]
  [2, "b c"]
  [3, "hello b c world"]
  [4, "x yz w"]
  [5, "x, y z"]
  [6, "x-y z"]
  [7, "1 2 3"]
  [8, "X Y"]
  [9, "é f g"]
  [10, "x  y\nz"]
  [11, "ab c d"]
  [12, "b. c"]
  [13, "x\ty"]
  [14, "U.S.A. today"]
  [15, "x.y.z"]
  [16, "x-y-zz"]
  [17, "x.-y"]
  [18, "I J"]
  [19, "x I y"]
  [20, "Z x y"]
  [21, "x y."]
  [22, "x.y. z"]
  [23, "x y-z"]
  [24, "a b c d e f g h i j k l m n o p q r s t u v w x y z"]
  [25, "x y!"]
  [26, "ß x y"]
  [27, "1x y z"]
  [28, "x"]
insert Q cols=Id,Body:
  [1, "xy"]
  [2, "x"]
  [3, "y"]
  [4, "xyz"]
  [5, "z"]
  [6, "yx"]
  [7, "x hello y"]
  [8, "hello"]

case tokens
query:
  SELECT Id, DEBUG_TOKENLIST(Tok) AS t FROM T ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]

case search_text
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "x") ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["4"]
  ["5"]
  ["6"]
  ["8"]
  ["10"]
  ["13"]
  ["15"]
  ["16"]
  ["17"]
  ["19"]
  ["20"]
  ["21"]
  ["22"]
  ["23"]
  ["24"]
  ["25"]
  ["26"]
  ["28"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "y") ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["5"]
  ["6"]
  ["8"]
  ["10"]
  ["13"]
  ["15"]
  ["16"]
  ["17"]
  ["19"]
  ["20"]
  ["21"]
  ["22"]
  ["23"]
  ["24"]
  ["25"]
  ["26"]
  ["27"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "xyzw") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "b") ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
  ["3"]
  ["12"]
  ["24"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "bc") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "xy") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "z") ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["5"]
  ["6"]
  ["10"]
  ["15"]
  ["20"]
  ["22"]
  ["23"]
  ["24"]
  ["27"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "usa") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "xyz") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "ij") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "i") ORDER BY Id
expect:
  columns: Id INT64
  ["18"]
  ["19"]
  ["24"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "abcdefghijklmnopqrstu") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "vwxyz") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "yz") ORDER BY Id
expect:
  columns: Id INT64
  ["4"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, "e") ORDER BY Id
expect:
  columns: Id INT64
  ["24"]

case search_query
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "y x") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y z") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "X Y") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x-y") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x.y") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x.Y") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x-y-z") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "\"x y\"") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x  y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x y`, has error(s): -Syntax error on column 4: Expecting 'AROUND(
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "(x y)") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `(x y)`, has error(s): -Encountered error on column 1 while parsing: sub_expression. Using parentheses to group query terms is not supported in rquery parser.
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x -y") ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x -y z") ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y -z") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x OR y") ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
  ["3"]
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y OR z") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x | y") ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
  ["3"]
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x* y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x* y`, has error(s): -Syntax error on column 4: Expecting 'AROUND(
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x (y)") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x (y)`, has error(s): -Encountered error on column 3 while parsing: sub_expression. Using parentheses to group query terms is not supported in rquery parser.
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x\ty") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y,") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x, y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x, y`, has error(s): -Syntax error on column 4: Expecting 'AROUND(
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x - y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x - y`, has error(s): -Encountered error on column 4 while parsing: sub_expression.

case search_words
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y", dialect => 'words') ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "y x", dialect => 'words') ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x hello y", dialect => 'words') ORDER BY Id
expect:
  columns: Id INT64
  ["7"]

case search_words_phrase
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y", dialect => 'words_phrase') ORDER BY Id
expect:
  columns: Id INT64
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x hello y", dialect => 'words_phrase') ORDER BY Id
expect:
  columns: Id INT64
  ["7"]

case score
query:
  SELECT Id, SCORE(Tok, 'x y') AS a, SCORE(Tok, 'xy') AS b FROM Q WHERE SEARCH(Tok, 'xy') ORDER BY Id
expect:
  columns: Id INT64, a FLOAT64, b FLOAT64
  ["1",0.0,1.0]

case snippet
query:
  SELECT Id, SNIPPET(Body, 'x') AS x, SNIPPET(Body, 'x y') AS xy, SNIPPET(Body, 'xyzw') AS xyzw FROM T ORDER BY Id
expect:
  columns: Id INT64, x JSON, xy JSON, xyzw JSON
  ["1","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x y z w, then more\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x y z w, then more\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x y z w, then more\"}]}"]
  ["2","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b c\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b c\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b c\"}]}"]
  ["3","{\"snippets\":[{\"highlights\":[],\"snippet\":\"hello b c world\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"hello b c world\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"hello b c world\"}]}"]
  ["4","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x yz w\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x yz w\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x yz w\"}]}"]
  ["5","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x, y z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":5,\"start_position\":4}],\"snippet\":\"x, y z\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x, y z\"}]}"]
  ["6","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x-y z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x-y z\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x-y z\"}]}"]
  ["7","{\"snippets\":[{\"highlights\":[],\"snippet\":\"1 2 3\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"1 2 3\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"1 2 3\"}]}"]
  ["8","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"X Y\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"X Y\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"X Y\"}]}"]
  ["9","{\"snippets\":[{\"highlights\":[],\"snippet\":\"é f g\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"é f g\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"é f g\"}]}"]
  ["10","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x  y\\nz\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":5,\"start_position\":4}],\"snippet\":\"x  y\\nz\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x  y\\nz\"}]}"]
  ["11","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ab c d\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ab c d\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ab c d\"}]}"]
  ["12","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b. c\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b. c\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"b. c\"}]}"]
  ["13","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x\\ty\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x\\ty\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x\\ty\"}]}"]
  ["14","{\"snippets\":[{\"highlights\":[],\"snippet\":\"U.S.A. today\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"U.S.A. today\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"U.S.A. today\"}]}"]
  ["15","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x.y.z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1},{\"end_position\":4,\"start_position\":3}],\"snippet\":\"x.y.z\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"x.y.z\"}]}"]
