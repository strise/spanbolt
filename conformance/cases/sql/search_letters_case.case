# Runs of single letters (#86): case, initials and length. Space-separated letters join only
# when they have the same case (`I J` is ij, `x I` stays apart); a letter right before a `.` is
# an initial and joins nothing (`x y.`); `.`/`-` runs ignore case; a token holds at most 21
# letters. See search_letters.case.
tags: sql search
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok);
  CREATE TABLE Q (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX QIdx ON Q(Tok)
insert T cols=Id,Body:
  [1, "X y"]
  [2, "x Y"]
  [3, "I J"]
  [4, "i x"]
  [5, "x I"]
  [6, "a B c"]
  [7, "I am"]
  [8, "x I y"]
  [9, "A b"]
  [10, "Q b"]
  [11, "x i"]
  [12, "i j"]
  [13, "I a"]
  [14, "x. y"]
  [15, "x.y. z"]
  [16, "x-y. z"]
  [17, "U.S. A"]
  [18, "x.-y"]
  [19, "x-.y"]
  [20, "(x y)"]
  [21, "\"x y\""]
  [22, "x y."]
  [23, "x y, z"]
  [24, "x y!"]
  [25, "x.y z"]
  [26, "x y.z"]
  [27, "x-1"]
  [28, "1-x"]
  [29, "x/y z"]
  [30, "x y/z"]
  [31, "x-y-zz"]
  [32, "xx-y"]
  [33, "x-yy"]
  [34, "X-Y"]
  [35, "x.Y"]
  [36, "x--y z"]
  [37, "- x y"]
  [38, "x y -"]
  [39, "a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p.q.r.s.t.u.v.w.x.y.z"]
  [40, "a b c d e f g h i j k l m n o p q r s t u v w x y z"]
  [41, "x y z w v u t s r q p o n m l k j i h g f e d c b a x y z w v u t s r q p o n m l k j i h g f e d c b a"]
  [42, "x."]
  [43, "X."]
  [44, "i."]
  [45, "x-"]
  [46, "-x"]
  [47, "x.y-z"]
  [48, "x-y.z"]
  [49, "x . y"]
  [50, "x . y z"]
  [51, "A.B c"]
  [52, "x y Z"]
  [53, "Z x y"]
  [54, "x y I"]
  [55, "I x y"]
  [56, "I"]
  [57, "x Y z"]
  [58, "X y Z"]
  [59, "xy Z w"]
insert Q cols=Id,Body:
  [1, "xy"]
  [2, "x"]
  [3, "y"]
  [4, "xyz"]
  [5, "z"]
  [6, "yx"]
  [7, "x hello y"]
  [8, "hello"]
  [9, "xyhello"]
  [10, "i"]
  [11, "ix"]

case tokens
query:
  SELECT Id, Body, DEBUG_TOKENLIST(Tok) AS t FROM T ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:18]
expect@spanner:
  columns: Id INT64, Body STRING, t STRING
  ["1","X y","x(boundary), y(end_boundary)"]
  ["2","x Y","x(boundary), y(end_boundary)"]
  ["3","I J","ij(boundary, end_boundary)"]
  ["4","i x","ix(boundary, end_boundary)"]
  ["5","x I","x(boundary), i(end_boundary)"]
  ["6","a B c","a(boundary), b, c(end_boundary)"]
  ["7","I am","i(boundary), am(end_boundary)"]
  ["8","x I y","x(boundary), i, y(end_boundary)"]
  ["9","A b","a(boundary), b(end_boundary)"]
  ["10","Q b","q(boundary), b(end_boundary)"]
  ["11","x i","xi(boundary, end_boundary)"]
  ["12","i j","ij(boundary, end_boundary)"]
  ["13","I a","i(boundary), a(end_boundary)"]
  ["14","x. y","x(boundary), y(end_boundary)"]
  ["15","x.y. z","xy(boundary), z(end_boundary)"]
  ["16","x-y. z","xy(boundary), z(end_boundary)"]
  ["17","U.S. A","us(boundary), a(end_boundary)"]
  ["18","x.-y","x(boundary), y(end_boundary)"]
  ["19","x-.y","x(boundary), y(end_boundary)"]
  ["20","(x y)","xy(boundary, end_boundary)"]
  ["21","\"x y\"","xy(boundary, end_boundary)"]
  ["22","x y.","x(boundary), y(end_boundary)"]
  ["23","x y, z","xy(boundary), z(end_boundary)"]
  ["24","x y!","xy(boundary, end_boundary)"]
  ["25","x.y z","xy(boundary), z(end_boundary)"]
  ["26","x y.z","x(boundary), yz(end_boundary)"]
  ["27","x-1","x(boundary), 1(end_boundary)"]
  ["28","1-x","1(boundary), x(end_boundary)"]
  ["29","x/y z","x(boundary), yz(end_boundary)"]
  ["30","x y/z","xy(boundary), z(end_boundary)"]
  ["31","x-y-zz","xy(boundary), zz(end_boundary)"]
  ["32","xx-y","xx(boundary), y(end_boundary)"]
  ["33","x-yy","x(boundary), yy(end_boundary)"]
  ["34","X-Y","xy(boundary, end_boundary)"]
  ["35","x.Y","xy(boundary, end_boundary)"]
  ["36","x--y z","x(boundary), --, yz(end_boundary)"]
  ["37","- x y","xy(boundary, end_boundary)"]
  ["38","x y -","xy(boundary, end_boundary)"]
  ["39","a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p.q.r.s.t.u.v.w.x.y.z","abcdefghijklmnopqrstu(boundary), vwxyz(end_boundary)"]
  ["40","a b c d e f g h i j k l m n o p q r s t u v w x y z","abcdefghijklmnopqrstu(boundary), vwxyz(end_boundary)"]
  ["41","x y z w v u t s r q p o n m l k j i h g f e d c b a x y z w v u t s r q p o n m l k j i h g f e d c b a","xyzwvutsrqponmlkjihgf(boundary), edcbaxyzwvutsrqponmlk, jihgfedcba(end_boundary)"]
  ["42","x.","x(boundary, end_boundary)"]
  ["43","X.","x(boundary, end_boundary)"]
  ["44","i.","i(boundary, end_boundary)"]
  ["45","x-","x(boundary, end_boundary)"]
  ["46","-x","x(boundary, end_boundary)"]
  ["47","x.y-z","xy(boundary), z(end_boundary)"]
  ["48","x-y.z","xy(boundary), z(end_boundary)"]
  ["49","x . y","x(boundary), y(end_boundary)"]
  ["50","x . y z","x(boundary), yz(end_boundary)"]
  ["51","A.B c","ab(boundary), c(end_boundary)"]
  ["52","x y Z","xy(boundary), z(end_boundary)"]
  ["53","Z x y","z(boundary), xy(end_boundary)"]
  ["54","x y I","xy(boundary), i(end_boundary)"]
  ["55","I x y","i(boundary), xy(end_boundary)"]
  ["56","I","i(boundary, end_boundary)"]
  ["57","x Y z","x(boundary), y, z(end_boundary)"]
  ["58","X y Z","x(boundary), y, z(end_boundary)"]
  ["59","xy Z w","xy(boundary), z, w(end_boundary)"]

# Rows 20 and 21: prod keeps a closing `)` or `"` at the end of a snippet.
case snip
query:
  SELECT Id, SNIPPET(Body, 'x y') AS a, SNIPPET(Body, 'x') AS c FROM T ORDER BY Id
expect:
  columns: Id INT64, a JSON, c JSON
