case search
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "I x") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["2"]
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "i x") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["11"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "X y") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x Y") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "(x y)") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `(x y)`, has error(s): -Encountered error on column 1 while parsing: sub_expression. Using parentheses to group query terms is not supported in rquery parser.
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x (y)") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x (y)`, has error(s): -Encountered error on column 3 while parsing: sub_expression. Using parentheses to group query terms is not supported in rquery parser.
expect@spanner:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x \"y\"") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "\"x\" y") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x.y.") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x.y.`, has error(s): -Encountered error on column 4 while parsing: term.
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y,") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x, y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x, y`, has error(s): -Syntax error on column 4: Expecting 'AROUND(
expect@spanner:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x -y z") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["2"]
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y -z") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x OR y z") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["2"]
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y OR z") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  columns: Id INT64
  ["1"]
  ["5"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x OR -y") ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["4"]
  ["5"]
  ["6"]
  ["7"]
  ["8"]
  ["9"]
  ["10"]
  ["11"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x AROUND(2) y z") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "\"x y\" OR z") ORDER BY Id
expect:
  columns: Id INT64
  ["5"]
expect@spanner:
  columns: Id INT64
  ["1"]
  ["5"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x\ty") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "xy*") ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
expect@spanner:
  same
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x y*") ORDER BY Id
expect:
  columns: Id INT64
  ["7"]
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x* y") ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `x* y`, has error(s): -Syntax error on column 4: Expecting 'AROUND(
expect@spanner:
  columns: Id INT64
  ["7"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x.Y") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["1"]
query:
  SELECT Id FROM Q WHERE SEARCH(Tok, "x-y-z") ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["4"]
# Column c8: prod doesn't highlight the stopword `i` in a query with other words.
case snipq
query:
  SELECT SNIPPET('xy x y xyz yx i ix', "x y") AS c0, SNIPPET('xy x y xyz yx i ix', "y x") AS c1, SNIPPET('xy x y xyz yx i ix', "x y z") AS c2, SNIPPET('xy x y xyz yx i ix', "x-y") AS c3, SNIPPET('xy x y xyz yx i ix', "\"x y\"") AS c4, SNIPPET('xy x y xyz yx i ix', "x OR y") AS c5, SNIPPET('xy x y xyz yx i ix', "-x y") AS c6, SNIPPET('xy x y xyz yx i ix', "x AROUND y") AS c7, SNIPPET('xy x y xyz yx i ix', "I x") AS c8, SNIPPET('xy x y xyz yx i ix', "x AROUND(2) y z") AS c9, SNIPPET('xy x y xyz yx i ix', "x y -z") AS c10
expect:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON, c10 JSON
  ["{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":16,\"start_position\":15}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":5,\"start_position\":4},{\"end_position\":7,\"start_position\":6}],\"snippet\":\"xy x y xyz yx i ix\"}]}"]
