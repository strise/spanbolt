case search_with_id_in_subquery
tags: oracle2
query:
  SELECT id, ARRAY_AGG(nee.entity_id ORDER BY nee.entity_id) AS entities
  FROM news_events_entities nee
  WHERE id IN (SELECT id FROM news_events WHERE NOT archived IS TRUE)
    AND SEARCH(text__tokens, @entityText)
    AND negative_ams_weight IS NOT NULL
    AND entity_type IN UNNEST(@entityTypes)
  GROUP BY id
  ORDER BY id
params:
  @entityText STRING = "\"COCA COLA\" OR \"OLA TESTMANN\""
  @entityTypes ARRAY<STRING> = ["ORG", "PER"]
expect:
  columns: id STRING, entities ARRAY<STRING>
  ["e1",["x1","x2"]]
  ["e2",["x1"]]
  ["e4",["x1"]]
expect@spanner:
  same

# matching_mentions_accented_text_fails with the partition and WHERE filters prod needs.
case matching_mentions_accented_with_partition_filter
tags: oracle2
query:
  SELECT DISTINCT id FROM news_events_entities nee
  WHERE SEARCH(text__tokens, @entityText)
    AND negative_ams_weight IS NOT NULL
    AND entity_type IN UNNEST(@entityTypes)
params:
  @entityText STRING = "\"BJØRN ÅSE ÆRLIG\" OR \"BJØRN ASE ÆRLIG\" OR \"BJORN ASE AERLIG\""
  @entityTypes ARRAY<STRING> = ["PER"]
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `"BJØRN ÅSE ÆRLIG" OR "BJØRN ASE ÆRLIG" OR "BJORN ASE AERLIG"`, has error(s): -Syntax error on column 6: Expecting '"
expect@spanner:
  columns: id STRING
  ["e4"]

# Is a partition filter required (prod said "no appropriate search index" without one)?
case matching_mentions_without_partition_filter
tags: oracle2
query:
  SELECT DISTINCT id FROM news_events_entities nee
  WHERE SEARCH(text__tokens, @entityText)
    AND negative_ams_weight IS NOT NULL
params:
