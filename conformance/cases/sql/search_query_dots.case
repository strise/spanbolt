  ["2"]
  ["3"]
  ["4"]
  ["8"]
query:
  SELECT Id FROM D WHERE SEARCH(Tok, 'apple banana:') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `apple banana:`, has error(s): -Encountered error on column 13 while parsing: term.
expect@spanner:
