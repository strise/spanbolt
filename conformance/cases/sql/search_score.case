# DEBUG_TOKENLIST shows prod's token lists directly (the emulator has no such function).
case debug_tokenlist_ngrams
query:
  SELECT Id, DEBUG_TOKENLIST(Code_Ngrams) AS t FROM S WHERE Id IN (1, 4, 7) ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["1","[A, AB, ABC, B, BC, C]"]
  ["4","[-, -1, -12, /, /x, 1, 12, 123, 2, 23, 23/, 3, 3/, 3/x, A, AB, ABC, ABC-, B, BC, BC-, C, C-, C-1, x], BC-1, C-12, -123, 123/, 23/x"]
  ["7","[A, Ab, AbC, AbCd, C, Cd, CdE, E, Ef, b, bC, bCd, d, dE, dEf, f], bCdE, CdEf"]

case debug_tokenlist_tri
query:
  SELECT Id, DEBUG_TOKENLIST(Body_Tri) AS t FROM S WHERE Id IN (1, 5) ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["1","alp, lph, pha"]
  ["5","alp, lph, pha, \"ha \", \"a b\", \" be\", bet, eta"]

case debug_tokenlist_substring
query:
  SELECT Id, DEBUG_TOKENLIST(Body_Substr) AS t FROM S WHERE Id IN (1, 5) ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["1","[a, al, alp, h, ha, l, lp, lph, p, ph, pha], alph, lpha"]
  ["5","[a, al, alp, b, be, bet, e, et, eta, h, ha, l, lp, lph, p, ph, pha, t, ta], alph, lpha, <gap(1)>, beta"]

case debug_tokenlist_fulltext
query:
  SELECT Id, DEBUG_TOKENLIST(Body_Tokens) AS t FROM S WHERE Id IN (2, 5) ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:12]
expect@spanner:
  columns: Id INT64, t STRING
  ["2","alpha(boundary), alpha(end_boundary)"]
  ["5","alpha(boundary), beta(end_boundary)"]

