# --- TOKENIZE_NGRAMS case handling: Code values are ABC, abc, Abc, ABC-123/x, abcdef, ABCDEF, AbCdEf, xyz, XYZ

case ngrams_case_lower_query
query:
  SELECT Id FROM S WHERE SEARCH_NGRAMS(Code_Ngrams, 'abc') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["2"]
  ["3"]
  ["4"]
  ["5"]
  ["6"]
  ["7"]
expect@spanner:
  columns: Id INT64
  ["2"]
  ["5"]

case ngrams_case_upper_query
query:
  SELECT Id FROM S WHERE SEARCH_NGRAMS(Code_Ngrams, 'ABC') ORDER BY Id
expect:
