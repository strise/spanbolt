# Data points for fitting prod's SCORE and SCORE_NGRAMS values, and for TOKENIZE_NGRAMS case
# handling. Term frequency (rows 1-4), document length (rows 5-8, 13), terms per query, repeated
# query terms, OR/AND, phrases, options and corpus size (score_corpus_* cases insert more rows).
# Prod needs a SEARCH predicate next to SCORE, so every SCORE query repeats its query in WHERE.
tags: sql search oracle3
schema:
  CREATE TABLE S (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Code STRING(MAX),
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
    Body_Tri TOKENLIST AS (TOKENIZE_NGRAMS(Body, ngram_size_min => 3, ngram_size_max => 3)) HIDDEN,
    Body_Ngrams TOKENLIST AS (TOKENIZE_NGRAMS(Body)) HIDDEN,
    Body_Substr TOKENLIST AS (TOKENIZE_SUBSTRING(Body)) HIDDEN,
    Code_Ngrams TOKENLIST AS (TOKENIZE_NGRAMS(Code)) HIDDEN,
    Code_Tri TOKENLIST AS (TOKENIZE_NGRAMS(Code, ngram_size_min => 3, ngram_size_max => 3)) HIDDEN,
    Code_Substr TOKENLIST AS (TOKENIZE_SUBSTRING(Code)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX SSearch ON S(Body_Tokens, Body_Tri, Body_Ngrams, Body_Substr);
  CREATE SEARCH INDEX SCodes ON S(Code_Ngrams, Code_Tri, Code_Substr)
insert S cols=Id,Body,Code:
  [1, "alpha", "ABC"]
  [2, "alpha alpha", "abc"]
  [3, "alpha alpha alpha", "Abc"]
  [4, "alpha alpha alpha alpha", "ABC-123/x"]
  [5, "alpha beta", "abcdef"]
  [6, "alpha beta beta", "ABCDEF"]
  [7, "alpha beta gamma", "AbCdEf"]
  [8, "alpha one two three four five six seven eight nine ten eleven twelve thirteen fourteen", "xyz"]
  [9, "beta gamma", "XYZ"]
  [10, "gamma delta", null]
  [11, "delta", null]
  [12, "epsilon zeta eta theta", null]
  [13, "one two three four five six seven alpha eight nine ten", null]

# --- SCORE: term frequency and document length

case score_one_term
query:
  SELECT Id, SCORE(Body_Tokens, 'alpha') AS s FROM S WHERE SEARCH(Body_Tokens, 'alpha') ORDER BY Id
expect:
  columns: Id INT64, s FLOAT64
  ["1",1.0]
  ["2",2.0]
  ["3",3.0]
  ["4",4.0]
  ["5",1.0]
  ["6",1.0]
  ["7",1.0]
  ["8",1.0]
  ["13",1.0]
expect@spanner:
  columns: Id INT64, s FLOAT64
  ["1",1.2588917016983032]
  ["2",1.6450823545455933]
  ["3",1.9531786441802979]
  ["4",2.2095134258270264]
  ["5",1.2588917016983032]
  ["6",1.2588917016983032]
  ["7",1.2588917016983032]
  ["8",1.2588917016983032]
  ["13",1.2588917016983032]

case score_one_term_rare
query:
  SELECT Id, SCORE(Body_Tokens, 'delta') AS s FROM S WHERE SEARCH(Body_Tokens, 'delta') ORDER BY Id
expect:
