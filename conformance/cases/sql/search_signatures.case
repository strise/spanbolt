case score_enhanced_with_options
# Spanner's enhanced scores differ from spanbolt's (sql/search_score/score_enhance_query): only
# the signature is checked here.
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud') AND SCORE(Body_Tokens, 'cloud', enhance_query => true, enhance_query_options => JSON '{}') > 0
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE Argument types: TOKENLIST, STRING, enhance_query => BOOL, enhance_query_options => JSON Signature: SCORE([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature Signature: SCORE([tokens=>]TOKENLIST, [query=>]BYTES, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:60]
expect@spanner:
  columns: Id INT64
  ["1"]

case score_all_options_typed
# Spanner's enhanced scores differ from spanbolt's (sql/search_score/score_enhance_query): only
# the signature is checked here.
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud') AND SCORE(Body_Tokens, 'cloud', enhance_query => true, language_tag => 'en', dialect => 'rquery', enhance_query_options => JSON '{}', options => JSON '{}', dictionary => CAST(NULL AS STRING)) > 0
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE Argument types: TOKENLIST, STRING, enhance_query => BOOL, language_tag => STRING, dialect => STRING, enhance_query_options => JSON, options => JSON, dictionary => STRING Signature: SCORE([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature Signature: SCORE([tokens=>]TOKENLIST, [query=>]BYTES, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:60]
expect@spanner:
  columns: Id INT64
  ["1"]

