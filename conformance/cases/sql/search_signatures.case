# SEARCH and SCORE signatures where Cloud Spanner and the emulator differ (spanbolt #131): Spanner
# takes `enhance_query_options => JSON`, and its SCORE takes no BYTES query. `expect:` is recorded
# from the emulator; `expect@spanner:` from Cloud Spanner.
tags: sql search oracle
schema:
  CREATE TABLE Docs (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX DocsSearch ON Docs(Body_Tokens)
insert Docs cols=Id,Body:
  [1, "cloud spanner emulator"]
  [2, "the lazy dog"]

case search_enhance_query_options
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query_options => JSON '{}')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query_options => JSON Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid usage of enhance_query_options. The argument can only be used when enhance_query is true.

case search_enhance_query_options_null
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query_options => NULL)
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query_options => NULL Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH\n Argument types: TOKENLIST, STRING, enhance_query_options => NULL\n Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [dictionary => STRING])\n Named argument `enhance_query_options`: Unable to coerce type INT64 to expected type JSON [at 1:27]

case search_enhance_query_options_string
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query_options => '{}')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query_options => STRING Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH\n Argument types: TOKENLIST, STRING, enhance_query_options => STRING\n Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [dictionary => STRING])\n Named argument `enhance_query_options`: Unable to coerce type STRING to expected type JSON [at 1:27]

case search_all_options
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query => false, language_tag => 'en', dialect => 'rquery', enhance_query_options => JSON '{}', dictionary => NULL)
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query => BOOL, language_tag => STRING, dialect => STRING, enhance_query_options => JSON, dictionary => NULL Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH\n Argument types: TOKENLIST, STRING, enhance_query => BOOL, language_tag => STRING, dialect => STRING, enhance_query_options => JSON, dictionary => NULL\n Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [dictionary => STRING])\n Named argument `dictionary`: Unable to coerce type INT64 to expected type STRING [at 1:27]

case score_enhance_query_options
query:
  SELECT Id, SCORE(Body_Tokens, 'cloud', enhance_query_options => JSON '{}') AS s FROM Docs WHERE SEARCH(Body_Tokens, 'cloud')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE Argument types: TOKENLIST, STRING, enhance_query_options => JSON Signature: SCORE([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature Signature: SCORE([tokens=>]TOKENLIST, [query=>]BYTES, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:12]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Invalid usage of enhance_query_options. The argument can only be used when enhance_query is true.

case score_all_options
query:
  SELECT Id, SCORE(Body_Tokens, 'cloud', enhance_query => false, language_tag => 'en', dialect => 'rquery', enhance_query_options => JSON '{}', options => JSON '{}', dictionary => NULL) AS s FROM Docs WHERE SEARCH(Body_Tokens, 'cloud')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE Argument types: TOKENLIST, STRING, enhance_query => BOOL, language_tag => STRING, dialect => STRING, enhance_query_options => JSON, options => JSON, dictionary => NULL Signature: SCORE([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature Signature: SCORE([tokens=>]TOKENLIST, [query=>]BYTES, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:12]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE\n Argument types: TOKENLIST, STRING, enhance_query => BOOL, language_tag => STRING, dialect => STRING, enhance_query_options => JSON, options => JSON, dictionary => NULL\n Signature: SCORE([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [options => JSON], [dictionary => STRING])\n Named argument `dictionary`: Unable to coerce type INT64 to expected type STRING [at 1:12]

case score_bytes_query_parameter
query:
  SELECT Id, SCORE(Body_Tokens, @q) AS s FROM Docs WHERE SEARCH(Body_Tokens, 'cloud')
params:
  @q BYTES = "Y2xvdWQ="
expect:
  error: INVALID_ARGUMENT
  message: Invalid search query type: BYTES.
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE\n Argument types: TOKENLIST, BYTES\n Signature: SCORE(TOKENLIST, STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [options => JSON], [dictionary => STRING])\n Argument 2: Unable to coerce type BYTES to expected type STRING [at 1:12]

case score_wrong_type
query:
  SELECT Id, SCORE(Body_Tokens, 1) AS s FROM Docs WHERE SEARCH(Body_Tokens, 'cloud')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE Argument types: TOKENLIST, INT64 Signature: SCORE(TOKENLIST, STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Argument 2: Unable to coerce type INT64 to expected type STRING Signature: SCORE(TOKENLIST, BYTES, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [options => JSON], [dictionary => STRING]) Argument 2: Unable to coerce type INT64 to expected type BYTES [at 1:12]
expect@spanner:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SCORE\n Argument types: TOKENLIST, INT64\n Signature: SCORE(TOKENLIST, STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [enhance_query_options => JSON], [options => JSON], [dictionary => STRING])\n Argument 2: Unable to coerce type INT64 to expected type STRING [at 1:12]

# Spanner accepts `enhance_query_options` only next to `enhance_query => TRUE`.
case search_enhanced_with_options
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query => true, enhance_query_options => JSON '{}')
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query => BOOL, enhance_query_options => JSON Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  columns: Id INT64
  ["1"]

case search_enhanced_null_options
query:
  SELECT Id FROM Docs WHERE SEARCH(Body_Tokens, 'cloud', enhance_query => true, enhance_query_options => CAST(NULL AS JSON))
expect:
  error: INVALID_ARGUMENT
  message: No matching signature for function SPANNER:SEARCH Argument types: TOKENLIST, STRING, enhance_query => BOOL, enhance_query_options => JSON Signature: SEARCH([tokens=>]TOKENLIST, [query=>]STRING, [enhance_query => BOOL], [language_tag => STRING], [dialect => STRING], [dictionary => STRING]) Named argument `enhance_query_options` does not exist in signature [at 1:27]
expect@spanner:
  columns: Id INT64
  ["1"]

