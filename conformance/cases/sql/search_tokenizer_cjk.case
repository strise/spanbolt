# Cloud Spanner's fulltext tokenizer on Japanese, Chinese and Korean text (#140): how it cuts
# words, read through DEBUG_TOKENLIST (Spanner only).
tags: sql search

case cjk_corpus_1
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['日本語', '日本語を勉強します', '東京都', '東京都庁', '大阪府', '京都大学', '東京大学', '早稲田大学', '日本経済新聞', '国際連合', '自然言語処理', '形態素解析', '人工知能', '機械学習', '情報科学', '電子メール', '携帯電話', '新幹線', '富士山', '日本人', '外国人', '経済産業省', '内閣総理大臣', '今日は良い天気ですね', '私は東京に住んでいます', '彼女は毎朝コーヒーを飲む', 'この本はとても面白かった', '明日の会議は十時からです', 'すもももももももものうち', '吾輩は猫である', 'ありがとうございます', 'おはようございます', 'こんにちは', 'さようなら', '食べました']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["ありがとうございます","ありがとう(boundary), ござい, ます(end_boundary)"]
  ["おはようございます","おはよう(boundary), ござい, ます(end_boundary)"]
  ["この本はとても面白かった","この(boundary), 本, は, とても, 面白かっ, た(end_boundary)"]
  ["こんにちは","こんにちは(boundary, end_boundary)"]
  ["さようなら","さようなら(boundary, end_boundary)"]
  ["すもももももももものうち","すもももももも(boundary), も, もの, うち(end_boundary)"]
  ["京都大学","京都(boundary), 大学(end_boundary)"]
  ["人工知能","人工(boundary), 知能(end_boundary)"]
  ["今日は良い天気ですね","今日(boundary), は, 良い, 天気, です, ね(end_boundary)"]
  ["内閣総理大臣","内閣(boundary), 総理, 大臣(end_boundary)"]
  ["吾輩は猫である","吾輩(boundary), は, 猫, で, ある(end_boundary)"]
  ["国際連合","国際(boundary), 連合(end_boundary)"]
  ["外国人","外国(boundary), 人(end_boundary)"]
  ["大阪府","大阪(boundary), 府(end_boundary)"]
  ["富士山","富士山(boundary, end_boundary)"]
  ["形態素解析","形態素(boundary), 解析(end_boundary)"]
  ["彼女は毎朝コーヒーを飲む","彼女(boundary), は, 毎朝, コーヒー, を, 飲む(end_boundary)"]
  ["情報科学","情報(boundary), 科学(end_boundary)"]
  ["携帯電話","携帯(boundary), 電話(end_boundary)"]
  ["新幹線","新幹線(boundary, end_boundary)"]
  ["日本人","日本(boundary), 人(end_boundary)"]
  ["日本経済新聞","日本(boundary), 経済, 新聞(end_boundary)"]
  ["日本語","日本(boundary), 語(end_boundary)"]
  ["日本語を勉強します","日本(boundary), 語, を, 勉強, し, ます(end_boundary)"]
  ["早稲田大学","早稲田(boundary), 大学(end_boundary)"]
  ["明日の会議は十時からです","明日(boundary), の, 会議, は, 十, 時, から, です(end_boundary)"]
  ["東京大学","東京(boundary), 大学(end_boundary)"]
  ["東京都","東京(boundary), 都(end_boundary)"]
  ["東京都庁","東京(boundary), 都庁(end_boundary)"]
  ["機械学習","機械(boundary), 学習(end_boundary)"]
  ["私は東京に住んでいます","私(boundary), は, 東京, に, 住ん, で, い, ます(end_boundary)"]
  ["経済産業省","経済(boundary), 産業, 省(end_boundary)"]
  ["自然言語処理","自然(boundary), 言語, 処理(end_boundary)"]
  ["電子メール","電子(boundary), メール(end_boundary)"]
  ["食べました","食べ(boundary), まし, た(end_boundary)"]

case cjk_corpus_2
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['食べられない', '行きたい', '見ている', 'コンピューター', 'インターネット', 'ソフトウェアエンジニア', 'データベース', 'スパナー', 'アメリカ合衆国', '東京タワー', '新宿駅', '渋谷区', '山田太郎', '株式会社', '検索エンジン', '全文検索', '漢字仮名交じり文', '日本語の文章を単語に分割する', '東京特許許可局', '生麦生米生卵', 'お茶', 'お金', '一二三', '二〇二六年', '3月25日', '１２３円', 'ｶﾀｶﾅ', '日本の首都は東京です', '私の名前は田中です', '中文分词测试', '北京大学', '清华大学', '中华人民共和国', '我爱北京天安门', '今天天气很好']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["3月25日","3(boundary), 月, 25, 日(end_boundary)"]
  ["お茶","お茶(boundary, end_boundary)"]
  ["お金","お金(boundary, end_boundary)"]
  ["アメリカ合衆国","アメリカ合衆国(boundary, end_boundary)"]
  ["インターネット","インターネット(boundary, end_boundary)"]
  ["コンピューター","コンピューター(boundary, end_boundary)"]
  ["スパナー","スパナー(boundary, end_boundary)"]
  ["ソフトウェアエンジニア","ソフトウェア(boundary), エンジニア(end_boundary)"]
  ["データベース","データベース(boundary, end_boundary)"]
  ["一二三","一(boundary), 二, 三(end_boundary)"]
  ["中华人民共和国","中华(boundary), 人民, 共和国(end_boundary)"]
  ["中文分词测试","中文(boundary), 分词, 测试(end_boundary)"]
  ["二〇二六年","二(boundary), 〇, 二, 六, 年(end_boundary)"]
  ["今天天气很好","今天(boundary), 天气, 很, 好(end_boundary)"]
  ["全文検索","全文(boundary), 検索(end_boundary)"]
  ["北京大学","北京(boundary), 大学(end_boundary)"]
  ["山田太郎","山田(boundary), 太郎(end_boundary)"]
  ["我爱北京天安门","我(boundary), 爱, 北京, 天安门(end_boundary)"]
  ["新宿駅","新宿(boundary), 駅(end_boundary)"]
  ["日本の首都は東京です","日本(boundary), の, 首都, は, 東京, です(end_boundary)"]
  ["日本語の文章を単語に分割する","日本(boundary), 語, の, 文章, を, 単語, に, 分割, する(end_boundary)"]
  ["東京タワー","東京(boundary), タワー(end_boundary)"]
  ["東京特許許可局","東京(boundary), 特許, 許可, 局(end_boundary)"]
  ["株式会社","株式(boundary), 会社(end_boundary)"]
  ["検索エンジン","検索(boundary), エンジン(end_boundary)"]
  ["清华大学","清华(boundary), 大学(end_boundary)"]
  ["渋谷区","渋谷(boundary), 区(end_boundary)"]
  ["漢字仮名交じり文","漢字(boundary), 仮名, 交じり, 文(end_boundary)"]
  ["生麦生米生卵","生麦(boundary), 生, 米, 生, 卵(end_boundary)"]
  ["私の名前は田中です","私(boundary), の, 名前, は, 田中, です(end_boundary)"]
  ["行きたい","行き(boundary), たい(end_boundary)"]
  ["見ている","見(boundary), て, いる(end_boundary)"]
  ["食べられない","食べ(boundary), られ, ない(end_boundary)"]
  ["１２３円","123(boundary), 円(end_boundary)"]
  ["ｶﾀｶﾅ","カタカナ(boundary, end_boundary)"]

case cjk_corpus_3
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['我们在学习中文', '自然语言处理', '计算机科学', '人工智能', '机器学习', '数据库', '搜索引擎', '全文检索', '上海市', '广州', '深圳', '香港', '台灣', '臺北市', '繁體中文', '简体中文', '你好', '谢谢', '再见', '我是学生', '他在图书馆看书', '这个问题很难', '研究生命起源', '结婚的和尚未结婚的', '南京市长江大桥', '乒乓球拍卖完了', '中国科学院', '国务院', '长城', '习近平', '马云', '阿里巴巴', '腾讯', '百度', '小米手机']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["上海市","上海(boundary), 市(end_boundary)"]
  ["中国科学院","中国(boundary), 科学院(end_boundary)"]
  ["乒乓球拍卖完了","乒乓(boundary), 球, 拍卖, 完了(end_boundary)"]
