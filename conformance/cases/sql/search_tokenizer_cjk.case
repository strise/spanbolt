case cjk_corpus_4
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['苹果电脑', '喜欢', '不知道', '一个', '三个人', '第一次', '二零二六年', '한국어', '한국어 텍스트', '안녕하세요', '대한민국', '서울특별시', '자연어처리', '나는학생입니다', '감사합니다', '검색엔진', '데이터베이스', 'abc日本def', 'Google日本', 'iPhone手机', '東京2020', '日本 語', '日', '漢字', '中文English混合', 'テスト test テスト', '日本語、英語、中国語', '「日本語」', '日本語。英語', '第3回', '100円', 'α日本']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["100円","100(boundary), 円(end_boundary)"]
  ["Google日本","google(boundary), 日本(end_boundary)"]
  ["abc日本def","abc(boundary), 日本, def(end_boundary)"]
  ["iPhone手机","iphone(boundary), 手机(end_boundary)"]
  ["α日本","α(boundary), 日本(end_boundary)"]
  ["「日本語」","日本(boundary), 語(end_boundary)"]
  ["テスト test テスト","テスト(boundary), test, テスト(end_boundary)"]
  ["一个","一个(boundary, end_boundary)"]
  ["三个人","三(boundary), 个人(end_boundary)"]
  ["不知道","不(boundary), 知道(end_boundary)"]
  ["中文English混合","中文(boundary), english, 混合(end_boundary)"]
  ["二零二六年","二(boundary), 零, 二, 六, 年(end_boundary)"]
  ["喜欢","喜欢(boundary, end_boundary)"]
  ["日","日(boundary, end_boundary)"]
  ["日本 語","日本(boundary), 語(end_boundary)"]
  ["日本語、英語、中国語","日本(boundary), 語, 英語, 中国, 語(end_boundary)"]
  ["日本語。英語","日本(boundary), 語, 英語(end_boundary)"]
  ["東京2020","東京(boundary), 2020(end_boundary)"]
  ["漢字","漢字(boundary, end_boundary)"]
  ["第3回","第(boundary), 3, 回(end_boundary)"]
  ["第一次","第(boundary), 一, 次(end_boundary)"]
  ["苹果电脑","苹果(boundary), 电脑(end_boundary)"]
  ["감사합니다","감사(boundary), 합니다(end_boundary)"]
  ["검색엔진","검색(boundary), 엔진(end_boundary)"]
  ["나는학생입니다","나는(boundary), 학생, 입니다(end_boundary)"]
  ["대한민국","대한민국(boundary, end_boundary)"]
  ["데이터베이스","데이터베이스(boundary, end_boundary)"]
  ["서울특별시","서울(boundary), 특별시(end_boundary)"]
  ["안녕하세요","안녕하세요(boundary, end_boundary)"]
  ["자연어처리","자연어(boundary), 처리(end_boundary)"]
  ["한국어","한국어(boundary, end_boundary)"]
  ["한국어 텍스트","한국어(boundary), 텍스트(end_boundary)"]
