  ["他在图书馆看书","他(boundary), 在, 图书, 馆, 看书(end_boundary)"]
  ["你好","你(boundary), 好(end_boundary)"]
  ["全文检索","全文(boundary), 检索(end_boundary)"]
  ["再见","再见(boundary, end_boundary)"]
  ["南京市长江大桥","南京(boundary), 市, 长江, 大桥(end_boundary)"]
  ["台灣","台灣(boundary, end_boundary)"]
  ["国务院","国务院(boundary, end_boundary)"]
  ["小米手机","小米(boundary), 手机(end_boundary)"]
  ["广州","广州(boundary, end_boundary)"]
  ["我们在学习中文","我们(boundary), 在, 学习, 中文(end_boundary)"]
  ["我是学生","我(boundary), 是, 学生(end_boundary)"]
  ["搜索引擎","搜索(boundary), 引擎(end_boundary)"]
  ["数据库","数据库(boundary, end_boundary)"]
  ["机器学习","机器(boundary), 学习(end_boundary)"]
  ["深圳","深圳(boundary, end_boundary)"]
  ["百度","百度(boundary, end_boundary)"]
  ["研究生命起源","研究(boundary), 生命, 起源(end_boundary)"]
  ["简体中文","简体(boundary), 中文(end_boundary)"]
  ["繁體中文","繁體(boundary), 中文(end_boundary)"]
  ["结婚的和尚未结婚的","结婚(boundary), 的, 和, 尚未, 结婚, 的(end_boundary)"]
  ["腾讯","腾讯(boundary, end_boundary)"]
  ["自然语言处理","自然(boundary), 语言, 处理(end_boundary)"]
