  message: Error(s) parsing search query `-- foo`, has error(s): -Encountered error on column 3 while parsing: sub_expression.
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, '---') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `---`, has error(s): -Encountered error on column 3 while parsing: sub_expression.
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, '&&') ORDER BY Id
