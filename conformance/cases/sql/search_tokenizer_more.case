query:
  SELECT Id FROM T WHERE SEARCH(Tok, '&foo') ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
  ["5"]
  ["19"]
  ["20"]
  ["22"]
  ["24"]
  ["31"]
  ["41"]
  ["44"]
  ["60"]
  ["61"]
  ["71"]
  ["73"]
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, '3.14.15') ORDER BY Id
expect:
  columns: Id INT64
  ["27"]
expect@spanner:
  same
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'foo_') ORDER BY Id
expect:
  columns: Id INT64
  ["2"]
  ["5"]
  ["19"]
  ["20"]
  ["22"]
  ["24"]
  ["31"]
  ["41"]
  ["44"]
  ["60"]
  ["61"]
  ["71"]
  ["73"]
expect@spanner:
  columns: Id INT64
query:
  SELECT Id FROM T WHERE SEARCH(Tok, '_a') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["21"]
  ["32"]
  ["42"]
  ["72"]
  ["74"]
  ["75"]
expect@spanner:
  columns: Id INT64
  ["75"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'a_') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
  ["21"]
  ["32"]
  ["42"]
  ["72"]
  ["74"]
  ["75"]
expect@spanner:
