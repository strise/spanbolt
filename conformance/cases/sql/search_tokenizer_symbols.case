# TOKENIZE_FULLTEXT around `_`, `&`, `@`, `--`, `</` and non-ASCII spaces (#119). Cloud Spanner
# keeps some of these inside a token, adds a second token at the same position for others, and
# splits on Unicode spaces; the emulator splits on all of them.
tags: sql search
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
