case normalisation_other_tokenizers
query:
  SELECT DEBUG_TOKENLIST(TOKENIZE_SUBSTRING('ﬁle İx ＡＢ')) AS s,
    DEBUG_TOKENLIST(TOKENIZE_NGRAMS('ﬁİＡ', ngram_size_min=>1, ngram_size_max=>2)) AS n,
    DEBUG_TOKENLIST(TOKENIZE_SUBSTRING('Straße ꭰ ᾳ')) AS s2
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:8]
expect@spanner:
  columns: s STRING, n STRING, s2 STRING
  ["[a, b, e, f, fi, fil, i, il, ile, l, le, x], file, <gap(1)>, ix, <gap(1)>, ab","[İ, ﬁ, ﬁİ, Ａ], İＡ","[a, aß, aße, e, r, ra, raß, s, st, str, t, tr, tra, ß, ße, α, ι], stra, traß, raße, <gap(1)>, Ꭰ, <gap(1)>, αι"]

case joined_letters_inside_words
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['xy\'s z', 'xy_z q', 'xy&z q', 'x\'s y', 'a_b c', 'x_y z', 'q x_y', 'at&t x', 'a&b c', 'xy\'s z w', 'xy+.', 'xy+,', 'xy+;', 'xy+!', 'xy+:', 'xy+?', 'xy+)', 'xy+.z', 'xy+. z', 'c++.', 'c++,', 'c#.', 'c#,', 'a+.', 'x y+.', 'xy+..', 'xy+-']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["a&b c","a&b(boundary), c(end_boundary)"]
  ["a+.","a+(boundary, end_boundary)"]
  ["a_b c","a_b(boundary), c(end_boundary)"]
  ["at&t x","at&t(boundary), x(end_boundary)"]
  ["c#,","c#(boundary, end_boundary)"]
  ["c#.","c#(boundary, end_boundary)"]
  ["c++,","c(boundary), ++(end_boundary)"]
  ["c++.","c(boundary), ++(end_boundary)"]
  ["q x_y","q(boundary), x_y(end_boundary)"]
  ["x y+.","x(boundary), y+(end_boundary)"]
  ["x's y","[x, x\\'s](boundary), y(end_boundary)"]
  ["x_y z","x_y(boundary), z(end_boundary)"]
  ["xy&z q","xy&z(boundary), q(end_boundary)"]
  ["xy's z","[xy, xy\\'s](boundary), z(end_boundary)"]
  ["xy's z w","[xy, xy\\'s](boundary), zw(end_boundary)"]
  ["xy+!","xy(boundary), +!(end_boundary)"]
  ["xy+)","xy(boundary), \"+)\"(end_boundary)"]
  ["xy+,","xy+(boundary, end_boundary)"]
  ["xy+-","xy(boundary), +-(end_boundary)"]
  ["xy+.","xy+(boundary, end_boundary)"]
  ["xy+. z","xy+(boundary), z(end_boundary)"]
  ["xy+..","xy+(boundary, end_boundary)"]
  ["xy+.z","xy+(boundary), z(end_boundary)"]
  ["xy+:","xy(boundary), +:(end_boundary)"]
  ["xy+;","xy(boundary), +;(end_boundary)"]
  ["xy+?","xy(boundary), +?(end_boundary)"]
  ["xy_z q","xy_z(boundary), q(end_boundary)"]

case cjk_tokens
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['日本語', '日本語を勉強します', '中文分词测试', '한국어 텍스트', '東京都', 'カタカナ', 'ひらがな', 'abc日本def', '日本 語', '日', '私は学生です', '北京大学', '台灣', '漢字']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["abc日本def","abc(boundary), 日本, def(end_boundary)"]
  ["ひらがな","ひらがな(boundary, end_boundary)"]
  ["カタカナ","カタカナ(boundary, end_boundary)"]
  ["中文分词测试","中文(boundary), 分词, 测试(end_boundary)"]
  ["北京大学","北京(boundary), 大学(end_boundary)"]
  ["台灣","台灣(boundary, end_boundary)"]
  ["日","日(boundary, end_boundary)"]
  ["日本 語","日本(boundary), 語(end_boundary)"]
  ["日本語","日本(boundary), 語(end_boundary)"]
  ["日本語を勉強します","日本(boundary), 語, を, 勉強, し, ます(end_boundary)"]
  ["東京都","東京(boundary), 都(end_boundary)"]
  ["漢字","漢字(boundary, end_boundary)"]
  ["私は学生です","私(boundary), は, 学生, です(end_boundary)"]
  ["한국어 텍스트","한국어(boundary), 텍스트(end_boundary)"]
case search_normalised
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
  [1, "ﬁle"]
  [2, "İstanbul"]
  [3, "日本語"]
  [4, "a@b.c"]
  [5, "café"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'file') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  columns: Id INT64
  ["1"]
