case search_cjk_prefix
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
  [1, "ﬁle"]
  [2, "İstanbul"]
  [3, "日本語"]
  [4, "a@b.c"]
  [5, "cafe\u0301"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, '日本') ORDER BY Id
expect:
  error: INVALID_ARGUMENT
  message: Error(s) parsing search query `日本`, has error(s): -Encountered error on column 6 while parsing: sub_expression.
expect@spanner:
  columns: Id INT64
  ["3"]

