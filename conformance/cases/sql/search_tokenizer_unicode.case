# Cloud Spanner's fulltext tokenizer on email addresses with single-letter parts, single letters
# inside words (`xy's z`), `+` before punctuation, Unicode normalisation and CJK text (#140), read
# through DEBUG_TOKENLIST (Spanner only) and SEARCH.
tags: sql search

case email_tokens
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['a@b.c', 'a@b.cd', 'ab@c.d', 'x@y.z.w', 'a.b@c.d', 'a@bc.de', 'q a@b.c r', 'a b@c.d', 'a@b', 'a@b c', 'a.b.c@d.e']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["a b@c.d","a(boundary), [b, b@c.d], cd(end_boundary)"]
  ["a.b.c@d.e","[a.b.c@d.e, abc](boundary), de(end_boundary)"]
  ["a.b@c.d","[a.b@c.d, ab](boundary), cd(end_boundary)"]
  ["a@b","[a, a@b](boundary), b(end_boundary)"]
  ["a@b c","[a, a@b](boundary), b, c(end_boundary)"]
  ["a@b.c","[a, a@b.c](boundary), bc(end_boundary)"]
  ["a@b.cd","[a, a@b.cd](boundary), b, cd(end_boundary)"]
  ["a@bc.de","[a, a@bc.de](boundary), bc, de(end_boundary)"]
  ["ab@c.d","[ab, ab@c.d](boundary), cd(end_boundary)"]
  ["q a@b.c r","q(boundary), [a, a@b.c], bc, r(end_boundary)"]
  ["x@y.z.w","[x, x@y.z.w](boundary), yzw(end_boundary)"]
case normalisation_tokens
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t
  FROM UNNEST(['ﬁle', 'İstanbul', 'ǅemal', 'Åström', 'café', 'café', 'Ⅻ', '①', 'ｆｕｌｌ', 'ΣΑΣ', 'ﬀ', '½', 'Straße', 'ŉ', 'ﬆ', 'K', 'µ', 'ǰ', 'ᾈ', 'ﬃx']) AS v
  ORDER BY v
expect:
  error: INVALID_ARGUMENT
  message: Function not found: DEBUG_TOKENLIST [at 1:11]
expect@spanner:
  columns: v STRING, t STRING
  ["K","k(boundary, end_boundary)"]
  ["Straße","straße(boundary, end_boundary)"]
  ["café","café(boundary, end_boundary)"]
  ["café","café(boundary, end_boundary)"]
  ["µ","μ(boundary, end_boundary)"]
  ["½","½(boundary, end_boundary)"]
  ["Åström","åström(boundary, end_boundary)"]
  ["İstanbul","istanbul(boundary, end_boundary)"]
  ["ŉ","ʼn(boundary, end_boundary)"]
  ["ǅemal","džemal(boundary, end_boundary)"]
  ["ǰ","ǰ(boundary, end_boundary)"]
  ["ΣΑΣ","σασ(boundary, end_boundary)"]
  ["ᾈ","ἀι(boundary, end_boundary)"]
  ["Ⅻ","ⅻ(boundary, end_boundary)"]
  ["①","①(boundary, end_boundary)"]
  ["ﬀ","ff(boundary, end_boundary)"]
  ["ﬁle","file(boundary, end_boundary)"]
  ["ﬃx","ffix(boundary, end_boundary)"]
  ["ﬆ","st(boundary, end_boundary)"]
  ["ｆｕｌｌ","full(boundary, end_boundary)"]
case normalisation_more
query:
  SELECT v, DEBUG_TOKENLIST(TOKENIZE_FULLTEXT(v)) AS t, TO_CODE_POINTS(v) AS cp
  FROM UNNEST(['ẞ', 'ſ', 'ĳ', 'ŀ', 'ﬓ', 'ᾳ', 'ΐ', 'ϐ', 'ϑ', 'ǈ', '²', 'ℌ', 'ｶ', 'ｱｲ', '㌀', '０１', 'Ａ', 'i\u0307', 'I', 'ı', 'a\u0307', 'e\u0301\u0301', 'Ω', 'Å', 'ﬅ', 'proﬁle', 'ΣΑΣ ς', 'ꭰ', 'Ꭰ', 'ﬗ', 'ǅ', '\u1e9b', 'ﬄ', 'Ⅻ', 'ⓐ', 'Ⓐ', '𝐀', 'ℹ', 'ﬁ\u0301']) AS v
  ORDER BY v
