  [1, "xy+"]
  [2, "other"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'xy+,') ORDER BY Id
expect:
  columns: Id INT64
  ["1"]
expect@spanner:
  same

case search_apostrophe_letter
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
  [1, "xy's z"]
  [2, "other"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'sz') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same

case search_underscore_letter
schema:
  CREATE TABLE T (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX TIdx ON T(Tok)
insert T cols=Id,Body:
  [1, "xy_z q"]
  [2, "other"]
query:
  SELECT Id FROM T WHERE SEARCH(Tok, 'zq') ORDER BY Id
expect:
  columns: Id INT64
expect@spanner:
  same
