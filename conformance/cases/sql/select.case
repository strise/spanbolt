tags: sql select
schema:
  CREATE TABLE Teams (
    TeamId STRING(36) NOT NULL,
    Name STRING(MAX) NOT NULL,
    CustomerId STRING(36),
    Created TIMESTAMP NOT NULL,
  ) PRIMARY KEY (TeamId);
  CREATE TABLE Entities (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    Kind STRING(32) NOT NULL,
    Status STRING(32),
    Name STRING(MAX),
    Aliases ARRAY<STRING(MAX)>,
    Data JSON,
    Score FLOAT64,
    Version INT64 NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    UpdatedAt TIMESTAMP,
  ) PRIMARY KEY (TeamId, EntityId),
    INTERLEAVE IN PARENT Teams ON DELETE CASCADE;
  CREATE INDEX EntitiesByKind ON Entities(TeamId, Kind);
  CREATE NULL_FILTERED INDEX EntitiesByStatus ON Entities(Status) STORING (Name);
  CREATE TABLE Reviews (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    ReviewId INT64 NOT NULL,
    CreatedBy STRING(36) NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    Outcome STRING(16),
  ) PRIMARY KEY (TeamId, EntityId, ReviewId),
    INTERLEAVE IN PARENT Entities ON DELETE CASCADE;
  CREATE TABLE Users (
    UserId STRING(36) NOT NULL,
    Email STRING(MAX) NOT NULL,
    Name STRING(MAX),
  ) PRIMARY KEY (UserId);
  CREATE TABLE Signals (
    EntityId STRING(36) NOT NULL,
    SignalType STRING(32) NOT NULL,
    ValidFrom TIMESTAMP NOT NULL,
    Confidence FLOAT64 NOT NULL,
  ) PRIMARY KEY (EntityId, SignalType, ValidFrom)
insert Teams cols=TeamId,Name,CustomerId,Created:
  ["t1", "Alpha", "c1", "2024-01-01T00:00:00Z"]
  ["t2", "Beta", "c1", "2024-02-01T00:00:00Z"]
  ["t3", "Gamma", null, "2024-03-01T00:00:00Z"]
