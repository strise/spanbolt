# Where Cloud Spanner grows a cut snippet. A side across a sentence end (`.`, `!`, `?`, `...`)
# waits until the other side is done; `,` `;` `:` and `)` don't stop it. A term that occurs more
# than once is shown from the fewest words that hold every term, ties in query order.
# spanbolt follows it (`Snippets` in crates/sql/src/search/eval.rs).
tags: sql search
schema:
  CREATE TABLE W (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX WSearch ON W(Body_Tokens)

case sentence_end
query:
  SELECT
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>8) AS c0,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>8) AS c1,
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>10) AS c2,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>10) AS c3,
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>12) AS c4,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>12) AS c5,
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>14) AS c6,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>14) AS c7,
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>16) AS c8,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>16) AS c9,
    SNIPPET("aaa bbb ccc! ddd eee xy fff ggg hhh iii", "xy", max_snippet_width=>20) AS c10,
    SNIPPET("aaa bbb ccc ddd eee xy fff ggg! hhh iii", "xy", max_snippet_width=>20) AS c11
expect:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON, c10 JSON, c11 JSON
