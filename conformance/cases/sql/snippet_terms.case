# SNIPPET with several terms, swept over max_snippet_width 6..40 (#87). When the terms don't fit
# in one snippet, Cloud Spanner returns one snippet per term, up to max_snippets; terms next to
# each other stay together and a repeated term never gets a second snippet. spanbolt approximates
# the cut and the split (`snippet_spans` in crates/sql/src/search/eval.rs, 332 of these 560
# widths), so these fail in default mode: they are the target for an exact port.
tags: sql search
schema:
  CREATE TABLE W (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Tok TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX WIdx ON W(Tok)
insert W cols=Id,Body:
  [1, "one two three four five six seven eight"]
  [2, "alpha bb c dddd eeeee f gg hhh iiii jjjjj k ll"]
  [3, "two one two one two one two one two one two"]
  [4, "red green blue red green blue red green blue red green blue"]

case seven_two
