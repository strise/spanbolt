case sym_xy2
query:
  SELECT
    SNIPPET("xy@z.com q", "xy") AS c0,
    SNIPPET("a&xy q", "xy") AS c1,
    SNIPPET("&xy q", "xy") AS c2,
    SNIPPET("xy&& z", "xy") AS c3,
    SNIPPET("xy+& z", "xy") AS c4,
    SNIPPET("z&xy", "xy") AS c5,
    SNIPPET("xy- z", "xy") AS c6,
    SNIPPET("xy* z", "xy") AS c7,
    SNIPPET("xy% z", "xy") AS c8,
    SNIPPET("xy= z", "xy") AS c9,
    SNIPPET("xy~ z", "xy") AS c10,
    SNIPPET("xy^ z", "xy") AS c11,
    SNIPPET("xy$ z", "xy") AS c12,
    SNIPPET("xy| z", "xy") AS c13,
    SNIPPET("xy< z", "xy") AS c14,
    SNIPPET("xy> z", "xy") AS c15,
    SNIPPET("xy! z", "xy") AS c16
