case sym_query
query:
  SELECT
    SNIPPET("xy+ z", "xy+") AS c0,
    SNIPPET("xy z", "xy+") AS c1,
    SNIPPET("xy& z", "xy&") AS c2,
    SNIPPET("xy z", "xy&") AS c3,
    SNIPPET("c++ z", "c++") AS c4,
    SNIPPET("c z", "c++") AS c5,
    SNIPPET("xy# z", "xy#") AS c6,
    SNIPPET("x# z", "x#") AS c7,
    SNIPPET("xy+ xy z", "xy") AS c8,
    SNIPPET("xy xy+ z", "xy") AS c9
expect:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON
  ["{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1}],\"snippet\":\"xy+ z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1}],\"snippet\":\"xy z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1}],\"snippet\":\"xy& z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1}],\"snippet\":\"xy z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"c++ z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"c z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1}],\"snippet\":\"xy# z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":2,\"start_position\":1}],\"snippet\":\"x# z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1},{\"end_position\":7,\"start_position\":5}],\"snippet\":\"xy+ xy z\"}]}","{\"snippets\":[{\"highlights\":[{\"end_position\":3,\"start_position\":1},{\"end_position\":6,\"start_position\":4}],\"snippet\":\"xy xy+ z\"}]}"]
expect@spanner:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON
  ["{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":4}],\"snippet\":\"xy+ z\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"xy z\",\"source_begin\":1,\"source_end\":5}]}","{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":4}],\"snippet\":\"xy& z\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"xy z\",\"source_begin\":1,\"source_end\":5}]}","{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":4}],\"snippet\":\"c++ z\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"cz\",\"source_begin\":1,\"source_end\":3}]}","{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":3}],\"snippet\":\"xy# z\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":3}],\"snippet\":\"x# z\",\"source_begin\":1,\"source_end\":5}]}","{\"snippets\":[{\"highlights\":[{\"begin\":5,\"end\":7}],\"snippet\":\"xy+ xy z\",\"source_begin\":1,\"source_end\":9}]}","{\"snippets\":[{\"highlights\":[{\"begin\":1,\"end\":3}],\"snippet\":\"xy xy+ z\",\"source_begin\":1,\"source_end\":9}]}"]
