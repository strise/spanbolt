# SNIPPET cut to max_snippet_width, swept over widths 6..24 for every word of two texts (one
# column per width). Cloud Spanner's cut isn't a character budget: near the end of the text it
# keeps more than the width (row 11, 'll'), and a match that doesn't fit gives no snippet.
# spanbolt approximates it (`width_cut` in crates/sql/src/search/eval.rs), so most of these fail
# in default mode: they are the target for an exact port.
tags: sql search
schema:
  CREATE TABLE W (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX WSearch ON W(Body_Tokens)
insert W cols=Id,Body:
  [9, "one two three four five six seven eight"]
  [11, "alpha bb c dddd eeeee f gg hhh iiii jjjjj k ll"]

case one
query:
  SELECT SNIPPET(Body, 'one', max_snippet_width => 6) AS w6, SNIPPET(Body, 'one', max_snippet_width => 7) AS w7, SNIPPET(Body, 'one', max_snippet_width => 8) AS w8, SNIPPET(Body, 'one', max_snippet_width => 9) AS w9, SNIPPET(Body, 'one', max_snippet_width => 10) AS w10, SNIPPET(Body, 'one', max_snippet_width => 11) AS w11, SNIPPET(Body, 'one', max_snippet_width => 12) AS w12, SNIPPET(Body, 'one', max_snippet_width => 13) AS w13, SNIPPET(Body, 'one', max_snippet_width => 14) AS w14, SNIPPET(Body, 'one', max_snippet_width => 15) AS w15, SNIPPET(Body, 'one', max_snippet_width => 16) AS w16, SNIPPET(Body, 'one', max_snippet_width => 17) AS w17, SNIPPET(Body, 'one', max_snippet_width => 18) AS w18, SNIPPET(Body, 'one', max_snippet_width => 19) AS w19, SNIPPET(Body, 'one', max_snippet_width => 20) AS w20, SNIPPET(Body, 'one', max_snippet_width => 21) AS w21, SNIPPET(Body, 'one', max_snippet_width => 22) AS w22, SNIPPET(Body, 'one', max_snippet_width => 23) AS w23, SNIPPET(Body, 'one', max_snippet_width => 24) AS w24 FROM W WHERE Id = 9
expect:
  columns: w6 JSON, w7 JSON, w8 JSON, w9 JSON, w10 JSON, w11 JSON, w12 JSON, w13 JSON, w14 JSON, w15 JSON, w16 JSON, w17 JSON, w18 JSON, w19 JSON, w20 JSON, w21 JSON, w22 JSON, w23 JSON, w24 JSON
