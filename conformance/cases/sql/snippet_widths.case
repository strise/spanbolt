# SNIPPET's max_snippet_width over characters above U+00FF, five (or ten) of one character per
# text. Cloud Spanner counts Arial's advance widths, 12 to the em rounded half down, and 9 for
# Latin, Greek and Cyrillic letters Arial lacks. spanbolt follows it (`snippet_char_width` in
# crates/sql/src/search/eval.rs, table from scripts/snippet_widths.py).
tags: sql search
schema:
  CREATE TABLE W (
    Id INT64 NOT NULL,
    Body STRING(MAX),
    Body_Tokens TOKENLIST AS (TOKENIZE_FULLTEXT(Body)) HIDDEN,
  ) PRIMARY KEY (Id);
  CREATE SEARCH INDEX WSearch ON W(Body_Tokens)

case width_cyr_a
query:
  SELECT
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>1) AS c0,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>2) AS c1,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>3) AS c2,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>4) AS c3,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>5) AS c4,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>6) AS c5,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>7) AS c6,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>8) AS c7,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>9) AS c8,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>10) AS c9,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>11) AS c10,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>12) AS c11,
    SNIPPET("\u0430\u0430\u0430\u0430\u0430", "zz", max_snippet_width=>13) AS c12
expect:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON, c10 JSON, c11 JSON, c12 JSON
  ["{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\"}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\"}]}"]
expect@spanner:
  columns: c0 JSON, c1 JSON, c2 JSON, c3 JSON, c4 JSON, c5 JSON, c6 JSON, c7 JSON, c8 JSON, c9 JSON, c10 JSON, c11 JSON, c12 JSON
  ["{\"snippets\":[]}","{\"snippets\":[]}","{\"snippets\":[]}","{\"snippets\":[]}","{\"snippets\":[]}","{\"snippets\":[]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}","{\"snippets\":[{\"highlights\":[],\"snippet\":\"ааааа\",\"source_begin\":1,\"source_end\":6}]}"]

