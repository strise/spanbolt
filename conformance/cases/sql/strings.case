case concat_and_operator
query:
  SELECT CONCAT(Name, ' (', Kind, ')') AS a, Name || '!' AS b, CONCAT('x', NULL) AS c FROM Entities WHERE TeamId = 't1' AND EntityId = 'e1'
expect:
  columns: a STRING, b STRING, c STRING
  ["Acme AS (company)","Acme AS!",null]

case starts_ends_with
query:
  SELECT EntityId FROM Entities WHERE STARTS_WITH(Name, @p) OR ENDS_WITH(Name, 'ASA')
params:
  @p STRING = "Acme"
expect:
  columns: EntityId STRING
  ["e1"]
  ["e4"]
  ["e1"]

case regexp_contains_replace
query:
  SELECT EntityId, REGEXP_REPLACE(Name, r'\s+(AS|ASA)$', '') AS base FROM Entities WHERE REGEXP_CONTAINS(Name, r'(?i)^[a-d]')
expect:
  columns: EntityId STRING, base STRING
  ["e1","Acme"]
  ["e3","Beta Holding"]
  ["e1","Acme"]
  ["e4","Delta"]

case regexp_extract
query:
  SELECT REGEXP_EXTRACT('order-1234-x', r'(\d+)') AS a, REGEXP_EXTRACT_ALL('a1b22c333', r'\d+') AS b
expect:
  columns: a STRING, b ARRAY<STRING>
  ["1234",["1","22","333"]]

case regexp_invalid
query:
  SELECT REGEXP_CONTAINS('a', '(')
expect:
  error: OUT_OF_RANGE
  message: Cannot parse regular expression: missing ): (

case split_and_join
query:
  SELECT SPLIT('a,b,,c', ',') AS parts, SPLIT('', ',') AS empty, ARRAY_TO_STRING(SPLIT('x y', ' '), '|') AS joined
expect:
  columns: parts ARRAY<STRING>, empty ARRAY<STRING>, joined STRING
  [["a","b","","c"],[""],"x|y"]

case format_function
query:
  SELECT FORMAT('%d-%s-%.2f-%05d', 7, 'x', 3.14159, 42) AS f, FORMAT('%t', [1, 2]) AS t
expect:
  columns: f STRING, t STRING
  ["7-x-3.14-00042","[1, 2]"]

case case_and_trim
query:
  SELECT UPPER('æøå') AS u, LOWER('ÆØÅ') AS l, TRIM('  x  ') AS t, LTRIM('xxy', 'x') AS lt, RTRIM('yxx', 'x') AS rt
expect:
  columns: u STRING, l STRING, t STRING, lt STRING, rt STRING
  ["ÆØÅ","æøå","x","y","y"]

case substr_and_strpos
query:
  SELECT SUBSTR('Nordmann', 2, 3) AS s, SUBSTR('abc', -2) AS neg, STRPOS('banana', 'na') AS p, LENGTH('😀') AS len, REVERSE('abc') AS r
expect:
  columns: s STRING, neg STRING, p INT64, len INT64, r STRING
  ["ord","bc","3","1","cba"]

case replace_repeat_pad
query:
  SELECT REPLACE('a.b.c', '.', '/') AS r, REPEAT('ab', 3) AS rep, LPAD('7', 3, '0') AS lp, RPAD('x', 3, '-') AS rp
expect:
  columns: r STRING, rep STRING, lp STRING, rp STRING
  ["a/b/c","ababab","007","x--"]

case like_escapes
query:
  SELECT 'a_b' LIKE 'a\\_b' AS esc, 'axb' LIKE 'a_b' AS any1, '100%' LIKE '100\\%' AS pct
expect:
  columns: esc BOOL, any1 BOOL, pct BOOL
  [true,true,true]

case string_compare_collation
query:
  SELECT 'a' < 'B' AS a, 'Z' < 'a' AS b, 'æ' > 'z' AS c
expect:
  columns: a BOOL, b BOOL, c BOOL
  [false,true,true]

case normalize_and_codepoints
query:
  SELECT TO_CODE_POINTS('aæ') AS cp, CODE_POINTS_TO_STRING([97, 230]) AS s, NORMALIZE('e\u0301') = 'é' AS n
expect:
  columns: cp ARRAY<INT64>, s STRING, n BOOL
  [["97","230"],"aæ",true]

case safe_convert_bytes
query:
  SELECT SAFE_CONVERT_BYTES_TO_STRING(b'\xff') AS s, CAST(b'abc' AS STRING) AS c
expect:
  columns: s STRING, c STRING
  ["�","abc"]

