# ARRAY<STRUCT> result columns (spanbolt #52). Production rejects a result column that can be a
# NULL ARRAY<STRUCT>, and one built with array constructor syntax (`[STRUCT(...)]`); the emulator
# does neither. `expect:` is recorded from the emulator; `expect@spanner:` from real Spanner.
tags: sql struct oracle
schema:
  CREATE TABLE Items (
    Id INT64 NOT NULL,
    Grp STRING(16),
    Val INT64,
  ) PRIMARY KEY (Id)
insert Items cols=Id,Grp,Val:
  [1, "a", 10]
  [2, "a", 20]
  [3, "b", 5]
  [4, null, 7]

# Where a NULL ARRAY<STRUCT> can come from, and what makes it non-null.
case nullable_sources
query:
  SELECT a FROM (SELECT ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items WHERE Id > 100)
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  WITH t AS (SELECT ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items WHERE Id > 100) SELECT a FROM t
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT a FROM (SELECT ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items) WHERE a IS NOT NULL
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["2","20"],["4","7"],["1","10"],["3","5"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Grp, ARRAY_AGG(STRUCT(Id, Val) ORDER BY Id) AS a FROM Items GROUP BY Grp ORDER BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  [null,[["4","7"]]]
  ["a",[["1","10"],["2","20"]]]
  ["b",[["3","5"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY_AGG(STRUCT(Id, Val) ORDER BY Id) AS a FROM Items HAVING COUNT(*) > 0
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["1","10"],["2","20"],["3","5"],["4","7"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY_CONCAT_AGG(ARRAY(SELECT AS STRUCT i.Id FROM Items i WHERE i.Id = o.Id)) AS a FROM Items o WHERE o.Id > 100
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ANY_VALUE(ARRAY(SELECT AS STRUCT i.Id FROM Items i WHERE i.Id = o.Id)) AS a FROM Items o WHERE o.Id = 1
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT i.Id FROM Items i WHERE i.Id = 1)) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT Id, CASE WHEN Val > 8 THEN ARRAY(SELECT AS STRUCT 1 AS x) END AS a FROM Items ORDER BY Id
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT COALESCE(ARRAY_AGG(STRUCT(Id, Val)), ARRAY_AGG(STRUCT(Id, Val))) AS a FROM Items WHERE Id > 100
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT o.Id, t.a FROM Items o LEFT JOIN (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a, 1 AS k) t ON o.Id = t.k ORDER BY o.Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",null]
  ["3",null]
  ["4",null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. A likely cause for this error is a sub-SELECT in a FULL OUTER JOIN, or on the nullable side of a LEFT/RIGHT OUTER JOIN. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT a FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a UNION ALL SELECT ARRAY_AGG(STRUCT(2 AS x)) FROM Items WHERE Id > 100)
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [null]
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY_CONCAT(ARRAY(SELECT AS STRUCT 1 AS x), ARRAY(SELECT AS STRUCT 2 AS x)) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"],["2"]]]
expect@spanner:
  same
query:
  SELECT ARRAY_REVERSE(ARRAY(SELECT AS STRUCT Id FROM Items WHERE Id < 3 ORDER BY Id)) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [[["2"],["1"]]]
expect@spanner:
  same
query:
  SELECT @p AS a
params:
  @p ARRAY<STRUCT<x INT64>> = [[1]]
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT (SELECT ARRAY_AGG(STRUCT(i.Id AS y)) FROM Items i WHERE i.Id > 100) AS f) AS a
expect:
  columns: a ARRAY<STRUCT<f ARRAY<STRUCT<y INT64>>>>
  [[[null]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<y INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT ARRAY_AGG(STRUCT(i.Id AS y)) AS f FROM Items i WHERE i.Id > 100) AS a
expect:
  columns: a ARRAY<STRUCT<f ARRAY<STRUCT<y INT64>>>>
  [[[null]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<y INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.

# Shapes that are never NULL.
case non_null_sources
query:
  SELECT ARRAY(SELECT AS STRUCT Id, Val FROM Items WHERE Id > 100) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[]]
expect@spanner:
  same
query:
  SELECT Id, IF(Val > 8, ARRAY(SELECT AS STRUCT 1 AS x), ARRAY(SELECT AS STRUCT 2 AS x)) AS a FROM Items ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[["1"]]]
  ["3",[["2"]]]
  ["4",[["2"]]]
expect@spanner:
  same
query:
  SELECT Id, IF(Val > 8, ARRAY(SELECT AS STRUCT 1 AS x), []) AS a FROM Items ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[["1"]]]
  ["3",[]]
  ["4",[]]
expect@spanner:
  same
query:
  SELECT IFNULL(CAST(NULL AS ARRAY<STRUCT<x INT64>>), ARRAY(SELECT AS STRUCT 1 AS x)) AS a
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
query:
  SELECT a FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT ARRAY<STRUCT<x INT64>>[] AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[]]
expect@spanner:
  same
query:
  SELECT x.a FROM UNNEST(ARRAY(SELECT AS STRUCT ARRAY(SELECT AS STRUCT 1 AS y) AS a)) AS x
expect:
  columns: a ARRAY<STRUCT<y INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT (SELECT ARRAY_AGG(STRUCT(i.Id AS Id)) FROM Items i WHERE i.Id > 100) IS NULL AS n
expect:
  columns: n BOOL
  [true]
expect@spanner:
  same
query:
  SELECT ARRAY(SELECT STRUCT(Id, Val) FROM Items WHERE Id < 3 ORDER BY Id) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["1","10"],["2","20"]]]
expect@spanner:
  same

# Array constructor syntax for an ARRAY<STRUCT> result.
case array_constructor
query:
  SELECT ARRAY<STRUCT<x INT64>>[(1)] AS a
expect:
  error: INVALID_ARGUMENT
  message: Array element type INT64 does not coerce to STRUCT<x INT64> [at 1:32]
expect@spanner:
  same
query:
  SELECT Id, [STRUCT(Id AS Id)] AS a FROM Items ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<Id INT64>>
  ["1",[["1"]]]
  ["2",[["2"]]]
  ["3",[["3"]]]
  ["4",[["4"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT a FROM (SELECT [STRUCT(1 AS x)] AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT COALESCE(ARRAY_AGG(STRUCT(Id, Val)), [STRUCT(0 AS Id, 0 AS Val)]) AS a FROM Items WHERE Id > 100
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["0","0"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT ARRAY_CONCAT([STRUCT(1 AS x)], ARRAY(SELECT AS STRUCT 2 AS x)) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"],["2"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT ARRAY(SELECT AS STRUCT * FROM UNNEST([STRUCT(1 AS x)])) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT ARRAY_LENGTH([STRUCT(1 AS x)]) AS n
expect:
  columns: n INT64
  ["1"]
expect@spanner:
  same
query:
  SELECT ARRAY(SELECT AS STRUCT [STRUCT(1 AS y)] AS f) AS a
expect:
  columns: a ARRAY<STRUCT<f ARRAY<STRUCT<y INT64>>>>
  [[[[["1"]]]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT Id, CASE WHEN Val > 8 THEN [STRUCT(Id AS Id)] ELSE NULL END AS a FROM Items ORDER BY Id
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.

# How nullability passes through functions, joins, subqueries and nested fields.
case nullable_flow
query:
  SELECT ARRAY_CONCAT(ARRAY_AGG(STRUCT(Id AS x)), ARRAY(SELECT AS STRUCT 1 AS x)) AS a FROM Items
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["2"],["4"],["1"],["3"],["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY_REVERSE(ARRAY_AGG(STRUCT(Id AS x))) AS a FROM Items
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["3"],["1"],["4"],["2"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT i.Id FROM Items i WHERE i.Id = o.Id) FROM Items o WHERE o.Id > 100) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT o.Id, IFNULL(t.a, []) AS a FROM Items o LEFT JOIN (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a, 1 AS k) t ON o.Id = t.k ORDER BY o.Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[]]
  ["3",[]]
  ["4",[]]
expect@spanner:
  same
query:
  SELECT o.Id, t.a FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a, 1 AS k) t LEFT JOIN Items o ON o.Id = t.k ORDER BY o.Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
expect@spanner:
  same
query:
  SELECT o.Id, t.a FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a, 1 AS k) t RIGHT JOIN Items o ON o.Id = t.k ORDER BY o.Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",null]
  ["3",null]
  ["4",null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. A likely cause for this error is a sub-SELECT in a FULL OUTER JOIN, or on the nullable side of a LEFT/RIGHT OUTER JOIN. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT o.Id, t.a FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x) AS a, 1 AS k) t FULL JOIN Items o ON o.Id = t.k ORDER BY o.Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",null]
  ["3",null]
  ["4",null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT k FROM (SELECT ARRAY_AGG(STRUCT(Id)) AS a, 1 AS k FROM Items)
expect:
  columns: k INT64
  ["1"]
expect@spanner:
  same
query:
  SELECT * FROM (SELECT ARRAY_AGG(STRUCT(Id)) AS a FROM Items WHERE Id > 100)
expect:
  columns: a ARRAY<STRUCT<Id INT64>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT CAST(NULL AS ARRAY<STRUCT<x INT64>>) AS a, [STRUCT(1 AS x)] AS b
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT [STRUCT(1 AS x)] AS b, CAST(NULL AS ARRAY<STRUCT<x INT64>>) AS a
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT ARRAY_AGG(STRUCT(Id, 1, [1, 2] AS arr, STRUCT(1 AS q, 'r' AS r) AS s, CAST(NULL AS NUMERIC) AS n)) AS a FROM Items WHERE Id > 100
expect:
  columns: a ARRAY<STRUCT<Id INT64, INT64, arr ARRAY<INT64>, s STRUCT<q INT64, r STRING>, n NUMERIC>>
  [null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, INT64, arr ARRAY<INT64>, s STRUCT<q INT64, r STRING>, n NUMERIC>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT ARRAY(SELECT AS STRUCT CAST(NULL AS ARRAY<STRUCT<z INT64>>) AS g) AS f) AS a
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT @p AS f) AS a
params:
  @p ARRAY<STRUCT<x INT64>> = [[1]]
expect:
  columns: a ARRAY<STRUCT<f ARRAY<STRUCT<x INT64>>>>
  [[[[["1"]]]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT IF(i.Val > 8, ARRAY(SELECT AS STRUCT 1 AS x), NULL) AS f FROM Items i) AS a
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT a FROM (SELECT ARRAY(SELECT AS STRUCT CAST(NULL AS ARRAY<STRUCT<z INT64>>) AS g) AS a)
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Id, CASE Grp WHEN 'a' THEN ARRAY(SELECT AS STRUCT 1 AS x) WHEN 'b' THEN NULL ELSE [] END AS a FROM Items ORDER BY Id
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Id, CASE Grp WHEN 'a' THEN ARRAY(SELECT AS STRUCT 1 AS x) ELSE [] END AS a FROM Items ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[["1"]]]
  ["3",[]]
  ["4",[]]
expect@spanner:
  same
query:
  SELECT ARRAY(SELECT AS STRUCT i.Id, ARRAY(SELECT AS STRUCT ARRAY_AGG(STRUCT(j.Id AS z)) AS g FROM Items j WHERE j.Id > 100) AS f FROM Items i WHERE i.Id = 1) AS a
expect:
  columns: a ARRAY<STRUCT<Id INT64, f ARRAY<STRUCT<g ARRAY<STRUCT<z INT64>>>>>>
  [[["1",[[null]]]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT AS STRUCT * FROM (SELECT ARRAY_AGG(STRUCT(Id AS z)) AS g FROM Items WHERE Id > 100)) AS a
expect:
  columns: a ARRAY<STRUCT<g ARRAY<STRUCT<z INT64>>>>
  [[[null]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY(SELECT x FROM UNNEST(ARRAY(SELECT AS STRUCT 1 AS x)) AS x) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT ARRAY_CONCAT(CAST(NULL AS ARRAY<STRUCT<x INT64>>), ARRAY(SELECT AS STRUCT 1 AS x)) AS a
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.

# When a scalar subquery can return no row, and whether the rules look through aggregates.
case scalar_subquery_and_aggregates
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT 1 AS x) FROM Items LIMIT 1) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT 1 AS x) FROM UNNEST([1])) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT 1 AS x) FROM (SELECT COUNT(*) AS c FROM Items)) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  WITH w AS (SELECT 1 AS k) SELECT (SELECT ARRAY(SELECT AS STRUCT 1 AS x) FROM w) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  same
query:
  SELECT (SELECT ARRAY(SELECT AS STRUCT 1 AS x) FROM Items WHERE Id = 1) AS a
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["1"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Id, (SELECT ARRAY(SELECT AS STRUCT o.Id AS x)) AS a FROM Items o ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[["2"]]]
  ["3",[["3"]]]
  ["4",[["4"]]]
expect@spanner:
  same
query:
  SELECT Id, (SELECT ARRAY(SELECT AS STRUCT o.Id AS x) FROM (SELECT 1) LIMIT 1) AS a FROM Items o ORDER BY Id
expect:
  columns: Id INT64, a ARRAY<STRUCT<x INT64>>
  ["1",[["1"]]]
  ["2",[["2"]]]
  ["3",[["3"]]]
  ["4",[["4"]]]
expect@spanner:
  same
query:
  SELECT IFNULL(ARRAY_CONCAT_AGG([STRUCT(Id AS x)]), []) AS a FROM Items
expect:
  columns: a ARRAY<STRUCT<x INT64>>
  [[["2"],["4"],["1"],["3"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT IFNULL(ANY_VALUE(ARRAY(SELECT AS STRUCT CAST(NULL AS ARRAY<STRUCT<z INT64>>) AS g)), []) AS a FROM Items
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Id, IFNULL((SELECT ARRAY(SELECT AS STRUCT CAST(NULL AS ARRAY<STRUCT<z INT64>>) AS g) FROM Items i WHERE i.Id = o.Id), []) AS a FROM Items o ORDER BY Id
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<z INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.

# Aggregates in a grouped query: every group has a row.
case grouped_aggregates
query:
  SELECT Grp, ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["2","20"],["1","10"]]]
  [null,[["4","7"]]]
  ["b",[["3","5"]]]
expect@spanner:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  [null,[["4","7"]]]
  ["b",[["3","5"]]]
  ["a",[["1","10"],["2","20"]]]
query:
  SELECT Grp, ARRAY_AGG(STRUCT(Id, Val) ORDER BY Id) AS a FROM Items GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["1","10"],["2","20"]]]
  [null,[["4","7"]]]
  ["b",[["3","5"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT ARRAY_AGG(STRUCT(Id, Val) ORDER BY Val) AS a FROM Items GROUP BY Grp
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["1","10"],["2","20"]]]
  [[["4","7"]]]
  [[["3","5"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Grp, ARRAY_AGG(STRUCT(Id, Val) LIMIT 1) AS a FROM Items GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["2","20"]]]
  [null,[["4","7"]]]
  ["b",[["3","5"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<Id INT64, Val INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Grp, ARRAY_AGG(IF(Val > 8, STRUCT(Id, Val), NULL) IGNORE NULLS) AS a FROM Items GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["2","20"],["1","10"]]]
  [null,null]
  ["b",null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.
query:
  SELECT Grp, ARRAY_CONCAT_AGG(ARRAY(SELECT AS STRUCT i.Id FROM Items i WHERE i.Id = o.Id)) AS a FROM Items o GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64>>
  ["a",[["2"],["1"]]]
  [null,[["4"]]]
  ["b",[["3"]]]
expect@spanner:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64>>
  [null,[["4"]]]
  ["b",[["3"]]]
  ["a",[["1"],["2"]]]
query:
  SELECT Grp, ANY_VALUE(IF(Val > 8, ARRAY(SELECT AS STRUCT 1 AS x), NULL)) AS a FROM Items GROUP BY Grp
expect:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Spanner does not support array constructor syntax for a null-valued array of struct.
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query can return a null-valued array of struct, which is not supported by Spanner. ARRAY<STRUCT<x INT64>> is the type that might contain null values. Use IFNULL/COALESCE to convert potentially null values to non-null values.
query:
  SELECT Grp, ANY_VALUE(ARRAY(SELECT AS STRUCT 1 AS x)) AS a FROM Items GROUP BY Grp
expect:
  columns: Grp STRING, a ARRAY<STRUCT<x INT64>>
  ["a",[["1"]]]
  [null,[["1"]]]
  ["b",[["1"]]]
expect@spanner:
  same
query:
  SELECT Grp, ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items GROUP BY Grp HAVING COUNT(*) > 1
expect:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["2","20"],["1","10"]]]
expect@spanner:
  columns: Grp STRING, a ARRAY<STRUCT<Id INT64, Val INT64>>
  ["a",[["1","10"],["2","20"]]]
query:
  SELECT a FROM (SELECT Grp, ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items GROUP BY Grp)
expect:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["2","20"],["1","10"]]]
  [[["4","7"]]]
  [[["3","5"]]]
expect@spanner:
  columns: a ARRAY<STRUCT<Id INT64, Val INT64>>
  [[["4","7"]]]
  [[["3","5"]]]
  [[["1","10"],["2","20"]]]
query:
  SELECT ARRAY_AGG(STRUCT(Id, Val)) AS a FROM Items GROUP BY ROLLUP(Grp)
expect:
  error: INVALID_ARGUMENT
  message: GROUP BY ROLLUP is unsupported [at 1:60]
expect@spanner:
  same
query:
  SELECT Grp, ARRAY_AGG(DISTINCT STRUCT(Id, Val)) AS a FROM Items GROUP BY Grp
expect:
  error: INVALID_ARGUMENT
  message: Aggregate functions with DISTINCT cannot be used with arguments of type STRUCT [at 1:13]
expect@spanner:
  same
