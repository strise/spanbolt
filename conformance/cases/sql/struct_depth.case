expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: This query returns a STRUCT value constructed by a scalar subquery or struct construction syntax. Spanner does not yet support returning STRUCT except as arrays-of-structs. Rephrase your query to produce the struct value with an array subquery: ARRAY(SELECT AS STRUCT expr ...) or flatten the structs fields into the result.

# Spanner returns no STRUCT inside a returned ARRAY<STRUCT> either, at any depth; an ARRAY<STRUCT>
# field is fine.
case result_type_2
query:
  SELECT CAST([] AS ARRAY<STRUCT<f STRUCT<g INT64>>>) AS s
expect:
  columns: s ARRAY<STRUCT<f STRUCT<g INT64>>>
  [[]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: A struct value cannot be returned as a column value. Rewrite the query to flatten the struct fields in the result.

case result_type_struct_in_array_field
query:
  SELECT CAST([] AS ARRAY<STRUCT<f ARRAY<STRUCT<g STRUCT<h INT64>>>>>) AS s
expect:
  columns: s ARRAY<STRUCT<f ARRAY<STRUCT<g STRUCT<h INT64>>>>>
  [[]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: A struct value cannot be returned as a column value. Rewrite the query to flatten the struct fields in the result.

case result_type_array_field
query:
  SELECT CAST([] AS ARRAY<STRUCT<f ARRAY<STRUCT<g INT64>>>>) AS s
expect:
  columns: s ARRAY<STRUCT<f ARRAY<STRUCT<g INT64>>>>
  [[]]
expect@spanner:
  same

case result_subquery_struct_field
query:
  SELECT ARRAY(SELECT AS STRUCT 1 AS a, CAST(NULL AS STRUCT<g INT64>) AS f) AS s
expect:
  columns: s ARRAY<STRUCT<a INT64, f STRUCT<g INT64>>>
  [[["1",null]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: A struct value cannot be returned as a column value. Rewrite the query to flatten the struct fields in the result.
