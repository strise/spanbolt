# STRUCT types nested deep (#160, #162). A STRUCT level of GoogleSQL's TypeProto is three protobuf
# messages and of a STRUCT literal's value two, so prost's limit of 100 nested messages stopped
# spanbolt at 32 levels of type and 50 of literal. The emulator answers thousands of levels of type;
# STRUCT parameters stop at 15 levels. Cloud Spanner runs out of stack sooner (about 1200 levels of
# type, 450 field accesses), fails to decode a request with a parameter type 33 levels deep, and
# returns no STRUCT nested in a returned ARRAY<STRUCT>.
tags: sql struct limits

case cast_16
query:
  SELECT CAST(NULL AS STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f STRUCT<f INT64>>>>>>>>>>>>>>>>) IS NULL
expect:
  columns: BOOL
  [true]
expect@spanner:
  same

