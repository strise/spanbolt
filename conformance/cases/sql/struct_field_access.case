case single_row_correlated_filter
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT d.x FROM (SELECT 1 AS x) d WHERE d.x = n) AS a FROM UNNEST([1,2]) n)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[],null]
  [[["1"]],"1"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case unnest_of_outer_column_with_filter
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT v AS x FROM UNNEST([n]) v WHERE v > 0) AS a FROM UNNEST([1,2]) n)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["2"]],"2"]
  [[["1"]],"1"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case read_through_array_reverse
query:
  SELECT c.a, ARRAY_REVERSE(c.a)[SAFE_OFFSET(0)].x AS x FROM (SELECT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS x FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a) c
expect:
  columns: a ARRAY<STRUCT<x STRING>>, x STRING
  [[["reviews"]],"reviews"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case read_through_scalar_subquery_element
query:
  SELECT c.a, (SELECT e FROM UNNEST(c.a) e LIMIT 1).x AS x FROM (SELECT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS x FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a) c
expect:
  columns: a ARRAY<STRUCT<x STRING>>, x STRING
  [[["reviews"]],"reviews"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case read_through_array_concat
query:
  SELECT c.a, ARRAY_CONCAT(c.a, c.a)[SAFE_OFFSET(0)].x AS x FROM (SELECT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS x FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a) c
expect:
  columns: a ARRAY<STRUCT<x STRING>>, x STRING
  [[["reviews"]],"reviews"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case read_through_array_first
query:
  SELECT c.a FROM (SELECT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS x FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a) c WHERE ARRAY_FIRST(c.a).x = 'reviews'
expect:
  columns: a ARRAY<STRUCT<x STRING>>
  [[["reviews"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case read_through_safe_ordinal
query:
  SELECT c.a, c.a[SAFE_ORDINAL(1)].x AS x FROM (SELECT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS x FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a) c
expect:
  columns: a ARRAY<STRUCT<x STRING>>, x STRING
  [[["reviews"]],"reviews"]
expect@spanner:
