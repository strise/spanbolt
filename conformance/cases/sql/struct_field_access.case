# Cloud Spanner cannot read a field of a struct that the query also returns: an
# ARRAY(SELECT AS STRUCT ...) column that is in the final result and has a field read anywhere in
# the query. It only applies when the array subquery can yield other than exactly one row (a table
# scan, a multi-element UNNEST, GROUP BY, a filter that is not constant). The emulator accepts
# every shape here.
# `expect@spanner:` blocks are recorded with `record --oracle spanner`. The probes that mapped the
# rule are in conformance/spanner-probes-struct-field-access.md.
tags: sql struct oracle
schema:
  CREATE TABLE reviews (
    id INT64 NOT NULL,
    risk_level STRING(32),
    effective_at TIMESTAMP,
  ) PRIMARY KEY (id)
insert reviews cols=id,risk_level,effective_at:
  [1, "high", "2024-01-01T00:00:00Z"]
  [2, "low", "2024-06-01T00:00:00Z"]

# Rejected by Cloud Spanner.

case retention_candidates_shape
query:
  SELECT c.TABLE_NAME, c.last_col, ARRAY(SELECT AS STRUCT r.COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS r WHERE r.TABLE_NAME = c.TABLE_NAME AND r.ORDINAL_POSITION <= c.last_col[SAFE_OFFSET(0)].ORDINAL_POSITION ORDER BY r.ORDINAL_POSITION DESC LIMIT 1) AS at_or_before FROM (SELECT s.TABLE_NAME, ARRAY(SELECT AS STRUCT l.COLUMN_NAME, l.ORDINAL_POSITION FROM INFORMATION_SCHEMA.COLUMNS l WHERE l.TABLE_NAME = s.TABLE_NAME AND l.TABLE_SCHEMA = s.TABLE_SCHEMA ORDER BY l.ORDINAL_POSITION DESC LIMIT 1) AS last_col FROM INFORMATION_SCHEMA.TABLES s WHERE s.TABLE_SCHEMA = '' AND s.TABLE_NAME = 'reviews') c
expect:
  columns: TABLE_NAME STRING, last_col ARRAY<STRUCT<COLUMN_NAME STRING, ORDINAL_POSITION INT64>>, at_or_before ARRAY<STRUCT<COLUMN_NAME STRING>>
  ["reviews",[["effective_at","3"]],[["effective_at"]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case table_array_returned_and_read
query:
  SELECT c.TABLE_NAME, c.last_col, c.last_col[SAFE_OFFSET(0)].COLUMN_NAME AS n FROM (SELECT s.TABLE_NAME, ARRAY(SELECT AS STRUCT l.COLUMN_NAME, l.ORDINAL_POSITION FROM INFORMATION_SCHEMA.COLUMNS l WHERE l.TABLE_NAME = s.TABLE_NAME AND l.TABLE_SCHEMA = s.TABLE_SCHEMA ORDER BY l.ORDINAL_POSITION DESC LIMIT 1) AS last_col FROM INFORMATION_SCHEMA.TABLES s WHERE s.TABLE_SCHEMA = '' AND s.TABLE_NAME = 'reviews') c
expect:
  columns: TABLE_NAME STRING, last_col ARRAY<STRUCT<COLUMN_NAME STRING, ORDINAL_POSITION INT64>>, n STRING
  ["reviews",[["effective_at","3"]],"effective_at"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

