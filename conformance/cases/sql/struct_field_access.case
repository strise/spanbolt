case single_row_limit_zero
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT 1 AS x FROM UNNEST([1]) v LIMIT 0) AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[],null]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

# Accepted by Cloud Spanner.

case table_array_read_but_not_returned
query:
  SELECT c.TABLE_NAME, ARRAY(SELECT AS STRUCT r.COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS r WHERE r.TABLE_NAME = c.TABLE_NAME AND r.ORDINAL_POSITION <= c.last_col[SAFE_OFFSET(0)].ORDINAL_POSITION ORDER BY r.ORDINAL_POSITION DESC LIMIT 1) AS at_or_before FROM (SELECT s.TABLE_NAME, ARRAY(SELECT AS STRUCT l.COLUMN_NAME, l.ORDINAL_POSITION FROM INFORMATION_SCHEMA.COLUMNS l WHERE l.TABLE_NAME = s.TABLE_NAME AND l.TABLE_SCHEMA = s.TABLE_SCHEMA ORDER BY l.ORDINAL_POSITION DESC LIMIT 1) AS last_col FROM INFORMATION_SCHEMA.TABLES s WHERE s.TABLE_SCHEMA = '' AND s.TABLE_NAME = 'reviews') c
expect:
  columns: TABLE_NAME STRING, at_or_before ARRAY<STRUCT<COLUMN_NAME STRING>>
  ["reviews",[["effective_at"]]]
expect@spanner:
  same

