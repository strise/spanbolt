case table_array_element_null_and_length
query:
  SELECT c.last_col, c.last_col[SAFE_OFFSET(0)] IS NULL AS n, ARRAY_LENGTH(c.last_col) AS len FROM (SELECT s.TABLE_NAME, ARRAY(SELECT AS STRUCT l.COLUMN_NAME, l.ORDINAL_POSITION FROM INFORMATION_SCHEMA.COLUMNS l WHERE l.TABLE_NAME = s.TABLE_NAME AND l.TABLE_SCHEMA = s.TABLE_SCHEMA ORDER BY l.ORDINAL_POSITION DESC LIMIT 1) AS last_col FROM INFORMATION_SCHEMA.TABLES s WHERE s.TABLE_SCHEMA = '' AND s.TABLE_NAME = 'reviews') c
expect:
  columns: last_col ARRAY<STRUCT<COLUMN_NAME STRING, ORDINAL_POSITION INT64>>, n BOOL, len INT64
  [[["effective_at","3"]],false,"1"]
expect@spanner:
  same

case table_array_read_only
