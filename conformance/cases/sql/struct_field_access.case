query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT d.x FROM (SELECT d0.x FROM (SELECT 1 AS x) d0) d) AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["1"]],"1"]
expect@spanner:
  same

case single_row_with_entry
query:
  WITH d AS (SELECT 1 AS x) SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT d.x FROM d) AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["1"]],"1"]
expect@spanner:
  same

case one_element_unnest_of_outer_column
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT v AS x FROM UNNEST([n]) v) AS a FROM UNNEST([1,2]) n)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["2"]],"2"]
  [[["1"]],"1"]
expect@spanner:
  same

case scalar_aggregate_with_correlated_filter
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT COUNT(*) AS x FROM UNNEST([1,2]) v WHERE v = n) AS a FROM UNNEST([1,2]) n)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["1"]],"1"]
  [[["1"]],"1"]
expect@spanner:
  same

case left_join_of_single_rows
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT AS STRUCT d.x FROM (SELECT 1 AS x) d LEFT JOIN (SELECT 2 AS y) e ON TRUE) AS a)
expect:
  columns: a ARRAY<STRUCT<x INT64>>, x INT64
  [[["1"]],"1"]
expect@spanner:
  same

# A nested table inside a single-row array (probe v14) is rejected once read through the outer
# struct. A constant filter is folded: FALSE or NULL leaves no row, so the subquery is a nested
# table; TRUE keeps it single-row.

case nested_table_in_single_row_array
query:
  SELECT a, a[SAFE_OFFSET(0)].x[SAFE_OFFSET(0)].y FROM (SELECT ARRAY(SELECT AS STRUCT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS y FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS x FROM UNNEST([1]) v) AS a)
expect:
  columns: a ARRAY<STRUCT<x ARRAY<STRUCT<y STRING>>>>, y STRING
  [[[[["reviews"]]]],"reviews"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case nested_table_in_no_from_array
query:
  SELECT a, a[SAFE_OFFSET(0)].x[SAFE_OFFSET(0)].y FROM (SELECT ARRAY(SELECT AS STRUCT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS y FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS x) AS a)
expect:
  columns: a ARRAY<STRUCT<x ARRAY<STRUCT<y STRING>>>>, y STRING
  [[[[["reviews"]]]],"reviews"]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

case nested_table_in_single_row_array_read_in_where
query:
  SELECT a FROM (SELECT ARRAY(SELECT AS STRUCT ARRAY(SELECT AS STRUCT t.TABLE_NAME AS y FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS x FROM UNNEST([1]) v) AS a) WHERE a[SAFE_OFFSET(0)].x[SAFE_OFFSET(0)].y IS NOT NULL
expect:
  columns: a ARRAY<STRUCT<x ARRAY<STRUCT<y STRING>>>>
  [[[[["reviews"]]]]]
expect@spanner:
  error: UNIMPLEMENTED
  message: Unsupported query shape: Accessing fields of a struct value also present in the final result is not supported.

