case table_array_of_select_struct
query:
  SELECT a, a[SAFE_OFFSET(0)].x FROM (SELECT ARRAY(SELECT STRUCT(t.TABLE_NAME AS x) FROM INFORMATION_SCHEMA.TABLES t WHERE t.TABLE_NAME = 'reviews') AS a)
