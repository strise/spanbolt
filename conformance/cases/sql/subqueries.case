tags: sql subquery
schema:
  CREATE TABLE Teams (
    TeamId STRING(36) NOT NULL,
    Name STRING(MAX) NOT NULL,
    CustomerId STRING(36),
    Created TIMESTAMP NOT NULL,
  ) PRIMARY KEY (TeamId);
  CREATE TABLE Entities (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    Kind STRING(32) NOT NULL,
    Status STRING(32),
    Name STRING(MAX),
    Aliases ARRAY<STRING(MAX)>,
    Data JSON,
    Score FLOAT64,
    Version INT64 NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    UpdatedAt TIMESTAMP,
  ) PRIMARY KEY (TeamId, EntityId),
    INTERLEAVE IN PARENT Teams ON DELETE CASCADE;
  CREATE INDEX EntitiesByKind ON Entities(TeamId, Kind);
  CREATE NULL_FILTERED INDEX EntitiesByStatus ON Entities(Status) STORING (Name);
  CREATE TABLE Reviews (
    TeamId STRING(36) NOT NULL,
    EntityId STRING(36) NOT NULL,
    ReviewId INT64 NOT NULL,
    CreatedBy STRING(36) NOT NULL,
    CreatedAt TIMESTAMP NOT NULL,
    Outcome STRING(16),
  ) PRIMARY KEY (TeamId, EntityId, ReviewId),
    INTERLEAVE IN PARENT Entities ON DELETE CASCADE;
  CREATE TABLE Users (
    UserId STRING(36) NOT NULL,
    Email STRING(MAX) NOT NULL,
    Name STRING(MAX),
  ) PRIMARY KEY (UserId);
  CREATE TABLE Signals (
    EntityId STRING(36) NOT NULL,
    SignalType STRING(32) NOT NULL,
    ValidFrom TIMESTAMP NOT NULL,
    Confidence FLOAT64 NOT NULL,
  ) PRIMARY KEY (EntityId, SignalType, ValidFrom)
insert Teams cols=TeamId,Name,CustomerId,Created:
  ["t1", "Alpha", "c1", "2024-01-01T00:00:00Z"]
  ["t2", "Beta", "c1", "2024-02-01T00:00:00Z"]
  ["t3", "Gamma", null, "2024-03-01T00:00:00Z"]
insert Entities cols=TeamId,EntityId,Kind,Status,Name,Aliases,Data,Score,Version,CreatedAt,UpdatedAt:
  ["t1", "e1", "company", "active", "Acme AS", ["ACME", "Acme Group"], "{\"country\":\"NO\",\"size\":120,\"tags\":[\"a\",\"b\"],\"owner\":{\"id\":\"p1\",\"share\":0.5}}", 0.75, 3, "2024-01-05T10:00:00Z", "2024-06-01T12:30:00.123456Z"]
  ["t1", "e2", "person", "active", "Kari Nordmann", [], "{\"country\":\"NO\",\"birth\":{\"year\":1980}}", 0.5, 1, "2024-01-06T00:00:00Z", null]
  ["t1", "e3", "company", "archived", "Beta Holding", ["BH"], "{\"country\":\"SE\",\"size\":5}", null, 2, "2024-02-10T08:00:00Z", "2024-03-01T00:00:00Z"]
  ["t1", "e4", "company", null, "Delta ASA", null, null, 1.25, 1, "2024-03-15T00:00:00Z", null]
  ["t2", "e1", "company", "active", "Acme AS", ["ACME"], "{\"country\":\"NO\",\"size\":120}", 0.9, 5, "2024-02-02T00:00:00Z", null]
  ["t2", "e5", "person", "pending", "Ola Nordmann", ["Ola"], "{\"country\":\"DK\"}", 0.1, 1, "2024-04-01T00:00:00Z", null]
insert Reviews cols=TeamId,EntityId,ReviewId,CreatedBy,CreatedAt,Outcome:
  ["t1", "e1", 1, "u1", "2024-01-10T00:00:00Z", "approved"]
  ["t1", "e1", 2, "u2", "2024-02-10T00:00:00Z", null]
  ["t1", "e3", 1, "u1", "2024-02-11T00:00:00Z", "rejected"]
  ["t2", "e5", 1, "u3", "2024-04-02T00:00:00Z", null]
insert Users cols=UserId,Email,Name:
  ["u1", "ann@example.com", "Ann"]
  ["u2", "bob@example.com", null]
  ["u4", "dan@example.com", "Dan"]
insert Signals cols=EntityId,SignalType,ValidFrom,Confidence:
  ["e1", "news", "2024-05-01T00:00:00Z", 0.8]
  ["e1", "news", "2024-05-20T00:00:00Z", 0.4]
  ["e1", "sanction", "2024-04-01T00:00:00Z", 1.0]
  ["e3", "news", "2024-05-02T00:00:00Z", 0.6]
  ["e5", "pep", "2024-01-01T00:00:00Z", 0.9]

case in_subquery
query:
  SELECT EntityId FROM Entities WHERE EntityId IN (SELECT EntityId FROM Signals WHERE SignalType = 'news')
expect:
  columns: EntityId STRING
  ["e3"]
  ["e1"]
  ["e1"]

case not_exists_anti_join
query:
  SELECT e.TeamId, e.EntityId FROM Entities e
  WHERE NOT EXISTS (SELECT 1 FROM Reviews r WHERE r.TeamId = e.TeamId AND r.EntityId = e.EntityId)
expect:
  columns: TeamId STRING, EntityId STRING
  ["t1","e4"]
  ["t1","e2"]
  ["t2","e1"]

case exists_correlated
query:
  SELECT e.EntityId FROM Entities e
  WHERE EXISTS (SELECT 1 FROM Reviews r WHERE r.TeamId = e.TeamId AND r.EntityId = e.EntityId AND r.CreatedBy = @u AND r.Outcome IS NULL)
params:
  @u STRING = "u2"
expect:
  columns: EntityId STRING
  ["e1"]

case latest_per_key_anti_join
query:
  SELECT s.EntityId, s.SignalType, s.ValidFrom FROM Signals s
  WHERE NOT EXISTS (SELECT 1 FROM Signals later
    WHERE later.EntityId = s.EntityId AND later.SignalType = s.SignalType AND later.ValidFrom > s.ValidFrom)
expect:
  columns: EntityId STRING, SignalType STRING, ValidFrom TIMESTAMP
  ["e3","news","2024-05-02T00:00:00Z"]
  ["e5","pep","2024-01-01T00:00:00Z"]
  ["e1","news","2024-05-20T00:00:00Z"]
  ["e1","sanction","2024-04-01T00:00:00Z"]

case scalar_subquery_in_join
query:
  SELECT t.TeamId, (SELECT MAX(e.Version) FROM Entities e WHERE e.TeamId = t.TeamId) AS max_version FROM Teams t
expect:
  columns: TeamId STRING, max_version INT64
  ["t1","3"]
  ["t2","5"]
  ["t3",null]

case scalar_subquery_multiple_rows
query:
  SELECT (SELECT EntityId FROM Entities) AS x
expect:
  error: OUT_OF_RANGE
  message: More than one element

case not_in_with_null
query:
  SELECT EntityId FROM Entities WHERE TeamId = 't1' AND Status NOT IN (SELECT Status FROM Entities WHERE TeamId = 't1')
expect:
  columns: EntityId STRING

case cte_multi
query:
  WITH counts AS (SELECT TeamId, COUNT(*) AS n FROM Entities GROUP BY TeamId),
       named AS (SELECT t.Name, c.n FROM Teams t JOIN counts c USING (TeamId))
  SELECT Name, n FROM named ORDER BY n DESC, Name
expect:
  columns: Name STRING, n INT64
  ["Alpha","4"]
  ["Beta","2"]

case cte_page_first
query:
  WITH page AS (SELECT TeamId, EntityId FROM Entities ORDER BY CreatedAt DESC LIMIT @limit)
  SELECT e.EntityId, e.Name FROM Entities e WHERE (e.TeamId, e.EntityId) IN (SELECT AS STRUCT TeamId, EntityId FROM page)
params:
  @limit INT64 = 2
expect:
  columns: EntityId STRING, Name STRING
  ["e5","Ola Nordmann"]
  ["e4","Delta ASA"]

case cte_union_links
query:
  WITH link AS (
    SELECT EntityId AS owner, Name AS linked FROM Entities WHERE TeamId = @t AND Name IS NOT NULL
    UNION ALL
    SELECT EntityId, CreatedBy FROM Reviews WHERE TeamId = @t)
  SELECT linked, MIN(owner) AS owner FROM link GROUP BY linked
params:
  @t STRING = "t1"
expect:
  columns: linked STRING, owner STRING
  ["Beta Holding","e3"]
  ["Kari Nordmann","e2"]
  ["u2","e1"]
  ["Acme AS","e1"]
  ["Delta ASA","e4"]
  ["u1","e1"]

case cte_from_unnest_params
query:
  WITH weights AS (
    SELECT t AS SignalType, w FROM UNNEST(@types) AS t WITH OFFSET i JOIN UNNEST(@weights) AS w WITH OFFSET j ON i = j)
  SELECT s.EntityId, SUM(w.w * s.Confidence) AS score FROM Signals s JOIN weights w USING (SignalType) GROUP BY s.EntityId
params:
  @types ARRAY<STRING> = ["news", "sanction"]
  @weights ARRAY<FLOAT64> = [1.0, 10.0]
expect:
  columns: EntityId STRING, score FLOAT64
  ["e3",0.6]
  ["e1",11.2]

case union_all
query:
  SELECT EntityId AS id, Name FROM Entities WHERE Kind = 'person'
  UNION ALL
  SELECT UserId, Name FROM Users
expect:
  columns: id STRING, Name STRING
  ["e2","Kari Nordmann"]
  ["u1","Ann"]
  ["e5","Ola Nordmann"]
  ["u2",null]
  ["u4","Dan"]

case union_distinct
query:
  SELECT Kind FROM Entities UNION DISTINCT SELECT 'company'
expect:
  columns: Kind STRING
  ["person"]
  ["company"]

case except_distinct
query:
  SELECT EntityId FROM Entities EXCEPT DISTINCT SELECT EntityId FROM Signals
expect:
  columns: EntityId STRING
  ["e4"]
  ["e2"]

case intersect_distinct
query:
  SELECT EntityId FROM Entities INTERSECT DISTINCT SELECT EntityId FROM Signals
expect:
  columns: EntityId STRING
  ["e3"]
  ["e1"]
  ["e5"]

case union_order_limit
query:
  SELECT UserId AS id FROM Users UNION ALL SELECT TeamId FROM Teams ORDER BY id LIMIT 4
expect:
  columns: id STRING
  ["t1"]
  ["t2"]
  ["t3"]
  ["u1"]

case union_column_count_mismatch
query:
  SELECT 1, 2 UNION ALL SELECT 3
expect:
  error: INVALID_ARGUMENT
  message: Queries in UNION ALL have mismatched column count; query 1 has 2 columns, query 2 has 1 column [at 1:23]

case insert_guard_row
query:
  SELECT 'x' AS v FROM (SELECT 1) WHERE EXISTS (SELECT 1 FROM Users WHERE UserId = @u)
params:
  @u STRING = "u1"
expect:
  columns: v STRING
  ["x"]

