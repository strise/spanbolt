# TABLESAMPLE (spanbolt #89). Sampling is random, so the cases check only what is deterministic:
# BERNOULLI at 0 and 100 percent, RESERVOIR with n >= rows (every row) and n < rows (exactly n rows),
# bounds on the sampled count, and the errors for bad arguments.
tags: sql oracle
schema:
  CREATE TABLE Items (
    Id INT64 NOT NULL,
    Grp STRING(16),
    Val INT64,
  ) PRIMARY KEY (Id);
  CREATE INDEX ItemsByGrp ON Items(Grp)
insert Items cols=Id,Grp,Val:
  [1, "a", 10]
  [2, "a", 20]
  [3, "b", 5]
  [4, null, 7]

case bernoulli_all_and_none
query:
  SELECT Id, Grp, Val FROM Items TABLESAMPLE BERNOULLI (100 PERCENT)
expect:
  columns: Id INT64, Grp STRING, Val INT64
  ["4",null,"7"]
  ["3","b","5"]
  ["2","a","20"]
  ["1","a","10"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (0 PERCENT)
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  same
query:
  SELECT i.Id FROM Items AS i TABLESAMPLE BERNOULLI (100 PERCENT) WHERE i.Val > 6
expect:
  columns: Id INT64
  ["2"]
  ["4"]
  ["1"]
expect@spanner:
  same
query:
  SELECT Id FROM Items TABLESAMPLE BERNOULLI (100.0 PERCENT) i WHERE i.Val > 6
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Expected end of input but got identifier "i" [at 1:60]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Syntax error: Expected \";\" or end of input but got identifier \"i\" [at 1:60]
query:
  SELECT COUNT(*) BETWEEN 0 AND 4 AS InRange FROM Items TABLESAMPLE BERNOULLI (50 PERCENT)
expect:
  columns: InRange BOOL
  [true]
expect@spanner:
  same
query:
  SELECT COUNT(*) BETWEEN 0 AND 4 AS InRange FROM Items TABLESAMPLE BERNOULLI (0.5 PERCENT)
expect:
  columns: InRange BOOL
  [true]
expect@spanner:
  same

case bernoulli_params
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p INT64 = 100
expect:
  columns: N INT64
  ["4"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p FLOAT64 = 0.0
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p INT64 = null
expect:
  error: OUT_OF_RANGE
  message: SampleScan requires non-null size
expect@spanner:
  error: OUT_OF_RANGE
  message: Sample size as percent must be in range [0,100].
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p INT64 = 101
expect:
  error: OUT_OF_RANGE
  message: PERCENT value must be in the range [0, 100]
expect@spanner:
  error: OUT_OF_RANGE
  message: Sample size as percent must be in range [0,100].
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p FLOAT64 = -0.5
expect:
  error: OUT_OF_RANGE
  message: PERCENT value must be in the range [0, 100]
expect@spanner:
  error: OUT_OF_RANGE
  message: Sample size as percent must be in range [0,100].
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p STRING = "50"
expect:
  error: INVALID_ARGUMENT
  message: PERCENT expects either a double or an integer literal or parameter [at 1:56]
expect@spanner:
  same

case bernoulli_bad_arguments
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (101 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: PERCENT value must be in the range [0, 100] [at 1:56]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (-1 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected "-" [at 1:56]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected \"-\" [at 1:56]
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (NULL PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected keyword NULL [at 1:56]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (2 ROWS)
expect:
  error: INVALID_ARGUMENT
  message: BERNOULLI/ROWS is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: The specified sampling algorithm (bernoulli/ROWS) is not supported (check the spelling).
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI ('a' PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected string literal 'a' [at 1:56]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected string literal \'a\' [at 1:56]
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (1 + 1 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Expected keyword PERCENT or keyword ROWS but got "+" [at 1:58]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Syntax error: Expected keyword PERCENT or keyword ROWS but got \"+\" [at 1:58]
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE SYSTEM (10 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: SYSTEM sampling is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: The specified sampling algorithm (system/PERCENT) is not supported (check the spelling).

case reservoir_rows
query:
  SELECT Id, Grp, Val FROM Items TABLESAMPLE RESERVOIR (10 ROWS)
expect:
  columns: Id INT64, Grp STRING, Val INT64
  ["1","a","10"]
  ["2","a","20"]
  ["3","b","5"]
  ["4",null,"7"]
expect@spanner:
  same
query:
  SELECT Id FROM Items TABLESAMPLE RESERVOIR (4 ROWS)
expect:
  columns: Id INT64
  ["3"]
  ["4"]
  ["1"]
  ["2"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (2 ROWS)
expect:
  columns: N INT64
  ["2"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (0 ROWS)
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  same
query:
  SELECT COUNT(DISTINCT Id) AS N FROM Items TABLESAMPLE RESERVOIR (3 ROWS)
expect:
  columns: N INT64
  ["3"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (@n ROWS)
params:
  @n INT64 = 1
expect:
  columns: N INT64
  ["1"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (2 ROWS) WHERE Val > 100
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  same
query:
  SELECT COUNT(*) <= 2 AS AtMost FROM Items TABLESAMPLE RESERVOIR (2 ROWS) WHERE Val > 6
expect:
  columns: AtMost BOOL
  [true]
expect@spanner:
  same

case reservoir_bad_arguments
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (-1 ROWS)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected "-" [at 1:56]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected \"-\" [at 1:56]
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (NULL ROWS)
expect:
  error: INVALID_ARGUMENT
  message: Syntax error: Unexpected keyword NULL [at 1:56]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (50 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: RESERVOIR/PERCENT is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: The specified sampling algorithm (reservoir/PERCENT) is not supported (check the spelling).
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (1.5 ROWS)
expect:
  error: INVALID_ARGUMENT
  message: ROWS expects an integer literal or parameter [at 1:56]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (@n ROWS)
params:
  @n INT64 = -2
expect:
  error: OUT_OF_RANGE
  message: SampleScan requires non-negative size
expect@spanner:
  error: INVALID_ARGUMENT
  message: LIMIT value may not be negative.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (@n ROWS)
params:
  @n INT64 = null
expect:
  error: OUT_OF_RANGE
  message: SampleScan requires non-null size
expect@spanner:
  error: INVALID_ARGUMENT
  message: LIMIT value may not be null.

case unsupported_clauses
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (100 PERCENT) REPEATABLE (1)
expect:
  error: INVALID_ARGUMENT
  message: REPEATABLE is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: REPEATABLE TABLESAMPLE is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (2 ROWS) REPEATABLE (7)
expect:
  error: INVALID_ARGUMENT
  message: REPEATABLE is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: REPEATABLE TABLESAMPLE is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (2 ROWS) REPEATABLE (1)
expect:
  error: INVALID_ARGUMENT
  message: REPEATABLE is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: REPEATABLE TABLESAMPLE is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE SYSTEM (2 ROWS) REPEATABLE (1)
expect:
  error: INVALID_ARGUMENT
  message: REPEATABLE is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: REPEATABLE TABLESAMPLE is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE FOO (2 ROWS)
expect:
  error: INVALID_ARGUMENT
  message: Unknown scan method foo
expect@spanner:
  error: INVALID_ARGUMENT
  message: The specified sampling algorithm (foo/ROWS) is not supported (check the spelling).
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (2 ROWS) REPEATABLE (@seed)
params:
  @seed INT64 = null
expect:
  error: INVALID_ARGUMENT
  message: REPEATABLE is not supported
expect@spanner:
  error: INVALID_ARGUMENT
  message: REPEATABLE TABLESAMPLE is not supported.
query:
  SELECT Id, w FROM Items TABLESAMPLE RESERVOIR (10 ROWS) WITH WEIGHT w
expect:
  columns: Id INT64, w FLOAT64
  ["3",1.0]
  ["2",1.0]
  ["4",1.0]
  ["1",1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (1 ROWS PARTITION BY Grp)
expect:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE does not support the PARTITION BY clause [at 1:63]
expect@spanner:
  same

case sample_shapes
query:
  SELECT COUNT(*) AS N FROM (SELECT Id FROM Items WHERE Val > 6) TABLESAMPLE BERNOULLI (100 PERCENT)
expect:
  columns: N INT64
  ["3"]
expect@spanner:
  same
query:
  SELECT x FROM UNNEST([1, 2, 3]) AS x TABLESAMPLE BERNOULLI (100 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE is not allowed with array scans [at 1:38]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items@{FORCE_INDEX=ItemsByGrp} TABLESAMPLE RESERVOIR (10 ROWS) WHERE Grp = 'a'
expect:
  columns: N INT64
  ["2"]
expect@spanner:
  same
query:
  SELECT a.Id, b.Id AS Other FROM Items a TABLESAMPLE BERNOULLI (100 PERCENT) JOIN Items b TABLESAMPLE RESERVOIR (5 ROWS) ON a.Id = b.Id ORDER BY a.Id
expect:
  columns: Id INT64, Other INT64
  ["1","1"]
  ["2","2"]
  ["3","3"]
  ["4","4"]
expect@spanner:
  same
query:
  WITH t AS (SELECT Id FROM Items) SELECT COUNT(*) AS N FROM t TABLESAMPLE RESERVOIR (3 ROWS)
expect:
  columns: N INT64
  ["3"]
expect@spanner:
  same
query:
  SELECT Grp, COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (100 PERCENT) GROUP BY Grp ORDER BY Grp
expect:
  columns: Grp STRING, N INT64
  [null,"1"]
  ["a","2"]
  ["b","1"]
expect@spanner:
  same
query:
  SELECT o.Id, (SELECT COUNT(*) FROM Items TABLESAMPLE RESERVOIR (2 ROWS) WHERE Items.Id > o.Id - 10) AS N FROM Items o ORDER BY o.Id
expect:
  columns: Id INT64, N INT64
  ["1","2"]
  ["2","2"]
  ["3","2"]
  ["4","2"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE reservoir (10 ROWS)
expect:
  columns: N INT64
  ["4"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE Bernoulli (100 PERCENT)
expect:
  columns: N INT64
  ["4"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE FOO (10 PERCENT)
expect:
  error: INVALID_ARGUMENT
  message: Unknown scan method foo
expect@spanner:
  error: INVALID_ARGUMENT
  message: The specified sampling algorithm (foo/PERCENT) is not supported (check the spelling).
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (9223372036854775807 ROWS)
expect:
  columns: N INT64
  ["4"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p FLOAT64 = "NaN"
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  error: OUT_OF_RANGE
  message: Sample size as percent must be in range [0,100].
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE BERNOULLI (@p PERCENT)
params:
  @p FLOAT64 = 100.0
expect:
  columns: N INT64
  ["4"]
expect@spanner:
  same
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (@n ROWS)
params:
  @n FLOAT64 = 2.0
expect:
  error: INVALID_ARGUMENT
  message: ROWS expects an integer literal or parameter [at 1:56]
expect@spanner:
  same

case with_weight
query:
  SELECT w FROM Items TABLESAMPLE RESERVOIR (2 ROWS) WITH WEIGHT w
expect:
  columns: w FLOAT64
  [2.0]
  [2.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT COUNT(*) AS N, MIN(w) AS Lo, MAX(w) AS Hi FROM Items TABLESAMPLE RESERVOIR (3 ROWS) WITH WEIGHT AS w
expect:
  columns: N INT64, Lo FLOAT64, Hi FLOAT64
  ["3",1.3333333333333333,1.3333333333333333]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT Id, weight FROM Items TABLESAMPLE BERNOULLI (100 PERCENT) WITH WEIGHT
expect:
  columns: Id INT64, weight FLOAT64
  ["4",1.0]
  ["3",1.0]
  ["2",1.0]
  ["1",1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT COUNTIF(w != 4.0) AS Off FROM Items TABLESAMPLE BERNOULLI (25 PERCENT) WITH WEIGHT w
expect:
  columns: Off INT64
  ["0"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT COUNTIF(w != 2.0) AS Off FROM Items TABLESAMPLE BERNOULLI (@p PERCENT) WITH WEIGHT w
params:
  @p FLOAT64 = 50.0
expect:
  columns: Off INT64
  ["0"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT COUNT(*) AS N FROM Items TABLESAMPLE RESERVOIR (0 ROWS) WITH WEIGHT w
expect:
  columns: N INT64
  ["0"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT Id, w FROM (SELECT Id FROM Items WHERE Id > 1) TABLESAMPLE RESERVOIR (5 ROWS) WITH WEIGHT w
expect:
  columns: Id INT64, w FLOAT64
  ["2",1.0]
  ["4",1.0]
  ["3",1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT Id, Items.w FROM Items TABLESAMPLE RESERVOIR (5 ROWS) WITH WEIGHT w
expect:
  error: INVALID_ARGUMENT
  message: Name w not found inside Items [at 1:18]
expect@spanner:
  same
query:
  SELECT * FROM Items TABLESAMPLE RESERVOIR (5 ROWS) WITH WEIGHT w
expect:
  columns: Id INT64, Grp STRING, Val INT64, w FLOAT64
  ["2","a","20",1.0]
  ["4",null,"7",1.0]
  ["3","b","5",1.0]
  ["1","a","10",1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
query:
  SELECT Id, Val FROM Items TABLESAMPLE RESERVOIR (5 ROWS) WITH WEIGHT Val
expect:
  columns: Id INT64, Val FLOAT64
  ["4",1.0]
  ["3",1.0]
  ["1",1.0]
  ["2",1.0]
expect@spanner:
  error: INVALID_ARGUMENT
  message: TABLESAMPLE WITH WEIGHT is not supported.
