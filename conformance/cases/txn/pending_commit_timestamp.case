# Reading a cell that DML wrote with PENDING_COMMIT_TIMESTAMP() in the same read-write transaction:
# its value isn't known until commit, so Spanner rejects the read (emulator issue #25, v1.5.43).
# Buffered mutations aren't visible to reads in the transaction, so they never conflict.
tags: txn sql
schema:
  CREATE TABLE Events (
    Id STRING(36) NOT NULL,
    Created TIMESTAMP OPTIONS (allow_commit_timestamp = true),
    Note STRING(MAX),
  ) PRIMARY KEY (Id);
  CREATE INDEX EventsByCreated ON Events(Created);
  CREATE INDEX EventsByNote ON Events(Note);
  CREATE INDEX EventsByNoteStoring ON Events(Note) STORING (Created);
  CREATE TABLE Others (
    Id INT64 NOT NULL,
    V STRING(MAX),
  ) PRIMARY KEY (Id)
insert Events cols=Id,Created,Note:
  ["seed", "2020-01-01T00:00:00Z", "n"]
insert Others cols=Id,V:
  [1, "x"]

case select_pending_column
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Created FROM Events WHERE Id = 'a'
expect:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because it, or its associated index, has a pending CommitTimestamp
expect@spanner:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because 1. it, or its associated index, has a pending CommitTimestamp, or 2. change stream tracking Column Created can't access the pending commit timestamp to record the old value.

case select_other_columns
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Id, Note FROM Events WHERE Id = 'a'
expect:
  columns: Id STRING, Note STRING
  ["a",null]
expect@spanner:
  same

