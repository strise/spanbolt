case select_other_table
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT V FROM Others
expect:
