  ["x"]
expect@spanner:
  same
commit txn=t
expect:
  ok
expect@spanner:
  same

case select_after_update
begin txn=t
dml txn=t:
  UPDATE Events SET Created = PENDING_COMMIT_TIMESTAMP() WHERE Id = 'seed'
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Created FROM Events WHERE Id = 'seed'
expect:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because it, or its associated index, has a pending CommitTimestamp
expect@spanner:
  error: INVALID_ARGUMENT
  message: Column Created cannot be accessed because 1. it, or its associated index, has a pending CommitTimestamp, or 2. change stream tracking Column Created can't access the pending commit timestamp to record the old value.

case then_return_pending_column
dml:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
  THEN RETURN Created
expect:
  error: INVALID_ARGUMENT
  message: The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.
expect@spanner:
  same

case then_return_star
dml:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
  THEN RETURN *
expect:
  error: INVALID_ARGUMENT
  message: The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.
expect@spanner:
  same

case then_return_other_column
dml:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
  THEN RETURN Id, Note
expect:
  count: 1
  columns: Id STRING, Note STRING
  ["a",null]
expect@spanner:
  same

case update_then_return_pending_column
dml:
  UPDATE Events SET Created = PENDING_COMMIT_TIMESTAMP() WHERE Id = 'seed'
  THEN RETURN Id, Created
expect:
  error: INVALID_ARGUMENT
  message: The PENDING_COMMIT_TIMESTAMP() function may only be used as a value for INSERT or UPDATE of an appropriately typed column. It cannot be used in SELECT, or as the input to any other scalar expression.
expect@spanner:
  same

case second_insert_same_table
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('b', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
commit txn=t
expect:
  ok
expect@spanner:
  same
query:
  SELECT COUNT(*) FROM Events WHERE Created > '2021-01-01T00:00:00Z'
expect:
  columns: INT64
  ["2"]
expect@spanner:
  same

