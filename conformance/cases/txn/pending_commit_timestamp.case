case query_force_index_on_pending_column
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Id FROM Events@{FORCE_INDEX=EventsByCreated}
expect:
  columns: Id STRING
  ["seed"]
  ["a"]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Table _Index_EventsByCreated cannot be accessed because 1. it, or its associated index, has a pending CommitTimestamp, or 2. change stream tracking Table _Index_EventsByCreated can't access the pending commit timestamp to record the old value.

case query_force_index_storing_pending_column
begin txn=t
dml txn=t:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
query txn=t:
  SELECT Id, Note FROM Events@{FORCE_INDEX=EventsByNoteStoring}
expect:
  columns: Id STRING, Note STRING
  ["seed","n"]
  ["a",null]
expect@spanner:
  same

case mutation_then_select
begin txn=t
insert Events cols=Id,Created txn=t:
  ["a", "spanner.commit_timestamp()"]
query txn=t:
  SELECT Id, Created FROM Events
expect:
  columns: Id STRING, Created TIMESTAMP
  ["seed","2020-01-01T00:00:00Z"]
expect@spanner:
  same
commit txn=t
expect:
  ok
expect@spanner:
  same

case select_after_commit
dml:
  INSERT INTO Events (Id, Created) VALUES ('a', PENDING_COMMIT_TIMESTAMP())
expect:
  count: 1
expect@spanner:
  same
begin txn=t
query txn=t:
  SELECT Id, Created FROM Events WHERE Id = 'a'
expect:
  columns: Id STRING, Created TIMESTAMP
  ["a","<now>"]
expect@spanner:
  same
