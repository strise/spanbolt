tags: values float32
schema:
  CREATE TABLE V (
    K INT64 NOT NULL,
    B BOOL,
    I INT64,
    F32 FLOAT32,
    F FLOAT64,
    N NUMERIC,
    S STRING(MAX),
    S3 STRING(3),
    Y BYTES(MAX),
    Y2 BYTES(2),
    D DATE,
    Ts TIMESTAMP,
    J JSON,
    AI ARRAY<INT64>,
    AS_ ARRAY<STRING(MAX)>,
    AF ARRAY<FLOAT64>,
    AN ARRAY<NUMERIC>,
    AJ ARRAY<JSON>,
    AY ARRAY<BYTES(MAX)>,
    AD ARRAY<DATE>,
    ATs ARRAY<TIMESTAMP>,
    AB ARRAY<BOOL>,
  ) PRIMARY KEY (K)

case one_point_five
insert V cols=K,F32:
  [1, 1.5]
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32
  ["1",1.5]

case nan
insert V cols=K,F32:
  [1, "NaN"]
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32
  ["1","NaN"]

case point_one
insert V cols=K,F32:
  [1, 0.1]
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32
  ["1",0.10000000149011612]

case max
insert V cols=K,F32:
  [1, 3.4028234663852886e38]
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32
  ["1",3.4028234663852886e+38]

case overflow
insert V cols=K,F32:
  [1, 1e39]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse number_value: 1e+39 as FLOAT
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32

case neg_inf
insert V cols=K,F32:
  [1, "-Infinity"]
read V cols=K,F32:
  [1]
expect:
  columns: K INT64, F32 FLOAT32
  ["1","-Infinity"]

