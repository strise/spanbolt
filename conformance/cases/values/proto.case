tags: values proto
# PROTO and ENUM columns through mutations and the Read API (#127). PROTO values are base64 bytes
# on the wire, ENUM values INT64 strings. `expect:` from the emulator 1.5.59.
proto:
  syntax = "proto2";
  package examples.music;
  message SingerInfo {
    optional int64 singer_id = 1;
    optional string birth_date = 2;
    optional string nationality = 3;
    optional Genre genre = 4;
    repeated string tags = 5;
    message Nested { optional int32 x = 1; }
    optional Nested nested = 6;
  }
  enum Genre {
    POP = 0;
    JAZZ = 1;
    FOLK = 2;
    ROCK = 3;
  }
schema:
  CREATE PROTO BUNDLE (examples.music.SingerInfo, examples.music.Genre, examples.music.SingerInfo.Nested);
  CREATE TABLE V (
    K INT64 NOT NULL,
    P examples.music.SingerInfo,
    E examples.music.Genre,
    AP ARRAY<examples.music.SingerInfo>,
    AE ARRAY<examples.music.Genre>,
    N examples.music.SingerInfo.Nested,
  ) PRIMARY KEY (K)

case round_trip
insert V cols=K,P,E,AP,AE,N:
  [1, "CAUgASoBYTICCAE=", 1, ["CAU=", null, ""], [0, 3, null], "CAE="]
  [2, null, null, null, null, null]
  [3, "", 0, [], [], ""]
read V cols=K,P,E,AP,AE,N:
  all
expect:
  columns: K INT64, P PROTO<examples.music.SingerInfo>, E ENUM<examples.music.Genre>, AP ARRAY<PROTO<examples.music.SingerInfo>>, AE ARRAY<ENUM<examples.music.Genre>>, N PROTO<examples.music.SingerInfo.Nested>
  ["1","CAUgASoBYTICCAE=","1",["CAU=",null,""],["0","3",null],"CAE="]
  ["2",null,null,null,null,null]
  ["3","","0",[],[],""]
expect@spanner:
  same

case enum_undefined_value
skip@emulator: the emulator aborts on an enum number its enum doesn't define
insert V cols=K,E:
  [1, 99]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Request contains an invalid argument.
read V cols=K,E:
  all
expect@spanner:
  columns: K INT64, E ENUM<examples.music.Genre>

case enum_negative_value
skip@emulator: the emulator aborts on an enum number its enum doesn't define
insert V cols=K,E:
  [1, -1]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Request contains an invalid argument.

case enum_out_of_int32_range
insert V cols=K,E:
  [1, 4294967296]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse 4294967296 as an integer
expect@spanner:
  error: FAILED_PRECONDITION
  message: Invalid value for column E in table V: Expected ENUM.

case enum_array_undefined_value
skip@emulator: the emulator aborts on an enum number its enum doesn't define
insert V cols=K,AE:
  [1, [1, 42]]
expect@spanner:
  error: INVALID_ARGUMENT
  message: Request contains an invalid argument.

case enum_by_name
insert V cols=K,E:
  [1, "JAZZ"]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse JAZZ as an integer
expect@spanner:
  error: FAILED_PRECONDITION
  message: Invalid value for column E in table V: Expected ENUM.

case enum_as_float
insert V cols=K,E:
  [1, 1.0]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse number_value: 1 as ENUM<examples.music.Genre>
expect@spanner:
  error: FAILED_PRECONDITION
  message: Invalid value for column E in table V: Expected ENUM.

case proto_invalid_bytes
insert V cols=K,P:
  [1, "//8="]
expect:
  ok
expect@spanner:
  same
read V cols=K,P:
  all
expect:
  columns: K INT64, P PROTO<examples.music.SingerInfo>
  ["1","//8="]
expect@spanner:
  same

case proto_not_base64
insert V cols=K,P:
  [1, "not base64!"]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse not base64! as BYTES. Byte strings must be base64-encoded. For more details, see https://cloud.google.com/spanner/docs/reference/rpc/google.spanner.v1#typecode
expect@spanner:
  error: FAILED_PRECONDITION
  message: Invalid value for column P in table V: Expected Base64 encoded PROTO.

case proto_as_number
insert V cols=K,P:
  [1, 5]
expect:
  error: FAILED_PRECONDITION
  message: Could not parse 5 as BYTES. Byte strings must be base64-encoded. For more details, see https://cloud.google.com/spanner/docs/reference/rpc/google.spanner.v1#typecode
expect@spanner:
  error: FAILED_PRECONDITION
  message: Invalid value for column P in table V: Expected Base64 encoded PROTO.

case proto_wrong_message_bytes
insert V cols=K,N:
  [1, "CAUgASoBYTICCAE="]
expect:
  ok
expect@spanner:
  same
read V cols=K,N:
  all
expect:
  columns: K INT64, N PROTO<examples.music.SingerInfo.Nested>
  ["1","CAUgASoBYTICCAE="]
expect@spanner:
  same

case update_and_replace
insert V cols=K,P,E:
  [1, "CAU=", 1]
update V cols=K,E:
  [1, 2]
replace V cols=K,P:
  [2, "CAU="]
read V cols=K,P,E:
  all
expect:
  columns: K INT64, P PROTO<examples.music.SingerInfo>, E ENUM<examples.music.Genre>
  ["1","CAU=","2"]
  ["2","CAU=",null]
expect@spanner:
  same

case not_null_columns
schema:
  CREATE PROTO BUNDLE (examples.music.SingerInfo, examples.music.Genre);
  CREATE TABLE V (
    K INT64 NOT NULL,
    P examples.music.SingerInfo NOT NULL,
    E examples.music.Genre NOT NULL,
  ) PRIMARY KEY (K)
insert V cols=K,P:
  [1, "CAU="]
expect:
  error: FAILED_PRECONDITION
  message: A new row in table V does not specify a non-null value for NOT NULL column: E
expect@spanner:
  error: FAILED_PRECONDITION
  message: A new row in table V does not specify a non-null value for these NOT NULL columns: E.
insert V cols=K,P,E:
  [1, null, 1]
expect:
  error: FAILED_PRECONDITION
  message: Cannot specify a null value for column: V.P in table: V
expect@spanner:
  error: FAILED_PRECONDITION
  message: P must not be NULL in table V.
insert V cols=K,P,E:
  [1, "", 0]
expect:
  ok
expect@spanner:
  same
read V cols=K,P,E:
  all
expect:
  columns: K INT64, P PROTO<examples.music.SingerInfo>, E ENUM<examples.music.Genre>
  ["1","","0"]
expect@spanner:
  same

case enum_key
schema:
  CREATE PROTO BUNDLE (examples.music.Genre);
  CREATE TABLE V (
    G examples.music.Genre NOT NULL,
    S STRING(MAX),
  ) PRIMARY KEY (G)
insert V cols=G,S:
  [3, "rock"]
  [1, "jazz"]
  [0, "pop"]
read V cols=G,S:
  all
expect:
  columns: G ENUM<examples.music.Genre>, S STRING
  ["0","pop"]
  ["1","jazz"]
  ["3","rock"]
expect@spanner:
  same
read V cols=G,S:
  [1]
expect:
  columns: G ENUM<examples.music.Genre>, S STRING
  ["1","jazz"]
expect@spanner:
  same
read V cols=G,S:
  range [1] .. [3]
expect:
  columns: G ENUM<examples.music.Genre>, S STRING
  ["1","jazz"]
  ["3","rock"]
expect@spanner:
  same
delete V:
  [1]
read V cols=G,S:
  all
expect:
  columns: G ENUM<examples.music.Genre>, S STRING
  ["0","pop"]
  ["3","rock"]
expect@spanner:
  same

case enum_index_read
schema:
  CREATE PROTO BUNDLE (examples.music.Genre);
  CREATE TABLE V (
    K INT64 NOT NULL,
    G examples.music.Genre,
  ) PRIMARY KEY (K);
  CREATE INDEX VByG ON V(G)
insert V cols=K,G:
  [1, 3]
  [2, 1]
  [3, null]
read V cols=K,G index=VByG:
  all
expect:
  columns: K INT64, G ENUM<examples.music.Genre>
  ["3",null]
  ["2","1"]
  ["1","3"]
expect@spanner:
  same
read V cols=K,G index=VByG:
  [1]
expect:
  columns: K INT64, G ENUM<examples.music.Genre>
  ["2","1"]
expect@spanner:
  same
